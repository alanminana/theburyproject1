{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.claude/skills/impeccable/scripts/impeccable context *)",
      "Bash(grep -n \"^\\\\.[a-z-]* *{\\\\|^\\\\.[a-z-]*,$\" shared-components.css)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opusplan",
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "disabledMcpjsonServers": [
    "context7",
    "github"
  ],
  "skillOverrides": {
    "context7-protocolo": "off",
    "csharp-testing": "off",
    "dotnet-patterns": "off",
    "normalize-razor-structure": "off",
    "ui-ux-pro-max": "off"
  }
}
