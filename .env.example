# Copiar a .env (NO commitear .env) y reemplazar TODOS los CHANGE_ME.
#   cp .env.example .env
# Generar contraseñas fuertes:  openssl rand -base64 24
#
# Caracteres especiales en contraseñas: la app y db-init las manejan con cualquier caracter (; " ' $ \ etc.).
# Usar comillas SIMPLES: Compose no interpola su contenido. Dentro de ellas, escapar una comilla simple como \'.
# No hacer `source .env`: el formato dotenv de Compose no es un script de shell.
# No imprimir `docker compose config`, `config --environment`, `env` ni `docker inspect` en logs/CI.
# Validar estructura sin imprimir valores: docker compose config --quiet.

# --- SQL Server ---
# Minimo 8 caracteres y 3 de 4 clases (mayuscula, minuscula, digito, simbolo). El valor de ejemplo NO cumple a proposito:
# db-init y la app rechazan CHANGE_ME explicitamente.
# Credencial ADMINISTRATIVA: solo la usan los servicios `db` y `db-init`. La app NUNCA la recibe.
MSSQL_SA_PASSWORD=CHANGE_ME
MSSQL_DATABASE=TheBuryProjectDb
# Credencial de la APLICACION (login SQL dedicado, sin roles de servidor; SOLO db_datareader/db_datawriter: sin DDL).
# db-init lo crea/actualiza; `app` se conecta con este usuario. Usuario: letras, digitos y _ (no puede ser `sa`).
ERP_DB_USER=CHANGE_ME
ERP_DB_PASSWORD=CHANGE_ME
# Credencial de MIGRACIONES (login SQL dedicado; db_datareader/db_datawriter/db_ddladmin, sin sysadmin ni db_owner).
# Solo la usa el servicio one-shot `migrate`. Debe ser un usuario DISTINTO de ERP_DB_USER (y no `sa`).
ERP_MIGRATION_USER=CHANGE_ME
ERP_MIGRATION_PASSWORD=CHANGE_ME
# Developer = solo desarrollo. Produccion: Express (gratis, 10 GB / 1 GB RAM) o Standard/Enterprise con licencia.
MSSQL_PID=Developer

# --- ERP: usuario administrador inicial (SuperAdmin) ---
# Password: minimo 6 caracteres con mayuscula, minuscula y digito (reglas de Identity).
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
# Despues del primer login: cambiar la password desde Identity, borrar ADMIN_PASSWORD de .env
# y eliminar el contenedor detenido `migrate` (docker compose rm -f migrate).
# Deploys posteriores verifican el admin existente; una base nueva sin password falla.

# --- Red / HTTPS ---
# Dominio publico del ERP (Caddy emite y renueva el certificado). Requiere DNS A/AAAA apuntando al servidor y 80/443 abiertos.
ERP_DOMAIN=CHANGE_ME
# Subred fija de la red Docker interna; ASP.NET solo confia en X-Forwarded-* originados aqui. Cambiar solo si choca con tu red.
BURY_NET_SUBNET=172.29.88.0/24
# Solo overlay de desarrollo: puerto local (127.0.0.1) donde se publica Kestrel. En produccion `app` no se publica.
APP_PORT=8080
# Solo overlay de desarrollo: puerto local de SQL Server.
MSSQL_HOST_PORT=1433

# --- Mercado Libre (opcional; dejar vacio si no se usa) ---
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
# URL publica de callback OAuth; debe coincidir con la configurada en la app de Mercado Libre.
# Forma: https://<ERP_DOMAIN>/MercadoLibre/OAuthCallback
MERCADOLIBRE_REDIRECT_URI=

# --- Backups (scripts/backup/, ver docs/backup-restore.md) ---
# Directorio del HOST donde quedan los backups (sql/, files/, logs/). En produccion usar una ruta FUERA del repo y, idealmente, de otro
# disco/particion que los datos de SQL, p.ej. /srv/bury-backups. Contiene datos sensibles: se crea con permisos 700. NUNCA se sirve por web.
BACKUP_DIR=./backups
# Retencion local (dias, por NOMBRE de archivo) y minimo de backups recientes que se conservan siempre.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN_KEEP=3
# Copia externa (opcional pero RECOMENDADA): <remoto>:<ruta>, resuelto por rclone. El remoto "offsite" se define en backup-offsite.env
# (RCLONE_CONFIG_OFFSITE_* ; ver backup-offsite.env.example). Vacio = sin copia externa (el backup avisa con WARN en cada corrida).
BACKUP_REMOTE=
# true = el backup FALLA (exit 6) si BACKUP_REMOTE esta vacio. Activar en produccion.
BACKUP_REQUIRE_OFFSITE=false
# Dias que se conservan los backups en el remoto (0 = no borrar nada en el remoto).
BACKUP_REMOTE_RETENTION_DAYS=30
# Incluir caddy-data (certificados ACME) en el backup de archivos. Solo acelera la recuperacion (evita re-emitir certificados).
BACKUP_INCLUDE_CADDY=true
# Detener `app` unos segundos durante `backup.sh all` para que SQL y archivos sean un par consistente.
BACKUP_STOP_APP=true
# auto = COMPRESSION solo si la edicion lo soporta (Express NO). on | off para forzar.
BACKUP_SQL_COMPRESSION=auto
