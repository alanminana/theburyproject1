  "narrative": {
    "northStar": "El Mostrador Sereno",
    "overview": "Sistema oscuro, sobrio y amigable pensado para sesiones largas en un comercio real. Fondos casi negros con matiz violeta, texto claro de alto contraste y un único acento lima; la profundidad es tonal. Voz cálida y amable, profesional y tranquila.",
    "keyCharacteristics": [
      "Fondos oscuros suaves con matiz violeta",
      "Un solo acento lima",
      "Profundidad tonal; única sombra en el CTA",
      "Controles de 44px y texto mínimo de 12px",
      "Todo el color sale de palette.css"
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "El lima aparece solo en acciones principales, foco y selección activa.",
        "section": "colors"
      },
      {
        "name": "The Floor Contrast Rule",
        "body": "Todo texto sobre superficie oscura llega a ≥6,4:1.",
        "section": "colors"
      },
      {
        "name": "The Dark Ink Rule",
        "body": "Sobre acento o estados claros el texto es tinta oscura, no blanca.",
        "section": "colors"
      },
      {
        "name": "The Single Source Rule",
        "body": "Ningún hex/rgb literal fuera de palette.css.",
        "section": "colors"
      },
      {
        "name": "The 12px Floor Rule",
        "body": "Nada por debajo de 12px.",
        "section": "typography"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Importes en mono/tabular, alineados a la derecha.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Paneles, cards y tablas son planos en reposo; la profundidad es tonal.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do consumir color solo vía --pal-* / --erp-* / --ml-*.",
      "Do usar texto oscuro sobre el acento lima y estados claros.",
      "Do dar a todo control 44px de alto y foco visible de 2px lima.",
      "Do mantener texto ≥12px y ≥6,4:1 de contraste.",
      "Do reutilizar los componentes canónicos antes de crear variantes por módulo."
    ],
    "donts": [
      "Don't introducir un segundo design system ni hex literales fuera de palette.css.",
      "Don't usar blanco puro de texto sobre lima, ámbar o verde.",
      "Don't agregar sombras de reposo a cards o paneles.",
      "Don't usar el lima como decoración ni en más de una acción principal por pantalla.",
      "Don't usar rojo 500 puro como texto sobre fondo oscuro.",
      "Don't hacer la interfaz agresiva ni recargada."
