@model IEnumerable<TheBuryProject.ViewModels.ProductoCriticoViewModel>
@{
    ViewData["Title"] = "Productos Críticos de Stock";
    var lista = Model?.OrderByDescending(p => p.EstaAgotado).ThenBy(p => p.PorcentajeStockMinimo).ToList()
                ?? new List<TheBuryProject.ViewModels.ProductoCriticoViewModel>();
    var agotados = lista.Count(p => p.EstaAgotado);
}

<div class="inv-screen inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-controller="Catalogo" asp-action="Index" asp-route-tab="alertas" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Alertas</a>
            <h1>Productos críticos</h1>
            <p>Stock agotado o por debajo del mínimo. Primero los agotados.</p>
        </div>
        <div class="inv-head__acciones">
            <a asp-action="Estadisticas" class="inv-btn inv-btn--ghost">Estadísticas</a>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    @if (lista.Any())
    {
        <dl class="inv-panel inv-resumen">
            <div><dt>Agotados</dt><dd class="@(agotados > 0 ? "inv-text-danger" : null)">@agotados</dd></div>
            <div><dt>Bajo el mínimo</dt><dd>@(lista.Count - agotados)</dd></div>
            <div><dt>Valor en riesgo</dt><dd>$ @lista.Sum(p => p.ValorInventario).ToString("N0")</dd></div>
        </dl>

        <section class="inv-panel inv-panel--tabla" aria-label="Productos críticos">
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de productos críticos">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="inv-col-num">Stock / mínimo</th>
                            <th scope="col" class="inv-col-num">Reposición sugerida</th>
                            <th scope="col" class="inv-col-num">Valor en inventario</th>
                            <th scope="col">Última venta</th>
                            <th scope="col" class="inv-col-actions">Alertas pendientes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in lista)
                        {
                            <tr>
                                <th scope="row">
                                    @p.Nombre
                                    <p class="inv-ayuda-texto">@p.Codigo · @p.CategoriaNombre@(p.MarcaNombre != null ? " · " + p.MarcaNombre : "")</p>
                                </th>
                                <td data-label="Stock / mínimo" class="inv-col-num">
                                    <span class="inv-importe @(p.EstaAgotado ? "inv-text-danger" : null)">@p.StockActual.ToString("N0")</span> / @p.StockMinimo.ToString("N0")
                                    <p class="inv-ayuda-texto">@(p.EstaAgotado ? "Agotado" : $"{p.PorcentajeStockMinimo:N0} % del mínimo")</p>
                                </td>
                                <td data-label="Reposición sugerida" class="inv-col-num">@(p.CantidadSugeridaReposicion.HasValue ? p.CantidadSugeridaReposicion.Value.ToString("N0") : "—")</td>
                                <td data-label="Valor en inventario" class="inv-col-num">$ @p.ValorInventario.ToString("N2")</td>
                                <td data-label="Última venta">
                                    @(p.UltimaVenta.HasValue ? p.UltimaVenta.Value.AHoraComercial().ToString("dd/MM/yyyy") : "Sin ventas")
                                    @if (p.DiasDesdeUltimaVenta > 0)
                                    {
                                        <p class="inv-ayuda-texto">hace @p.DiasDesdeUltimaVenta días</p>
                                    }
                                </td>
                                <td data-label="Alertas pendientes" class="inv-col-actions">
                                    <a asp-action="PorProducto" asp-route-id="@p.Id" class="inv-btn inv-btn--ghost inv-btn--sm" aria-label="Ver las @p.AlertasPendientes alertas pendientes de @p.Nombre">@p.AlertasPendientes · ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <div class="inv-panel inv-empty">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <p class="inv-empty__title">No hay productos en estado crítico.</p>
        </div>
    }
</div>
