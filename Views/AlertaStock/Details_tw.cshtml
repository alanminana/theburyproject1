@model TheBuryProject.ViewModels.AlertaStockViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Detalle de Alerta";
    var tipo = AlertaStockUi.Tipo(Model.Tipo);
    var estado = AlertaStockUi.Estado(Model.Estado);
    var activa = AlertaStockUi.EstaActiva(Model.Estado);
    var volver = ViewData["ReturnUrl"] as string ?? Url.Action("Index", "Catalogo", new { tab = "alertas" });
    var aqui = Url.Action("Details", "AlertaStock", new { id = Model.Id });
    var version = Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : null;
}

<div class="inv-screen inv-screen--form inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a href="@volver" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Volver</a>
            <h1>@Model.ProductoNombre <span class="@estado.Clase">@estado.Texto</span></h1>
            <p>@Model.ProductoCodigo · @Model.CategoriaNombre@(string.IsNullOrEmpty(Model.MarcaNombre) ? "" : " · " + Model.MarcaNombre)</p>
        </div>
        <div class="inv-head__acciones">
            <a asp-action="PorProducto" asp-route-id="@Model.ProductoId" class="inv-btn inv-btn--ghost">Alertas del producto</a>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <section class="inv-panel" aria-label="Detalle de la alerta">
        <p>
            <span class="@tipo.Clase">@tipo.Texto</span>
            <span class="inv-pill">Prioridad @AlertaStockUi.Prioridad(Model.Prioridad).Texto.ToLowerInvariant()</span>
            @if (Model.NotificacionUrgente && activa)
            {
                <span class="inv-pill inv-pill--danger">Urgente</span>
            }
        </p>
        <p>@Model.Mensaje</p>
        <dl class="inv-resumen">
            <div><dt>Stock actual</dt><dd class="@(Model.StockActual <= 0 ? "inv-text-danger" : null)">@Model.StockActual.ToString("N0")</dd></div>
            <div><dt>Stock mínimo</dt><dd>@Model.StockMinimo.ToString("N0")</dd></div>
            @if (Model.CantidadSugeridaReposicion.HasValue)
            {
                <div><dt>Reposición sugerida</dt><dd>@Model.CantidadSugeridaReposicion.Value.ToString("N0")</dd></div>
            }
            <div><dt>Generada</dt><dd>@Model.FechaAlerta.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</dd></div>
            @if (Model.FechaResolucion.HasValue)
            {
                <div><dt>Cerrada</dt><dd>@Model.FechaResolucion.Value.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div><dt>Cerrada por</dt><dd>@(Model.UsuarioResolucion ?? "—")</dd></div>
            }
        </dl>
        @if (!string.IsNullOrEmpty(Model.Observaciones))
        {
            <p class="inv-aviso inv-aviso--info"><strong>Observaciones:</strong> @Model.Observaciones</p>
        }
    </section>

    @if (activa && User.TienePermiso("stock", "adjust"))
    {
        <section class="inv-panel" aria-labelledby="alerta-acciones">
            <h2 id="alerta-acciones" class="inv-panel__titulo">Cerrar la alerta</h2>
            <p class="inv-ayuda-texto">Ninguna de estas acciones modifica el stock.</p>
            <form id="form-resolver-alerta" asp-action="Resolver" method="post" data-prevent-double-submit>
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="rowVersion" value="@version" disabled="@(version == null)" />
                <input type="hidden" name="returnUrl" value="@aqui" />
                <div class="inv-campo">
                    <label class="inv-campo__etiqueta" for="alerta-observaciones">Observaciones <span class="inv-campo__requerido">(opcional)</span></label>
                    <textarea id="alerta-observaciones" name="observaciones" rows="2" maxlength="1000" class="inv-control"></textarea>
                </div>
            </form>
            <div class="inv-actions">
                <form asp-action="Ignorar" method="post" data-prevent-double-submit data-inv-confirm="@AlertaStockUi.ConfirmarIgnorar(Model)">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="rowVersion" value="@version" disabled="@(version == null)" />
                    <input type="hidden" name="returnUrl" value="@aqui" />
                    <button type="submit" class="inv-btn inv-btn--ghost">Ignorar</button>
                </form>
                @if (Model.Estado == EstadoAlerta.Pendiente)
                {
                    <form asp-action="MarcarEnProceso" method="post" data-prevent-double-submit>
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="rowVersion" value="@version" disabled="@(version == null)" />
                        <input type="hidden" name="returnUrl" value="@aqui" />
                        <button type="submit" class="inv-btn inv-btn--ghost">Marcar en proceso</button>
                    </form>
                }
                <button type="submit" form="form-resolver-alerta" class="inv-btn inv-btn--primary">Marcar como resuelta</button>
            </div>
        </section>
    }
</div>
