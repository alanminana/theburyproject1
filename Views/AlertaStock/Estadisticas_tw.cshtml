@model TheBuryProject.ViewModels.AlertaStockEstadisticasViewModel
@{
    ViewData["Title"] = "Estadísticas de Alertas de Stock";
    var porPrioridad = new[] { ("Crítica", Model.AlertasCriticas), ("Alta", Model.AlertasAltas), ("Media", Model.AlertasMedias) };
    var porTipo = new[]
    {
        ("Stock agotado", Model.AlertasStockAgotado), ("Stock crítico", Model.AlertasStockCritico),
        ("Stock bajo", Model.AlertasStockBajo), ("Sin movimiento", Model.AlertasSinMovimiento)
    };
}

<div class="inv-screen inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            @* Sin productos.view el catálogo responde «Acceso denegado»: la miga vuelve al listado propio. *@
            @if (User.TienePermiso("productos", "view"))
            {
                <a asp-controller="Catalogo" asp-action="Index" asp-route-tab="alertas" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Alertas</a>
            }
            else
            {
                <a asp-controller="AlertaStock" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Alertas</a>
            }
            <h1>Estadísticas de alertas</h1>
        </div>
        <div class="inv-head__acciones">
            <a asp-action="Criticos" class="inv-btn inv-btn--ghost">Productos críticos</a>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <dl class="inv-panel inv-resumen">
        <div><dt>Pendientes</dt><dd>@Model.AlertasPendientes de @Model.TotalAlertas</dd></div>
        <div><dt>Urgentes</dt><dd>@Model.AlertasUrgentes</dd></div>
        <div><dt>Vencidas</dt><dd>@Model.AlertasVencidas</dd></div>
        <div><dt>Resueltas</dt><dd>@Model.AlertasResueltas (@Model.TasaResolucionPorcentaje.ToString("N0") %)</dd></div>
        <div><dt>Tiempo promedio de resolución</dt><dd>@Model.PromedioResolucionDias.ToString("N1") días</dd></div>
        <div><dt>Productos afectados</dt><dd>@Model.ProductosAfectados</dd></div>
        @* Mismo cálculo que «Valor en riesgo» de Productos críticos (crítico + agotado). *@
        <div><dt>Valor en riesgo</dt><dd>$ @Model.ValorTotalStockCritico.ToString("N0")</dd></div>
    </dl>

    <div class="inv-grid-2">
        <section class="inv-panel" aria-labelledby="est-prioridad">
            <h2 id="est-prioridad" class="inv-panel__titulo">Por prioridad</h2>
            @foreach (var (texto, cantidad) in porPrioridad)
            {
                <label class="inv-barra">
                    <span>@texto</span>
                    <meter min="0" max="@Math.Max(1, Model.TotalAlertas)" value="@cantidad">@cantidad</meter>
                    <strong>@cantidad</strong>
                </label>
            }
        </section>
        <section class="inv-panel" aria-labelledby="est-tipo">
            <h2 id="est-tipo" class="inv-panel__titulo">Por tipo</h2>
            <dl class="inv-datos">
                @foreach (var (texto, cantidad) in porTipo)
                {
                    <div class="inv-datos__fila"><dt>@texto</dt><dd>@cantidad</dd></div>
                }
            </dl>
        </section>
    </div>

    <div class="inv-grid-2">
        @if (Model.UltimasAlertas.Any())
        {
            <section class="inv-panel" aria-labelledby="est-ultimas">
                <h2 id="est-ultimas" class="inv-panel__titulo">Últimas alertas</h2>
                <ul class="inv-lista">
                    @foreach (var a in Model.UltimasAlertas.Take(10))
                    {
                        var tipo = AlertaStockUi.Tipo(a.Tipo);
                        <li>
                            <div>
                                <a class="inv-link" asp-action="Details" asp-route-id="@a.Id">@a.ProductoNombre</a>
                                <p class="inv-ayuda-texto">@a.FechaAlerta.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <span class="@tipo.Clase">@tipo.Texto</span>
                        </li>
                    }
                </ul>
            </section>
        }
        @if (Model.ProductosMasAlertas.Any())
        {
            <section class="inv-panel" aria-labelledby="est-productos">
                <h2 id="est-productos" class="inv-panel__titulo">Productos con más alertas</h2>
                <ul class="inv-lista">
                    @foreach (var p in Model.ProductosMasAlertas.Take(10))
                    {
                        <li>
                            <div>
                                <a class="inv-link" asp-action="PorProducto" asp-route-id="@p.ProductoId">@p.ProductoNombre</a>
                                <p class="inv-ayuda-texto">@p.CategoriaNombre · stock @p.StockActual.ToString("N0") de un mínimo de @p.StockMinimo.ToString("N0")</p>
                            </div>
                            <strong>@p.TotalAlertas @(p.TotalAlertas == 1 ? "alerta" : "alertas")</strong>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</div>
