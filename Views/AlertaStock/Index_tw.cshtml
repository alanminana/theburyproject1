@model TheBuryProject.ViewModels.PaginatedResult<TheBuryProject.ViewModels.AlertaStockViewModel>
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Alertas de Stock";
    ViewData["MetaDescription"] = "Seguimiento operativo de alertas de stock, productos criticos y reposicion.";

    var filtro = ViewBag.Filtro as TheBuryProject.ViewModels.AlertaStockFiltroViewModel
                 ?? new TheBuryProject.ViewModels.AlertaStockFiltroViewModel();
    var tiposAlerta = ViewBag.TiposAlerta as TipoAlertaStock[] ?? Array.Empty<TipoAlertaStock>();
    var prioridades = ViewBag.Prioridades as PrioridadAlerta[] ?? Array.Empty<PrioridadAlerta>();
    var estados = ViewBag.Estados as EstadoAlerta[] ?? Array.Empty<EstadoAlerta>();
    var alertas = Model.Items?.ToList() ?? new List<TheBuryProject.ViewModels.AlertaStockViewModel>();
    // Conteos sobre el total filtrado real (no solo esta página) — ver AlertaStockService.ContarPorEstadoAsync.
    var pendientes = ViewBag.TotalPendientes as int? ?? alertas.Count(a => a.Estado == EstadoAlerta.Pendiente);
    var criticas = ViewBag.TotalCriticas as int? ?? alertas.Count(a => a.Prioridad == PrioridadAlerta.Critica || a.NotificacionUrgente);
}

@section Styles {
    <link rel="stylesheet" href="~/css/horizontal-scroll-affordance.css" asp-append-version="true" />
}

<div class="space-y-6">

    <div class="hero-erp sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex-1 min-w-0">
                <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-2">
                    <a asp-controller="Home" asp-action="Index" class="hover:text-slate-200 transition-colors">Inicio</a>
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                    <span class="text-slate-200">Alertas de Stock</span>
                </nav>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-100">Alertas de stock</h1>
                <p class="mt-1 text-sm text-slate-400">Priorizá reposición, resolución e incidencias de inventario desde una grilla operativa.</p>
            </div>
            <div class="flex flex-wrap gap-2 shrink-0">
                <a asp-action="Criticos" class="btn-erp-danger">
                    <span class="material-symbols-outlined text-base">crisis_alert</span>
                    Críticos
                </a>
                <a asp-action="Estadisticas" class="btn-erp-ghost">
                    <span class="material-symbols-outlined text-base">bar_chart</span>
                    Estadísticas
                </a>
                <form asp-action="GenerarAlertas" method="post" class="inline" data-alerta-confirm="Generar alertas de stock ahora?">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-erp-secondary">
                        <span class="material-symbols-outlined text-base">refresh</span>
                        Generar alertas
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="toast-msg flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400" role="status">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="toast-msg flex items-center gap-3 rounded-xl border border-slate-700 bg-slate-800/50 p-4 text-sm font-semibold text-slate-300" role="status">
            <span class="material-symbols-outlined">info</span>
            @TempData["Info"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-msg flex items-center gap-3 rounded-xl border border-red-500/20 bg-red-500/10 p-4 text-sm font-semibold text-red-400" role="alert">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    @await Html.PartialAsync("_AlertaStockListadoPartial", new TheBuryProject.ViewModels.AlertaStockListadoPartialViewModel
    {
        Resultado = Model,
        Filtro = filtro,
        TiposAlerta = tiposAlerta,
        Prioridades = prioridades,
        Estados = estados,
        TotalPendientes = pendientes,
        TotalCriticas = criticas,
        Embed = false
    })
</div>

@section Scripts {
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/alerta-stock-index.js" asp-append-version="true"></script>
}
