@model IEnumerable<TheBuryProject.ViewModels.AlertaStockViewModel>
@{
    ViewData["Title"] = "Alertas por Producto";
    var producto = ViewBag.Producto as TheBuryProject.Models.Entities.Producto;
    var lista = Model?.ToList() ?? new List<TheBuryProject.ViewModels.AlertaStockViewModel>();
}

<div class="inv-screen inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            @* Sin productos.view el catálogo responde «Acceso denegado»: la miga vuelve al listado propio. *@
            @if (User.TienePermiso("productos", "view"))
            {
                <a asp-controller="Catalogo" asp-action="Index" asp-route-tab="alertas" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Alertas</a>
            }
            else
            {
                <a asp-controller="AlertaStock" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Alertas</a>
            }
            <h1>@(producto?.Nombre ?? "Producto")</h1>
            <p>Historial de alertas@(string.IsNullOrEmpty(producto?.Codigo) ? "" : " · " + producto.Codigo)</p>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <section class="inv-panel inv-panel--tabla" aria-label="Alertas del producto">
        @if (lista.Any())
        {
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de alertas del producto">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Alerta</th>
                            <th scope="col" class="inv-col-num">Stock / mínimo</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Cierre</th>
                            <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in lista)
                        {
                            var tipo = AlertaStockUi.Tipo(a.Tipo);
                            var estado = AlertaStockUi.Estado(a.Estado);
                            <tr>
                                <th scope="row">
                                    <a class="inv-link" asp-action="Details" asp-route-id="@a.Id" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")">@tipo.Texto</a>
                                    <p class="inv-ayuda-texto">@a.FechaAlerta.AHoraComercial().ToString("dd/MM/yyyy HH:mm") · prioridad @AlertaStockUi.Prioridad(a.Prioridad).Texto.ToLowerInvariant()</p>
                                </th>
                                <td data-label="Stock / mínimo" class="inv-col-num">@a.StockActual.ToString("N0") / @a.StockMinimo.ToString("N0")</td>
                                <td data-label="Estado"><span class="@estado.Clase">@estado.Texto</span></td>
                                <td data-label="Cierre">@(a.FechaResolucion.HasValue ? a.FechaResolucion.Value.AHoraComercial().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                <td class="inv-col-actions">
                                    <div class="inv-row-actions">
                                        <partial name="~/Views/AlertaStock/_AlertaAcciones.cshtml" model="a" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="inv-empty">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                <p class="inv-empty__title">Este producto no tiene alertas registradas.</p>
            </div>
        }
    </section>
</div>
