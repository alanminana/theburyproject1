@model TheBuryProject.ViewModels.AlertaStockListadoPartialViewModel
@using TheBuryProject.Models.Enums
@{
    var filtro = Model.Filtro;
    var alertas = Model.Resultado.Items?.ToList() ?? new List<TheBuryProject.ViewModels.AlertaStockViewModel>();
    var filtroActivo = !string.IsNullOrWhiteSpace(filtro.ProductoNombre) || filtro.Tipo.HasValue
                       || filtro.Prioridad.HasValue || filtro.Estado.HasValue;

    // Embebido en la pestaña Alertas de Inventario: filtros y paginado apuntan al catálogo y conservan la pestaña;
    // las acciones de fila siempre apuntan a AlertaStockController.
    var ctrl = Model.Embed ? "Catalogo" : "AlertaStock";
    string Nombre(string campo) => Model.Embed ? $"alerta.{campo}" : campo;

    var rutaBase = new Dictionary<string, string>();
    if (Model.Embed) { rutaBase["tab"] = "alertas"; }
    if (!string.IsNullOrWhiteSpace(filtro.ProductoNombre)) { rutaBase[Nombre("ProductoNombre")] = filtro.ProductoNombre!; }
    if (filtro.Tipo.HasValue) { rutaBase[Nombre("Tipo")] = ((int)filtro.Tipo.Value).ToString(); }
    if (filtro.Prioridad.HasValue) { rutaBase[Nombre("Prioridad")] = ((int)filtro.Prioridad.Value).ToString(); }
    if (filtro.Estado.HasValue) { rutaBase[Nombre("Estado")] = ((int)filtro.Estado.Value).ToString(); }

    Dictionary<string, string> RutaPagina(int pagina) => new(rutaBase) { [Nombre("PageNumber")] = pagina.ToString() };
}

<section class="inv-panel inv-panel--tabla" aria-label="Alertas de stock">
    <form id="filterForm" asp-controller="@ctrl" asp-action="Index" method="get" class="inv-filters" role="search" aria-label="Filtrar alertas">
        @if (Model.Embed)
        {
            <input type="hidden" name="tab" value="alertas" />
        }
        <div class="inv-search">
            <label class="sr-only" for="alerta-producto">Producto</label>
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <input id="alerta-producto" type="search" name="@Nombre("ProductoNombre")" value="@filtro.ProductoNombre" class="inv-control" placeholder="Nombre del producto" />
        </div>
        <div class="inv-filtros-linea">
            <label class="sr-only" for="alerta-estado">Estado</label>
            <select id="alerta-estado" name="@Nombre("Estado")" class="inv-control">
                <option value="">Todos los estados</option>
                @foreach (var estado in Model.Estados)
                {
                    <option value="@((int)estado)" selected="@(filtro.Estado == estado)">@AlertaStockUi.Estado(estado).Texto</option>
                }
            </select>
            <label class="sr-only" for="alerta-tipo">Tipo</label>
            <select id="alerta-tipo" name="@Nombre("Tipo")" class="inv-control">
                <option value="">Todos los tipos</option>
                @foreach (var tipo in Model.TiposAlerta)
                {
                    <option value="@((int)tipo)" selected="@(filtro.Tipo == tipo)">@AlertaStockUi.Tipo(tipo).Texto</option>
                }
            </select>
            <label class="sr-only" for="alerta-prioridad">Prioridad</label>
            <select id="alerta-prioridad" name="@Nombre("Prioridad")" class="inv-control">
                <option value="">Todas las prioridades</option>
                @foreach (var prioridad in Model.Prioridades)
                {
                    <option value="@((int)prioridad)" selected="@(filtro.Prioridad == prioridad)">@AlertaStockUi.Prioridad(prioridad).Texto</option>
                }
            </select>
            <button type="submit" class="inv-btn inv-btn--ghost">Filtrar</button>
        </div>
    </form>

    <div class="inv-results__bar">
        <p class="inv-results__count">
            <strong>@Model.TotalPendientes</strong> @(Model.TotalPendientes == 1 ? "pendiente" : "pendientes")
            @if (Model.TotalCriticas > 0)
            {
                @* «Urgentes»: la misma población que «Productos críticos» y que Estadísticas. *@
                <text> · <strong>@Model.TotalCriticas</strong> @(Model.TotalCriticas == 1 ? "urgente" : "urgentes")</text>
            }
        </p>
        @if (filtroActivo)
        {
            <a class="inv-link" asp-controller="@ctrl" asp-action="Index" asp-all-route-data="@(Model.Embed ? new Dictionary<string, string> { ["tab"] = "alertas" } : new Dictionary<string, string>())">Limpiar filtros</a>
        }
    </div>

    @if (alertas.Any())
    {
        <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de alertas de stock">
            <table class="inv-table inv-table--apilable">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col">Alerta</th>
                        <th scope="col" class="inv-col-num">Stock / mínimo</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in alertas)
                    {
                        var tipo = AlertaStockUi.Tipo(a.Tipo);
                        var prioridad = AlertaStockUi.Prioridad(a.Prioridad);
                        var estado = AlertaStockUi.Estado(a.Estado);
                        <tr>
                            <th scope="row" class="inv-cell-producto">
                                <p class="inv-producto__nombre">
                                    <a asp-controller="AlertaStock" asp-action="Details" asp-route-id="@a.Id" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" title="@a.ProductoNombre">@a.ProductoNombre</a>
                                </p>
                                <p class="inv-producto__meta">@a.ProductoCodigo@(string.IsNullOrWhiteSpace(a.CategoriaNombre) ? "" : " · " + a.CategoriaNombre)</p>
                            </th>
                            <td data-label="Alerta">
                                <span class="@tipo.Clase">@tipo.Texto</span>
                                <p class="inv-sub">Prioridad @prioridad.Texto.ToLowerInvariant()@(a.NotificacionUrgente && AlertaStockUi.EstaActiva(a.Estado) ? " · urgente" : "")</p>
                            </td>
                            <td data-label="Stock / mínimo" class="inv-col-num">
                                <span class="inv-importe @(a.StockActual <= 0 ? "inv-text-danger" : null)">@a.StockActual.ToString("N0")</span> / @a.StockMinimo.ToString("N0")
                            </td>
                            <td data-label="Estado">
                                <span class="@estado.Clase">@estado.Texto</span>
                                <p class="inv-sub">@a.FechaAlerta.AHoraComercial().ToString("dd/MM/yyyy HH:mm")@(a.EstaVencida && AlertaStockUi.EstaActiva(a.Estado) ? " · vencida" : "")</p>
                            </td>
                            <td class="inv-col-actions">
                                <div class="inv-row-actions">
                                    <partial name="~/Views/AlertaStock/_AlertaAcciones.cshtml" model="a" />
                                    @if (User.TienePermiso("movimientos", "view"))
                                    {
                                        <a asp-controller="MovimientoStock" asp-action="Kardex" asp-route-id="@a.ProductoId" class="inv-icon-btn" aria-label="Kardex de @a.ProductoNombre" title="Kardex">
                                            <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Resultado.TotalPages > 1)
        {
            <nav class="inv-pager" aria-label="Páginas de alertas">
                @if (Model.Resultado.HasPreviousPage)
                {
                    <a asp-controller="@ctrl" asp-action="Index" asp-all-route-data="RutaPagina(Model.Resultado.PageNumber - 1)" class="inv-btn inv-btn--ghost" rel="prev">Anterior</a>
                }
                <span aria-current="page">@Model.Resultado.FirstRecord–@Model.Resultado.LastRecord de @Model.Resultado.TotalRecords</span>
                @if (Model.Resultado.HasNextPage)
                {
                    <a asp-controller="@ctrl" asp-action="Index" asp-all-route-data="RutaPagina(Model.Resultado.PageNumber + 1)" class="inv-btn inv-btn--ghost" rel="next">Siguiente</a>
                }
            </nav>
        }
    }
    else
    {
        <div class="inv-empty">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <p class="inv-empty__title">No hay alertas con esos filtros.</p>
        </div>
    }
</section>
