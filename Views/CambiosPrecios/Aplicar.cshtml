@model TheBuryProject.ViewModels.AplicarBatchViewModel
@{
    ViewData["Title"] = "Aplicar lote";
    var precios = LoteDePreciosUi.Precios(Model.CantidadProductos);
}

<div class="inv-screen inv-screen--form inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-action="Preview" asp-route-id="@Model.BatchId" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Volver al lote</a>
            <h1>Aplicar «@Model.Nombre»</h1>
            <p>Reemplaza @precios en las listas.</p>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <dl class="inv-panel inv-resumen">
        <div><dt>Precios que cambian</dt><dd>@Model.CantidadProductos</dd></div>
        @if (Model.AprobadoPor != null)
        {
            <div><dt>Aprobado por</dt><dd>@Model.AprobadoPor</dd></div>
            <div><dt>Fecha de aprobación</dt><dd>@Model.FechaAprobacion?.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</dd></div>
        }
    </dl>

    <form asp-action="AplicarConfirmed" method="post" class="inv-panel" data-prevent-double-submit
          data-inv-confirm="@System.Text.Json.JsonSerializer.Serialize(new {
              titulo = $"¿Aplicar {precios}?",
              datos = new object[] { new[] { "Lote", Model.Nombre }, new[] { "Precios que cambian", Model.CantidadProductos.ToString() }, new { etiqueta = "Vigencia", campo = "fechaVigencia", vacio = "Desde ahora" } },
              consecuencias = new[] { "Los precios anteriores se cierran apenas confirmás.", "Venta y Cotización usan los precios nuevos de la lista predeterminada desde la vigencia.", "El lote se puede revertir después desde su detalle." },
              etiquetaConfirmar = $"Aplicar {precios}",
              tono = "primario" })">
        <input type="hidden" name="id" value="@Model.BatchId" />
        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
        <div class="inv-campo">
            <label class="inv-campo__etiqueta" for="FechaVigencia">Vigencia, hora argentina <span class="inv-campo__requerido">(opcional)</span></label>
            <input id="FechaVigencia" name="FechaVigencia" type="datetime-local" value="" class="inv-control" aria-describedby="vigencia-ayuda" />
            <p id="vigencia-ayuda" class="inv-campo__ayuda">
                Dejala vacía para que rija desde ahora. Si elegís una fecha futura, el precio anterior se cierra igual al aplicar:
                hasta esa fecha la lista queda sin precio vigente y se usa el precio base del producto.
            </p>
        </div>
        <div class="inv-actions">
            <a asp-action="Preview" asp-route-id="@Model.BatchId" class="inv-btn inv-btn--ghost">Volver</a>
            <button type="submit" class="inv-btn inv-btn--primary">Aplicar @precios</button>
        </div>
    </form>
</div>
