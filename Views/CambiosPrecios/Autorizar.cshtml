@model TheBuryProject.ViewModels.AutorizarBatchViewModel
@{
    ViewData["Title"] = "Autorizar lote";
}

<div class="inv-screen inv-screen--form inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-action="Preview" asp-route-id="@Model.BatchId" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Volver al lote</a>
            <h1>Autorizar «@Model.Nombre»</h1>
            <p>Aprobar no cambia precios: deja el lote listo para aplicarlo.</p>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <dl class="inv-panel inv-resumen">
        <div><dt>Cómo se calcula</dt><dd>@LoteDePreciosUi.Tipo(Model.TipoCambio)</dd></div>
        <div><dt>Valor</dt><dd>@Model.ValorCambio.ToString("N2")@(Model.TipoCambio == TheBuryProject.Models.Enums.TipoCambio.ValorAbsoluto ? " $" : " %")</dd></div>
        <div><dt>Precios incluidos</dt><dd>@Model.CantidadProductos</dd></div>
        <div><dt>Solicitado por</dt><dd>@Model.SolicitadoPor</dd></div>
        <div><dt>Fecha</dt><dd>@Model.FechaSolicitud.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</dd></div>
    </dl>

    <div class="inv-grid-2">
        <section class="inv-panel" aria-labelledby="aprobar-titulo">
            <h2 id="aprobar-titulo" class="inv-panel__titulo">Aprobar</h2>
            <form asp-action="Aprobar" method="post" class="inv-panel__form" data-prevent-double-submit>
                <input type="hidden" name="id" value="@Model.BatchId" />
                <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
                <div class="inv-campo">
                    <label class="inv-campo__etiqueta" for="aprobar-notas">Notas <span class="inv-campo__requerido">(opcional)</span></label>
                    <textarea id="aprobar-notas" name="notas" rows="2" class="inv-control"></textarea>
                </div>
                <div class="inv-actions"><button type="submit" class="inv-btn inv-btn--primary">Aprobar lote</button></div>
            </form>
        </section>

        <section class="inv-panel" aria-labelledby="rechazar-titulo">
            <h2 id="rechazar-titulo" class="inv-panel__titulo">Rechazar</h2>
            <form asp-action="Rechazar" method="post" data-prevent-double-submit data-inv-confirm="@System.Text.Json.JsonSerializer.Serialize(new {
                      titulo = "¿Rechazar este lote?",
                      datos = new object[] { new[] { "Lote", Model.Nombre }, new[] { "Precios incluidos", Model.CantidadProductos.ToString() }, new { etiqueta = "Motivo", campo = "motivo" } },
                      consecuencias = new[] { "El lote queda rechazado y no se puede aplicar.", "Ningún precio cambia." },
                      etiquetaConfirmar = "Rechazar lote" })">
                <input type="hidden" name="id" value="@Model.BatchId" />
                <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
                <div class="inv-campo">
                    <label class="inv-campo__etiqueta" for="rechazar-motivo">Motivo del rechazo</label>
                    <textarea id="rechazar-motivo" name="motivo" rows="2" required class="inv-control"></textarea>
                </div>
                <div class="inv-actions"><button type="submit" class="inv-btn inv-btn--ghost">Rechazar lote</button></div>
            </form>
        </section>
    </div>
</div>
