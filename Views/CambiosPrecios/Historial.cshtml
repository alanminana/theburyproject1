@model TheBuryProject.ViewModels.HistorialPreciosViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Historial de precios — " + Model.ProductoNombre;
    var listas = ViewBag.Listas as SelectList ?? new SelectList(Enumerable.Empty<object>());
}

<div class="inv-screen inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            @* Sin productos.view el catálogo responde «Acceso denegado»: la miga vuelve al listado propio. *@
            @if (User.TienePermiso("productos", "view"))
            {
                <a asp-controller="Catalogo" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Inventario</a>
            }
            else
            {
                <a asp-controller="CambiosPrecios" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Cambios de precios</a>
            }
            <h1>@Model.ProductoNombre</h1>
            <p>Historial de precios · @Model.ProductoCodigo</p>
        </div>
        @if (User.TienePermiso("precios", "history"))
        {
            <div class="inv-head__acciones">
                <a asp-action="ExportarHistorial" asp-route-productoId="@Model.ProductoId" class="inv-btn inv-btn--ghost"
                   title="Exporta el último año de todas las listas">
                    <span class="material-symbols-outlined" aria-hidden="true">download</span>
                    Exportar Excel
                </a>
            </div>
        }
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <section class="inv-panel inv-panel--tabla" aria-labelledby="historial-listas">
        <div class="inv-panel__cabecera">
            <div>
                <h2 id="historial-listas" class="inv-panel__titulo">Precios en listas</h2>
                <p class="inv-ayuda-texto">@Model.Precios.Count @(Model.Precios.Count == 1 ? "registro" : "registros")</p>
            </div>
            <form asp-action="Historial" method="get" class="inv-actions">
                <input type="hidden" name="productoId" value="@Model.ProductoId" />
                <select name="listaId" aria-label="Lista de precios" class="inv-control">
                    <option value="">Todas las listas</option>
                    @foreach (var item in listas)
                    {
                        <option value="@item.Value" selected="@(Model.ListaId?.ToString() == item.Value)">@item.Text</option>
                    }
                </select>
                <button type="submit" class="inv-btn inv-btn--ghost">Filtrar</button>
            </form>
        </div>

        @if (Model.Precios.Any())
        {
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de precios en listas">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Lista</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="inv-col-num">Precio</th>
                            <th scope="col" class="inv-col-num">Costo</th>
                            <th scope="col" class="inv-col-num">Margen</th>
                            <th scope="col">Vigencia</th>
                            <th scope="col">Cargado por</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Precios)
                        {
                            <tr>
                                <th scope="row">@p.ListaNombre</th>
                                <td data-label="Estado">
                                    <span class="@(p.EsVigente ? "inv-pill inv-pill--ok" : "inv-pill inv-pill--muted")">@(p.EsVigente ? "Vigente" : "Histórico")</span>
                                    @if (p.EsManual)
                                    {
                                        <span class="inv-pill">Manual</span>
                                    }
                                </td>
                                <td data-label="Precio" class="inv-col-num"><span class="inv-importe">$ @p.Precio.ToString("N2")</span></td>
                                <td data-label="Costo" class="inv-col-num">$ @p.Costo.ToString("N2")</td>
                                <td data-label="Margen" class="inv-col-num"><span class="@(p.MargenPorcentaje < 0 ? "inv-text-danger" : null)">@p.MargenPorcentaje.ToString("N1") %</span></td>
                                <td data-label="Vigencia">
                                    @p.VigenciaDesde.AHoraComercial().ToString("dd/MM/yyyy HH:mm")
                                    <p class="inv-ayuda-texto">@(p.VigenciaHasta.HasValue ? "hasta " + p.VigenciaHasta.Value.AHoraComercial().ToString("dd/MM/yyyy HH:mm") : "sin fecha de fin")</p>
                                </td>
                                <td data-label="Cargado por">@(p.CreadoPor ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="inv-empty">
                <p class="inv-empty__title">Este producto no tiene precios en listas@(Model.ListaId.HasValue ? " en la lista elegida" : "").</p>
                <p>Sin precio en la lista predeterminada, Venta y Cotización usan el precio base.</p>
            </div>
        }
    </section>

    <section class="inv-panel inv-panel--tabla" aria-labelledby="historial-cambios">
        <div class="inv-panel__cabecera">
            <div>
                <h2 id="historial-cambios" class="inv-panel__titulo">Cambios de precio del producto</h2>
                <p class="inv-ayuda-texto">Los mismos que muestra «Historial de precios» en el listado de productos, incluidos los del precio base.</p>
            </div>
        </div>
        @if (Model.CambiosDeProducto.Any())
        {
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de cambios de precio del producto">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col" class="inv-col-num">Precio anterior</th>
                            <th scope="col" class="inv-col-num">Precio nuevo</th>
                            <th scope="col">Motivo</th>
                            <th scope="col">Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cambio in Model.CambiosDeProducto)
                        {
                            <tr>
                                <th scope="row">@cambio.Fecha.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</th>
                                <td data-label="Precio anterior" class="inv-col-num">$ @cambio.PrecioAnterior.ToString("N2")</td>
                                <td data-label="Precio nuevo" class="inv-col-num"><span class="inv-importe">$ @cambio.PrecioNuevo.ToString("N2")</span></td>
                                <td data-label="Motivo">@(cambio.Motivo ?? "Sin motivo")</td>
                                <td data-label="Usuario">@cambio.Usuario</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="inv-empty"><p>No hay cambios registrados sobre este producto.</p></div>
        }
    </section>
</div>
