@model TheBuryProject.ViewModels.BatchListViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Cambios de Precios";
    var puedeSimular = User.TienePermiso("precios", "simulate");
    var puedeAprobar = User.TienePermiso("precios", "approve");
    var puedeAplicar = User.TienePermiso("precios", "apply");
    var puedeRevertir = User.TienePermiso("precios", "revert");
    var estadosNav = new (EstadoBatch? Estado, string Texto)[]
    {
        (null, "Todos"),
        (EstadoBatch.Simulado, "Simulados"),
        (EstadoBatch.Aprobado, "Aprobados"),
        (EstadoBatch.Aplicado, "Aplicados"),
        (EstadoBatch.Revertido, "Revertidos"),
        (EstadoBatch.Rechazado, "Rechazados"),
        (EstadoBatch.Cancelado, "Cancelados")
    };
}

<div class="inv-screen inv-page">
    <h1 class="sr-only">Cambios de precios</h1>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <div class="inv-head">
        <div class="inv-head__titulo">
            <p>Cambian precios que ya existen en listas: se simulan, se aprueban y se aplican.</p>
        </div>
        @if (puedeSimular)
        {
            <div class="inv-head__acciones">
                <a asp-action="Simular" class="inv-btn inv-btn--primary">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                    Nueva simulación
                </a>
            </div>
        }
    </div>

    <nav class="inv-segmentos" aria-label="Filtrar por estado">
        @foreach (var (estado, texto) in estadosNav)
        {
            <a asp-action="Index" asp-route-estado="@(estado.HasValue ? ((int)estado.Value).ToString() : "")"
               aria-current="@(Model.EstadoFiltro == estado ? "page" : null)">@texto</a>
        }
    </nav>

    <section class="inv-panel inv-panel--tabla" aria-label="Lotes de cambios de precios">
        @if (Model.Batches.Any())
        {
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de lotes">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Lote</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="inv-col-num">Cambio</th>
                            <th scope="col" class="inv-col-num">Precios</th>
                            <th scope="col">Solicitado</th>
                            <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Batches)
                        {
                            var (clase, texto) = LoteDePreciosUi.Estado(b.Estado);
                            // Una sola acción siguiente por estado, y solo si el usuario puede ejecutarla.
                            (string Accion, string Texto)? siguiente = b.Estado switch
                            {
                                EstadoBatch.Simulado when puedeAprobar => ("Autorizar", "Autorizar"),
                                EstadoBatch.Aprobado when puedeAplicar => ("Aplicar", "Aplicar"),
                                EstadoBatch.Aplicado when puedeRevertir => ("Revertir", "Revertir"),
                                _ => null
                            };
                            <tr>
                                <th scope="row">
                                    <a class="inv-link" asp-action="Preview" asp-route-id="@b.Id">@b.Nombre</a>
                                    <p class="inv-ayuda-texto">@b.TipoCambioDisplay</p>
                                </th>
                                <td data-label="Estado"><span class="@clase">@texto</span></td>
                                <td data-label="Cambio" class="inv-col-num">@LoteDePreciosUi.Cambio(b.TipoCambio, b.TipoAplicacion, b.ValorCambio)</td>
                                <td data-label="Precios" class="inv-col-num">@b.CantidadProductos</td>
                                <td data-label="Solicitado">
                                    @b.SolicitadoPor
                                    <p class="inv-ayuda-texto">@b.FechaSolicitud.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</p>
                                </td>
                                <td class="inv-col-actions">
                                    <div class="inv-row-actions">
                                        @if (siguiente is { } paso)
                                        {
                                            <a class="inv-btn inv-btn--ghost inv-btn--sm" asp-action="@paso.Accion" asp-route-id="@b.Id"
                                               aria-label="@paso.Texto el lote @b.Nombre">@paso.Texto</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="inv-empty">
                <span class="material-symbols-outlined" aria-hidden="true">price_change</span>
                <p class="inv-empty__title">
                    @(Model.EstadoFiltro.HasValue ? "No hay lotes en ese estado" : "Todavía no hay cambios por lotes")
                </p>
                @if (Model.EstadoFiltro.HasValue)
                {
                    <p><a class="inv-link" asp-action="Index">Ver todos</a></p>
                }
            </div>
        }
    </section>
</div>

<partial name="~/Views/ListaPrecio/_ListaPrecioAyuda.cshtml" />

@section Scripts {
    <script src="~/js/lista-precio-ayuda.js" asp-append-version="true"></script>
}
