@model TheBuryProject.ViewModels.SimulacionViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Lote — " + Model.Nombre;
    var origenCatalogo = TempData["OrigenCatalogo"] != null;
    var (claseEstado, textoEstado) = LoteDePreciosUi.Estado(Model.Estado);
    var cambio = LoteDePreciosUi.Cambio(Model.TipoCambio, Model.TipoAplicacion, Model.ValorCambio);
    var puedeAprobar = User.TienePermiso("precios", "approve");
    var puedeAplicar = User.TienePermiso("precios", "apply");
    var puedeRevertir = User.TienePermiso("precios", "revert");
    var paginas = Math.Max(1, (int)Math.Ceiling((double)Model.CantidadProductos / Math.Max(1, Model.TamanioPagina)));
    var conAvisos = Model.Items.Count(i => i.TieneAdvertencia);
    var motivo = Model.Estado switch
    {
        EstadoBatch.Rechazado => ("Motivo del rechazo", Model.MotivoRechazo),
        EstadoBatch.Cancelado => ("Motivo de la cancelación", Model.MotivoCancelacion),
        EstadoBatch.Revertido => ("Motivo de la reversión", Model.MotivoReversion),
        _ => ((string?)null, (string?)null)
    };
    // Lo que falta para que el lote avance, cuando este usuario no puede hacerlo.
    var pendiente = Model.Estado switch
    {
        EstadoBatch.Simulado when !puedeAprobar => "Falta que alguien con permiso para aprobar cambios de precios lo autorice.",
        EstadoBatch.Aprobado when !puedeAplicar => "Está aprobado. Falta que alguien con permiso para aplicar precios lo ejecute.",
        _ => null
    };
}

<div class="inv-screen inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            @if (origenCatalogo)
            {
                @* Sin productos.view el catálogo responde «Acceso denegado»: la miga vuelve al listado propio. *@
                @if (User.TienePermiso("productos", "view"))
                {
                    <a asp-controller="Catalogo" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Inventario</a>
                }
                else
                {
                    <a asp-controller="CambiosPrecios" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Cambios de precios</a>
                }
            }
            else
            {
                <a asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Cambios por lotes</a>
            }
            <h1>@Model.Nombre <span class="@claseEstado">@textoEstado</span></h1>
            <p>Solicitado por @Model.SolicitadoPor el @Model.FechaSolicitud.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="inv-head__acciones">
            @if (Model.Estado == EstadoBatch.Simulado && puedeAprobar)
            {
                <form asp-action="Cancelar" method="post" data-prevent-double-submit data-inv-confirm="@System.Text.Json.JsonSerializer.Serialize(new {
                          titulo = "¿Cancelar esta simulación?",
                          datos = new[] { new[] { "Lote", Model.Nombre }, new[] { "Precios incluidos", Model.CantidadProductos.ToString() } },
                          consecuencias = new[] { "El lote queda cancelado y no se puede aplicar.", "Ningún precio cambia." },
                          etiquetaCancelar = "Volver",
                          etiquetaConfirmar = "Cancelar el lote" })">
                    <input type="hidden" name="id" value="@Model.BatchId" />
                    <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion ?? Array.Empty<byte>())" />
                    <button type="submit" class="inv-btn inv-btn--ghost">Cancelar lote</button>
                </form>
                <a asp-action="Autorizar" asp-route-id="@Model.BatchId" class="inv-btn inv-btn--primary">Autorizar</a>
            }
            @if (Model.Estado == EstadoBatch.Aprobado && puedeAplicar)
            {
                <a asp-action="Aplicar" asp-route-id="@Model.BatchId" class="inv-btn inv-btn--primary">Aplicar precios</a>
            }
            @if (Model.Estado == EstadoBatch.Aplicado && puedeRevertir)
            {
                <a asp-action="Revertir" asp-route-id="@Model.BatchId" class="inv-btn inv-btn--ghost">Revertir</a>
            }
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    @if (!string.IsNullOrWhiteSpace(motivo.Item2))
    {
        <p class="inv-aviso inv-aviso--info"><strong>@motivo.Item1:</strong> @motivo.Item2</p>
    }
    @if (pendiente != null)
    {
        <p class="inv-aviso inv-aviso--info">@pendiente</p>
    }
    @if (conAvisos > 0)
    {
        <p class="inv-aviso inv-aviso--atencion">@(conAvisos == 1 ? "1 precio de esta página tiene una advertencia." : $"{conAvisos} precios de esta página tienen advertencias.") Revisalos antes de continuar.</p>
    }

    <dl class="inv-panel inv-resumen">
        <div><dt>Cambio</dt><dd>@cambio</dd></div>
        <div><dt>Cómo se calcula</dt><dd>@LoteDePreciosUi.Tipo(Model.TipoCambio)</dd></div>
        <div><dt>Precios incluidos</dt><dd>@Model.CantidadProductos</dd></div>
        @if (Model.PorcentajePromedioCambio.HasValue)
        {
            <div><dt>Variación promedio</dt><dd>@Model.PorcentajePromedioCambio.Value.ToString("N1") %</dd></div>
        }
    </dl>

    <section class="inv-panel inv-panel--tabla" aria-labelledby="lote-items-titulo">
        <div class="inv-panel__cabecera">
            <h2 id="lote-items-titulo" class="inv-panel__titulo">Precios del lote</h2>
        </div>
        @if (Model.Items.Any())
        {
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla de precios del lote">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="inv-col-num">Precio anterior</th>
                            <th scope="col" class="inv-col-num">Precio nuevo</th>
                            <th scope="col" class="inv-col-num">Diferencia</th>
                            <th scope="col" class="inv-col-num">Margen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <th scope="row">
                                    @item.ProductoNombre
                                    <p class="inv-ayuda-texto">@item.ProductoCodigo</p>
                                    @if (item.TieneAdvertencia)
                                    {
                                        <p class="inv-pill inv-pill--warning">@(item.MensajeAdvertencia ?? "Con advertencia")</p>
                                    }
                                </th>
                                <td data-label="Precio anterior" class="inv-col-num">$ @item.PrecioAnterior.ToString("N2")</td>
                                <td data-label="Precio nuevo" class="inv-col-num"><span class="inv-importe">$ @item.PrecioNuevo.ToString("N2")</span></td>
                                <td data-label="Diferencia" class="inv-col-num">
                                    @(item.DiferenciaValor >= 0 ? "+" : "−")$ @Math.Abs(item.DiferenciaValor).ToString("N2")
                                    <p class="inv-ayuda-texto">@(item.DiferenciaPorcentaje >= 0 ? "+" : "")@item.DiferenciaPorcentaje.ToString("N1") %</p>
                                </td>
                                <td data-label="Margen" class="inv-col-num">
                                    @(item.MargenAnterior.HasValue ? item.MargenAnterior.Value.ToString("N1") + " %" : "—") →
                                    <span class="@(item.MargenNuevo < 0 ? "inv-text-danger" : null)">@(item.MargenNuevo.HasValue ? item.MargenNuevo.Value.ToString("N1") + " %" : "—")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (paginas > 1)
            {
                <nav class="inv-pager" aria-label="Páginas del lote">
                    @if (Model.PaginaActual > 1)
                    {
                        <a asp-action="Preview" asp-route-id="@Model.BatchId" asp-route-page="@(Model.PaginaActual - 1)" class="inv-btn inv-btn--ghost" rel="prev">Anterior</a>
                    }
                    <span aria-current="page">Página @Model.PaginaActual de @paginas</span>
                    @if (Model.PaginaActual < paginas)
                    {
                        <a asp-action="Preview" asp-route-id="@Model.BatchId" asp-route-page="@(Model.PaginaActual + 1)" class="inv-btn inv-btn--ghost" rel="next">Siguiente</a>
                    }
                </nav>
            }
        }
        else
        {
            <div class="inv-empty">
                <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
                <p class="inv-empty__title">Este lote no tiene precios.</p>
            </div>
        }
    </section>
</div>
