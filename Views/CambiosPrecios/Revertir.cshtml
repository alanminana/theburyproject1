@model TheBuryProject.ViewModels.RevertirBatchViewModel
@{
    ViewData["Title"] = "Revertir lote";
    var precios = LoteDePreciosUi.Precios(Model.CantidadProductos);
}

<div class="inv-screen inv-screen--form inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-action="Preview" asp-route-id="@Model.BatchId" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Volver al lote</a>
            <h1>Revertir «@Model.Nombre»</h1>
            <p>Restaura los precios que estaban vigentes antes de este lote.</p>
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <dl class="inv-panel inv-resumen">
        <div><dt>Precios que vuelven atrás</dt><dd>@Model.CantidadProductos</dd></div>
        @if (Model.AplicadoPor != null)
        {
            <div><dt>Aplicado por</dt><dd>@Model.AplicadoPor</dd></div>
        }
        @if (Model.FechaAplicacion.HasValue)
        {
            <div><dt>Fecha de aplicación</dt><dd>@Model.FechaAplicacion.Value.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</dd></div>
        }
        @if (Model.FechaVigencia.HasValue)
        {
            <div><dt>Vigente desde</dt><dd>@Model.FechaVigencia.Value.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</dd></div>
        }
    </dl>

    <form asp-action="RevertirConfirmed" method="post" class="inv-panel" data-prevent-double-submit
          data-inv-confirm="@System.Text.Json.JsonSerializer.Serialize(new {
              titulo = $"¿Revertir {precios}?",
              datos = new object[] { new[] { "Lote", Model.Nombre }, new[] { "Precios que vuelven atrás", Model.CantidadProductos.ToString() }, new { etiqueta = "Motivo", campo = "Motivo" } },
              consecuencias = new[] { "Los precios anteriores vuelven a estar vigentes de inmediato.", "Se registra un lote de reversión con tu usuario." },
              etiquetaConfirmar = $"Revertir {precios}" })">
        <input type="hidden" name="id" value="@Model.BatchId" />
        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
        <div class="inv-campo">
            <label asp-for="Motivo" class="inv-campo__etiqueta">Motivo de la reversión</label>
            <textarea asp-for="Motivo" rows="3" required class="inv-control"></textarea>
            <span asp-validation-for="Motivo" class="inv-campo__error"></span>
        </div>
        <div class="inv-actions">
            <a asp-action="Preview" asp-route-id="@Model.BatchId" class="inv-btn inv-btn--ghost">Volver</a>
            <button type="submit" class="inv-btn inv-btn--danger">Revertir @precios</button>
        </div>
    </form>
</div>
