@model TheBuryProject.ViewModels.SimularCambioMasivoViewModel
@using TheBuryProject.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Nueva simulación";
    var listas = ViewBag.Listas as SelectList ?? new SelectList(Enumerable.Empty<object>());
    var categorias = ViewBag.Categorias as SelectList ?? new SelectList(Enumerable.Empty<object>());
    var marcas = ViewBag.Marcas as SelectList ?? new SelectList(Enumerable.Empty<object>());
    var alcanceUsado = (Model.CategoriasIds?.Any() ?? false) || (Model.MarcasIds?.Any() ?? false) || !string.IsNullOrWhiteSpace(Model.ProductoIdsText);
}

<div class="inv-screen inv-screen--form inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Cambios por lotes</a>
            <h1>Nueva simulación</h1>
            <p>Simular no cambia ningún precio. La vigencia se elige al aplicar.</p>
        </div>
    </header>

    <form asp-action="Simular" method="post" class="inv-screen" data-prevent-double-submit>
        <div asp-validation-summary="All" class="inv-aviso inv-aviso--error inv-resumen-errores" role="alert"></div>

        <section class="inv-panel" aria-labelledby="sim-cambio">
            <h2 id="sim-cambio" class="inv-panel__titulo">Cambio</h2>
            <div class="inv-campo">
                <label asp-for="Nombre" class="inv-campo__etiqueta">Nombre del lote</label>
                <input asp-for="Nombre" class="inv-control" placeholder="Ej.: aumento de noviembre" />
                <span asp-validation-for="Nombre" class="inv-campo__error"></span>
            </div>
            <div class="inv-grid-2">
                <div class="inv-campo">
                    <label asp-for="TipoCambio" class="inv-campo__etiqueta">Cómo se calcula</label>
                    <select asp-for="TipoCambio" class="inv-control">
                        @foreach (var tipo in Enum.GetValues<TipoCambio>())
                        {
                            <option value="@tipo">@LoteDePreciosUi.Tipo(tipo)</option>
                        }
                    </select>
                </div>
                <div class="inv-campo">
                    <label asp-for="TipoAplicacion" class="inv-campo__etiqueta">Sentido</label>
                    <select asp-for="TipoAplicacion" asp-items="Html.GetEnumSelectList<TipoAplicacion>()" class="inv-control"></select>
                </div>
                <div class="inv-campo">
                    <label asp-for="ValorCambio" class="inv-campo__etiqueta">Valor</label>
                    <input asp-for="ValorCambio" type="number" step="0.01" min="0" inputmode="decimal" class="inv-control" />
                    <span asp-validation-for="ValorCambio" class="inv-campo__error"></span>
                </div>
            </div>
            <div class="inv-campo">
                <label asp-for="Notas" class="inv-campo__etiqueta">Notas <span class="inv-campo__requerido">(opcional)</span></label>
                <textarea asp-for="Notas" rows="2" class="inv-control"></textarea>
            </div>
        </section>

        <fieldset class="inv-panel">
            <legend class="sr-only">Listas de precios afectadas</legend>
            <p class="inv-panel__titulo" aria-hidden="true">Listas de precios afectadas</p>
            <div class="inv-checks">
                @foreach (var lista in listas)
                {
                    <label>
                        <input type="checkbox" name="ListasIds" value="@lista.Value" class="inv-check"
                               checked="@(Model.ListasIds != null && Model.ListasIds.Contains(int.Parse(lista.Value ?? "0")))" />
                        @lista.Text
                    </label>
                }
            </div>
            <span asp-validation-for="ListasIds" class="inv-campo__error"></span>
        </fieldset>

        <details class="inv-panel" open="@alcanceUsado">
            <summary class="inv-panel__titulo">Limitar el alcance <span class="inv-campo__requerido">(sin límites, entran todos los productos con precio en esas listas)</span></summary>
            <div class="inv-grid-2">
                <div class="inv-campo">
                    <label for="f-CategoriasIds" class="inv-campo__etiqueta">Categorías</label>
                    <select id="f-CategoriasIds" name="CategoriasIds" multiple size="6" class="inv-control">
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Value" selected="@(Model.CategoriasIds != null && int.TryParse(categoria.Value, out var idCategoria) && Model.CategoriasIds.Contains(idCategoria))">@categoria.Text</option>
                        }
                    </select>
                </div>
                <div class="inv-campo">
                    <label for="f-MarcasIds" class="inv-campo__etiqueta">Marcas</label>
                    <select id="f-MarcasIds" name="MarcasIds" multiple size="6" class="inv-control">
                        @foreach (var marca in marcas)
                        {
                            <option value="@marca.Value" selected="@(Model.MarcasIds != null && int.TryParse(marca.Value, out var idMarca) && Model.MarcasIds.Contains(idMarca))">@marca.Text</option>
                        }
                    </select>
                </div>
            </div>
            <div class="inv-campo">
                <label asp-for="ProductoIdsText" class="inv-campo__etiqueta">IDs de productos puntuales, separados por coma</label>
                <input asp-for="ProductoIdsText" class="inv-control" inputmode="numeric" placeholder="Ej.: 1,2,45" />
                <span asp-validation-for="ProductoIdsText" class="inv-campo__error"></span>
            </div>
        </details>

        <div class="inv-actions">
            <a asp-action="Index" class="inv-btn inv-btn--ghost">Volver</a>
            <button type="submit" class="inv-btn inv-btn--primary">Simular</button>
        </div>
    </form>
</div>
