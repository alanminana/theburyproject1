@model CatalogoUnificadoViewModel
@{
    ViewData["Title"] = "Inventario";
    ViewData["MetaDescription"] = "Catálogo de productos, control de stock, listas de precios y movimientos de inventario del ERP TheBuryProject.";

    // Una sección por URL (?tab=): cada carga renderiza solo la sección pedida, sus diálogos y sus scripts.
    var seccion = Model.TabActiva;
    var secciones = new List<(string Clave, string Titulo, string Icono, int? Contador)>
    {
        ("productos", "Productos", "grid_view", null),
        ("categorias", "Categorías", "category", Model.TotalCategorias),
        ("marcas", "Marcas", "sell", Model.TotalMarcas)
    };
    if (Model.MostrarTabAlertas)
    {
        secciones.Add(("alertas", "Alertas", "notifications", Model.AlertasPendientes > 0 ? Model.AlertasPendientes : null));
    }
    if (Model.MostrarTabMovimientos)
    {
        secciones.Add(("movimientos", "Movimientos", "sync_alt", null));
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/horizontal-scroll-affordance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalogo-module.css" asp-append-version="true" />
}

<div class="erp-page-shell inv-page">
    <h1 class="sr-only">Inventario — @secciones.First(s => s.Clave == seccion).Titulo</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert-erp alert-erp-success toast-msg" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert-erp alert-erp-warning toast-msg" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            @TempData["Info"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-erp alert-erp-error toast-msg" role="alert">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            @TempData["Error"]
        </div>
    }

    <div class="inv-card">
        <div class="inv-card__nav">
            <nav class="modulo-tabs" aria-label="Secciones de Inventario" data-modulo-tabs>
                @foreach (var s in secciones)
                {
                    <a class="modulo-tab" data-modulo-tab="@s.Clave" aria-current="@(s.Clave == seccion ? "page" : null)"
                       asp-controller="Catalogo" asp-action="Index" asp-route-tab="@s.Clave">
                        <span class="material-symbols-outlined" aria-hidden="true">@s.Icono</span>
                        @s.Titulo
                        @if (s.Contador.HasValue)
                        {
                            <span class="inv-tab-count">@s.Contador</span>
                        }
                    </a>
                }
                @if (User.TienePermiso("precios", "view"))
                {
                    <a class="modulo-tab" data-modulo-tab="precios" asp-controller="ListaPrecio" asp-action="Index">
                        <span class="material-symbols-outlined" aria-hidden="true">price_change</span>
                        Precios
                    </a>
                }
            </nav>

            @if (seccion == "productos")
            {
                <div class="inv-card__actions">
                    <a asp-controller="Producto" asp-action="UnidadesGlobal" class="inv-btn inv-btn--ghost">
                        <span class="material-symbols-outlined" aria-hidden="true">qr_code_2</span>
                        Unidades físicas
                    </a>
                    @if (User.TienePermiso("precios", "simulate"))
                    {
                        <button type="button" id="btn-ajuste-masivo" data-catalogo-modal-open="precio" class="inv-btn inv-btn--ghost">
                            <span class="material-symbols-outlined" aria-hidden="true">price_change</span>
                            Ajustar precio base
                        </button>
                    }
                    @if (User.TienePermiso("productos", "create"))
                    {
                        <button type="button" id="btn-crear-producto" data-catalogo-modal-open="producto" class="inv-btn inv-btn--primary">
                            <span class="material-symbols-outlined" aria-hidden="true">add</span>
                            Nuevo producto
                        </button>
                    }
                </div>
            }
            else if (seccion == "alertas")
            {
                <div class="inv-card__actions">
                    <a asp-controller="AlertaStock" asp-action="Criticos" class="inv-btn inv-btn--ghost">
                        <span class="material-symbols-outlined" aria-hidden="true">crisis_alert</span>
                        Productos críticos
                    </a>
                    <a asp-controller="AlertaStock" asp-action="Estadisticas" class="inv-btn inv-btn--ghost">
                        <span class="material-symbols-outlined" aria-hidden="true">bar_chart</span>
                        Estadísticas
                    </a>
                    @if (User.TienePermiso("stock", "adjust"))
                    {
                        <form asp-controller="AlertaStock" asp-action="GenerarAlertas" method="post" data-prevent-double-submit>
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Catalogo", new { tab = "alertas" })" />
                            <button type="submit" class="inv-btn inv-btn--primary">
                                <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
                                Generar alertas
                            </button>
                        </form>
                    }
                </div>
            }
            else if (seccion == "movimientos" && User.TienePermiso("movimientos", "create"))
            {
                <div class="inv-card__actions">
                    <button type="button" class="inv-btn inv-btn--primary" data-ajuste-stock-open>
                        <span class="material-symbols-outlined" aria-hidden="true">add</span>
                        Registrar ajuste
                    </button>
                </div>
            }
        </div>

        @switch (seccion)
        {
            case "categorias":
                <partial name="_Categorias" model="Model" />
                break;
            case "marcas":
                <partial name="_Marcas" model="Model" />
                break;
            case "alertas":
                <div class="inv-section">
                    @if (Model.AlertasPartial != null)
                    {
                        @await Html.PartialAsync("~/Views/AlertaStock/_AlertaStockListadoPartial.cshtml", Model.AlertasPartial)
                    }
                    else
                    {
                        <div class="inv-empty" role="alert">
                            <span class="material-symbols-outlined" aria-hidden="true">error</span>
                            <p class="inv-empty__title">No se pudieron cargar las alertas de stock.</p>
                            <p><a class="inv-link" asp-controller="Catalogo" asp-action="Index" asp-route-tab="alertas">Reintentar</a></p>
                        </div>
                    }
                </div>
                break;
            case "movimientos":
                <div class="inv-section">
                    @if (Model.MovimientosPartial != null)
                    {
                        @await Html.PartialAsync("~/Views/MovimientoStock/_MovimientoStockListadoPartial.cshtml", Model.MovimientosPartial)
                    }
                    else
                    {
                        <div class="inv-empty" role="alert">
                            <span class="material-symbols-outlined" aria-hidden="true">error</span>
                            <p class="inv-empty__title">No se pudieron cargar los movimientos de stock.</p>
                            <p><a class="inv-link" asp-controller="Catalogo" asp-action="Index" asp-route-tab="movimientos">Reintentar</a></p>
                        </div>
                    }
                </div>
                break;
            default:
                <partial name="_Productos" model="Model" />
                break;
        }
    </div>
</div>

@if (seccion == "productos")
{
    <partial name="_ProductoDialogos" model="Model" />
    <partial name="_ProductoPaneles" model="Model" />
}
else if (seccion == "categorias")
{
    <partial name="_CategoriaDialogos" model="Model" />
}
else if (seccion == "marcas")
{
    <partial name="_MarcaDialogos" model="Model" />
}
else if (seccion == "movimientos" && User.TienePermiso("movimientos", "create") && ViewBag.ProductosActivosParaAjuste != null)
{
    @await Html.PartialAsync("~/Views/MovimientoStock/_AjusteStockModal.cshtml", new TheBuryProject.ViewModels.AjusteStockModalViewModel
    {
        Ajuste = new TheBuryProject.ViewModels.AjusteStockViewModel { ReturnUrl = Url.Action("Index", "Catalogo", new { tab = "movimientos" }) },
        ProductoBloqueado = false,
        Productos = ViewBag.ProductosActivosParaAjuste,
        Tipos = Model.MovimientosPartial?.Tipos
    })
}

@section Scripts {
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/catalogo-module.js" asp-append-version="true"></script>
    <script src="~/js/catalogo-index.js" asp-append-version="true"></script>
    @if (seccion == "productos")
    {
        <script>
            window.CatalogoData = window.CatalogoData || {};
            // Solo raíces: el alta/edición de producto carga subcategorías y submarcas aparte, según lo elegido.
            window.CatalogoData.categorias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.CategoriasRaiz?.Select(c => new { id = c.Id, nombre = c.Nombre }) ?? Enumerable.Empty<object>()));
            window.CatalogoData.marcas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.MarcasRaiz?.Select(m => new { id = m.Id, nombre = m.Nombre }) ?? Enumerable.Empty<object>()));
        </script>
        <script src="~/js/inventario-productos.js" asp-append-version="true"></script>
        <script src="~/js/producto-credito-personal-ui.js" asp-append-version="true"></script>
        <script src="~/js/producto-modal-validacion.js" asp-append-version="true"></script>
        <script src="~/js/producto-modal-tabs.js" asp-append-version="true"></script>
        <script src="~/js/producto-crear-modal.js" asp-append-version="true"></script>
        <script src="~/js/producto-editar-modal.js" asp-append-version="true"></script>
        <script src="~/js/producto-precio-calculo.js" asp-append-version="true"></script>
        <script src="~/js/precio-aumento-modal.js" asp-append-version="true"></script>
        <script src="~/js/historial-precio-modal.js" asp-append-version="true"></script>
        <script src="~/js/movimientos-inventario-modal.js" asp-append-version="true"></script>
        <script src="~/js/producto-comision-modal.js" asp-append-version="true"></script>
    }
    else if (seccion == "categorias")
    {
        <script src="~/js/categoria-crear-modal.js" asp-append-version="true"></script>
        <script src="~/js/categoria-editar-modal.js" asp-append-version="true"></script>
    }
    else if (seccion == "marcas")
    {
        <script src="~/js/marca-crear-modal.js" asp-append-version="true"></script>
        <script src="~/js/marca-editar-modal.js" asp-append-version="true"></script>
    }
    else if (seccion == "movimientos")
    {
        <script src="~/js/ajuste-stock-modal.js" asp-append-version="true"></script>
    }
}
