@model CatalogoUnificadoViewModel
@{
    var opcionesCategoriaPadre = CategoriaJerarquia.Opciones(Model.CategoriasListado);
}

<!-- Modal: Nueva Categoría -->
<dialog id="modal-nueva-categoria" class="inv-dialog inv-dialog--ancho" aria-labelledby="modal-nueva-categoria-title">
    <div class="inv-dialog__panel">
        <header class="flex shrink-0 items-center justify-between border-b border-slate-800 px-6 py-4">
            <div class="flex flex-col">
                <h2 id="modal-nueva-categoria-title" class="text-xl font-bold text-white">Nueva categoría</h2>
            </div>
            <button type="button" data-catalogo-modal-close="categoria" aria-label="Cerrar" class="p-2 hover:bg-slate-800 rounded-full transition-colors text-slate-400">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>

        <!-- Form -->
        <form id="form-nueva-categoria" method="post" novalidate class="catalogo-modal-form" asp-controller="Categoria" asp-action="CreateAjax">
            @Html.AntiForgeryToken()

            <!-- Scrollable Content -->
            <div class="catalogo-modal-form__body p-6 space-y-6">

                <!-- Validation Summary -->
                <div id="cat-modal-validation-summary" role="alert" aria-live="assertive" aria-atomic="true" class="hidden bg-red-500/10 border border-red-500/20 rounded-lg p-4 gap-3">
                    <span class="material-symbols-outlined text-red-500" aria-hidden="true">error</span>
                    <div>
                        <h4 class="text-sm font-bold text-red-500">Revisá los datos</h4>
                        <p id="cat-modal-validation-text" class="text-xs text-red-400/80 mt-1"></p>
                    </div>
                </div>

                <!-- Section: Datos de la categoría -->
                <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-6">
                    <div class="flex items-center gap-2 mb-6 border-b border-slate-800 pb-4">
                        <span class="material-symbols-outlined text-primary" aria-hidden="true">inventory_2</span>
                        <h3 class="text-white text-xl font-bold">Datos de la categoría</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        @await Html.PartialAsync("_CategoriaModalFields", new TheBuryProject.ViewModels.CategoriaModalFieldsViewModel
                        {
                            Prefix = "cat-modal",
                            CategoriasPadre = opcionesCategoriaPadre,
                            AlicuotasIVADatos = ViewBag.AlicuotasIVADatos,
                            ActivaPorDefecto = true
                        })
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <footer class="flex shrink-0 items-center justify-end gap-3 px-6 py-4 border-t border-slate-800 bg-slate-900/50">
                <button type="button" data-catalogo-modal-close="categoria"
                        class="whitespace-nowrap px-6 py-2.5 rounded-lg border border-slate-800 text-slate-300 font-bold text-sm hover:bg-slate-800 transition-colors">
                    Cancelar
                </button>
                <button type="submit" id="btn-guardar-categoria"
                        class="whitespace-nowrap px-6 py-2.5 rounded-lg bg-primary text-white font-bold text-sm hover:bg-primary/90 shadow-lg shadow-primary/20 transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">save</span>
                    Guardar categoría
                </button>
            </footer>
        </form>
    </div>
</dialog>

<!-- Modal: Editar Categoría -->
<dialog id="modal-editar-categoria" class="inv-dialog inv-dialog--ancho" aria-labelledby="modal-editar-categoria-title">
    <div class="inv-dialog__panel">
        <header class="flex shrink-0 items-center justify-between border-b border-slate-800 px-6 py-4">
            <div class="flex flex-col">
                <h2 id="modal-editar-categoria-title" class="text-xl font-bold text-white">Editar categoría</h2>
            </div>
            <button type="button" data-cat-edit-modal-close aria-label="Cerrar" class="p-2 hover:bg-slate-800 rounded-full transition-colors text-slate-400">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>
        <form id="form-editar-categoria" method="post" novalidate class="catalogo-modal-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="cat-edit-id" />
            <input type="hidden" name="RowVersion" id="cat-edit-rowversion" />
            <div class="catalogo-modal-form__body p-6 space-y-6">
                <div id="cat-edit-validation-summary" role="alert" aria-live="assertive" aria-atomic="true" class="hidden bg-red-500/10 border border-red-500/20 rounded-lg p-4 gap-3">
                    <span class="material-symbols-outlined text-red-500" aria-hidden="true">error</span>
                    <div>
                        <h4 class="text-sm font-bold text-red-500">Revisá los datos</h4>
                        <p id="cat-edit-validation-text" class="text-xs text-red-400/80 mt-1"></p>
                    </div>
                </div>
                <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-6">
                    <div class="flex items-center gap-2 mb-6 border-b border-slate-800 pb-4">
                        <span class="material-symbols-outlined text-primary" aria-hidden="true">inventory_2</span>
                        <h3 class="text-white text-xl font-bold">Datos de la categoría</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        @await Html.PartialAsync("_CategoriaModalFields", new TheBuryProject.ViewModels.CategoriaModalFieldsViewModel
                        {
                            Prefix = "cat-edit",
                            CategoriasPadre = opcionesCategoriaPadre,
                            AlicuotasIVADatos = ViewBag.AlicuotasIVADatos
                        })
                    </div>
                </div>
            </div>
            <footer class="flex shrink-0 items-center justify-end gap-3 px-6 py-4 border-t border-slate-800 bg-slate-900/50">
                <button type="button" data-cat-edit-modal-close
                        class="whitespace-nowrap px-6 py-2.5 rounded-lg border border-slate-800 text-slate-300 font-bold text-sm hover:bg-slate-800 transition-colors">
                    Cancelar
                </button>
                <button type="submit" id="btn-guardar-cat-edit"
                        class="whitespace-nowrap px-6 py-2.5 rounded-lg bg-primary text-white font-bold text-sm hover:bg-primary/90 shadow-lg shadow-primary/20 transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">save</span>
                    Guardar cambios
                </button>
            </footer>
        </form>
    </div>
</dialog>
