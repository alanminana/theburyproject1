@model CatalogoUnificadoViewModel
@{
    // Categorías: cada acción exige su permiso propio en CategoriaController (create/update/delete).
    var puedeCrearCategoria = User.TienePermiso("categorias", "create");
    var puedeEditarCategoria = User.TienePermiso("categorias", "update");
    var puedeEliminarCategoria = User.TienePermiso("categorias", "delete");
    // Con solo lectura no hay acciones por fila: la columna entera se omite (no queda vacía).
    var mostrarAccionesCategoria = puedeEditarCategoria || puedeEliminarCategoria;
    var categoriasOrdenadas = CategoriaJerarquia.Ordenar(Model.CategoriasListado);
}

    <!-- Tab: Categorías -->
    <div id="tab-categorias">
        <div class="border-b border-slate-800 px-5 py-4">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <h2 class="text-base font-bold text-white">Categorías registradas</h2>
                    <p class="text-sm text-slate-400">
                        Organizá el catálogo en categorías y subcategorías.
                    </p>
                </div>
                @if (puedeCrearCategoria)
                {
                    <div class="flex items-center gap-3">
                        <button type="button" id="btn-crear-categoria" data-catalogo-modal-open="categoria"
                                class="btn-erp-primary btn-sm">
                            <span class="material-symbols-outlined text-sm" aria-hidden="true">add</span>
                            Nueva categoría
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Categories Table -->
        <div data-oc-scroll class="relative" style="--oc-scroll-min-width: 640px;">
            <div data-oc-scroll-hint hidden class="px-5 pt-4 text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 lg:hidden">
                Deslizá la tabla para ver la jerarquía y las acciones.
            </div>
            <div data-oc-scroll-shell class="relative">
                <div data-oc-scroll-fade="left" hidden class="absolute inset-y-0 left-0 z-10 w-6 bg-linear-to-r from-slate-900 via-slate-900/95 to-transparent"></div>
                <div data-oc-scroll-fade="right" hidden class="absolute inset-y-0 right-0 z-10 w-6 bg-linear-to-l from-slate-900 via-slate-900/95 to-transparent"></div>
                <div data-oc-scroll-region class="overflow-x-auto scroll-smooth" tabindex="0" role="region" aria-label="Tabla de categorías del catálogo">
            <table data-erp-cards class="erp-table text-left" data-oc-scroll-table style="min-width: var(--oc-scroll-min-width);">
                <thead>
                    <tr class="bg-slate-800/30 border-b border-slate-800">
                        <th data-card="half" scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Código</th>
                        <th data-card="title" scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Categoría</th>
                        <th data-card="half" scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Categoría padre</th>
                        <th data-card="half" scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-center">Estado</th>
                        @if (mostrarAccionesCategoria)
                        {
                            <th data-card="actions" scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody id="categorias-tbody" class="divide-y divide-slate-800">
                    @if (categoriasOrdenadas.Count > 0)
                    {
                        @foreach (var (cat, nivel) in categoriasOrdenadas)
                        {
                            <tr class="hover:bg-white/5 transition-colors @(nivel > 0 ? "cat-row--child" : "") @(!cat.Activo ? "cat-row--inactive" : "")">
                                <td class="whitespace-nowrap px-4 py-3 text-sm font-mono text-slate-400">@cat.Codigo</td>
                                <td class="px-4 py-3">
                                    <div class="cat-row__name">
                                        @if (nivel > 0)
                                        {
                                            <span class="material-symbols-outlined cat-row__branch" aria-hidden="true">subdirectory_arrow_right</span>
                                        }
                                        <div class="min-w-0">
                                            <span class="text-sm font-semibold text-white">@cat.Nombre</span>
                                            @if (!string.IsNullOrEmpty(cat.Descripcion))
                                            {
                                                <p class="max-w-62.5 truncate text-xs text-slate-400" title="@cat.Descripcion">@cat.Descripcion</p>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-300">@(cat.ParentNombre ?? "—")</td>
                                <td class="px-4 py-3 text-center">
                                    @if (cat.Activo)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-green-500/20 text-green-400 border border-green-500/30">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30">
                                            Inactiva
                                        </span>
                                    }
                                </td>
                                @if (mostrarAccionesCategoria)
                                {
                                <td class="px-4 py-3 text-right">
                                    <div class="cat-row__actions">
                                        @if (puedeEditarCategoria)
                                        {
                                            <button type="button" data-cat-edit-id="@cat.Id"
                                                    class="row-action row-action--primary"
                                                    aria-label="Editar categoría @cat.Nombre" title="Editar">
                                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                                <span class="row-action__label">Editar</span>
                                            </button>
                                        }
                                        @if (puedeEliminarCategoria)
                                        {
                                            <button type="button" data-cat-delete-id="@cat.Id" data-cat-delete-nombre="@cat.Nombre"
                                                    class="row-action row-action--danger"
                                                    aria-label="Eliminar categoría @cat.Nombre" title="Eliminar">
                                                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                                <span class="row-action__label">Eliminar</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(mostrarAccionesCategoria ? 5 : 4)" class="py-12 text-center">
                                <span class="material-symbols-outlined text-4xl text-slate-600 mb-2 block" aria-hidden="true">category</span>
                                <p class="text-sm font-bold text-slate-400">Todavía no hay categorías</p>
                                @if (puedeCrearCategoria)
                                {
                                    <p class="mt-1 text-xs text-slate-500">Creá la primera con «Nueva categoría» para poder clasificar tus productos.</p>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
                </div>
            </div>
        </div>
        <!-- Footer -->
        <div class="border-t border-slate-800 px-6 py-4 text-xs text-slate-400">
            @categoriasOrdenadas.Count @(categoriasOrdenadas.Count == 1 ? "categoría" : "categorías")
        </div>
    </div>

<form id="form-delete-categoria" method="post" class="hidden">
    @Html.AntiForgeryToken()
</form>
