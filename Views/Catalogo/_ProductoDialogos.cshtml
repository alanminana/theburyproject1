@model CatalogoUnificadoViewModel
@{
    // El costo de envío del producto es un valor fijo: solo lo edita quien tenga productos.editshippingcost
    // (ProductoController lo vuelve a exigir en el servidor).
    var puedeEditarCostoEnvio = User.TienePermiso("productos", "editshippingcost");
    // Costos y precio de venta solo cambian con precios.apply (EditAjax lo vuelve a exigir).
    var puedeModificarImportes = User.TienePermiso("precios", "apply");
}

<!-- Modal: Nuevo Producto -->
<dialog id="modal-nuevo-producto" class="inv-drawer" aria-labelledby="modal-nuevo-producto-title">
    <div class="inv-drawer__panel">
        <header class="inv-drawer__header">
            <div>
                <h2 id="modal-nuevo-producto-title">Nuevo producto</h2>
                <p>El IVA se desglosa automáticamente a medida que cargás los precios.</p>
            </div>
            <button type="button" data-catalogo-modal-close="producto" class="inv-icon-btn" aria-label="Cerrar">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>

        <form id="form-nuevo-producto" method="post" asp-controller="Producto" asp-action="CreateAjax"
              class="flex flex-col flex-1 overflow-hidden">
            @Html.AntiForgeryToken()

            <!-- Validation Summary (siempre visible sobre las solapas) -->
            <div id="modal-validation-summary" role="alert" aria-live="assertive" aria-atomic="true" class="hidden mx-6 mt-4 bg-red-500/10 border border-red-500/20 rounded-lg p-4 gap-3">
                <span class="material-symbols-outlined text-red-500">error</span>
                <div>
                    <h4 class="text-sm font-bold text-red-500">Errores de validación</h4>
                    <p id="modal-validation-text" class="text-xs text-red-400/80 mt-1"></p>
                </div>
            </div>

            <!-- Solapas -->
            <div class="inv-tablist inv-tablist--panel prod-tabs-scroll" role="tablist" aria-label="Secciones del producto">
                <div role="presentation" class="flex flex-nowrap min-w-max">
                    <button type="button" role="tab" data-prod-create-tab="datos" aria-selected="true" class="inv-tab prod-create-tab">Datos</button>
                    <button type="button" role="tab" data-prod-create-tab="precios" aria-selected="false" class="inv-tab prod-create-tab">Precios</button>
                    <button type="button" role="tab" data-prod-create-tab="credito" aria-selected="false" class="inv-tab prod-create-tab">Crédito personal</button>
                    <button type="button" role="tab" data-prod-create-tab="caracteristicas" aria-selected="false" class="inv-tab prod-create-tab">Características</button>
                    <button type="button" role="tab" data-prod-create-tab="stock" aria-selected="false" class="inv-tab prod-create-tab">Stock</button>
                </div>
            </div>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto p-6">

                <!-- Panel: Datos -->
                <div data-prod-create-panel="datos" role="tabpanel">
                <!-- Section 1: Información Básica -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Información Básica</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="inv-campo">
                            <label for="prod-create-Codigo" class="inv-campo__etiqueta">Código</label>
                            <input id="prod-create-Codigo" name="Codigo" type="text"
                                   class="inv-control"
                                   placeholder="Ej: PROD-001" />
                            <span data-valmsg-for="Codigo" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="inv-campo">
                            <label for="prod-create-Nombre" class="inv-campo__etiqueta">Nombre</label>
                            <input id="prod-create-Nombre" name="Nombre" type="text"
                                   class="inv-control"
                                   placeholder="Nombre comercial del producto" />
                            <span data-valmsg-for="Nombre" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="md:col-span-2 inv-campo">
                            <label for="prod-create-Descripcion" class="inv-campo__etiqueta">Descripción</label>
                            <textarea id="prod-create-Descripcion" name="Descripcion" rows="3"
                                      class="inv-control"
                                      placeholder="Detalles técnicos o comerciales..."></textarea>
                        </div>
                        <div class="inv-campo">
                            <label for="ac-categoria-input" class="inv-campo__etiqueta">Categoría</label>
                            <div class="autocomplete-erp" id="ac-categoria">
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-lg pointer-events-none">search</span>
                                    <input type="text" id="ac-categoria-input" autocomplete="off"
                                           class="inv-control inv-control--icono"
                                           placeholder="Buscar categoría..." />
                                    <button type="button" id="ac-categoria-clear" class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white hidden transition-colors">
                                        <span class="material-symbols-outlined text-base">close</span>
                                    </button>
                                </div>
                                <input type="hidden" name="CategoriaId" id="modal-categoriaId" />
                                <div id="ac-categoria-dropdown" class="hidden absolute z-50 w-full mt-1 bg-slate-900 border border-slate-700 rounded-lg shadow-xl overflow-hidden max-h-52 overflow-y-auto"></div>
                            </div>
                            <span data-valmsg-for="CategoriaId" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="inv-campo">
                            <label for="modal-subcategoriaId" class="inv-campo__etiqueta">Subcategoría</label>
                            <select name="SubcategoriaId" id="modal-subcategoriaId"
                                    class="inv-control">
                                <option value="">Seleccionar subcategoría</option>
                            </select>
                        </div>
                        <div class="inv-campo">
                            <label for="ac-marca-input" class="inv-campo__etiqueta">Marca</label>
                            <div class="autocomplete-erp" id="ac-marca">
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-lg pointer-events-none">search</span>
                                    <input type="text" id="ac-marca-input" autocomplete="off"
                                           class="inv-control inv-control--icono"
                                           placeholder="Buscar marca..." />
                                    <button type="button" id="ac-marca-clear" class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white hidden transition-colors">
                                        <span class="material-symbols-outlined text-base">close</span>
                                    </button>
                                </div>
                                <input type="hidden" name="MarcaId" id="modal-marcaId" />
                                <div id="ac-marca-dropdown" class="hidden absolute z-50 w-full mt-1 bg-slate-900 border border-slate-700 rounded-lg shadow-xl overflow-hidden max-h-52 overflow-y-auto"></div>
                            </div>
                            <span data-valmsg-for="MarcaId" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="inv-campo">
                            <label for="modal-submarcaId" class="inv-campo__etiqueta">Submarca</label>
                            <select name="SubmarcaId" id="modal-submarcaId"
                                    class="inv-control">
                                <option value="">Seleccionar submarca</option>
                            </select>
                        </div>
                    </div>
                </section>
                </div>

                <!-- Panel: Precios -->
                <div data-prod-create-panel="precios" role="tabpanel" class="hidden">
                <!-- Section 2: Precios -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Precios</h3>
                    </div>
                    <div class="bg-primary/10 border border-primary/20 rounded-lg p-3 flex gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">info</span>
                        <p class="text-xs text-slate-300">
                            Ingresá el precio total informado por el proveedor, con IVA incluido. El sistema desglosa el IVA de compra, suma los costos adicionales y aplica la ganancia para obtener el precio final de venta. El IVA de venta se muestra desglosado y no se vuelve a sumar.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                        <!-- Compra informada por proveedor -->
                        <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-4 space-y-4">
                            <div>
                                <h4 class="text-sm font-bold text-white">1. Compra</h4>
                                <p class="text-xs text-slate-400">Datos que vienen del proveedor.</p>
                            </div>

                            <div class="inv-campo">
                                <label for="modal-precioCompra" class="inv-campo__etiqueta">Precio compra total con IVA</label>
                                <div class="relative">
                                    <span class="absolute left-3 top-2 text-slate-500">$</span>
                                    <input name="PrecioCompraTotalConIva" id="modal-precioCompra" type="number" step="0.01" min="0"
                                           class="inv-control inv-control--prefijo"
                                           placeholder="Ej: 121000" />
                                </div>
                                <span data-valmsg-for="PrecioCompra" class="text-xs text-red-500 hidden"></span>
                            </div>

                            <div class="inv-campo">
                                <label for="modal-porcentajeIVACompra" class="inv-campo__etiqueta">IVA del precio de compra</label>
                                <select name="PorcentajeIVACompra" id="modal-porcentajeIVACompra"
                                        class="inv-control">
                                    <option value="21" selected>21%</option>
                                    <option value="10.5">10.5%</option>
                                    <option value="27">27%</option>
                                    <option value="0">0%</option>
                                </select>
                            </div>

                            <div class="space-y-3">
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="modal-precioCompraSinIva" class="text-xs font-bold uppercase tracking-wider text-slate-400">Compra sin IVA</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="modal-precioCompraSinIva" type="text" readonly value="0.00"
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="modal-ivaCompraImporte" class="text-xs font-bold uppercase tracking-wider text-slate-400">IVA compra</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="modal-ivaCompraImporte" type="text" readonly value="0.00"
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Costos adicionales -->
                        <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-4 space-y-4">
                            <div>
                                <h4 class="text-sm font-bold text-white">2. Costos adicionales</h4>
                                <p class="text-xs text-slate-400">Se suman al costo del producto.</p>
                            </div>

                            <div class="catalogo-costos-grid">
                                <div class="inv-campo">
                                    <label for="modal-costoEnvio" class="inv-campo__etiqueta">Envío</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input name="CostoEnvio" id="modal-costoEnvio" type="number" step="0.01" min="0" value="0"
                                               readonly="@(!puedeEditarCostoEnvio)" title="@(puedeEditarCostoEnvio ? null : "Requiere el permiso «Editar costo de envío»")"
                                               class="inv-control inv-control--prefijo @(puedeEditarCostoEnvio ? "" : "cursor-not-allowed opacity-60")" />
                                    </div>
                                    @if (!puedeEditarCostoEnvio)
                                    {
                                        <p class="text-xs text-slate-500" data-costo-envio-solo-lectura title="Requiere el permiso «Editar costo de envío»">Fijo · solo lectura</p>
                                    }
                                </div>
                                <div class="inv-campo">
                                    <label for="modal-percepcionesCompra" class="inv-campo__etiqueta">Percepciones</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" name="PercepcionesCompra" id="modal-percepcionesCompra" type="number" step="0.01" min="0" value="0"
                                               class="inv-control inv-control--prefijo" />
                                    </div>
                                </div>
                                <div class="inv-campo">
                                    <label for="modal-otrosCostosCompra" class="inv-campo__etiqueta">Otros gastos</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input name="OtrosCostosCompra" id="modal-otrosCostosCompra" type="number" step="0.01" min="0" value="0"
                                               class="inv-control inv-control--prefijo" />
                                    </div>
                                </div>
                            </div>

                            <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 p-3">
                                <label for="modal-costoRealFinal" class="text-xs font-bold uppercase tracking-wider text-amber-400">Costo real final con gastos incluidos</label>
                                <div class="relative mt-1">
                                    <span class="absolute left-3 top-2 text-amber-400 font-bold">$</span>
                                    <input data-rule="monto" id="modal-costoRealFinal" type="text" readonly value="0.00"
                                           class="inv-control inv-control--prefijo inv-control--destacado inv-control--solo-lectura" />
                                </div>
                                <input type="hidden" name="PrecioCompra" id="modal-precioCompraRealFinal" value="0" />
                                <p class="mt-2 text-[11px] text-slate-400">Este valor se guarda como precio de costo del producto.</p>
                            </div>
                        </div>

                        <!-- Venta -->
                        <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-4 space-y-4">
                            <div>
                                <h4 class="text-sm font-bold text-white">3. Venta</h4>
                                <p class="text-xs text-slate-400">La ganancia se aplica sobre el costo real. El precio final ya incluye IVA.</p>
                            </div>

                            <div class="catalogo-ganancia-grid">
                                <div class="inv-campo">
                                    <label for="modal-margenPorcentaje" class="inv-campo__etiqueta">Ganancia %</label>
                                    <div class="relative">
                                        <input name="MargenPorcentaje" id="modal-margenPorcentaje" type="number" step="0.01" min="0" value="0"
                                               class="inv-control inv-control--sufijo" />
                                        <span class="absolute right-3 top-2 text-slate-500">%</span>
                                    </div>
                                </div>
                                <div class="inv-campo">
                                    <label for="modal-montoGanancia" class="inv-campo__etiqueta">Ganancia en pesos</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="none" id="modal-montoGanancia" type="number" step="0.01" value="0"
                                               class="inv-control inv-control--prefijo" />
                                    </div>
                                </div>
                            </div>

                            <div class="inv-campo catalogo-precio-final">
                                <label for="modal-precioFinal" class="catalogo-precio-final-label inv-campo__etiqueta">Precio final de venta con IVA</label>
                                <div class="relative">
                                    <span class="catalogo-precio-final-symbol absolute left-3 top-2 text-primary font-bold">$</span>
                                    <input name="PrecioVenta" id="modal-precioFinal" type="number" step="0.01" min="0"
                                           class="inv-control inv-control--prefijo inv-control--destacado" />
                                </div>
                                <span data-valmsg-for="PrecioVenta" class="text-xs text-red-500 hidden"></span>
                                <p class="text-[11px] text-slate-500">Se calcula con la ganancia; si lo ajustás a mano, la ganancia se recalcula.</p>
                            </div>

                            <div class="inv-campo">
                                <label for="modal-alicuotaIVAId" class="inv-campo__etiqueta">Alícuota utilizada para el desglose</label>
                                <select name="AlicuotaIVAId" id="modal-alicuotaIVAId"
                                        class="inv-control">
                                    <option value="">— Alícuota general (21%) —</option>
                                    @if (ViewBag.AlicuotasIVADatos != null)
                                    {
                                        foreach (var a in ViewBag.AlicuotasIVADatos)
                                        {
                                            <option value="@a.Id" data-porcentaje="@a.Porcentaje">@a.Texto</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" name="PorcentajeIVA" id="modal-porcentajeIVA" value="21" />
                                <p class="text-[11px] text-slate-500">Cambiarla solo recalcula el desglose; no modifica el precio final.</p>
                            </div>

                            <div class="space-y-3">
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="modal-ventaSinIva" class="text-xs font-bold uppercase tracking-wider text-slate-400">Venta sin IVA</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input id="modal-ventaSinIva" type="text" readonly value="0.00"
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="modal-ivaVentaImporte" class="text-xs font-bold uppercase tracking-wider text-slate-400">IVA incluido en la venta</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="modal-ivaVentaImporte" type="text" readonly value="0.00"
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <div class="inv-campo max-w-xs">
                            <label for="modal-maxCuotasSinInteres" class="inv-campo__etiqueta">Máx. cuotas sin interés</label>
                            <input name="MaxCuotasSinInteresPermitidas" id="modal-maxCuotasSinInteres" type="number" min="1" max="60"
                                   class="inv-control"
                                   placeholder="Sin restricción" />
                            <span data-valmsg-for="MaxCuotasSinInteresPermitidas" class="text-xs text-red-500 hidden"></span>
                            <p class="text-xs text-slate-500">Vacío = usa el máximo de la tarjeta. Solo aplica a tarjetas sin interés.</p>
                        </div>
                    </div>
                </section>
                </div>

                <!-- Panel: Crédito personal -->
                <div data-prod-create-panel="credito" role="tabpanel" class="hidden">
                <!-- Section 3: Crédito personal -->
                <section data-producto-credito-personal>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Crédito personal</h3>
                    </div>
                    <p class="text-xs text-slate-400 mb-4">
                        <strong class="text-slate-300">Recargo total:</strong> este porcentaje se agrega
                        una sola vez al saldo financiado. Elegí el estado de este producto:
                    </p>
                    <input type="hidden" name="CreditoPersonal.AdmiteCreditoPersonal" data-cp-admite-hidden value="true" />
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4" role="radiogroup" aria-label="Estado de Crédito Personal">
                        <label class="flex items-start gap-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3 cursor-pointer">
                            <input type="radio" name="CreditoPersonal.Modo" value="HeredaGlobal" data-cp-modo class="mt-0.5" checked />
                            <span>
                                <span class="block text-sm font-semibold text-white">Hereda global</span>
                                <span class="block text-xs text-slate-400">Usa los planes de Configuración de Pagos. Es lo normal para un producto nuevo.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3 cursor-pointer">
                            <input type="radio" name="CreditoPersonal.Modo" value="ConfiguracionPropia" data-cp-modo class="mt-0.5" />
                            <span>
                                <span class="block text-sm font-semibold text-white">Planes propios</span>
                                <span class="block text-xs text-slate-400">Elegí qué cantidades de cuotas ofrece este producto. El recargo de cada una lo fija siempre el plan global.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3 cursor-pointer">
                            <input type="radio" name="CreditoPersonal.Modo" value="NoDisponible" data-cp-modo class="mt-0.5" />
                            <span>
                                <span class="block text-sm font-semibold text-white">No disponible</span>
                                <span class="block text-xs text-slate-400">Bloquea Crédito Personal para este producto.</span>
                            </span>
                        </label>
                    </div>
                    <div class="inv-campo" data-cp-maxcuotas-wrap>
                        <label for="prod-create-CreditoPersonal-MaxCuotasCredito" class="inv-campo__etiqueta">Máx. cuotas crédito personal</label>
                        <input id="prod-create-CreditoPersonal-MaxCuotasCredito" name="CreditoPersonal.MaxCuotasCredito" type="number" min="1" max="120" step="1"
                               class="inv-control inv-control--corto"
                               placeholder="Sin restricción" />
                        <span data-valmsg-for="CreditoPersonal.MaxCuotasCredito" class="text-xs text-red-500 hidden"></span>
                        <p class="text-xs text-slate-500">Vacío = sin límite propio; aplica el rango global o del plan.</p>
                    </div>
                    <div class="mt-6 space-y-2" data-cp-cards-wrap>
                        <p class="inv-campo__etiqueta">Planes de cuotas propios</p>
                        <p class="text-xs text-slate-400">
                            Activá las cantidades permitidas para este producto. El recargo de cada una es el
                            del plan global vigente (no editable acá); las filas inactivas no se aplican y si
                            no activás ninguna, hereda la global.
                        </p>
                        <div id="modal-credito-cards" data-cp-cards-cont class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-2"></div>
                    </div>
                </section>
                </div>

                <!-- Panel: Características -->
                <div data-prod-create-panel="caracteristicas" role="tabpanel" class="hidden">
                <!-- Section 4: Características -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Características</h3>
                    </div>
                    <div class="flex flex-col gap-3">
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <p class="text-xs text-slate-400">Deslizá la tabla para revisar y completar las características del producto.</p>
                            <span id="modal-caracteristicas-count" class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-300">0 cargadas</span>
                        </div>
                        <div class="relative" data-oc-scroll style="--oc-scroll-min-width: 760px;">
                            <div data-oc-scroll-hint class="mb-2 hidden items-center gap-2 text-xs font-medium text-slate-400">
                                <span class="material-symbols-outlined text-sm">swipe</span>
                                Deslizá para ver y editar las columnas.
                            </div>
                            <div data-oc-scroll-shell class="relative overflow-hidden rounded-lg border border-slate-800">
                                <div data-oc-scroll-fade="left" class="pointer-events-none absolute inset-y-0 left-0 hidden w-8 bg-linear-to-r from-slate-900 via-slate-900/95 to-transparent"></div>
                                <div data-oc-scroll-fade="right" class="pointer-events-none absolute inset-y-0 right-0 hidden w-8 bg-linear-to-l from-slate-900 via-slate-900/95 to-transparent"></div>
                                <div data-oc-scroll-region tabindex="0" role="region" aria-label="Tabla de características del producto" class="overflow-x-auto">
                                    <table data-oc-scroll-table class="w-full border-collapse text-left text-sm" style="min-width: var(--oc-scroll-min-width);">
                                        <thead class="bg-slate-800/50">
                                            <tr>
                                                <th class="px-4 py-3 font-semibold">Nombre de la característica</th>
                                                <th class="px-4 py-3 font-semibold">Valor</th>
                                                <th class="px-4 py-3 w-20 text-center font-semibold">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="modal-caracteristicas-body" class="divide-y divide-slate-800">
                                            <!-- Dynamic rows inserted by JS -->
                                        </tbody>
                                        <tfoot>
                                            <tr class="/30 bg-slate-900/30">
                                                <td class="px-2 py-2">
                                                    <input id="modal-caract-nombre" aria-label="Nombre de la característica" type="text"
                                                           class="w-full border-none bg-transparent text-xs placeholder-slate-500 focus:ring-0"
                                                           placeholder="Ej: Material" />
                                                </td>
                                                <td class="px-2 py-2">
                                                    <input id="modal-caract-valor" aria-label="Valor de la característica" type="text"
                                                           class="w-full border-none bg-transparent text-xs placeholder-slate-500 focus:ring-0"
                                                           placeholder="Ej: Acero" />
                                                </td>
                                                <td class="px-2 py-2 text-center">
                                                    <button type="button" data-catalogo-action="product-add-caracteristica"
                                                            class="btn-erp-primary btn-sm">
                                                        <span class="material-symbols-outlined text-sm">add</span>
                                                    </button>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400 pl-1 italic">
                        Ejemplo: Color: Negro, Material: Acero, Memoria: 16GB
                    </p>
                </section>
                </div>

                <!-- Panel: Stock -->
                <div data-prod-create-panel="stock" role="tabpanel" class="hidden">
                <!-- Section 5: Stock & Configuración -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Stock &amp; Configuración</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="inv-campo">
                                <label for="prod-create-StockActual" class="inv-campo__etiqueta">Stock Actual</label>
                                <input id="prod-create-StockActual" name="StockActual" type="number" min="0" step="1" value="0"
                                       class="inv-control" />
                            </div>
                            <div class="inv-campo">
                                <label for="prod-create-StockMinimo" class="inv-campo__etiqueta">Stock Mínimo</label>
                                <input id="prod-create-StockMinimo" name="StockMinimo" type="number" min="0" step="1" value="0"
                                       class="inv-control" />
                            </div>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-slate-800/30 rounded-lg border border-slate-800">
                            <div>
                                <p class="text-sm font-bold text-white">Producto Activo</p>
                                <p class="text-xs text-slate-400">Habilitar este producto para la venta</p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input name="Activo" type="checkbox" value="true" checked class="sr-only peer" />
                                @* H-34: un checkbox desmarcado no se envía y el modelo asume Activo=true; el hidden va DESPUÉS (el binder toma el primer valor). *@
                                <input type="hidden" name="Activo" value="false" />
                                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-colors peer-checked:bg-primary"></div>
                            </label>
                        </div>
                    </div>
                </section>
                </div>
            </div>

            <!-- Footer -->
            <footer class="grid gap-3 border-t border-slate-800 bg-slate-900/50 px-6 py-4 sm:flex sm:items-center sm:justify-end">
                <button type="button" data-catalogo-modal-close="producto"
                        class="inv-btn inv-btn--ghost">
                    Cancelar
                </button>
                <button type="submit" id="btn-guardar-producto"
                        class="inv-btn inv-btn--primary">
                    Guardar Producto
                </button>
            </footer>
        </form>
    </div>
</dialog>

<!-- Modal: Editar Producto -->
<dialog id="modal-editar-producto" class="inv-drawer" aria-labelledby="modal-editar-producto-title">
    <div class="inv-drawer__panel">
        <header class="inv-drawer__header">
            <div>
                <h2 id="modal-editar-producto-title">Editar producto</h2>
                <p>Los cambios se aplican al guardar.</p>
            </div>
            <button type="button" data-prod-edit-modal-close class="inv-icon-btn" aria-label="Cerrar">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>

        <form id="form-editar-producto" method="post" action="/Producto/EditAjax/0"
              class="flex flex-col flex-1 overflow-hidden">
            @Html.AntiForgeryToken()
            <input type="hidden" id="prod-edit-id" name="Id" value="" />
            <input type="hidden" id="prod-edit-rowversion" name="RowVersion" value="" />

            <!-- Validation Summary (siempre visible sobre las solapas) -->
            <div id="prod-edit-validation-summary" role="alert" aria-live="assertive" aria-atomic="true" class="hidden mx-6 mt-4 bg-red-500/10 border border-red-500/20 rounded-lg p-4 gap-3">
                <span class="material-symbols-outlined text-red-500">error</span>
                <div>
                    <h4 class="text-sm font-bold text-red-500">Errores de validación</h4>
                    <p id="prod-edit-validation-text" class="text-xs text-red-400/80 mt-1"></p>
                </div>
            </div>

            <!-- Solapas -->
            <div class="inv-tablist inv-tablist--panel prod-tabs-scroll" role="tablist" aria-label="Secciones del producto">
                <div role="presentation" class="flex flex-nowrap min-w-max">
                    <button type="button" role="tab" data-prod-edit-tab="datos" aria-selected="true" class="inv-tab prod-edit-tab">Datos</button>
                    <button type="button" role="tab" data-prod-edit-tab="precios" aria-selected="false" class="inv-tab prod-edit-tab">Precios</button>
                    <button type="button" role="tab" data-prod-edit-tab="credito" aria-selected="false" class="inv-tab prod-edit-tab">Crédito personal</button>
                    <button type="button" role="tab" data-prod-edit-tab="caracteristicas" aria-selected="false" class="inv-tab prod-edit-tab">Características</button>
                    <button type="button" role="tab" data-prod-edit-tab="stock" aria-selected="false" class="inv-tab prod-edit-tab">Stock</button>
                </div>
            </div>

            <div class="flex-1 overflow-y-auto p-6">

                <!-- Panel: Datos -->
                <div data-prod-edit-panel="datos" role="tabpanel">
                <!-- Información Básica -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Información Básica</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="inv-campo">
                            <label for="prod-edit-codigo" class="inv-campo__etiqueta">Código</label>
                            <input id="prod-edit-codigo" name="Codigo" type="text" class="inv-control" />
                            <span data-valmsg-for="Codigo" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="inv-campo">
                            <label for="prod-edit-nombre" class="inv-campo__etiqueta">Nombre</label>
                            <input id="prod-edit-nombre" name="Nombre" type="text" class="inv-control" />
                            <span data-valmsg-for="Nombre" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="md:col-span-2 inv-campo">
                            <label for="prod-edit-descripcion" class="inv-campo__etiqueta">Descripción</label>
                            <textarea id="prod-edit-descripcion" name="Descripcion" rows="2" class="inv-control"></textarea>
                        </div>
                        <div class="inv-campo">
                            <label for="prod-edit-categoriaId" class="inv-campo__etiqueta">Categoría</label>
                            <select id="prod-edit-categoriaId" name="CategoriaId" class="inv-control">
                                <option value="">Seleccionar categoría</option>
                            </select>
                            <span data-valmsg-for="CategoriaId" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="inv-campo">
                            <label for="prod-edit-subcategoriaId" class="inv-campo__etiqueta">Subcategoría</label>
                            <select id="prod-edit-subcategoriaId" name="SubcategoriaId" class="inv-control">
                                <option value="">Sin subcategoría</option>
                            </select>
                        </div>
                        <div class="inv-campo">
                            <label for="prod-edit-marcaId" class="inv-campo__etiqueta">Marca</label>
                            <select id="prod-edit-marcaId" name="MarcaId" class="inv-control">
                                <option value="">Seleccionar marca</option>
                            </select>
                            <span data-valmsg-for="MarcaId" class="text-xs text-red-500 hidden"></span>
                        </div>
                        <div class="inv-campo">
                            <label for="prod-edit-submarcaId" class="inv-campo__etiqueta">Submarca</label>
                            <select id="prod-edit-submarcaId" name="SubmarcaId" class="inv-control">
                                <option value="">Sin submarca</option>
                            </select>
                        </div>
                    </div>
                </section>
                </div>

                <!-- Panel: Precios -->
                <div data-prod-edit-panel="precios" role="tabpanel" class="hidden">
                <!-- Precios -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Precios</h3>
                    </div>
                    <div id="prod-edit-precio-contexto" class="bg-primary/10 border border-primary/20 rounded-lg p-3 flex gap-3 mb-4">
                        <span class="material-symbols-outlined text-primary">info</span>
                        <p id="prod-edit-precio-contexto-texto" class="text-xs text-slate-300">
                            Editá la compra, los costos adicionales y la ganancia. El precio final de venta ya incluye IVA: el sistema solo desglosa el neto y el IVA, sin volver a sumarlo.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                        <!-- Compra informada por proveedor -->
                        <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-4 space-y-4">
                            <div>
                                <h4 class="text-sm font-bold text-white">1. Compra</h4>
                                <p class="text-xs text-slate-400">Datos que vienen del proveedor.</p>
                            </div>

                            <div class="inv-campo">
                                <label for="prod-edit-precioCompra" class="inv-campo__etiqueta">Precio compra total con IVA</label>
                                <div class="relative">
                                    <span class="absolute left-3 top-2 text-slate-500">$</span>
                                    <input id="prod-edit-precioCompra" name="PrecioCompraTotalConIva" type="number" step="0.01" min="0" readonly="@(!puedeModificarImportes)" title="@(puedeModificarImportes ? null : "Requiere el permiso «Aplicar Cambio» de Precios")"
                                           class="inv-control inv-control--prefijo" />
                                </div>
                                <span data-valmsg-for="PrecioCompra" class="text-xs text-red-500 hidden"></span>
                            </div>

                            <div class="inv-campo">
                                <label for="prod-edit-porcentajeIVACompra" class="inv-campo__etiqueta">IVA del precio de compra</label>
                                <select id="prod-edit-porcentajeIVACompra" name="PorcentajeIVACompra" disabled="@(!puedeModificarImportes)"
                                        class="inv-control">
                                    <option value="21">21%</option>
                                    <option value="10.5">10.5%</option>
                                    <option value="27">27%</option>
                                    <option value="0">0%</option>
                                </select>
                                <p class="text-[11px] text-slate-500">Sirve para separar el IVA del precio de compra. No cambia el costo real.</p>
                            </div>

                            <div class="space-y-3">
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="prod-edit-precioCompraSinIva" class="text-xs font-bold uppercase tracking-wider text-slate-400">Compra sin IVA</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="prod-edit-precioCompraSinIva" type="text" readonly
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="prod-edit-ivaCompraImporte" class="text-xs font-bold uppercase tracking-wider text-slate-400">IVA compra</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="prod-edit-ivaCompraImporte" type="text" readonly
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Costos adicionales -->
                        <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-4 space-y-4">
                            <div>
                                <h4 class="text-sm font-bold text-white">2. Costos adicionales</h4>
                                <p class="text-xs text-slate-400">Se suman al costo del producto.</p>
                            </div>

                            <div class="catalogo-costos-grid">
                                <div class="inv-campo">
                                    <label for="prod-edit-costoEnvio" class="inv-campo__etiqueta">Envío</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input id="prod-edit-costoEnvio" name="CostoEnvio" type="number" step="0.01" min="0" value="0"
                                               readonly="@(!puedeEditarCostoEnvio)" title="@(puedeEditarCostoEnvio ? null : "Requiere el permiso «Editar costo de envío»")"
                                               class="inv-control inv-control--prefijo @(puedeEditarCostoEnvio ? "" : "cursor-not-allowed opacity-60")" />
                                    </div>
                                    @if (!puedeEditarCostoEnvio)
                                    {
                                        <p class="text-xs text-slate-500" data-costo-envio-solo-lectura title="Requiere el permiso «Editar costo de envío»">Fijo · solo lectura</p>
                                    }
                                </div>
                                <div class="inv-campo">
                                    <label for="prod-edit-percepcionesCompra" class="inv-campo__etiqueta">Percepciones</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="prod-edit-percepcionesCompra" name="PercepcionesCompra" type="number" step="0.01" min="0" value="0" readonly="@(!puedeModificarImportes)" title="@(puedeModificarImportes ? null : "Requiere el permiso «Aplicar Cambio» de Precios")"
                                               class="inv-control inv-control--prefijo" />
                                    </div>
                                </div>
                                <div class="inv-campo">
                                    <label for="prod-edit-otrosCostosCompra" class="inv-campo__etiqueta">Otros gastos</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input id="prod-edit-otrosCostosCompra" name="OtrosCostosCompra" type="number" step="0.01" min="0" value="0" readonly="@(!puedeModificarImportes)" title="@(puedeModificarImportes ? null : "Requiere el permiso «Aplicar Cambio» de Precios")"
                                               class="inv-control inv-control--prefijo" />
                                    </div>
                                </div>
                            </div>

                            <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 p-3">
                                <label for="prod-edit-costoRealFinal" class="text-xs font-bold uppercase tracking-wider text-amber-400">Costo real final con gastos incluidos</label>
                                <div class="relative mt-1">
                                    <span class="absolute left-3 top-2 text-amber-400 font-bold">$</span>
                                    <input data-rule="monto" id="prod-edit-costoRealFinal" type="text" readonly
                                           class="inv-control inv-control--prefijo inv-control--destacado inv-control--solo-lectura" />
                                </div>
                                <input type="hidden" id="prod-edit-precioCompraRealFinal" name="PrecioCompra" value="0" />
                                <p class="mt-2 text-[11px] text-slate-400">Este valor se guarda como precio de costo del producto.</p>
                            </div>
                        </div>

                        <!-- Venta -->
                        <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-4 space-y-4">
                            <div>
                                <h4 class="text-sm font-bold text-white">3. Venta</h4>
                                <p class="text-xs text-slate-400">La ganancia se aplica sobre el costo real. El precio final ya incluye IVA.</p>
                            </div>

                            <div class="catalogo-ganancia-grid">
                                <div class="inv-campo">
                                    <label for="prod-edit-margenPorcentaje" class="inv-campo__etiqueta">Ganancia %</label>
                                    <div class="relative">
                                        <input id="prod-edit-margenPorcentaje" name="MargenPorcentaje" type="number" step="0.01" min="0" value="0" readonly="@(!puedeModificarImportes)" title="@(puedeModificarImportes ? null : "Requiere el permiso «Aplicar Cambio» de Precios")"
                                               class="inv-control inv-control--sufijo" />
                                        <span class="absolute right-3 top-2 text-slate-500">%</span>
                                    </div>
                                </div>
                                <div class="inv-campo">
                                    <label for="prod-edit-montoGanancia" class="inv-campo__etiqueta">Ganancia en pesos</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="none" id="prod-edit-montoGanancia" type="number" step="0.01" value="0"
                                               class="inv-control inv-control--prefijo" />
                                    </div>
                                </div>
                            </div>

                            <div class="inv-campo catalogo-precio-final">
                                <label for="prod-edit-precioFinal" class="catalogo-precio-final-label inv-campo__etiqueta">Precio final de venta con IVA</label>
                                <div class="relative">
                                    <span class="catalogo-precio-final-symbol absolute left-3 top-2 text-primary font-bold">$</span>
                                    <input id="prod-edit-precioFinal" name="PrecioVenta" type="number" step="0.01" min="0" readonly="@(!puedeModificarImportes)" title="@(puedeModificarImportes ? null : "Requiere el permiso «Aplicar Cambio» de Precios")"
                                           class="inv-control inv-control--prefijo inv-control--destacado" />
                                </div>
                                <span data-valmsg-for="PrecioVenta" class="text-xs text-red-500 hidden"></span>
                                <p class="text-[11px] text-slate-500">Se calcula con la ganancia; si lo ajustás a mano, la ganancia se recalcula.</p>
                            </div>

                            <div class="inv-campo">
                                <label for="prod-edit-alicuotaIVAId" class="inv-campo__etiqueta">Alícuota utilizada para el desglose</label>
                                <select id="prod-edit-alicuotaIVAId" name="AlicuotaIVAId" class="inv-control">
                                    <option value="">— Alícuota general (21%) —</option>
                                    @if (ViewBag.AlicuotasIVADatos != null)
                                    {
                                        foreach (var a in ViewBag.AlicuotasIVADatos)
                                        {
                                            <option value="@a.Id" data-porcentaje="@a.Porcentaje">@a.Texto</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" id="prod-edit-porcentajeIVA" name="PorcentajeIVA" value="21" />
                                <p class="text-[11px] text-slate-500">Cambiarla solo recalcula el desglose; no modifica el precio final.</p>
                            </div>

                            <input type="hidden" id="prod-edit-comisionPorcentaje" name="ComisionPorcentaje" value="0" />

                            <div class="space-y-3">
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="prod-edit-ventaSinIva" class="text-xs font-bold uppercase tracking-wider text-slate-400">Venta sin IVA</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input id="prod-edit-ventaSinIva" type="text" readonly
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                                <div class="inv-campo catalogo-valor-calculado p-2">
                                    <label for="prod-edit-ivaVentaImporte" class="text-xs font-bold uppercase tracking-wider text-slate-400">IVA incluido en la venta</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-2 text-slate-500">$</span>
                                        <input data-rule="monto" id="prod-edit-ivaVentaImporte" type="text" readonly
                                               class="inv-control inv-control--prefijo inv-control--solo-lectura" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <div class="inv-campo max-w-xs">
                            <label for="prod-edit-maxCuotasSinInteres" class="inv-campo__etiqueta">Máx. cuotas sin interés</label>
                            <input id="prod-edit-maxCuotasSinInteres" name="MaxCuotasSinInteresPermitidas" type="number" min="1" max="60"
                                   class="inv-control"
                                   placeholder="Sin restricción" />
                            <span data-valmsg-for="MaxCuotasSinInteresPermitidas" class="text-xs text-red-500 hidden"></span>
                            <p class="text-xs text-slate-500">Vacío = usa el máximo de la tarjeta. Solo aplica a tarjetas sin interés.</p>
                        </div>
                    </div>
                </section>
                </div>

                <!-- Panel: Crédito personal -->
                <div data-prod-edit-panel="credito" role="tabpanel" class="hidden">
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Crédito personal</h3>
                    </div>
                    <p class="text-xs text-slate-400 mb-4">
                        <strong class="text-slate-300">Recargo total:</strong> este porcentaje se agrega
                        una sola vez al saldo financiado. Elegí el estado de este producto:
                    </p>
                    <input type="hidden" id="prod-edit-credito-admite" name="CreditoPersonal.AdmiteCreditoPersonal" data-cp-admite-hidden value="true" />
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4" role="radiogroup" aria-label="Estado de Crédito Personal">
                        <label class="flex items-start gap-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3 cursor-pointer">
                            <input type="radio" name="CreditoPersonal.Modo" value="HeredaGlobal" data-cp-modo class="mt-0.5" checked />
                            <span>
                                <span class="block text-sm font-semibold text-white">Hereda global</span>
                                <span class="block text-xs text-slate-400">Usa los planes de Configuración de Pagos.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3 cursor-pointer">
                            <input type="radio" name="CreditoPersonal.Modo" value="ConfiguracionPropia" data-cp-modo class="mt-0.5" />
                            <span>
                                <span class="block text-sm font-semibold text-white">Planes propios</span>
                                <span class="block text-xs text-slate-400">Elegí qué cantidades de cuotas ofrece este producto. El recargo de cada una lo fija siempre el plan global.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3 cursor-pointer">
                            <input type="radio" name="CreditoPersonal.Modo" value="NoDisponible" data-cp-modo class="mt-0.5" />
                            <span>
                                <span class="block text-sm font-semibold text-white">No disponible</span>
                                <span class="block text-xs text-slate-400">Bloquea Crédito Personal para este producto.</span>
                            </span>
                        </label>
                    </div>
                    <div class="inv-campo" data-cp-maxcuotas-wrap>
                        <label for="prod-edit-credito-maxcuotas" class="inv-campo__etiqueta">Máx. cuotas crédito personal</label>
                        <input id="prod-edit-credito-maxcuotas" name="CreditoPersonal.MaxCuotasCredito" type="number" min="1" max="120" step="1"
                               class="inv-control inv-control--corto"
                               placeholder="Sin restricción" />
                        <span data-valmsg-for="CreditoPersonal.MaxCuotasCredito" class="text-xs text-red-500 hidden"></span>
                        <p class="text-xs text-slate-500">Vacío = sin límite propio; aplica el rango global o del plan.</p>
                    </div>
                    <div class="mt-6 space-y-2" data-cp-cards-wrap>
                        <p class="inv-campo__etiqueta">Planes de cuotas propios</p>
                        <p class="text-xs text-slate-400">
                            Activá las cantidades permitidas para este producto. El recargo de cada una es el
                            del plan global vigente (no editable acá); las filas inactivas no se aplican y si
                            no activás ninguna, hereda la global.
                        </p>
                        <div id="prod-edit-credito-cards" data-cp-cards-cont class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-2"></div>
                    </div>
                </section>
                </div>

                <!-- Panel: Características -->
                <div data-prod-edit-panel="caracteristicas" role="tabpanel" class="hidden">
                <!-- Características -->
                <section>
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <h3 class="inv-panel__titulo">Características</h3>
                        </div>
                        <span id="prod-edit-caracteristicas-count" class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-300">0 cargadas</span>
                    </div>
                    <div class="overflow-hidden rounded-lg border border-slate-800">
                        <table class="w-full border-collapse text-left text-sm">
                            <thead class="bg-slate-800/50">
                                <tr>
                                    <th class="px-4 py-3 font-semibold text-slate-300">Característica</th>
                                    <th class="px-4 py-3 font-semibold text-slate-300">Valor</th>
                                    <th class="px-4 py-3 w-16 text-center font-semibold text-slate-300"></th>
                                </tr>
                            </thead>
                            <tbody id="prod-edit-caracteristicas-body" class="divide-y divide-slate-800"></tbody>
                            <tfoot>
                                <tr class="bg-slate-900/30 border-t border-slate-800">
                                    <td class="px-4 py-2">
                                        <input id="prod-edit-caract-nombre" type="text" aria-label="Nueva característica" class="w-full border-none bg-transparent text-xs text-white placeholder-slate-500 focus:ring-0 outline-none" placeholder="Nueva característica" />
                                    </td>
                                    <td class="px-4 py-2">
                                        <input id="prod-edit-caract-valor" type="text" aria-label="Valor de la nueva característica" class="w-full border-none bg-transparent text-xs text-white placeholder-slate-500 focus:ring-0 outline-none" placeholder="Valor" />
                                    </td>
                                    <td class="px-4 py-2 text-center">
                                        <button type="button" data-prod-edit-add-caract aria-label="Agregar característica" class="inline-flex items-center justify-center rounded bg-primary/20 text-primary hover:bg-primary/30 transition-colors w-7 h-7">
                                            <span class="material-symbols-outlined text-sm">add</span>
                                        </button>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
                </div>

                <!-- Panel: Stock -->
                <div data-prod-edit-panel="stock" role="tabpanel" class="hidden">
                <!-- Stock & Estado -->
                <section>
                    <div class="inv-seccion">
                        <h3 class="inv-panel__titulo">Stock &amp; Estado</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="inv-campo">
                                <label for="prod-edit-stockActual" class="inv-campo__etiqueta">Stock Actual</label>
                                <input id="prod-edit-stockActual" name="StockActual" type="number" min="0" step="1" readonly tabindex="-1" aria-describedby="prod-edit-stockActual-hint" class="inv-control inv-control--solo-lectura" />
                                <p id="prod-edit-stockActual-hint" class="text-[11px] text-slate-500">Solo lectura. Se modifica desde Movimientos de stock.</p>
                            </div>
                            <div class="inv-campo">
                                <label for="prod-edit-stockMinimo" class="inv-campo__etiqueta">Stock Mínimo</label>
                                <input id="prod-edit-stockMinimo" name="StockMinimo" type="number" min="0" step="1" class="inv-control" />
                            </div>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-slate-800/30 rounded-lg border border-slate-800">
                            <div>
                                <p class="text-sm font-bold text-white">Producto Activo</p>
                                <p class="text-xs text-slate-400">Habilitar este producto para la venta</p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input id="prod-edit-activo" name="Activo" type="checkbox" value="true" aria-label="Producto activo" class="sr-only peer" />
                                @* H-34: un checkbox desmarcado no se envía y el modelo asume Activo=true; el hidden va DESPUÉS (el binder toma el primer valor). *@
                                <input type="hidden" name="Activo" value="false" />
                                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-colors peer-checked:bg-primary"></div>
                            </label>
                        </div>
                    </div>
                </section>
                </div>

            </div>

            <footer class="grid gap-3 border-t border-slate-800 bg-slate-900/50 px-6 py-4 sm:flex sm:items-center sm:justify-end">
                <button type="button" data-prod-edit-modal-close class="inv-btn inv-btn--ghost">
                    Cancelar
                </button>
                <button type="submit" id="btn-guardar-producto-edit" class="inv-btn inv-btn--primary">
                    <span class="material-symbols-outlined text-base">save</span>
                    Guardar Cambios
                </button>
            </footer>
        </form>
    </div>
</dialog>
