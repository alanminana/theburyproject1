<!-- Modal: Movimientos de Inventario                                 -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<dialog id="modal-movimientos" class="inv-dialog inv-dialog--tabla" aria-labelledby="modal-movimientos-title">
    <div class="inv-dialog__panel inv-dialog__panel--scroll">

        <!-- Modal Header -->
        <div class="flex flex-wrap justify-between items-start gap-4 p-6 pb-0">
            <div class="flex flex-col gap-1">
                <h2 id="modal-movimientos-title" class="text-white text-3xl font-black leading-tight tracking-tight">Movimientos de Inventario</h2>
                <p class="text-slate-400 text-base font-normal">Historial completo de entradas, salidas y ajustes de stock.</p>
            </div>
            <button type="button" id="btn-cerrar-movimientos"
                    class="flex items-center justify-center gap-2 rounded-lg h-10 px-4 bg-slate-800 text-white text-sm font-bold transition-colors hover:bg-slate-700">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                <span>Cerrar</span>
            </button>
        </div>

        <!-- Banner: contexto de producto (visible solo al abrir desde fila) -->
        <div id="mov-producto-contexto" class="hidden mx-6 mt-4 items-center justify-between gap-4 rounded-xl border border-primary/30 bg-primary/5 px-5 py-3">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-primary">inventory_2</span>
                <div>
                    <p class="text-sm font-bold text-white">Filtrando por: <span id="mov-producto-nombre-label" class="text-primary"></span></p>
                    <p class="text-xs text-slate-400">Historial por producto/SKU. No identifica unidades físicas individuales.</p>
                </div>
            </div>
            <button type="button" id="btn-mov-ver-todos"
                    class="text-xs font-bold text-primary hover:text-primary/80 transition-colors whitespace-nowrap flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">list</span>
                Ver todos los movimientos
            </button>
        </div>

        <!-- Modal Body -->
        <div class="flex flex-col gap-6 p-6">

            <!-- Stats Summary -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="flex flex-col gap-2 rounded-xl p-6 border border-slate-800 bg-slate-900/50">
                    <p class="text-slate-400 text-sm font-medium">Total movimientos</p>
                    <div class="flex items-baseline gap-2">
                        <p class="text-white text-2xl font-bold" id="mov-stat-total">0</p>
                    </div>
                </div>
                <div class="flex flex-col gap-2 rounded-xl p-6 border border-slate-800 bg-slate-900/50">
                    <p class="text-slate-400 text-sm font-medium">Entradas (Unidades)</p>
                    <div class="flex items-baseline gap-2">
                        <p class="text-white text-2xl font-bold" id="mov-stat-entradas">0</p>
                    </div>
                </div>
                <div class="flex flex-col gap-2 rounded-xl p-6 border border-slate-800 bg-slate-900/50">
                    <p class="text-slate-400 text-sm font-medium">Salidas (Unidades)</p>
                    <div class="flex items-baseline gap-2">
                        <p class="text-white text-2xl font-bold" id="mov-stat-salidas">0</p>
                    </div>
                </div>
                <div class="flex flex-col gap-2 rounded-xl p-6 border border-slate-800 bg-slate-900/50">
                    <p class="text-slate-400 text-sm font-medium">Ajustes</p>
                    <div class="flex items-baseline gap-2">
                        <p class="text-white text-2xl font-bold" id="mov-stat-ajustes">0</p>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
                <h3 class="text-white text-lg font-bold mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined">filter_list</span>
                    Filtros de Búsqueda
                    <span id="mov-filtros-badge" class="hidden items-center rounded-full bg-primary px-2.5 py-0.5 text-xs font-bold text-white"></span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="mov-fecha-desde" class="text-sm font-medium text-slate-400">Rango de Fechas</label>
                        <div class="flex items-center gap-2">
                            <input id="mov-fecha-desde" aria-label="Fecha desde" type="date" class="w-full rounded-lg bg-slate-800 border-none text-sm focus:ring-2 focus:ring-primary text-white" />
                            <span class="text-slate-400">-</span>
                            <input id="mov-fecha-hasta" aria-label="Fecha hasta" type="date" class="w-full rounded-lg bg-slate-800 border-none text-sm focus:ring-2 focus:ring-primary text-white" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="mov-tipo" class="text-sm font-medium text-slate-400">Tipo de Movimiento</label>
                        <select id="mov-tipo" class="w-full rounded-lg bg-slate-800 border-none text-sm focus:ring-2 focus:ring-primary text-white">
                            <option value="">Todos los tipos</option>
                            <option value="Entrada">Entrada</option>
                            <option value="Salida">Salida</option>
                            <option value="Ajuste">Ajuste</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="mov-producto" class="text-sm font-medium text-slate-400">Producto (SKU/Nombre)</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                            <input id="mov-producto" type="text" class="w-full pl-10 rounded-lg bg-slate-800 border-none text-sm focus:ring-2 focus:ring-primary text-white" placeholder="Ej: CPU-001..." />
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="mov-fuente-costo" class="text-sm font-medium text-slate-400">Fuente de Costo</label>
                        <select id="mov-fuente-costo" class="w-full rounded-lg bg-slate-800 border-none text-sm focus:ring-2 focus:ring-primary text-white">
                            <option value="">Todas las fuentes</option>
                            <option value="VentaDetalleSnapshot">Venta</option>
                            <option value="OrdenCompraDetalle">Orden de compra</option>
                            <option value="ProductoActual">Costo actual del producto</option>
                            <option value="AjusteManual">Ajuste manual</option>
                            <option value="Legacy">Histórico migrado</option>
                            <option value="NoInformado">No informado</option>
                        </select>
                    </div>
                </div>
                <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-800">
                    <button type="button" id="btn-mov-limpiar" class="px-4 py-2 text-sm font-bold text-slate-400 hover:text-white transition-colors">Limpiar</button>
                    <button type="button" id="btn-mov-buscar" class="px-6 py-2 rounded-lg bg-primary text-white text-sm font-bold hover:bg-primary/90 transition-colors">Buscar Movimientos</button>
                </div>
            </div>

            <!-- Actions Bar -->
            <div class="flex justify-between items-center px-2">
                <p class="text-sm text-slate-400">Mostrando <span class="font-bold text-white" id="mov-count-showing">0</span> de <span class="font-bold text-white" id="mov-count-total">0</span> movimientos<span id="mov-count-context" class="hidden text-slate-500"></span></p>
                <div class="flex gap-2">
                </div>
            </div>

            <!-- Movements Table -->
            <div data-oc-scroll class="relative">
                <div data-oc-scroll-fade="left" hidden class="absolute inset-y-0 left-0 z-10 w-6 rounded-l-xl" style="background:linear-gradient(to right,var(--pal-neutral-925),transparent);pointer-events:none;"></div>
                <div data-oc-scroll-fade="right" hidden class="absolute inset-y-0 right-0 z-10 w-6 rounded-r-xl" style="background:linear-gradient(to left,var(--pal-neutral-925),transparent);pointer-events:none;"></div>
                <div data-oc-scroll-region class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/50" tabindex="0" role="region" aria-label="Tabla de movimientos de inventario">
                <table data-erp-cards class="w-full text-left border-collapse" style="min-width:1180px;">
                    <thead>
                        <tr class="border-b border-slate-800 bg-slate-800/30">
                            <th data-card="half" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Fecha/Hora</th>
                            <th data-card="half" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Tipo</th>
                            <th data-card="title" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Producto</th>
                            <th data-card="third" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Cant.</th>
                            <th data-card="third" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Costo unitario</th>
                            <th data-card="third" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Costo total</th>
                            <th data-card="half" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300 cursor-help" title="Origen usado para valuar el costo del movimiento.">Fuente costo</th>
                            <th data-card="half" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Referencia</th>
                            <th data-card="half" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Usuario</th>
                            <th data-card="half" scope="col" class="px-4 py-4 text-sm font-bold text-slate-300">Saldo Post.</th>
                            <th scope="col" class="px-4 py-4 text-sm font-bold text-slate-300 text-right">Acción</th>
                        </tr>
                    </thead>
                    <tbody id="mov-tbody" class="divide-y divide-slate-800">
                        <!-- Rows populated by JS or empty state -->
                        <tr id="mov-empty-state">
                            <td colspan="11" class="py-16 text-center">
                                <div class="flex flex-col items-center gap-2 opacity-40">
                                    <span class="material-symbols-outlined text-4xl">swap_vert</span>
                                    <p class="text-slate-400 text-base">No hay movimientos para mostrar</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                </div><!-- /data-oc-scroll-region -->
            </div><!-- /data-oc-scroll -->

            <!-- Pagination -->
            <div class="flex items-center justify-between border-t border-slate-800 pt-6">
                <div class="flex items-center gap-2">
                    <span class="text-sm text-slate-400">Filas por página:</span>
                    <select id="mov-page-size" aria-label="Filas por página" class="bg-transparent border-none text-sm font-bold focus:ring-0 text-white">
                        <option>25</option>
                        <option>50</option>
                        <option>100</option>
                    </select>
                </div>
                <div class="flex items-center gap-1" id="mov-pagination">
                    <!-- Pagination rendered by JS -->
                </div>
            </div>
        </div>
    </div>
</dialog>
