@model ClienteViewModel
@{
    ViewData["Title"] = "Nuevo Cliente";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@section Styles {
    <partial name="_ClienteModuleStyles" />
}

<div class="shell" style="padding-top:1.5rem;padding-bottom:3rem">
    @if (!string.IsNullOrWhiteSpace(returnUrl))
    {
        <a href="@returnUrl" data-cliente-cancel class="inline-flex items-center gap-1.5 text-sm muted hover:text-white transition" style="text-decoration:none">
            <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>Volver a clientes
        </a>
    }
    else
    {
        <a asp-action="Index" data-cliente-cancel class="inline-flex items-center gap-1.5 text-sm muted hover:text-white transition" style="text-decoration:none">
            <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>Volver a clientes
        </a>
    }

    <div class="page-head" style="margin-top:.85rem">
        <div class="min-w-0">
            <h1 class="page-title">Nuevo cliente</h1>
            <p class="page-sub">Registrá un cliente con sus datos personales, de contacto y laborales. La aptitud crediticia se evalúa luego de guardar.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4" style="margin-top:1.5rem">
        <form id="clienteForm" asp-action="Create" method="post" novalidate class="lg:col-span-2 card" style="overflow:hidden">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }

            <partial name="_ClienteFormCampos" model="Model" />

            <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-2 card-pad" style="border-top:1px solid var(--line);background:color-mix(in srgb, var(--pal-neutral-950) 40%, transparent)">
                <div class="text-xs muted-2 flex items-center gap-1.5 mr-auto"><span class="material-symbols-outlined" style="font-size:16px">lock</span>Los datos se guardan de forma segura.</div>
                <div class="flex gap-2 w-full sm:w-auto">
                    @if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        <a href="@returnUrl" data-cliente-cancel class="btn btn-ghost flex-1 sm:flex-none">Cancelar</a>
                    }
                    else
                    {
                        <a asp-action="Index" data-cliente-cancel class="btn btn-ghost flex-1 sm:flex-none">Cancelar</a>
                    }
                    <button type="submit" class="btn btn-primary flex-1 sm:flex-none"><span class="material-symbols-outlined">person_add</span>Crear cliente</button>
                </div>
            </div>
        </form>

        <aside class="space-y-4">
            <div class="card card-pad">
                <div class="text-xs uppercase tracking-wide muted-2 font-semibold mb-3">Resumen</div>
                <div class="flex items-center gap-3 mb-4">
                    <div class="avatar avatar-lg" id="pv-avatar">+</div>
                    <div class="min-w-0"><div class="font-semibold text-white" id="pv-name">Nuevo cliente</div><div class="mono text-xs muted-2" id="pv-doc">-</div></div>
                </div>
                <dl class="kv">
                    <div class="kv-row"><dt>Estado inicial</dt><dd><span class="chip chip-ok">Activo</span></dd></div>
                    <div class="kv-row"><dt>Aptitud</dt><dd><span class="chip chip-neutral">Sin evaluar</span></dd></div>
                    <div class="kv-row"><dt>Límite</dt><dd class="num">Por puntaje</dd></div>
                </dl>
            </div>
            <div class="card card-pad">
                <div class="flex items-center gap-2 mb-3"><span class="material-symbols-outlined" style="color:var(--pal-accent);font-size:20px">tips_and_updates</span><h3 class="font-semibold text-white">Recordá</h3></div>
                <ul class="help-list">
                    <li><span class="material-symbols-outlined">call</span>Teléfono y domicilio (solapa Contacto) son obligatorios.</li>
                    <li><span class="material-symbols-outlined">badge</span>El documento y CUIL/CUIT deben ser únicos por cliente.</li>
                    <li><span class="material-symbols-outlined">gpp_good</span>La situación BCRA se consulta al evaluar la aptitud.</li>
                    <li><span class="material-symbols-outlined">folder_shared</span>La documentación se carga luego, desde el legajo.</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cliente-cuil.js" asp-append-version="true"></script>
    <script src="~/js/cliente-form.js" asp-append-version="true"></script>
}
