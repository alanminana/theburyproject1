@model ClienteViewModel
@{
    ViewData["Title"] = "Editar Cliente";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var nombreResumen = string.IsNullOrWhiteSpace(Model.NombreCompleto)
        ? $"{Model.Apellido}, {Model.Nombre}".Trim(' ', ',')
        : Model.NombreCompleto;
    var nivelRiesgo = Model.NivelRiesgo.ToString();
    var chipRiesgo = nivelRiesgo.Contains("Rechazado")
        ? "chip-bad"
        : nivelRiesgo.Contains("Condicional") || nivelRiesgo.Contains("Limitado")
            ? "chip-warn"
            : "chip-ok";
}

@section Styles {
    <partial name="_ClienteModuleStyles" />
}

<div class="shell" style="padding-top:1.5rem;padding-bottom:3rem">
    @if (!string.IsNullOrWhiteSpace(returnUrl))
    {
        <a href="@returnUrl" data-cliente-cancel class="inline-flex items-center gap-1.5 text-sm muted hover:text-white transition" style="text-decoration:none">
            <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>Volver al legajo
        </a>
    }
    else
    {
        <a asp-action="Details" asp-route-id="@Model.Id" data-cliente-cancel class="inline-flex items-center gap-1.5 text-sm muted hover:text-white transition" style="text-decoration:none">
            <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>Volver al legajo
        </a>
    }

    <div class="page-head" style="margin-top:.85rem">
        <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <h1 class="page-title">Editar cliente</h1>
                <span class="chip @chipRiesgo"><span class="material-symbols-outlined">verified</span>@nivelRiesgo</span>
            </div>
            <p class="page-sub">Modificá los datos de <strong>@nombreResumen</strong>. Las métricas crediticias se preservan y no se editan manualmente.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4" style="margin-top:1.5rem">
        <form id="clienteForm" asp-action="Edit" method="post" novalidate class="lg:col-span-2 card" style="overflow:hidden">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RowVersion" />
            <input type="hidden" asp-for="NombreCompleto" />
            <input type="hidden" asp-for="PuntajeRiesgo" />
            <input type="hidden" asp-for="NivelRiesgo" />
            <input type="hidden" asp-for="CreditosTotales" />
            <input type="hidden" asp-for="CreditosActivos" />
            <input type="hidden" asp-for="CuotasImpagas" />
            <input type="hidden" asp-for="MontoAdeudado" />
            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }

            <partial name="_ClienteFormCampos" model="Model" />

            <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-2 card-pad" style="border-top:1px solid var(--line);background:rgba(8,12,22,.4)">
                <div class="text-xs muted-2 flex items-center gap-1.5 mr-auto"><span class="material-symbols-outlined" style="font-size:16px">lock</span>Los datos se guardan de forma segura.</div>
                <div class="flex gap-2 w-full sm:w-auto">
                    @if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        <a href="@returnUrl" data-cliente-cancel class="btn btn-ghost flex-1 sm:flex-none">Cancelar</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@Model.Id" data-cliente-cancel class="btn btn-ghost flex-1 sm:flex-none">Cancelar</a>
                    }
                    <button type="submit" class="btn btn-primary flex-1 sm:flex-none"><span class="material-symbols-outlined">save</span>Guardar cambios</button>
                </div>
            </div>
        </form>

        <aside class="space-y-4">
            <div class="card card-pad">
                <div class="text-xs uppercase tracking-wide muted-2 font-semibold mb-3">Resumen</div>
                <div class="flex items-center gap-3 mb-4">
                    <div class="avatar avatar-lg" id="pv-avatar">@($"{Model.Apellido?.FirstOrDefault()}{Model.Nombre?.FirstOrDefault()}".ToUpperInvariant())</div>
                    <div class="min-w-0"><div class="font-semibold text-white" id="pv-name">@nombreResumen</div><div class="mono text-xs muted-2" id="pv-doc">@Model.NumeroDocumento</div></div>
                </div>
                <dl class="kv">
                    <div class="kv-row"><dt>Estado</dt><dd><span class="chip @(Model.Activo ? "chip-ok" : "chip-neutral")">@(Model.Activo ? "Activo" : "Inactivo")</span></dd></div>
                    <div class="kv-row"><dt>Aptitud</dt><dd><span class="chip @chipRiesgo">@nivelRiesgo</span></dd></div>
                    <div class="kv-row"><dt>Score</dt><dd class="num">@Model.PuntajeRiesgo</dd></div>
                    <div class="kv-row"><dt>Créditos activos</dt><dd class="num">@Model.CreditosActivos</dd></div>
                    <div class="kv-row"><dt>Monto adeudado</dt><dd class="num">@((Model.MontoAdeudado ?? 0m).ToString("C"))</dd></div>
                </dl>
            </div>
            <div class="card card-pad">
                <div class="flex items-center gap-2 mb-3"><span class="material-symbols-outlined" style="color:#fbbf24;font-size:20px">shield_lock</span><h3 class="font-semibold text-white">Datos preservados</h3></div>
                <p class="text-sm muted leading-relaxed">Las métricas crediticias, puntaje, nivel de riesgo, créditos, cuotas impagas y monto adeudado se mantienen y no se editan desde este formulario.</p>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cliente-cuil.js" asp-append-version="true"></script>
    <script src="~/js/cliente-form.js" asp-append-version="true"></script>
}
