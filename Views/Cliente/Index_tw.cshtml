@model ClienteFilterViewModel
@{
    ViewData["Title"] = "Gestión de Clientes";
    ViewData["MetaDescription"] = "Administración de clientes, límites de crédito y documentación asociada en el ERP TheBuryProject.";

    var clientes = Model.Clientes?.ToList() ?? new List<ClienteViewModel>();
    var totalEnPagina = clientes.Count;
    var errorCarga = ViewBag.ErrorCarga is true;
    var puedeEditar = ViewBag.PuedeEditarClientes is true;
    var puedeEliminar = ViewBag.PuedeEliminarClientes is true;

    var filtroClienteActivo = !string.IsNullOrWhiteSpace(Model.SearchTerm)
                            || Model.SoloActivos.HasValue
                            || !string.IsNullOrWhiteSpace(Model.TipoDocumento)
                            || !string.IsNullOrWhiteSpace(Model.NivelRiesgoFiltro);

    string ClienteNombre(ClienteViewModel cliente)
    {
        if (!string.IsNullOrWhiteSpace(cliente.NombreCompleto))
        {
            return cliente.NombreCompleto;
        }

        return $"{cliente.Apellido}, {cliente.Nombre}".Trim(' ', ',');
    }

    // Única fuente de verdad para la franja de riesgo (bajo/medio/alto): la misma que usa
    // el filtro "Riesgo" server-side (ClienteHelper.ClasificarRiesgo / NivelesRiesgoDeBucket),
    // para que el chip de cada fila nunca pueda contradecir lo que el filtro seleccionó.
    string RiesgoBucket(ClienteViewModel cliente) => ClienteHelper.ClasificarRiesgo(cliente.NivelRiesgo);

    string RiesgoTexto(ClienteViewModel cliente) => RiesgoBucket(cliente) switch
    {
        "alto" => "Alto",
        "medio" => "Medio",
        _ => "Bajo"
    };

    // badge-erp-* (shared-components.css) — convergencia ERP-UI-STANDARD §12.1: mismo
    // cálculo y textos, solo cambia el componente visual (antes .chip-* local).
    string RiesgoChip(ClienteViewModel cliente) => RiesgoBucket(cliente) switch
    {
        "alto" => "badge-erp badge-erp-danger",
        "medio" => "badge-erp badge-erp-warning",
        _ => "badge-erp badge-erp-success"
    };

    string RiesgoIcon(ClienteViewModel cliente) => RiesgoBucket(cliente) switch
    {
        "alto" => "block",
        "medio" => "gpp_maybe",
        _ => "verified"
    };

    int RiesgoPct(ClienteViewModel cliente)
    {
        if (cliente.PuntajeRiesgo <= 0) return 0;

        return Math.Clamp(
            (int)Math.Round((double)cliente.PuntajeRiesgo * 10, MidpointRounding.AwayFromZero),
            0,
            100
        );
    }

    string TextoRiesgoFiltro(string bucket) => bucket switch
    {
        "bajo" => "Bajo",
        "medio" => "Medio",
        "alto" => "Alto",
        _ => bucket
    };

    // ── Helpers de querystring: filtros vigentes menos uno (chips removibles) y orden ──
    Dictionary<string, string> RutaFiltros(string? campoExcluido = null)
    {
        var dict = new Dictionary<string, string>();

        if (!string.IsNullOrWhiteSpace(Model.SearchTerm) && campoExcluido != "SearchTerm")
            dict["SearchTerm"] = Model.SearchTerm;

        if (Model.SoloActivos.HasValue && campoExcluido != "SoloActivos")
            dict["SoloActivos"] = Model.SoloActivos.Value.ToString();

        if (!string.IsNullOrWhiteSpace(Model.TipoDocumento) && campoExcluido != "TipoDocumento")
            dict["TipoDocumento"] = Model.TipoDocumento;

        if (!string.IsNullOrWhiteSpace(Model.NivelRiesgoFiltro) && campoExcluido != "NivelRiesgoFiltro")
            dict["NivelRiesgoFiltro"] = Model.NivelRiesgoFiltro;

        if (Model.PageSize != 25)
            dict["PageSize"] = Model.PageSize.ToString();

        return dict;
    }

    Dictionary<string, string> RutaOrden(string campo)
    {
        var dict = RutaFiltros();
        dict["OrderBy"] = campo;
        dict["OrderDirection"] = (Model.OrderBy == campo && Model.OrderDirection != "desc") ? "desc" : "asc";
        return dict;
    }

    Dictionary<string, string> RutaPagina(int pagina)
    {
        var dict = RutaFiltros();
        if (!string.IsNullOrWhiteSpace(Model.OrderBy)) dict["OrderBy"] = Model.OrderBy;
        if (!string.IsNullOrWhiteSpace(Model.OrderDirection)) dict["OrderDirection"] = Model.OrderDirection;
        dict["PageNumber"] = pagina.ToString();
        return dict;
    }

    string IconoOrden(string campo) => Model.OrderBy != campo
        ? "unfold_more"
        : (Model.OrderDirection == "desc" ? "arrow_downward" : "arrow_upward");

    List<int> VentanaPaginas(int actual, int total)
    {
        var numeros = new List<int>();
        if (total <= 0) return numeros;

        if (total <= 7)
        {
            for (var p = 1; p <= total; p++) numeros.Add(p);
            return numeros;
        }

        const int elipsis = -1;
        numeros.Add(1);

        var inicio = Math.Max(2, actual - 1);
        var fin = Math.Min(total - 1, actual + 1);

        if (inicio > 2) numeros.Add(elipsis);
        for (var p = inicio; p <= fin; p++) numeros.Add(p);
        if (fin < total - 1) numeros.Add(elipsis);

        numeros.Add(total);
        return numeros;
    }

    var totalPaginas = Model.PageSize > 0 && Model.TotalResultados > 0
        ? (int)Math.Ceiling(Model.TotalResultados / (double)Model.PageSize)
        : 0;
    var primerRegistro = Model.TotalResultados == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var ultimoRegistro = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalResultados);
}

@section Styles {
    <partial name="_ClienteModuleStyles" />
}

@if (TempData["Success"] != null || TempData["Error"] != null)
{
    <div id="clienteIndexFeedback" class="shell cliente-feedback" role="alert" aria-live="polite">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-ok">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                <span class="flex-1 self-center">@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-bad">
                <span class="material-symbols-outlined" aria-hidden="true">error</span>
                <span class="flex-1 self-center">@TempData["Error"]</span>
            </div>
        }
    </div>
}
else
{
    <div id="clienteIndexFeedback" class="hidden shell cliente-feedback" role="alert" aria-live="polite"></div>
}

<div class="shell cliente-index">
    <!-- Header de página (ERP-UI-STANDARD §4, patrón sin hero — ver Catálogo/Index_tw.cshtml):
         sin card de título propio; el título ya aparece en la barra superior global
         (_Layout.cshtml). Las acciones principales se integran como toolbar del mismo card
         de contenido, junto a "Listado de clientes". -->

    @if (errorCarga)
    {
        <section class="cliente-section" aria-labelledby="cliente-list-title">
            <h2 id="cliente-list-title" class="sr-only">Listado de clientes</h2>

            <div class="card cliente-empty-card" role="alert" data-cliente-error-carga>
                <div class="empty">
                    <div class="empty-ic">
                        <span class="material-symbols-outlined" aria-hidden="true">cloud_off</span>
                    </div>

                    <h3>No pudimos cargar los clientes</h3>
                    <p>Ocurrió un error al consultar el listado. Probá de nuevo en unos segundos.</p>

                    <a asp-action="Index" class="btn btn-soft btn-sm empty-action">
                        <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
                        Reintentar
                    </a>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="cliente-section" aria-labelledby="cliente-list-title">

            @* ============================================================
           ACCIONES (patrón sin hero — mismo card que el contenido)
           ============================================================ *@
            <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:justify-end mb-3 cliente-head-actions"
                 aria-label="Acciones principales de clientes">
                <button type="button" class="btn-erp-primary btn-sm w-full sm:w-auto" data-cliente-modal-open="create">
                    <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
                    Nuevo cliente
                </button>

                @* Documentos/Créditos/Límites por puntaje no son acciones primarias de ESTA
                   pantalla (pertenecen a otros módulos) — quedan disponibles sin competir
                   visualmente con "Nuevo cliente". *@
                <details class="cliente-more-menu relative" data-cliente-row-menu>
                    <summary class="btn-erp-ghost btn-sm cursor-pointer w-full sm:w-auto" aria-label="Más acciones de clientes"
                             title="Más acciones de clientes">
                        <span class="material-symbols-outlined" aria-hidden="true">more_horiz</span>
                        Más
                    </summary>

                    <div class="cliente-more-menu__content cliente-row-menu__content">
                        <a asp-controller="DocumentoCliente" asp-action="Index" class="cliente-row-menu__item">
                            <span class="material-symbols-outlined" aria-hidden="true">folder_shared</span>
                            Documentos
                        </a>

                        <a asp-controller="Credito" asp-action="Index" class="cliente-row-menu__item">
                            <span class="material-symbols-outlined" aria-hidden="true">credit_score</span>
                            Créditos
                        </a>

                        <button type="button" class="cliente-row-menu__item" data-cliente-open-limites>
                            <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                            Límites por puntaje
                        </button>
                    </div>
                </details>
            </div>

            @* ============================================================
           CABECERA
           ============================================================ *@
            <div class="cliente-list-head">
                <div class="cliente-list-title">
                    <h2 id="cliente-list-title" class="sec-title">
                        Listado de clientes
                    </h2>
                </div>

                <span id="result-count" class="cliente-result-summary" aria-live="polite">
                    @if (Model.TotalResultados == 0)
                    {
                        @:0 clientes
                    }
                    else
                    {
                        @:Mostrando @primerRegistro–@ultimoRegistro de @Model.TotalResultados @(Model.TotalResultados == 1 ? "cliente" : "clientes")
                    }
                </span>
            </div>

            @* ============================================================
           FILTROS (se aplican automáticamente, sin botón "Filtrar")
           ============================================================ *@
            <form id="cliente-filter-form" method="get" asp-action="Index" class="filter-panel-erp cliente-filters"
                  role="search" aria-label="Buscar y filtrar clientes">

                @* PageNumber deliberadamente fuera del form: cambiar cualquier filtro
                   vuelve a la página 1 (ERP-UI-STANDARD §9). *@

                @* BÚSQUEDA *@
                <div class="cliente-filter-field cliente-filter-search">
                    <label for="cliente-search-input" class="cliente-filter-label">
                        Buscar cliente
                    </label>

                    <div class="cliente-search-control">
                        <span class="material-symbols-outlined cliente-search-control__icon" aria-hidden="true">
                            search
                        </span>

                        <input id="cliente-search-input" name="SearchTerm" value="@Model.SearchTerm" type="search"
                               class="filter-input-erp cliente-search-control__input"
                               placeholder="Nombre, DNI, CUIT, teléfono o email..."
                               autocomplete="off" data-cliente-autosubmit="debounce" />
                    </div>
                </div>

                @* ESTADO *@
                <div class="cliente-filter-field">
                    <label for="cliente-filter-estado" class="cliente-filter-label">
                        Estado
                    </label>

                    <select id="cliente-filter-estado" name="SoloActivos" class="filter-select-erp cliente-filter-select"
                            data-cliente-autosubmit="change">

                        <option value="">Todos</option>

                        @if (Model.SoloActivos == true)
                        {
                            <option value="true" selected>Activo</option>
                        }
                        else
                        {
                            <option value="true">Activo</option>
                        }

                        @if (Model.SoloActivos == false)
                        {
                            <option value="false" selected>Inactivo</option>
                        }
                        else
                        {
                            <option value="false">Inactivo</option>
                        }
                    </select>
                </div>

                @* RIESGO *@
                <div class="cliente-filter-field">
                    <label for="cliente-filter-riesgo" class="cliente-filter-label">
                        Riesgo
                    </label>

                    <select id="cliente-filter-riesgo" name="NivelRiesgoFiltro" class="filter-select-erp cliente-filter-select"
                            data-cliente-autosubmit="change">

                        <option value="">Todos</option>

                        @foreach (var bucket in new[] { "bajo", "medio", "alto" })
                        {
                            if (Model.NivelRiesgoFiltro == bucket)
                            {
                                <option value="@bucket" selected>@TextoRiesgoFiltro(bucket)</option>
                            }
                            else
                            {
                                <option value="@bucket">@TextoRiesgoFiltro(bucket)</option>
                            }
                        }
                    </select>
                </div>

                @* TIPO DE DOCUMENTO *@
                <div class="cliente-filter-field">
                    <label for="cliente-filter-documento" class="cliente-filter-label">
                        Tipo de documento
                    </label>

                    <select id="cliente-filter-documento" name="TipoDocumento" class="filter-select-erp cliente-filter-select"
                            data-cliente-autosubmit="change">

                        @if (string.IsNullOrWhiteSpace(Model.TipoDocumento))
                        {
                            <option value="" selected>Todos</option>
                        }
                        else
                        {
                            <option value="">Todos</option>
                        }

                        @if (ViewBag.TiposDocumento != null)
                        {
                            foreach (var tipo in (SelectList)ViewBag.TiposDocumento)
                            {
                                var tipoValue = string.IsNullOrWhiteSpace(tipo.Value)
                                    ? tipo.Text
                                    : tipo.Value;

                                if (Model.TipoDocumento == tipoValue)
                                {
                                    <option value="@tipoValue" selected>@tipo.Text</option>
                                }
                                else
                                {
                                    <option value="@tipoValue">@tipo.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                @* TAMAÑO DE PÁGINA *@
                <div class="cliente-filter-field cliente-filter-pagesize">
                    <label for="cliente-filter-pagesize" class="cliente-filter-label">
                        Mostrar
                    </label>

                    <select id="cliente-filter-pagesize" name="PageSize" class="filter-select-erp cliente-filter-select"
                            data-cliente-autosubmit="change">

                        @foreach (var tam in new[] { 10, 25, 50, 100 })
                        {
                            if (Model.PageSize == tam)
                            {
                                <option value="@tam" selected>@tam</option>
                            }
                            else
                            {
                                <option value="@tam">@tam</option>
                            }
                        }
                    </select>
                </div>
            </form>

            @* ============================================================
           FILTROS ACTIVOS (chips removibles individualmente)
           ============================================================ *@
            @if (filtroClienteActivo)
            {
                <div class="cliente-filter-chips" aria-label="Filtros activos">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-action="Index" asp-all-route-data="@RutaFiltros("SearchTerm")"
                           class="chip chip-info chip-removable" aria-label="Quitar filtro de búsqueda">
                            Búsqueda: "@Model.SearchTerm"
                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                        </a>
                    }

                    @if (Model.SoloActivos.HasValue)
                    {
                        <a asp-action="Index" asp-all-route-data="@RutaFiltros("SoloActivos")"
                           class="chip chip-info chip-removable"
                           aria-label="Quitar filtro de estado @(Model.SoloActivos.Value ? "activo" : "inactivo")">
                            @(Model.SoloActivos.Value ? "Activo" : "Inactivo")
                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.NivelRiesgoFiltro))
                    {
                        <a asp-action="Index" asp-all-route-data="@RutaFiltros("NivelRiesgoFiltro")"
                           class="chip chip-info chip-removable" aria-label="Quitar filtro de riesgo">
                            Riesgo @TextoRiesgoFiltro(Model.NivelRiesgoFiltro)
                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.TipoDocumento))
                    {
                        <a asp-action="Index" asp-all-route-data="@RutaFiltros("TipoDocumento")"
                           class="chip chip-info chip-removable" aria-label="Quitar filtro de tipo de documento">
                            Documento: @Model.TipoDocumento
                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                        </a>
                    }

                    <a asp-action="Index" class="btn btn-ghost btn-sm cliente-filter-clear">
                        <span class="material-symbols-outlined" aria-hidden="true">close</span>
                        Limpiar filtros
                    </a>
                </div>
            }

            <p id="cliente-table-help" class="sr-only">
                Las acciones directas permiten ver el legajo y editar el cliente.
                Créditos y baja del cliente se encuentran dentro del menú Más acciones.
            </p>

            @* ============================================================
           TABLA DE ESCRITORIO
           ============================================================ *@
            @* --oc-scroll-min-width: mismo mecanismo que Views/Proveedor/Index_tw.cshtml
               (horizontal-scroll-affordance.css) — referencia --cliente-table-min
               (cliente-module.css) como única fuente de verdad en vez de duplicar el
               valor. Sin esto, el min-width de la tabla quedaba en "auto" (piso 0,
               confirmado en vivo) y la columna Acciones terminaba solapada con Estado
               por debajo de ~1300px. *@
            <div class="table-erp-wrapper cliente-table-card hide-mobile" data-oc-scroll
                 style="--oc-scroll-min-width: var(--cliente-table-min);">

                <div class="scroll-hint cliente-scroll-hint hide-mobile" data-oc-scroll-hint hidden>
                    <span class="material-symbols-outlined" aria-hidden="true">
                        swipe
                    </span>

                    Deslizá horizontalmente para ver crédito, riesgo y acciones.
                </div>

                <div data-oc-scroll-shell>

                    <div data-oc-scroll-fade="left" class="pointer-events-none" aria-hidden="true" hidden>
                    </div>

                    <div data-oc-scroll-fade="right" class="pointer-events-none" aria-hidden="true" hidden>
                    </div>

                    <div class="tbl-wrap" data-oc-scroll-region tabindex="0" role="region"
                         aria-label="Listado de clientes en tabla" aria-describedby="result-count cliente-table-help">

                        <table class="tbl cliente-table" data-oc-scroll-table>

                            <caption class="sr-only">
                                Listado de clientes
                            </caption>

                            <colgroup>
                                <col class="cliente-col-nombre" />
                                <col class="cliente-col-documento" />
                                <col class="cliente-col-contacto" />
                                <col class="cliente-col-credito" />
                                <col class="cliente-col-riesgo" />
                                <col class="cliente-col-estado cliente-estado-cell" />
                                <col class="cliente-col-acciones" />
                            </colgroup>

                            <thead>
                                <tr>
                                    <th scope="col">
                                        <a asp-action="Index" asp-all-route-data="@RutaOrden("nombre")" class="cliente-th-sort">
                                            Cliente
                                            <span class="material-symbols-outlined" aria-hidden="true">@IconoOrden("nombre")</span>
                                        </a>
                                    </th>

                                    <th scope="col">
                                        <a asp-action="Index" asp-all-route-data="@RutaOrden("documento")" class="cliente-th-sort">
                                            Documento
                                            <span class="material-symbols-outlined" aria-hidden="true">@IconoOrden("documento")</span>
                                        </a>
                                    </th>

                                    <th scope="col">
                                        Contacto
                                    </th>

                                    <th scope="col">
                                        Crédito
                                    </th>

                                    <th scope="col">
                                        <a asp-action="Index" asp-all-route-data="@RutaOrden("puntaje")" class="cliente-th-sort">
                                            Riesgo
                                            <span class="material-symbols-outlined" aria-hidden="true">@IconoOrden("puntaje")</span>
                                        </a>
                                    </th>

                                    <th scope="col" class="cliente-estado-cell">
                                        <a asp-action="Index" asp-all-route-data="@RutaOrden("activo")" class="cliente-th-sort">
                                            Estado
                                            <span class="material-symbols-outlined" aria-hidden="true">@IconoOrden("activo")</span>
                                        </a>
                                    </th>

                                    <th scope="col" class="text-right">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="clientes-body">

                                @if (clientes.Any())
                                {
                                    foreach (var c in clientes)
                                    {
                                        var pct = RiesgoPct(c);
                                        var estado = c.Activo ? "activo" : "inactivo";
                                        var rowName = ClienteNombre(c);

                                        var tieneTelefono =
                                            !string.IsNullOrWhiteSpace(c.Telefono);

                                        var tieneEmail =
                                            !string.IsNullOrWhiteSpace(c.Email);

                                        var telefono = tieneTelefono
                                            ? c.Telefono
                                            : "Sin teléfono";

                                        var email = tieneEmail
                                            ? c.Email
                                            : "Sin email";

                                        var tipoDocumento =
                                            string.IsNullOrWhiteSpace(c.TipoDocumento)
                                                ? "Documento"
                                                : c.TipoDocumento;

                                        var documentoPrincipal =
                                            string.IsNullOrWhiteSpace(c.NumeroDocumento)
                                                ? $"{tipoDocumento} sin número"
                                                : $"{tipoDocumento} {c.NumeroDocumento}";

                                        var tieneCuilCuit =
                                            !string.IsNullOrWhiteSpace(c.CuilCuit);

                                        <tr data-cliente-row-id="@c.Id" data-estado="@estado" data-tipodoc="@c.TipoDocumento">

                                            @* CLIENTE *@
                                            <th scope="row" class="text-left font-normal">
                                                <div class="cliente-name-cell" title="@rowName">
                                                    <div class="font-medium @(c.Activo ? "text-white" : "text-slate-400")">
                                                        @rowName
                                                    </div>
                                                </div>

                                                @* Solo en la banda estrecha (≈900–1366px): la columna Estado se oculta
                                                   para darle ancho a Cliente/Contacto y el estado pasa acá, bajo el nombre. *@
                                                <span class="badge-erp cliente-name-estado @(c.Activo ? "badge-erp-success" : "badge-erp-neutral")">
                                                    @(c.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </th>

                                            @* DOCUMENTO *@
                                            <td>
                                                <div class="mono whitespace-nowrap text-sm text-slate-200"
                                                     title="@documentoPrincipal">
                                                    @documentoPrincipal
                                                </div>

                                                @if (tieneCuilCuit)
                                                {
                                                    <div class="mono mt-1 text-xs muted-2 cliente-doc-secondary" title="CUIT/CUIL @c.CuilCuit">
                                                        CUIT/CUIL <span class="cliente-doc-secondary__value">@c.CuilCuit</span>
                                                    </div>
                                                }
                                            </td>

                                            @* CONTACTO *@
                                            <td>
                                                <div class="flex max-w-64 flex-col gap-1">

                                                    <div class="flex min-w-0 items-center gap-2 text-sm @(tieneTelefono ? "muted" : "muted-2")"
                                                         title="@telefono">

                                                        <span class="material-symbols-outlined shrink-0 text-base"
                                                              aria-hidden="true">
                                                            phone
                                                        </span>

                                                        <span class="truncate">
                                                            @telefono
                                                        </span>
                                                    </div>

                                                    <div class="flex min-w-0 items-center gap-2 text-xs @(tieneEmail ? "muted" : "muted-2")"
                                                         title="@email">

                                                        <span class="material-symbols-outlined shrink-0 text-base"
                                                              aria-hidden="true">
                                                            mail
                                                        </span>

                                                        <span class="truncate">
                                                            @email
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>

                                            @* CRÉDITO *@
                                            <td>
                                                @if (c.CreditoRequiereConfiguracion)
                                                {
                                                    <span class="text-sm muted-2" title="@c.CreditoMensajeError">
                                                        Requiere configuración
                                                    </span>
                                                }
                                                else
                                                {
                                                    <div class="cliente-credit-cell">
                                                        <span class="text-sm font-semibold text-white num">
                                                            @((c.CreditoDisponible ?? 0m).ToString("C").Replace(' ', ' '))
                                                        </span>
                                                        <span class="text-xs muted-2">Disponible</span>
                                                    </div>
                                                }
                                            </td>

                                            @* RIESGO *@
                                            <td>
                                                <div class="cliente-risk-cell">
                                                    <span class="@RiesgoChip(c)">
                                                        <span class="material-symbols-outlined" aria-hidden="true">
                                                            @RiesgoIcon(c)
                                                        </span>

                                                        @RiesgoTexto(c)
                                                    </span>

                                                    <span class="text-xs muted-2" title="Puntaje de riesgo: @pct%">
                                                        @pct%
                                                    </span>
                                                </div>
                                            </td>

                                            @* ESTADO *@
                                            <td class="cliente-estado-cell">
                                                <span class="badge-erp @(c.Activo ? "badge-erp-success" : "badge-erp-neutral")">
                                                    @(c.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>

                                            @* ACCIONES — convergencia a .row-action (shared-components.css):
                                               mismos 3 controles, mismos permisos/destinos/data-*, solo
                                               cambia el componente visual (antes btn/btn-ghost locales).
                                               A ≥640px .row-action se vuelve ícono-only (label oculto vía
                                               .row-action__label), igual que AlertaStock/Proveedor — como la
                                               tabla desktop solo se muestra a partir de 900px (.hide-mobile),
                                               siempre se ve ícono-only acá, con title/aria-label. *@
                                            <td>
                                                <div class="row-actions whitespace-nowrap">

                                                    <a asp-action="Details" asp-route-id="@c.Id"
                                                       class="row-action row-action--primary"
                                                       aria-label="Ver legajo de @rowName" title="Ver legajo de @rowName">

                                                        <span class="material-symbols-outlined" aria-hidden="true">
                                                            visibility
                                                        </span>

                                                        <span class="row-action__label">Ver</span>
                                                    </a>

                                                    @if (puedeEditar)
                                                    {
                                                        <button type="button" class="row-action"
                                                                data-cliente-modal-open="edit" data-cliente-id="@c.Id"
                                                                aria-label="Editar @rowName" title="Editar @rowName">

                                                            <span class="material-symbols-outlined" aria-hidden="true">
                                                                edit
                                                            </span>

                                                            <span class="row-action__label">Editar</span>
                                                        </button>
                                                    }

                                                    <details class="cliente-row-menu relative" data-cliente-row-menu>

                                                        <summary
                                                            class="row-action"
                                                            aria-label="Más acciones para @rowName"
                                                            title="Más acciones para @rowName">

                                                            <span class="material-symbols-outlined" aria-hidden="true">
                                                                more_vert
                                                            </span>

                                                            <span class="row-action__label">Más</span>
                                                        </summary>

                                                        <div class="cliente-row-menu__content">
                                                            <a asp-controller="Credito" asp-action="Index" asp-route-clienteId="@c.Id"
                                                               class="cliente-row-menu__item">
                                                                <span class="material-symbols-outlined" aria-hidden="true">
                                                                    credit_score
                                                                </span>
                                                                Ver créditos
                                                            </a>

                                                            @if (puedeEliminar)
                                                            {
                                                                <a asp-action="Delete" asp-route-id="@c.Id"
   class="cliente-row-menu__item cliente-row-menu__item--danger">

                                                                    <span class="material-symbols-outlined" aria-hidden="true">
                                                                        delete
                                                                    </span>

                                                                    Dar de baja cliente
</a>
                                                            }
                                                        </div>
                                                    </details>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* ============================================================
           TARJETAS MÓVILES
           ============================================================ *@
            <div id="clientes-cards" class="m-card cliente-mobile-list" role="list" aria-labelledby="cliente-list-title"
                 aria-describedby="result-count">

                @foreach (var c in clientes)
                {
                    var rowName = ClienteNombre(c);
                    var pct = RiesgoPct(c);

                    var tieneTelefono =
                        !string.IsNullOrWhiteSpace(c.Telefono);

                    var tieneEmail =
                        !string.IsNullOrWhiteSpace(c.Email);

                    var telefono = tieneTelefono
                        ? c.Telefono
                        : "Sin teléfono";

                    var email = tieneEmail
                        ? c.Email
                        : "Sin email";

                    var tipoDocumento =
                        string.IsNullOrWhiteSpace(c.TipoDocumento)
                            ? "Documento"
                            : c.TipoDocumento;

                    var documentoPrincipal =
                        string.IsNullOrWhiteSpace(c.NumeroDocumento)
                            ? $"{tipoDocumento} sin número"
                            : $"{tipoDocumento} {c.NumeroDocumento}";

                    <article class="card card-pad cliente-mobile-card" role="listitem" data-cliente-row-id="@c.Id"
                             data-estado="@(c.Activo ? "activo" : "inactivo")" data-tipodoc="@c.TipoDocumento">

                        @* ENCABEZADO *@
                        <div class="cliente-card-top">

                            <div class="cliente-mobile-person">
                                <div class="cliente-mobile-person__text">

                                    <h3 class="font-medium @(c.Activo ? "text-white" : "text-slate-400")">
                                        @rowName
                                    </h3>

                                    <div class="mono mt-1 text-xs muted-2" title="@documentoPrincipal">
                                        @documentoPrincipal
                                    </div>
                                </div>
                            </div>

                            <span class="badge-erp @(c.Activo ? "badge-erp-success" : "badge-erp-neutral")">
                                @(c.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>

                        @* CONTACTO *@
                        <div class="mt-3 grid gap-2">

                            <div class="flex min-w-0 items-center gap-2 text-sm @(tieneTelefono ? "muted" : "muted-2")"
                                 title="@telefono">

                                <span class="material-symbols-outlined shrink-0 text-base" aria-hidden="true">
                                    phone
                                </span>

                                <span class="truncate">
                                    @telefono
                                </span>
                            </div>

                            <div class="flex min-w-0 items-center gap-2 text-sm @(tieneEmail ? "muted" : "muted-2")"
                                 title="@email">

                                <span class="material-symbols-outlined shrink-0 text-base" aria-hidden="true">
                                    mail
                                </span>

                                <span class="truncate">
                                    @email
                                </span>
                            </div>
                        </div>

                        @* CRÉDITO Y RIESGO *@
                        <div class="mt-3 grid grid-cols-2 gap-2 cliente-mobile-metrics">
                            <div class="minimetric">
                                <div class="mm-label">Crédito</div>

                                @if (c.CreditoRequiereConfiguracion)
                                {
                                    <div class="text-sm muted-2" title="@c.CreditoMensajeError">Requiere config.</div>
                                }
                                else
                                {
                                    <div class="mm-value num">@((c.CreditoDisponible ?? 0m).ToString("C").Replace(' ', ' '))</div>
                                    <div class="text-xs muted-2">Disponible</div>
                                }
                            </div>

                            <div class="minimetric">
                                <div class="mm-label">Riesgo</div>
                                <div class="flex flex-wrap items-center gap-2 mt-1">
                                    <span class="@RiesgoChip(c)">
                                        <span class="material-symbols-outlined" aria-hidden="true">
                                            @RiesgoIcon(c)
                                        </span>
                                        @RiesgoTexto(c)
                                    </span>
                                    <span class="text-xs muted-2" title="Puntaje de riesgo: @pct%">@pct%</span>
                                </div>
                            </div>
                        </div>

                        @* ACCIONES — se mantienen los botones locales (btn/btn-ghost) acá, sin
                           converger a .row-action: estas cards se muestran hasta 899px, y
                           .row-action pasa a ícono-only ya a partir de 640px — adoptarlo acá
                           ocultaría el label "Editar"/"Más" en la banda 640-899px, cambiando
                           un comportamiento que hoy funciona con min-[390px]:inline. *@
                        <div class="cliente-card-actions">

                            <a asp-action="Details" asp-route-id="@c.Id"
                               class="btn btn-soft btn-sm btn-block cliente-card-actions__primary">

                                <span class="material-symbols-outlined" aria-hidden="true">
                                    visibility
                                </span>

                                Ver legajo
                            </a>

                            <div class="grid @(puedeEditar ? "grid-cols-2" : "grid-cols-1") gap-2">

                                @if (puedeEditar)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" data-cliente-modal-open="edit"
                                            data-cliente-id="@c.Id" aria-label="Editar @rowName" title="Editar @rowName">

                                        <span class="material-symbols-outlined" aria-hidden="true">
                                            edit
                                        </span>

                                        <span>
                                            Editar
                                        </span>
                                    </button>
                                }

                                <details class="cliente-card-menu" data-cliente-row-menu>

                                    <summary class="btn btn-ghost btn-sm btn-block" aria-label="Más acciones para @rowName"
                                             title="Más acciones para @rowName">

                                        <span class="material-symbols-outlined" aria-hidden="true">
                                            more_horiz
                                        </span>

                                        <span>
                                            Más
                                        </span>
                                    </summary>

                                    <div class="cliente-card-menu__content">
                                        <a asp-controller="Credito" asp-action="Index" asp-route-clienteId="@c.Id"
                                           class="cliente-row-menu__item">
                                            <span class="material-symbols-outlined" aria-hidden="true">
                                                credit_score
                                            </span>
                                            Ver créditos
                                        </a>

                                        @if (puedeEliminar)
                                        {
                                            <a asp-action="Delete" asp-route-id="@c.Id"
   class="cliente-row-menu__item cliente-row-menu__item--danger">

                                                <span class="material-symbols-outlined" aria-hidden="true">
                                                    delete
                                                </span>

                                                Dar de baja cliente
</a>
                                        }
                                    </div>
                                </details>
                            </div>
                        </div>
                    </article>
                }
            </div>

            @* ============================================================
           ESTADO VACÍO
           ============================================================ *@
            @if (!clientes.Any())
            {
                <div id="empty-state" class="card cliente-empty-card" role="status">

                    <div class="empty">

                        <div class="empty-ic">
                            <span class="material-symbols-outlined" aria-hidden="true">
                                person_search
                            </span>
                        </div>

                        @if (filtroClienteActivo)
                        {
                            <h3>
                                No encontramos clientes con esta búsqueda
                            </h3>

                            <p>
                                Probá con otros términos o limpiá los filtros.
                            </p>

                            <a asp-action="Index" class="btn btn-soft btn-sm empty-action">

                                <span class="material-symbols-outlined" aria-hidden="true">
                                    close
                                </span>

                                Limpiar filtros
                            </a>
                        }
                        else
                        {
                            <h3>
                                No hay clientes registrados
                            </h3>

                            <p>
                                Creá tu primer cliente para comenzar.
                            </p>

                            <button type="button" class="btn btn-soft btn-sm empty-action" data-cliente-modal-open="create">
                                <span class="material-symbols-outlined" aria-hidden="true">
                                    person_add
                                </span>

                                Nuevo cliente
                            </button>
                        }
                    </div>
                </div>
            }

            @* ============================================================
           PAGINACIÓN
           ============================================================ *@
            @if (Model.TotalResultados > 0 && totalPaginas > 1)
            {
                <nav class="cliente-pagination" aria-label="Paginación de clientes">
                    <p class="cliente-pagination__info">
                        Mostrando @primerRegistro–@ultimoRegistro de @Model.TotalResultados
                    </p>

                    <div class="cliente-pagination__controls">
                        @if (Model.PageNumber > 1)
                        {
                            <a asp-action="Index" asp-all-route-data="@RutaPagina(Model.PageNumber - 1)"
                               class="btn btn-ghost btn-xs cliente-pagination__nav" rel="prev">
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                                <span>Anterior</span>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-ghost btn-xs cliente-pagination__nav is-disabled" aria-disabled="true">
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                                <span>Anterior</span>
                            </span>
                        }

                        <div class="cliente-pagination__pages" aria-label="Páginas">
                            @foreach (var p in VentanaPaginas(Model.PageNumber, totalPaginas))
                            {
                                if (p == -1)
                                {
                                    <span class="cliente-pagination__ellipsis" aria-hidden="true">&hellip;</span>
                                }
                                else if (p == Model.PageNumber)
                                {
                                    <span class="cliente-pagination__page is-current" aria-current="page">@p</span>
                                }
                                else
                                {
                                    <a asp-action="Index" asp-all-route-data="@RutaPagina(p)"
                                       class="cliente-pagination__page">@p</a>
                                }
                            }
                        </div>

                        <span class="cliente-pagination__compact">Página @Model.PageNumber de @totalPaginas</span>

                        @if (Model.PageNumber < totalPaginas)
                        {
                            <a asp-action="Index" asp-all-route-data="@RutaPagina(Model.PageNumber + 1)"
                               class="btn btn-ghost btn-xs cliente-pagination__nav" rel="next">
                                <span>Siguiente</span>
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-ghost btn-xs cliente-pagination__nav is-disabled" aria-disabled="true">
                                <span>Siguiente</span>
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                            </span>
                        }
                    </div>
                </nav>
            }
        </section>
    }
</div>

<div id="limitesModalContainer"></div>

<partial name="_ClienteModal" />

@section Scripts {
    @* Necesario para el wizard real del drawer de alta (validación de campos
       obligatorios por paso, reutilizando las reglas [Required] del ViewModel en
       vez de duplicarlas en JS). No hay otro formulario con asp-for en esta vista
       (el buscador/filtros usa inputs planos sin data-val), así que no activa
       validación en ningún otro lugar de la pantalla. *@
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/module-index.js" asp-append-version="true"></script>
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/cliente-index.js" asp-append-version="true"></script>
    <script src="~/js/cliente-cuil.js" asp-append-version="true"></script>
    <script src="~/js/cliente-modal.js" asp-append-version="true"></script>
}
