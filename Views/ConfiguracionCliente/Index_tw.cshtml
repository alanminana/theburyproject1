@model ConfiguracionActualizacionDatosClienteViewModel
@{
    ViewData["Title"] = "Configuración de pagos";
    var puedeEditar = User.TienePermiso("configuracion", "update");
}

@section Styles {
    <style>
        .cfgpago-head { border: 1px solid var(--pal-neutral-800); border-radius: 12px; background: color-mix(in srgb, var(--pal-neutral-925) 60%, transparent); padding: 1rem 1.25rem .85rem; margin: .5rem 0 1rem; }
        .cfgpago-head-main { min-width: 0; }
        .cfgpago-tabs-slot { margin-top: .75rem; }
        .cfgcli-card { border: 1px solid var(--pal-neutral-800); border-radius: 12px; background: color-mix(in srgb, var(--pal-neutral-925) 60%, transparent); padding: 1.1rem 1.25rem; }
        .cfgcli-hint { color: var(--pal-neutral-400); font-size: .8125rem; line-height: 1.5; margin: .25rem 0 .75rem; }
        .cfgcli-field { width: 8rem; height: 42px; border-radius: 8px; border: 1px solid var(--pal-neutral-700); background: var(--pal-neutral-925); color: var(--pal-neutral-100); padding: 0 .75rem; font-size: .875rem; font-variant-numeric: tabular-nums; }
        .cfgcli-field:focus { outline: none; border-color: var(--pal-info-500); box-shadow: 0 0 0 3px color-mix(in srgb, var(--pal-info-500) 35%, transparent); }
        .cfgcli-field[readonly] { opacity: .62; }
        .cfgcli-switch input { accent-color: var(--pal-accent); width: 1.1rem; height: 1.1rem; }
        .cfgcli-switch { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; color: var(--pal-neutral-100); font-weight: 600; font-size: .9rem; }
    </style>
}

<header class="cfgpago-head">
    <div class="cfgpago-head-main">
        <h1 class="cfgpago-title">Configuración de pagos</h1>
        <p class="cfgpago-sub">Datos del cliente: cada cuánto se le pide al usuario revisar la información de un cliente.</p>
    </div>
    <div class="cfgpago-tabs-slot">
        <partial name="~/Views/ConfiguracionPago/_ConfiguracionPagoTabs.cshtml" view-data="@(new ViewDataDictionary(ViewData) { { "ConfigPagoTab", "cliente" } })" />
    </div>
</header>

@if (TempData["Success"] != null)
{
    <div class="mb-4 flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400" role="status">
        <span class="material-symbols-outlined">check_circle</span>
        @TempData["Success"]
    </div>
}

<form asp-controller="ConfiguracionCliente" asp-action="Index" method="post" class="space-y-5">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400" role="alert"></div>
    }

    <section class="cfgcli-card" aria-labelledby="cfgcli-title">
        <h2 id="cfgcli-title" class="text-lg font-semibold text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">contact_phone</span> Actualización de datos
        </h2>
        <p class="cfgcli-hint">
            Cuando un cliente supera este tiempo sin que se editen sus datos, al buscarlo en Venta o abrirlo en Clientes se muestra un aviso que
            lleva a editarlo. Guardar el formulario de edición reinicia el contador.
        </p>

        <label class="cfgcli-switch">
            <input asp-for="Activa" type="checkbox" disabled="@(!puedeEditar)" />
            Avisar para actualizar datos del cliente
        </label>

        <div class="mt-3 flex flex-wrap items-center gap-3">
            <label asp-for="DiasRevision" class="text-sm font-semibold text-slate-300">Revisar cada</label>
            <input asp-for="DiasRevision" type="number" min="1" max="3650" step="1" class="cfgcli-field" readonly="@(!puedeEditar)" />
            <span class="text-sm text-slate-400">días</span>
        </div>
        <span asp-validation-for="DiasRevision" class="text-xs text-red-500"></span>
    </section>

    @if (puedeEditar)
    {
        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button type="submit" class="btn-erp-primary w-full sm:w-auto sm:py-2.5">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">save</span>
                Guardar configuración
            </button>
        </div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
