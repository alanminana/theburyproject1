                                La fecha de vigencia elegida es anterior a hoy. Esta version se aplicara retroactivamente
                                y quedara registrada como tal en el historial, junto con el motivo indicado.
                            </p>
                            <p class="text-xs text-slate-500 mb-5">Confirma para continuar con la creacion de esta version retroactiva.</p>
                            <footer class="flex justify-end gap-2">
                                <button type="button" data-punitorio-modal-close class="btn-erp-ghost">Cancelar</button>
                                <button type="button" id="pun-confirmar-retro" class="btn-erp-primary">
                                    <span class="material-symbols-outlined text-[15px]">check</span> Confirmar y crear
                                </button>
                            </footer>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cp-notice cp-notice-warn mb-4">
                        <span class="material-symbols-outlined text-amber-300">lock</span>
                        <p class="text-sm text-slate-300">No tenes permiso para crear nuevas versiones de punitorios. Contacta a un administrador.</p>
                    </div>
                }

                <div>
                    <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px] text-slate-400">history</span>
                        Historial de versiones
                        <span class="ml-auto text-xs font-normal text-slate-500">@pun.Historial.Count registro(s)</span>
                    </h3>

                    @if (pun.Historial.Count > 0)
                    {
                        <div class="overflow-x-auto rounded-xl border border-slate-800">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-800 bg-slate-800/50">
                                        <th class="px-3 py-2 text-left font-medium text-slate-400">Vigente desde</th>
                                        <th class="px-3 py-2 text-center font-medium text-slate-400">Estado</th>
                                        <th class="px-3 py-2 text-right font-medium text-slate-400">Porcentaje</th>
                                        <th class="px-3 py-2 text-right font-medium text-slate-400">Periodo</th>
                                        <th class="px-3 py-2 text-right font-medium text-slate-400">Gracia</th>
                                        <th class="px-3 py-2 text-left font-medium text-slate-400">Motivo</th>
                                        <th class="px-3 py-2 text-left font-medium text-slate-400">Creada por</th>
                                        <th class="px-3 py-2 text-left font-medium text-slate-400">Fecha creacion</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800">
                                    @foreach (var v in pun.Historial)
                                    {
                                        <tr class="hover:bg-slate-800/50 transition-colors @(v.EsVigenteHoy ? "bg-emerald-900/10" : "")">
                                            <td class="px-3 py-2 text-slate-300 font-mono text-xs">@v.VigenteDesde.ToString("dd/MM/yyyy")</td>
                                            <td class="px-3 py-2 text-center">
                                                @if (v.EsVigenteHoy)
                                                {
                                                    <span class="badge-erp badge-erp-success">vigente</span>
                                                }
                                                else if (v.EsFutura)
                                                {
                                                    <span class="badge-erp badge-erp-info">futura</span>
                                                }
                                                else if (!v.Activa)
                                                {
                                                    <span class="badge-erp badge-erp-warning">inactiva</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-erp">historica</span>
                                                }
                                                @if (v.EsRetroactiva)
                                                {
                                                    <span class="badge-erp badge-erp-danger ml-1">retroactiva</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 text-right font-mono text-slate-100">@v.Porcentaje.ToString("0.##")%</td>
                                            <td class="px-3 py-2 text-right text-slate-400">@v.PeriodoDias d</td>
                                            <td class="px-3 py-2 text-right text-slate-400">@v.DiasGracia d</td>
                                            <td class="px-3 py-2 text-slate-400 max-w-55 truncate" title="@v.MotivoCambio">@(string.IsNullOrWhiteSpace(v.MotivoCambio) ? "—" : v.MotivoCambio)</td>
                                            <td class="px-3 py-2 text-slate-400">@(v.CreatedBy ?? "—")</td>
                                            <td class="px-3 py-2 text-slate-400 text-xs">@v.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="px-6 py-10 text-center text-sm text-slate-400 rounded-xl border border-slate-800">
                            <span class="material-symbols-outlined text-3xl block mb-2">history</span>
                            No hay versiones de punitorios registradas.
                        </div>
                    }
                </div>
            </section>
        }
    </main>
