                    <div id="m-punitorio-retro" class="hidden fixed inset-0 z-50 cp-modal-bg flex items-center justify-center p-4" data-punitorio-modal-backdrop>
                        <div class="cp-modal-card w-full max-w-md p-6" role="dialog" aria-modal="true" aria-labelledby="punRetroTitulo" aria-describedby="punRetroDesc">
                            <header class="flex items-start justify-between gap-3 mb-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-lg flex items-center justify-center bg-amber-500/10 text-amber-300 shrink-0">
                                        <span class="material-symbols-outlined">warning</span>
                                    </div>
                                    <h3 id="punRetroTitulo" class="text-lg font-semibold text-white">Vigencia retroactiva</h3>
                                </div>
                                <button type="button" data-punitorio-modal-close class="rounded-lg border border-slate-700 bg-slate-800 p-1.5 text-slate-400 hover:text-white" aria-label="Cerrar">
