@model CreditoPersonalConfigViewModel
@using TheBuryProject.ViewModels.Punitorio
@{
    ViewData["Title"] = "Configuración de pagos";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var volverHref = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "Credito") ?? "/Credito";
    var perfiles = Model.Perfiles ?? new List<PerfilCreditoViewModel>();
    var limites = Model.LimitesPorPuntaje ?? new List<ClienteCreditoLimiteItemViewModel>();
    var limitesActivos = limites.Count(l => l.Activo);
    var limiteClienteNuevo = limites.FirstOrDefault(l => l.Puntaje == 0)?.LimiteMonto ?? 0m;
    var puedeEditar = User.TienePermiso("configuracion", "update");
    var puedeConfigMora = User.TienePermiso("mora", "config");
    var dg = Model.DefaultsGlobales ?? new DefaultsGlobalesViewModel();
    var sf = Model.SemaforoFinanciero ?? new SemaforoFinancieroViewModel();
    // Micro-lote 4: la disponibilidad de cuotas sale SOLO de los planes activos. No hay rango.
    var planesActivosResumen = (Model.CuotasCreditoPersonal ?? new List<CuotaCreditoPersonalViewModel>())
        .Where(c => c.Activo).Select(c => c.CantidadCuotas).Distinct().OrderBy(c => c).ToList();

    // PUN-ML8 — Punitorios por mora.
    var puedeVerPunitorio = User.TienePermiso("configuracion", "viewpunitorio");
    var puedeGestionarPunitorio = User.TienePermiso("configuracion", "managepunitorio");
    var pun = Model.Punitorios ?? new ConfiguracionPunitorioPageViewModel();
    var activeSection = ViewData["ActiveSection"] as string;
}

@section Styles {
    <partial name="_CreditoModuleStyles" />
    <style>
        .cfgpago-head { border: 1px solid var(--pal-neutral-800); border-radius: 12px; background: color-mix(in srgb, var(--pal-neutral-925) 60%, transparent); padding: 1rem 1.25rem .85rem; margin: .5rem 0 1rem; }
        .cfgpago-head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem 1rem; flex-wrap: wrap; }
        .cfgpago-tabs-slot { margin-top: .75rem; }
        .cfgpago-head-main { flex: 1 1 20rem; min-width: 0; }
        .cp-subnav { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
        .cp-nav-link {
            display: inline-flex; align-items: center; gap: .4rem; flex-shrink: 0; min-height: 2.5rem; padding: 0 .9rem;
            border-radius: 999px; border: 1px solid var(--pal-neutral-800); background: transparent;
            color: var(--erp-fg-2, var(--pal-neutral-350)); font-size: .8125rem; font-weight: 600; white-space: nowrap;
            cursor: pointer; transition: background .12s, border-color .12s, color .12s;
        }
        .cp-nav-link:hover { background: var(--pal-neutral-850); color: var(--pal-neutral-200); }
        .cp-nav-link:focus-visible { outline: 2px solid var(--pal-accent); outline-offset: 2px; }
        .cp-nav-link.is-active { font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3rem; background: color-mix(in srgb, var(--pal-info-500) 13%, transparent); border-color: color-mix(in srgb, var(--pal-info-500) 35%, transparent); color: var(--pal-neutral-50); }
        .cp-section { display: none; }
        .cp-section.is-active { display: block; }
        .cp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
        .cp-head > .flex-1 { flex: 1 1 16rem; }
        .cp-lim-head { display: none; }
        .cp-lim { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .5rem .85rem; align-items: center; }
        .cp-lim-input { grid-column: 1 / -1; grid-row: 2; }
        .cp-lim-out { grid-column: 1 / -1; grid-row: 3; margin: 0; }
        .cp-lim-out:empty { display: none; }
        @@media (min-width: 1024px) {
            .cp-lim-head, .cp-lim { grid-template-columns: 9rem 13rem 7rem minmax(0, 1fr); column-gap: 1rem; }
            .cp-lim-head { display: grid; padding: 0 calc(1rem + 1px); color: var(--erp-fg-3, var(--pal-neutral-400)); font-size: var(--erp-fs-min, 0.75rem); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
            .cp-lim { padding: .65rem 1rem; }
            .cp-lim-input, .cp-lim-out { grid-column: auto; grid-row: auto; }
            .cp-lim .cp-field { height: 38px; }
            .cp-lim-input .cp-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        }
        .cp-plans { display: grid; gap: .5rem; }
        .cp-plans-head { display: none; }
        .cp-plan .cp-field::placeholder { font-family: inherit; font-size: .8rem; }
        .cp-plan { display: grid; grid-template-columns: minmax(0, 1fr); gap: .6rem 1rem; }
        .cp-plan-preview, .cp-plan-help, .cp-plan-note { margin: 0; }
        .cp-plan-csr { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; min-width: 0; }
        .cp-plan-csr .cp-csr-grid { flex: 1 1 auto; }
        @@media (min-width: 1024px) {
            .cp-plans-head, .cp-plan { grid-template-columns: 8.5rem 13rem minmax(0, 1fr); column-gap: 1.25rem; align-items: center; }
            .cp-plans-head { display: grid; padding: 0 calc(1rem + 1px); color: var(--erp-fg-3, var(--pal-neutral-400)); font-size: var(--erp-fs-min, 0.75rem); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
            .cp-plan { padding: .65rem 1rem; row-gap: .25rem; }
            .cp-plan-title { grid-column: 1; grid-row: 1; }
            .cp-plan-rate { grid-column: 2; grid-row: 1; }
            .cp-plan-csr { grid-column: 3; grid-row: 1; }
            .cp-plan-preview { grid-column: 1 / 3; grid-row: 2; }
            .cp-plan-help { grid-column: 3; grid-row: 2; }
            .cp-plan-note { grid-column: 1 / -1; grid-row: 3; }
            .cp-plan .cp-field { height: 38px; }
            .cp-plan-rate .cp-label, .cp-plan-lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        }
        @@media (min-width: 1280px) {
            .cp-lim-head, .cp-lim { grid-template-columns: 12rem 16rem 9rem minmax(0, 1fr); column-gap: 1.25rem; }
            .cp-plans-head, .cp-plan { grid-template-columns: 10rem 17rem minmax(0, 1fr); }
        }
        @@media (max-width: 639px) {
            .cp-subnav, .cp-hero-actions {
                flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
                -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
                mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
            }
            .cp-hero-actions { width: 100%; }
            .cp-hero-actions > a { flex: 0 0 auto; }
        }
        .cp-kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
        .cp-kpi-wide { grid-column: span 2; }
        @@media (min-width: 1280px) { .cp-kpis { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
        .cp-card { background: var(--pal-neutral-925); border: 1px solid var(--pal-neutral-800); border-radius: 10px; padding: .85rem 1rem; }
        .cp-notice {
            display: flex; gap: .75rem; align-items: flex-start;
            border: 1px solid color-mix(in srgb, var(--pal-info-500) 28%, transparent); background: color-mix(in srgb, var(--pal-info-500) 6%, transparent);
            border-radius: 10px; padding: .85rem 1rem;
        }
        .cp-notice-warn { border-color: color-mix(in srgb, var(--pal-warning-500) 32%, transparent); background: color-mix(in srgb, var(--pal-warning-500) 6%, transparent); }
        .cp-field {
            width: 100%; height: 42px; border-radius: 8px; border: 1px solid var(--pal-neutral-700);
            background: var(--pal-neutral-925); color: var(--pal-neutral-100); padding: 0 .75rem; font-size: .875rem;
        }
        .cp-field-money { padding-left: 1.75rem; }
        .cp-field:focus { outline: none; border-color: var(--pal-info-500); box-shadow: 0 0 0 3px color-mix(in srgb, var(--pal-info-500) 35%, transparent); }
        .cp-field[readonly], .cp-field:disabled { opacity: .62; cursor: default; }
        .cp-label { display:block; margin-bottom:.35rem; color:var(--erp-fg-2, var(--pal-neutral-350)); font-size:var(--erp-fs-min, 0.75rem); font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
        .cp-hint { margin-top:.28rem; color:var(--erp-fg-3, var(--pal-neutral-400)); font-size:var(--erp-fs-min, 0.75rem); line-height:1.4; }
        .cp-modo {
            display:flex; gap:.6rem; align-items:flex-start;
            border-radius:10px; padding:.55rem .85rem; border:1px solid var(--pal-neutral-800); background:var(--pal-neutral-925);
        }
        .cp-modo.is-especifico { border-color:color-mix(in srgb, var(--pal-success-500) 30%, transparent); background:color-mix(in srgb, var(--pal-success-500) 7%, transparent); }
        .cp-modo.is-especifico #cp-modo-icon { color:var(--pal-success-300); }
        .cp-modo.is-sinplanes { border-color:color-mix(in srgb, var(--pal-warning-500) 35%, transparent); background:color-mix(in srgb, var(--pal-warning-500) 8%, transparent); }
        .cp-modo.is-sinplanes #cp-modo-icon { color:var(--pal-warning-300); }
        .cp-chips { display:flex; flex-wrap:wrap; gap:.3rem; }
        .cp-chip {
            display:inline-flex; align-items:center; justify-content:center;
            min-width:1.6rem; height:1.5rem; padding:0 .45rem; border-radius:7px;
            font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:var(--erp-fs-min, 0.75rem); font-weight:700;
            background:color-mix(in srgb, var(--pal-info-500) 12%, transparent); border:1px solid color-mix(in srgb, var(--pal-info-500) 28%, transparent); color:var(--pal-info-200);
        }
        .cp-pill {
            display:inline-flex; align-items:center; gap:.25rem; border-radius:999px; padding:.15rem .5rem;
            font-size:var(--erp-fs-min, 0.75rem); font-weight:700; text-transform:uppercase; letter-spacing:.05em;
            border:1px solid color-mix(in srgb, var(--pal-info-500) 22%, transparent); background:color-mix(in srgb, var(--pal-info-500) 10%, transparent); color:var(--pal-info-300);
        }
        .cp-pill-green { border-color:color-mix(in srgb, var(--pal-success-500) 22%, transparent); background:color-mix(in srgb, var(--pal-success-500) 10%, transparent); color:var(--pal-success-300); }
        .cp-pill-amber { border-color:color-mix(in srgb, var(--pal-warning-500) 25%, transparent); background:color-mix(in srgb, var(--pal-warning-500) 10%, transparent); color:var(--pal-warning-300); }
        .cp-profiles { display: grid; gap: .5rem; }
        .cp-prof-head { display: none; }
        .cp-prof { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem .85rem; }
        .cp-prof-name { grid-column: 1 / -1; order: -2; }
        .cp-prof-desc { grid-column: 1 / -1; order: -1; }
        .cp-prof-active { display: flex; align-items: flex-end; }
        @@media (min-width: 640px) {
            .cp-prof { grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: end; }
            .cp-prof-active { align-items: flex-end; }
        }
        @@media (min-width: 1280px) {
            .cp-prof-head, .cp-prof { grid-template-columns: minmax(0, 1.4fr) 7rem 8rem 5.5rem 5.5rem 5rem 5rem; column-gap: 1rem; align-items: center; }
            .cp-prof-head { display: grid; padding: 0 calc(1rem + 1px); color: var(--erp-fg-3, var(--pal-neutral-400)); font-size: var(--erp-fs-min, 0.75rem); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
            .cp-prof { padding: .65rem 1rem; row-gap: .4rem; }
            .cp-prof-name { grid-column: auto; order: 0; }
            .cp-prof-desc { grid-column: 1 / -1; order: 0; }
            .cp-prof-active { align-items: center; }
            .cp-prof .cp-field { height: 38px; }
            .cp-prof .cp-label:not(.cp-prof-keep) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        }
        .cp-csr-grid { display:flex; flex-wrap:wrap; gap:.35rem; }
        .cp-csr-item {
            display:inline-flex; align-items:center; gap:.3rem; padding:.22rem .5rem; border-radius:7px;
            border:1px solid var(--pal-neutral-700); background:var(--pal-neutral-925); cursor:pointer; user-select:none;
            font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:var(--erp-fs-min, 0.75rem); font-weight:600; color:var(--erp-fg-2, var(--pal-neutral-350));
            transition: background .12s, border-color .12s, color .12s;
        }
        .cp-csr-item input { width:13px; height:13px; }
        .cp-csr-item.is-checked { border-color:color-mix(in srgb, var(--pal-warning-500) 40%, transparent); background:color-mix(in srgb, var(--pal-warning-500) 10%, transparent); color:var(--pal-warning-300); }
        .cp-modal-bg { background: color-mix(in srgb, var(--pal-neutral-950) 78%, transparent); backdrop-filter: blur(3px); }
        .cp-modal-card { background:var(--pal-neutral-875); border:1px solid var(--pal-neutral-800); border-radius:16px; box-shadow:0 25px 50px color-mix(in srgb, var(--pal-black) 55%, transparent); }
        /* Al enfocar (p. ej. validación fallida) el control y su mensaje quedan por encima de la barra sticky. */
        .cp-shell :is(input, select, textarea, button, summary) { scroll-margin-bottom: 15rem; }
        .cp-savebar {
            position: sticky; bottom: 0; z-index: 30; margin-top: 1rem; padding: .6rem .9rem;
            border: 1px solid var(--pal-neutral-800); border-radius: 12px; background: var(--pal-neutral-925);
            box-shadow: 0 -10px 18px -10px color-mix(in srgb, var(--pal-black) 55%, transparent);
        }
        @@media (max-width: 1023px) {
            .cp-savebar { bottom: -5.5rem; }
        }
        @@media (max-width: 639px) {
            .cp-savebar { justify-content: flex-end; }
            .cp-savebar-hint { display: none; }
        }
    </style>
}

<header class="cfgpago-head">
    <div class="cfgpago-head-row">
        <div class="cfgpago-head-main">
            <h1 class="cfgpago-title">Configuración de pagos</h1>
            <p class="cfgpago-sub">Crédito personal: recargos por cuotas, límites por puntaje, perfiles y punitorios.</p>
        </div>
        <div class="cp-hero-actions flex items-center gap-2 flex-wrap max-w-full">
            <a asp-controller="ConfiguracionContratoCredito" asp-action="Index"
               asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
               class="btn-erp-secondary py-2 text-sm no-underline">
                <span class="material-symbols-outlined text-[17px]">contract</span>
                Plantilla contrato
            </a>
            @if (puedeConfigMora)
            {
                <a asp-controller="Mora" asp-action="ConfiguracionExpandida"
                   asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                   class="btn-erp-secondary py-2 text-sm no-underline">
                    <span class="material-symbols-outlined text-[17px]">tune</span>
                    Configuración de mora
                </a>
            }
            <a href="@volverHref" class="btn-erp-ghost py-2 text-sm no-underline">
                <span class="material-symbols-outlined text-[17px]">arrow_back</span>
                Volver
            </a>
        </div>
    </div>
    <div class="cfgpago-tabs-slot">
        <partial name="_ConfiguracionPagoTabs" view-data="@(new ViewDataDictionary(ViewData) { { "ConfigPagoTab", "credito" } })" />
    </div>
</header>

@if (TempData["Success"] != null)
{
    <div class="mb-4 flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400" role="status">
        <span class="material-symbols-outlined">check_circle</span>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400" role="alert">
        <span class="material-symbols-outlined">error</span>
        @TempData["Error"]
    </div>
}

<div class="cp-shell">
    <div class="space-y-5 min-w-0">
        <nav id="sec-nav" class="cp-subnav" aria-label="Secciones de crédito personal">
            <button type="button" class="cp-nav-link is-active" data-target="s1"><span class="material-symbols-outlined text-[17px]" aria-hidden="true">dashboard</span> Resumen</button>
            <button type="button" class="cp-nav-link" data-target="s2"><span class="material-symbols-outlined text-[17px]" aria-hidden="true">calculate</span> Recargos y cuotas</button>
            <button type="button" class="cp-nav-link" data-target="s3"><span class="material-symbols-outlined text-[17px]" aria-hidden="true">speed</span> Límites por puntaje</button>
            <button type="button" class="cp-nav-link" data-target="s4"><span class="material-symbols-outlined text-[17px]" aria-hidden="true">groups</span> Perfiles</button>
            @if (puedeVerPunitorio)
            {
                <button type="button" class="cp-nav-link" data-target="s7"><span class="material-symbols-outlined text-[17px]" aria-hidden="true">gavel</span> Punitorios por mora</button>
            }
        </nav>

        <form asp-action="CreditoPersonal" asp-controller="ConfiguracionPago" method="post" id="credito-config-form">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }

            <div asp-validation-summary="ModelOnly" class="mb-4 rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400"></div>

            <section id="s1" class="cp-section is-active">
                <div class="cp-head">
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">Resumen</h2>
                        <p class="text-sm text-slate-400 mt-0.5">Estado actual de la configuración activa de crédito personal.</p>
                    </div>
                </div>

                <div class="cp-kpis">
                    <div class="cp-card">
                        <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wide text-slate-500">
                            <span class="material-symbols-outlined text-blue-400 text-[13px]">percent</span> Recargo total
                        </div>
                        <div class="mt-1.5 text-xl font-semibold text-white font-mono" id="r-tasa">@dg.TasaMensual.ToString("0.00") %</div>
                    </div>
                    <div class="cp-card cp-kpi-wide">
                        <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wide text-slate-500">
                            <span class="material-symbols-outlined text-cyan-300 text-[13px]">view_timeline</span> Planes activos
                        </div>
                        @if (planesActivosResumen.Count == 0)
                        {
                            <div class="mt-1.5 text-sm font-semibold text-amber-300 font-mono" id="r-cuotas">Sin planes activos</div>
                        }
                        else
                        {
                            <div class="mt-1.5 text-lg font-semibold text-white font-mono" id="r-cuotas">@string.Join(", ", planesActivosResumen)</div>
                        }
                    </div>
                    <div class="cp-card">
                        <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wide text-slate-500">
                            <span class="material-symbols-outlined text-amber-300 text-[13px]">payments</span> Gastos
                        </div>
                        <div class="mt-1.5 text-lg font-semibold text-white font-mono" id="r-gastos">$ @dg.GastosAdministrativos.ToString("N0")</div>
                    </div>
                    <div class="cp-card">
                        <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wide text-slate-500">
                            <span class="material-symbols-outlined text-green-400 text-[13px]">speed</span> Límite puntaje 0
                        </div>
                        <div class="mt-1.5 text-lg font-semibold text-white font-mono">$ @limiteClienteNuevo.ToString("N0")</div>
                    </div>
                    <div class="cp-card">
                        <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wide text-slate-500">
                            <span class="material-symbols-outlined text-violet-300 text-[13px]">groups</span> Perfiles
                        </div>
                        <div class="mt-1.5 text-xl font-semibold text-white font-mono">@perfiles.Count</div>
                    </div>
                </div>

                <div class="cp-notice mt-4">
                    <span class="material-symbols-outlined text-cyan-300 mt-0.5 shrink-0 text-[17px]">info</span>
                    <div class="text-sm text-slate-300">
                        El cupo de cada cliente sale de su <strong class="text-cyan-200">puntaje (0 a 5)</strong> y del límite definido para ese puntaje en <strong class="text-cyan-200">Límites por puntaje</strong>.
                        La aptitud de venta y la mora se gestionan en sus propias pantallas.
                    </div>
                </div>

                <details class="cp-card mt-3">
                    <summary class="cursor-pointer text-sm font-semibold text-white">Dónde se decide cada regla</summary>
                    <ul class="mt-3 space-y-2 text-xs text-slate-400 leading-relaxed">
                        <li><strong class="text-slate-200">Aptitud de venta:</strong> documentación, cupo, mora y BCRA/Veraz se evalúan al vender, no acá.</li>
                        <li><strong class="text-slate-200">Score por mora:</strong> los impactos automáticos se configuran en la pantalla de mora.</li>
                        <li><strong class="text-slate-200">Garante y documentos:</strong> un garante válido puede sustituir el recibo de sueldo; BCRA/Veraz es obligatorio para evaluar crédito.</li>
                        <li><strong class="text-slate-200">Autorización manual:</strong> es puntual por venta y no modifica el puntaje ni el límite futuro del cliente.</li>
                    </ul>
                </details>
            </section>

            <section id="s2" class="cp-section">
                @{
                    var cuotasCredito = Model.CuotasCreditoPersonal ?? new List<CuotaCreditoPersonalViewModel>();
                    var cuotasActivas = cuotasCredito.Where(c => c.Activo).Select(c => c.CantidadCuotas).Distinct().OrderBy(c => c).ToList();
                    var hayEspecificas = cuotasActivas.Count > 0;
                }
                <div class="cp-head">
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">Recargos y cuotas</h2>
                        <p class="text-sm text-slate-400 mt-0.5">Valores globales que se usan cuando el cliente no tiene perfil o configuración propia.</p>
                    </div>
                </div>

                <div class="cp-card">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                        <div>
                            <label asp-for="DefaultsGlobales.TasaMensual" class="cp-label">Recargo global (%)</label>
                            <input asp-for="DefaultsGlobales.TasaMensual" type="number" step="0.01" min="0" max="100"
                                   value="@(dg.TasaMensual.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))"
                                   readonly="@(!puedeEditar)" class="cp-field" data-summary="tasa" />
                            <p class="cp-hint">Fallback: lo heredan los planes activos que no fijan su propio porcentaje.</p>
                            <span asp-validation-for="DefaultsGlobales.TasaMensual" class="text-xs text-red-500"></span>
                        </div>
                        <div>
                            <label asp-for="DefaultsGlobales.GastosAdministrativos" class="cp-label">Gastos administrativos</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm font-mono pointer-events-none">$</span>
                                <input asp-for="DefaultsGlobales.GastosAdministrativos" type="number" step="0.01" min="0"
                                       readonly="@(!puedeEditar)" class="cp-field cp-field-money font-mono" data-summary="gastos" />
                            </div>
                            <p class="cp-hint">Monto fijo que se suma al capital al configurar el crédito.</p>
                            <span asp-validation-for="DefaultsGlobales.GastosAdministrativos" class="text-xs text-red-500"></span>
                        </div>
                    </div>
                    <details class="mt-3">
                        <summary class="cursor-pointer text-xs font-semibold text-slate-300">Cómo se aplican estos valores</summary>
                        <div class="mt-2 space-y-2 text-xs text-slate-400 leading-relaxed">
                            <p>Los planes de "Planes de cuotas" (abajo) son la fuente primaria del recargo aplicado en una venta. Si un plan activo <strong class="text-slate-300">no</strong> fija su propio porcentaje, el recargo global lo completa al vender; sin ningún valor acá tampoco, ese plan queda sin porcentaje válido.</p>
                            <p>Estos valores son fallback global. Si el cliente tiene perfil preferido o valores personalizados, el flujo de configuración del crédito resuelve esa prioridad.</p>
                        </div>
                    </details>
                </div>

                <div class="mt-6">
                    <div class="cp-head" style="margin-bottom:.6rem">
                        <div class="min-w-0">
                            <h3 class="text-base font-semibold text-white">Planes de cuotas</h3>
                            <p class="text-xs text-slate-400 mt-0.5">Cada plan activo puede fijar un recargo total propio, aplicado una sola vez sobre el saldo financiado.</p>
                        </div>
                        @if (puedeEditar)
                        {
                            <button type="button" data-open-modal="m-cuota" class="btn-erp-secondary shrink-0 text-sm py-2">
                                <span class="material-symbols-outlined text-[15px]">add</span> Agregar cuota
                            </button>
                        }
                    </div>

                    <div id="cp-modo" class="cp-modo mb-3 flex-wrap items-center @(hayEspecificas ? "is-especifico" : "is-sinplanes")">
                        <span id="cp-modo-icon" class="material-symbols-outlined text-[17px] shrink-0">@(hayEspecificas ? "check_circle" : "warning")</span>
                        <p id="cp-modo-title" class="text-sm text-slate-200 font-medium leading-snug min-w-0">
                            @if (hayEspecificas)
                            {
                                <text>Estos planes activos son la única fuente de cantidades disponibles. Solo se habilitan estas cantidades de cuota.</text>
                            }
                            else
                            {
                                <text>Sin planes globales activos: Crédito Personal no ofrece cuotas. Agregá al menos un plan activo para habilitar cantidades.</text>
                            }
                        </p>
                        <div id="cp-modo-chips" class="cp-chips">
                            @foreach (var n in cuotasActivas)
                            {
                                <span class="cp-chip">@n</span>
                            }
                        </div>
                    </div>

                    <span asp-validation-for="CuotasCreditoPersonal" class="block mb-3 text-xs text-red-400"></span>

                    <details class="mb-3">
                        <summary class="cursor-pointer text-xs font-semibold text-slate-300">Cómo se calcula el recargo de un plan</summary>
                        <p class="cp-hint mt-2">
                            Cada plan activo puede fijar su <span class="font-semibold text-cyan-300">propio recargo explícito</span>.
                            <span class="font-semibold text-amber-300">Vacío</span> se guarda igual y hereda el recargo global (arriba) al vender;
                            sin ningún valor ahí tampoco, esta cantidad de cuotas queda sin porcentaje válido y no se puede vender con ella.
                            <span class="font-semibold text-cyan-300">0</span> = sin recargo, explícito y distinto de "sin configurar".
                            El porcentaje se aplica <strong class="text-slate-300">una única vez</strong> sobre el saldo
                            financiado (ej: 6 cuotas al 10 % sobre $100.000 → recargo $10.000, total financiado $110.000). No se aplica mes a mes ni se compone.
                        </p>
                    </details>

                    @if (cuotasCredito.Count > 0)
                    {
                        <div class="cp-plans">
                            <div class="cp-plans-head" aria-hidden="true">
                                <span>Plan</span>
                                <span>Recargo total (%)</span>
                                <span>Cuotas sin recargo</span>
                            </div>
                            @for (var i = 0; i < cuotasCredito.Count; i++)
                            {
                                var cuota = cuotasCredito[i];
                                <div class="cp-card cp-plan" data-cuota-card>
                                    <input type="hidden" asp-for="CuotasCreditoPersonal[i].Id" />
                                    <input type="hidden" asp-for="CuotasCreditoPersonal[i].CantidadCuotas" />
                                    <input type="hidden" asp-for="CuotasCreditoPersonal[i].Orden" />

                                    <div class="cp-plan-title flex items-center justify-between gap-2 min-w-0">
                                        <p class="text-base font-semibold text-white truncate">@cuota.CantidadCuotas cuota@(cuota.CantidadCuotas != 1 ? "s" : "")</p>
                                        <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 shrink-0">
                                            <input asp-for="CuotasCreditoPersonal[i].Activo" disabled="@(!puedeEditar)" class="rounded border-slate-600 bg-slate-900 text-primary focus:ring-primary" />
                                            Activa
                                        </label>
                                    </div>

                                    <div class="cp-plan-rate min-w-0">
                                        <label asp-for="CuotasCreditoPersonal[i].TasaMensual" class="cp-label">Recargo total (%)</label>
                                        <input asp-for="CuotasCreditoPersonal[i].TasaMensual" type="number" step="0.01" min="0" max="100"
                                               value="@(cuota.TasaMensual?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))"
                                               readonly="@(!puedeEditar)" placeholder="Requerido si está activa (0 = sin recargo)" class="cp-field font-mono"
                                               data-preview-porcentaje data-preview-cuotas="@cuota.CantidadCuotas" data-preview-target="preview-cuota-@i" />
                                        <span asp-validation-for="CuotasCreditoPersonal[i].TasaMensual" class="text-xs text-red-400"></span>
                                    </div>

                                    <p class="cp-hint cp-plan-preview" id="preview-cuota-@i" data-preview-out>Ejemplo sobre $100.000: —</p>

                                    @if (cuota.Id > 0)
                                    {
                                        <div class="cp-plan-csr">
                                            <span class="cp-label cp-plan-lbl mb-0!">Cuotas sin recargo</span>
                                            <div class="cp-csr-grid" data-csr-checks="@i" data-csr-cantidad="@cuota.CantidadCuotas">
                                                @for (var n = 1; n <= cuota.CantidadCuotas; n++)
                                                {
                                                    var marcada = cuota.CuotasSinRecargo != null && cuota.CuotasSinRecargo.Contains(n);
                                                    <label class="cp-csr-item@(marcada ? " is-checked" : "")">
                                                        <input type="checkbox"
                                                               name="CuotasCreditoPersonal[@i].CuotasSinRecargo"
                                                               value="@n"
                                                               checked="@marcada"
                                                               disabled="@(!puedeEditar)"
                                                               data-csr-checkbox />
                                                        <span>@n</span>
                                                    </label>
                                                }
                                            </div>
                                            <span class="text-[11px] font-mono text-slate-500" data-csr-resumen="@i">—</span>
                                        </div>
                                        <p class="cp-hint cp-plan-help" data-csr-ayuda>—</p>
                                    }
                                    else
                                    {
                                        <p class="cp-hint cp-plan-csr">Guardá este plan para poder elegir sus cuotas sin recargo.</p>
                                    }

                                    @if (cuota.Activo && !cuota.TasaMensual.HasValue)
                                    {
                                        <p class="cp-hint cp-plan-note text-cyan-300">ℹ Sin recargo propio: al vender va a heredar el recargo global de arriba (@dg.TasaMensual.ToString("0.##") %). Si tampoco está configurado ahí, no se va a poder vender con esta cantidad de cuotas.</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rounded-xl border border-dashed border-slate-700 bg-slate-950/30 p-5 text-center">
                            <span class="material-symbols-outlined text-amber-500/70 text-[24px]">warning</span>
                            <p class="mt-1 text-sm text-slate-500">No hay planes de cuotas activos. Sin planes, Crédito Personal no ofrece cuotas: agregá al menos un plan.</p>
                        </div>
                    }
                </div>

                <div class="mt-6">
                    <h3 class="text-base font-semibold text-white">Semáforo de la simulación</h3>
                    <p class="text-xs text-slate-400 mt-0.5 mb-3">Solo cambia el color de la relación cuota / monto financiado en la simulación; no decide aptitud ni cupo.</p>
                    <div class="cp-card grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                        <div>
                            <label asp-for="SemaforoFinanciero.RatioVerdeMax" class="cp-label">Ratio máximo verde</label>
                            <input asp-for="SemaforoFinanciero.RatioVerdeMax" type="number" step="0.01" min="0.01" max="0.99" readonly="@(!puedeEditar)" class="cp-field" />
                            <p class="cp-hint">Ej: 0.08 muestra verde si la cuota llega hasta el 8% del monto financiado.</p>
                            <span asp-validation-for="SemaforoFinanciero.RatioVerdeMax" class="text-xs text-red-500"></span>
                        </div>
                        <div>
                            <label asp-for="SemaforoFinanciero.RatioAmarilloMax" class="cp-label">Ratio máximo amarillo</label>
                            <input asp-for="SemaforoFinanciero.RatioAmarilloMax" type="number" step="0.01" min="0.01" max="0.99" readonly="@(!puedeEditar)" class="cp-field" />
                            <p class="cp-hint">Por encima de este ratio la simulación se muestra en rojo.</p>
                            <span asp-validation-for="SemaforoFinanciero.RatioAmarilloMax" class="text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section id="s3" class="cp-section">
                <div class="cp-head">
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">Límites reales por puntaje</h2>
                        <p class="text-sm text-slate-400 mt-0.5">Cupo máximo de crédito según el puntaje interno del cliente (0 a 5).</p>
                    </div>
                    <span class="cp-pill cp-pill-green">@limitesActivos activos</span>
                </div>

                <span asp-validation-for="LimitesPorPuntaje" class="block mb-3 text-xs text-red-400"></span>

                <div class="cp-plans">
                    <div class="cp-lim-head" aria-hidden="true">
                        <span>Puntaje</span>
                        <span>Límite de crédito</span>
                        <span>Equivale a</span>
                        <span>Estado</span>
                    </div>
                    @for (var i = 0; i < limites.Count; i++)
                    {
                        var item = limites[i];
                        <div class="cp-card cp-lim">
                            <input type="hidden" asp-for="LimitesPorPuntaje[i].Id" />
                            <input type="hidden" asp-for="LimitesPorPuntaje[i].Puntaje" />

                            <div class="cp-lim-title min-w-0">
                                <p class="text-base font-semibold text-white">Puntaje @item.Puntaje</p>
                                <p class="text-xs text-slate-500">@(item.Puntaje == 0 ? "Cliente nuevo" : "Comportamiento crediticio")</p>
                            </div>
                            <div class="cp-lim-input min-w-0">
                                <label asp-for="LimitesPorPuntaje[i].LimiteMonto" class="cp-label">Límite de crédito</label>
                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm font-mono pointer-events-none">$</span>
                                    <input asp-for="LimitesPorPuntaje[i].LimiteMonto" type="number" step="1" min="0"
                                           readonly="@(!puedeEditar)" class="cp-field cp-field-money font-mono" data-money-hint />
                                </div>
                                <span asp-validation-for="LimitesPorPuntaje[i].LimiteMonto" class="text-xs text-red-400"></span>
                            </div>
                            <p class="cp-hint cp-lim-out font-mono" data-money-out aria-live="polite"></p>
                            <label class="cp-lim-active inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300">
                                <input asp-for="LimitesPorPuntaje[i].Activo" disabled="@(!puedeEditar)" class="rounded border-slate-600 bg-slate-900 text-primary focus:ring-primary" />
                                Activo
                            </label>
                        </div>
                    }
                </div>
            </section>

            <section id="s4" class="cp-section">
                <div class="cp-head">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 flex-wrap mb-0.5">
                            <span class="cp-pill">@perfiles.Count perfil@(perfiles.Count != 1 ? "es" : "")</span>
                        </div>
                        <h2 class="text-lg font-semibold text-white">Perfiles de crédito</h2>
                        <p class="text-sm text-slate-400 mt-0.5">Valores propios de cada perfil. Se aplican a los clientes que lo tienen como preferido; el rango de cuotas del perfil no cambia los planes de Recargos y cuotas.</p>
                    </div>
                    @if (puedeEditar)
                    {
                        <button type="button" data-open-modal="m-perfil" class="btn-erp-primary shrink-0 text-sm py-2">
                            <span class="material-symbols-outlined text-[15px]">add</span> Nuevo perfil
                        </button>
                    }
                </div>

                <div class="cp-profiles">
                    @if (perfiles.Count > 0)
                    {
                        <div class="cp-prof-head" aria-hidden="true">
                            <span>Nombre</span>
                            <span>Tasa (%)</span>
                            <span>Gastos ($)</span>
                            <span>Mín. cuotas</span>
                            <span>Máx. cuotas</span>
                            <span>Orden</span>
                            <span>Estado</span>
                        </div>
                    }
                    @for (var i = 0; i < perfiles.Count; i++)
                    {
                        var perfil = perfiles[i];
                        <div class="cp-card cp-prof">
                            <input type="hidden" asp-for="Perfiles[i].Id" />
                            <div class="cp-prof-name min-w-0">
                                <label asp-for="Perfiles[i].Nombre" class="cp-label">Nombre</label>
                                <input asp-for="Perfiles[i].Nombre" readonly="@(!puedeEditar)" class="cp-field font-semibold" />
                            </div>
                            <div>
                                <label asp-for="Perfiles[i].TasaMensual" class="cp-label">Tasa mensual (%)</label>
                                <input asp-for="Perfiles[i].TasaMensual" type="number" step="0.01" min="0" max="100"
                                       value="@(perfil.TasaMensual.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))"
                                       readonly="@(!puedeEditar)" class="cp-field font-mono" />
                            </div>
                            <div>
                                <label asp-for="Perfiles[i].GastosAdministrativos" class="cp-label">Gastos admin ($)</label>
                                <input asp-for="Perfiles[i].GastosAdministrativos" type="number" step="0.01" min="0" readonly="@(!puedeEditar)" class="cp-field font-mono" />
                            </div>
                            <div>
                                <label asp-for="Perfiles[i].MinCuotas" class="cp-label">Mín. cuotas</label>
                                <input asp-for="Perfiles[i].MinCuotas" type="number" min="1" max="120" readonly="@(!puedeEditar)" class="cp-field font-mono" />
                            </div>
                            <div>
                                <label asp-for="Perfiles[i].MaxCuotas" class="cp-label">Máx. cuotas</label>
                                <input asp-for="Perfiles[i].MaxCuotas" type="number" min="1" max="120" readonly="@(!puedeEditar)" class="cp-field font-mono" />
                            </div>
                            <div>
                                <label asp-for="Perfiles[i].Orden" class="cp-label">Orden</label>
                                <input asp-for="Perfiles[i].Orden" type="number" readonly="@(!puedeEditar)" class="cp-field font-mono" />
                            </div>
                            <div class="cp-prof-active">
                                <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 h-[38px]">
                                    <input asp-for="Perfiles[i].Activo" disabled="@(!puedeEditar)" class="rounded border-slate-600 bg-slate-900 text-primary focus:ring-primary" />
                                    Activo
                                </label>
                            </div>
                            <div class="cp-prof-desc min-w-0">
                                <label asp-for="Perfiles[i].Descripcion" class="cp-label">Descripción</label>
                                <input asp-for="Perfiles[i].Descripcion" readonly="@(!puedeEditar)" placeholder="Descripción (opcional)" class="cp-field" />
                            </div>
                        </div>
                    }

                    @if (perfiles.Count == 0)
                    {
                        <div class="rounded-xl border border-dashed border-slate-700 bg-slate-950/30 p-5 text-center">
                            <span class="material-symbols-outlined text-slate-600 text-[24px]">folder_open</span>
                            <p class="mt-1 text-sm text-slate-500">No hay perfiles configurados.</p>
                        </div>
                    }
                </div>
            </section>
        </form>

        @if (puedeVerPunitorio)
        {
            <section id="s7" class="cp-section">
                <div class="cp-head">
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">Punitorios por mora</h2>
                        <p class="text-sm text-slate-400 mt-0.5">Configuración versionada del punitorio aplicado sobre cuotas vencidas. Cada cambio crea una versión nueva; ninguna versión existente se edita ni se elimina.</p>
                    </div>
                </div>

                <div class="cp-card mb-4">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        <span class="cp-pill @(pun.Actual.EsActiva ? "cp-pill-green" : pun.Actual.EsInactiva ? "cp-pill-amber" : "")">
                            <span class="material-symbols-outlined text-sm">@(pun.Actual.EsActiva ? "check_circle" : pun.Actual.EsInactiva ? "pause_circle" : pun.Actual.EsCero ? "info" : "block")</span>
                            @pun.Actual.EstadoTexto
                        </span>
                        @if (pun.Actual.VigenteDesde.HasValue)
                        {
                            <span class="text-xs text-slate-500">vigente desde @pun.Actual.VigenteDesde.Value.ToString("dd/MM/yyyy")</span>
                        }
                    </div>

                    @if (pun.Actual.TieneConfiguracion)
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">
                            <div>
                                <p class="cp-label mb-1!">Porcentaje</p>
                                <p class="text-lg font-semibold text-white font-mono">@pun.Actual.Porcentaje?.ToString("0.##")%</p>
                            </div>
                            <div>
                                <p class="cp-label mb-1!">Período</p>
                                <p class="text-lg font-semibold text-white font-mono">@pun.Actual.PeriodoDias @(pun.Actual.PeriodoDias == 1 ? "día" : "días")</p>
                            </div>
                            <div>
                                <p class="cp-label mb-1!">Gracia</p>
                                <p class="text-lg font-semibold text-white font-mono">@pun.Actual.DiasGracia @(pun.Actual.DiasGracia == 1 ? "día" : "días")</p>
                            </div>
                            <div>
                                <p class="cp-label mb-1!">Prorrateo diario</p>
                                <p class="text-lg font-semibold text-emerald-400">Si</p>
                            </div>
                        </div>
                    }

                    <p class="cp-hint">@pun.Actual.ReglaTexto</p>
                </div>

                @if (pun.Actual.ProximaVersion != null)
                {
                    var prox = pun.Actual.ProximaVersion;
                    <div class="cp-notice mb-4">
                        <span class="material-symbols-outlined text-cyan-300">upcoming</span>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-white">Próximo cambio programado: @prox.VigenteDesde.ToString("dd/MM/yyyy")</p>
                            <p class="text-xs text-slate-400 mt-0.5">
                                @(prox.Activa
                                    ? $"Pasará a {prox.Porcentaje.ToString("0.##")}% cada {prox.PeriodoDias} dia(s), con {prox.DiasGracia} dia(s) de gracia."
                                    : "Pasará a inactiva: no se cobrarán nuevos punitorios desde esa fecha.")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(prox.MotivoCambio))
                            {
                                <p class="text-xs text-slate-500 mt-1">Motivo: @prox.MotivoCambio</p>
                            }
                            <p class="text-xs text-slate-500 mt-1">Por el versionado append-only, esta versión no se puede editar ni cancelar: una nueva versión siempre debe tener vigencia posterior a todas las existentes.</p>
                        </div>
                    </div>
                }

                @if (puedeGestionarPunitorio)
                {
                    <div class="cp-card mb-4">
                        <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-cyan-300">add_circle</span>
                            Crear nueva versión
                        </h3>

                        <form id="punitorio-form" asp-action="CrearVersionPunitorio" asp-controller="ConfiguracionPago" method="post">
                            @Html.AntiForgeryToken()
                            @if (!string.IsNullOrWhiteSpace(returnUrl))
                            {
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                            }
                            <input type="hidden" id="pun-hoy-comercial" value="@pun.HoyComercial.ToString("yyyy-MM-dd")" />

                            <div asp-validation-summary="ModelOnly" class="mb-3 rounded-xl border border-rose-500/20 bg-rose-500/10 p-3 text-xs font-semibold text-rose-400 empty:hidden"></div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-3">
                                <div>
                                    <label asp-for="Punitorios!.CrearForm.VigenteDesde" class="cp-label"></label>
                                    <input asp-for="Punitorios!.CrearForm.VigenteDesde" type="date" id="pun-vigente-desde" class="cp-field font-mono" />
                                    <span asp-validation-for="Punitorios!.CrearForm.VigenteDesde" class="block mt-1 text-xs text-red-400"></span>
                                </div>
                                <div>
                                    <label asp-for="Punitorios!.CrearForm.Porcentaje" class="cp-label"></label>
                                    <input asp-for="Punitorios!.CrearForm.Porcentaje" type="number" step="0.01" min="0" id="pun-porcentaje" class="cp-field font-mono"
                                           data-preview-punitorio data-preview-target="pun-preview-out" />
                                    <span asp-validation-for="Punitorios!.CrearForm.Porcentaje" class="block mt-1 text-xs text-red-400"></span>
                                </div>
                                <div>
                                    <label asp-for="Punitorios!.CrearForm.PeriodoDias" class="cp-label"></label>
                                    <input asp-for="Punitorios!.CrearForm.PeriodoDias" type="number" min="1" id="pun-periodo" class="cp-field font-mono"
                                           data-preview-punitorio data-preview-target="pun-preview-out" />
                                    <span asp-validation-for="Punitorios!.CrearForm.PeriodoDias" class="block mt-1 text-xs text-red-400"></span>
