@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        var CREDIT_SECTIONS = ['s1', 's2', 's3', 's4', 's7'];

        function money(value) {
            var number = parseFloat(value || '0');
            return '$ ' + number.toLocaleString('es-AR', { maximumFractionDigits: 0 });
        }

        function updateSummary() {
            var tasa = document.querySelector('[data-summary="tasa"]');
            var gastos = document.querySelector('[data-summary="gastos"]');
            var rTasa = document.getElementById('r-tasa');
            var rGastos = document.getElementById('r-gastos');

            if (tasa && rTasa) rTasa.textContent = parseFloat(tasa.value || '0').toFixed(2) + ' %';
            if (gastos && rGastos) rGastos.textContent = money(gastos.value);
            // El resumen de planes activos (r-cuotas) lo mantiene updateCuotasMode: sale de los
            // planes, no de un rango.
        }

        // Previsualizacion de recargo TOTAL (no mensual, no compuesta): pega al mismo endpoint
        // que reutiliza FinancialCalculationService.SimularPlanCredito, la unica formula
        // canonica. El JS no calcula nada financiero por su cuenta; solo pinta la respuesta.
        // Es previsualizacion visual, best-effort: nunca es autoridad para guardar (el POST de
        // guardado vuelve a validar el porcentaje server-side, sin depender de este fetch).
        var PREVIEW_URL = '@Url.Action("PreviewRecargoCreditoPersonal", "ConfiguracionPago")';
        var previewTimers = new Map();

        function moneyPreview(value) {
            var n = Number(value) || 0;
            return '$ ' + n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function resolverCuotasPreview(input) {
            if (input.hasAttribute('data-preview-cuotas')) {
                var fijo = parseInt(input.getAttribute('data-preview-cuotas'), 10);
                return isNaN(fijo) ? null : fijo;
            }
            var inputId = input.getAttribute('data-preview-cuotas-input');
            var origen = inputId ? document.getElementById(inputId) : null;
            var n = origen ? parseInt(origen.value, 10) : NaN;
            return (isNaN(n) || n < 1) ? null : n;
        }

        function ejecutarPreview(input) {
            var out = document.getElementById(input.getAttribute('data-preview-target') || '');
            var cuotas = resolverCuotasPreview(input);
            var porcentajeRaw = input.value;

            if (!out) return;

            // ML4: recargo propio vacio NUNCA hereda el recargo global (dejo de ser fallback
            // desde ML2.1/ML2). Sin porcentaje propio no hay preview posible: el plan queda
            // incompleto y el guardado lo va a rechazar si esta activo.
            if (porcentajeRaw === '' || cuotas === null) {
                out.textContent = '';
                return;
            }

            var porcentaje = parseFloat(porcentajeRaw);
            if (isNaN(porcentaje) || porcentaje < 0) {
                out.textContent = '';
                return;
            }

            var url = PREVIEW_URL + '?cuotas=' + encodeURIComponent(cuotas) +
                '&porcentajeRecargoTotal=' + encodeURIComponent(porcentaje);

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data) { out.textContent = ''; return; }
                    if (cuotas <= 1) {
                        out.textContent = 'Recargo ' + moneyPreview(data.recargoTotal) +
                            ' · Total financiado ' + moneyPreview(data.totalFinanciado);
                        return;
                    }
                    // El vector de cuotas viene ya resuelto del servidor (misma fuente que
                    // persiste el guardado real): solo se lee, nunca se recalcula ni se
                    // reconstruye por multiplicacion (eso podria no cerrar contra
                    // totalFinanciado cuando el residuo de redondeo cae en la ultima cuota).
                    var vector = data.cuotas;
                    var regular = vector[0].total;
                    var ultima = vector[vector.length - 1].total;
                    var textoCuotas = (regular === ultima)
                        ? (cuotas + ' cuotas de ' + moneyPreview(regular))
                        : ((cuotas - 1) + ' cuotas de ' + moneyPreview(regular) +
                            ' · última cuota ' + moneyPreview(ultima));
                    out.textContent = 'Ejemplo sobre $100.000: recargo ' + moneyPreview(data.recargoTotal) +
                        ' · total financiado ' + moneyPreview(data.totalFinanciado) +
                        ' · ' + textoCuotas;
                })
                .catch(function () { /* previsualizacion best-effort: sin bloquear la edicion */ });
        }

        function programarPreview(input) {
            if (previewTimers.has(input)) clearTimeout(previewTimers.get(input));
            previewTimers.set(input, setTimeout(function () { ejecutarPreview(input); }, 250));
        }

        function inicializarPreviews() {
            document.querySelectorAll('[data-preview-porcentaje]').forEach(function (input) {
                input.addEventListener('input', function () { programarPreview(input); });
                ejecutarPreview(input);
            });

            var nuevaCuotaCantidadEl = document.getElementById('nuevaCuotaCantidad');
            var nuevaCuotaTasaEl = document.getElementById('nuevaCuotaTasaMensual');
            if (nuevaCuotaCantidadEl && nuevaCuotaTasaEl) {
                nuevaCuotaCantidadEl.addEventListener('input', function () { programarPreview(nuevaCuotaTasaEl); });
            }
        }

        // CSR-ML5 — ayuda visual (best-effort, NO autoritativa) de "cuotas sin recargo" por plan.
        // Solo pinta lo que ya validó/validará el servidor (ConfiguracionCreditoPersonalCuotaSinRecargoRules);
        // no bloquea el checkbox ni el submit — "la validación server-side manda", el POST vuelve
        // a rechazar una selección inválida aunque este texto no llegue a actualizarse.
        function updateCsrUI(container) {
            if (!container) return;
            var card = container.closest('[data-cuota-card]');
            var total = parseInt(container.getAttribute('data-csr-cantidad'), 10) || 0;
            var marcadas = [];

            container.querySelectorAll('[data-csr-checkbox]').forEach(function (chk) {
                var item = chk.closest('.cp-csr-item');
                if (item) item.classList.toggle('is-checked', chk.checked);
                if (chk.checked) marcadas.push(parseInt(chk.value, 10));
            });
            marcadas.sort(function (a, b) { return a - b; });

            var resumen = card ? card.querySelector('[data-csr-resumen]') : null;
            if (resumen) resumen.textContent = marcadas.length + '/' + total;

            var ayuda = card ? card.querySelector('[data-csr-ayuda]') : null;
            if (!ayuda) return;

            var tasaInput = card ? card.querySelector('input[name$=".TasaMensual"]') : null;
            var tasa = tasaInput ? parseFloat(tasaInput.value) : NaN;
            var conRecargo = total - marcadas.length;

            ayuda.classList.remove('text-amber-300');

            if (marcadas.length === 0) {
                ayuda.textContent = total > 0 ? 'Todas las cuotas tienen recargo.' : '—';
            } else if (marcadas.length === total) {
                if (!isNaN(tasa) && tasa > 0) {
                    ayuda.classList.add('text-amber-300');
                    ayuda.textContent = '⚠ Debe quedar al menos una cuota con recargo: no se puede marcar sin recargo la totalidad con un recargo mayor a 0 %.';
                } else {
                    ayuda.textContent = 'Con recargo 0 %, todas las cuotas ya tienen recargo $0.';
                }
            } else {
                ayuda.textContent = marcadas.length + ' cuota' + (marcadas.length !== 1 ? 's' : '') +
                    ' sin recargo: ' + marcadas.join(', ') + ' · ' + conRecargo +
                    ' cuota' + (conRecargo !== 1 ? 's' : '') + ' con recargo.';
            }
        }

        function inicializarCsr() {
            document.querySelectorAll('[data-csr-checks]').forEach(function (container) {
                updateCsrUI(container);
                container.querySelectorAll('[data-csr-checkbox]').forEach(function (chk) {
                    chk.addEventListener('change', function () { updateCsrUI(container); });
                });
            });

            // Si cambia el recargo total del plan, el caso "totalidad marcada" pasa de invalido a
            // valido (0 %) o viceversa: recalcular la ayuda sin esperar a tocar un checkbox.
            document.querySelectorAll('[data-cuota-card] input[name$=".TasaMensual"]').forEach(function (input) {
                input.addEventListener('input', function () {
                    var card = input.closest('[data-cuota-card]');
                    var container = card ? card.querySelector('[data-csr-checks]') : null;
                    updateCsrUI(container);
                });
            });
        }

        // Refleja en vivo la unica fuente de cantidades: los planes activos. Sin planes activos,
        // Credito Personal no ofrece cuotas (no hay rango de respaldo).
        function updateCuotasMode() {
            var modo = document.getElementById('cp-modo');
            if (!modo) return;

            var title = document.getElementById('cp-modo-title');
            var icon = document.getElementById('cp-modo-icon');
            var chips = document.getElementById('cp-modo-chips');
            var rCuotas = document.getElementById('r-cuotas');

            var activas = [];
            document.querySelectorAll('[data-cuota-card]').forEach(function (card) {
                var check = card.querySelector('input[type="checkbox"]');
                var cant = card.querySelector('input[name$=".CantidadCuotas"]');
                if (check && check.checked && cant) {
                    var n = parseInt(cant.value, 10);
                    if (!isNaN(n) && activas.indexOf(n) === -1) activas.push(n);
                }
            });
            activas.sort(function (a, b) { return a - b; });

            if (activas.length > 0) {
                modo.classList.add('is-especifico');
                modo.classList.remove('is-sinplanes');
                if (icon) icon.textContent = 'check_circle';
                if (title) title.textContent = 'Estos planes activos son la unica fuente de cantidades disponibles. Solo se habilitan estas cantidades de cuota.';
                if (chips) {
                    chips.innerHTML = '';
                    activas.forEach(function (n) {
                        var c = document.createElement('span');
                        c.className = 'cp-chip';
                        c.textContent = n;
                        chips.appendChild(c);
                    });
                }
                if (rCuotas) {
                    rCuotas.textContent = activas.join(', ');
                    rCuotas.className = 'mt-1.5 text-lg font-semibold text-white font-mono';
                }
            } else {
                modo.classList.add('is-sinplanes');
                modo.classList.remove('is-especifico');
                if (icon) icon.textContent = 'warning';
                if (title) title.textContent = 'Sin planes globales activos: Credito Personal no ofrece cuotas. Agrega al menos un plan activo para habilitar cantidades.';
                if (chips) chips.innerHTML = '';
                if (rCuotas) {
                    rCuotas.textContent = 'Sin planes activos';
                    rCuotas.className = 'mt-1.5 text-sm font-semibold text-amber-300 font-mono';
                }
            }
        }

        // Aviso nativo al salir con cambios sin guardar en el formulario de configuracion.
        // Guardar (y los modales "Agregar cuota"/"Nuevo perfil", que envian el mismo form) lo desactivan.
        var formDirty = false;
        var configForm = document.getElementById('credito-config-form');
        if (configForm) {
            var markDirty = function (event) {
                var t = event.target;
                if (t && (t.form === configForm || configForm.contains(t))) formDirty = true;
            };
            document.addEventListener('input', markDirty);
            document.addEventListener('change', markDirty);
            configForm.addEventListener('submit', function () { formDirty = false; });
            document.querySelectorAll('[form="credito-config-form"][type="submit"]').forEach(function (b) {
                b.addEventListener('click', function () { formDirty = false; });
            });
            window.addEventListener('beforeunload', function (event) {
                if (!formDirty) return;
                event.preventDefault();
                event.returnValue = '';
            });
        }

        // Ayuda visual: importe con separador de miles debajo del input numerico (no cambia el valor enviado).
        function actualizarImporte(input) {
            var out = input.closest('.cp-card').querySelector('[data-money-out]');
            if (!out) return;
            var n = parseFloat(input.value);
            out.textContent = isNaN(n) ? '' : '= $ ' + n.toLocaleString('es-AR', { maximumFractionDigits: 2 });
        }
        document.querySelectorAll('[data-money-hint]').forEach(function (input) {
            actualizarImporte(input);
            input.addEventListener('input', function () { actualizarImporte(input); });
        });

        function showSection(id) {
            if (CREDIT_SECTIONS.indexOf(id) === -1) id = 's1';

            CREDIT_SECTIONS.forEach(function (sid) {
                var el = document.getElementById(sid);
                if (el) el.classList.toggle('is-active', sid === id);
            });

            document.querySelectorAll('[data-target]').forEach(function (btn) {
                btn.classList.toggle('is-active', btn.dataset.target === id);
                if (btn.dataset.target === id) btn.setAttribute('aria-current', 'true'); else btn.removeAttribute('aria-current');
            });

            // s7 (Punitorios) tiene su propio form/boton de guardado: la barra sticky de
            // "Guardar configuracion" (ligada a credito-config-form) no aplica ahi.
            var savebar = document.getElementById('cp-savebar');
            if (savebar) savebar.classList.toggle('hidden', id === 's7' || id === 's1');

            try { history.replaceState(null, '', '#' + id); } catch (e) { }
        }

        // Modales "Nuevo perfil" / "Agregar cuota": foco inicial en el primer campo, foco atrapado
        // mientras estan abiertos, Escape los cierra y el foco vuelve al boton que los abrio.
        var modalOpener = null;
        var openModalId = null;

        function modalFocusables(modal) {
            return Array.prototype.slice
                .call(modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
                .filter(function (el) { return !el.disabled && el.offsetParent !== null; });
        }

        function openModal(id, opener) {
            var el = document.getElementById(id);
            if (!el) return;
            modalOpener = opener || document.activeElement;
            openModalId = id;
            el.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            var firstField = el.querySelector('input:not([type="checkbox"]):not([type="hidden"])');
            var items = modalFocusables(el);
            var target = firstField || items[0];
            if (target) target.focus();
        }

        function closeModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.add('hidden');
            document.body.style.overflow = '';
            openModalId = null;
            if (modalOpener && typeof modalOpener.focus === 'function') modalOpener.focus();
            modalOpener = null;
        }

        document.addEventListener('keydown', function (event) {
            if (!openModalId) return;
            var modal = document.getElementById(openModalId);
            if (!modal) return;
            if (event.key === 'Escape') {
                event.preventDefault();
                closeModal(openModalId);
                return;
            }
            if (event.key !== 'Tab') return;
            var items = modalFocusables(modal);
            if (items.length === 0) return;
            var first = items[0];
            var last = items[items.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        });

        // ── PUN-ML8: preview de punitorios (calculador server-side, nunca recalculado en JS) ──
        var PUNITORIO_PREVIEW_URL = '@Url.Action("PreviewPunitorio", "ConfiguracionPago")';
        var punitorioPreviewTimer = null;

        function punitorioEstadoSufijo(estado) {
            switch (estado) {
                case 'DentroDeGracia': return ' (dentro de gracia)';
                case 'ConfiguracionInactiva': return ' (config. inactiva)';
                case 'SinConfiguracion': return ' (sin config.)';
                default: return '';
            }
        }

        function ejecutarPreviewPunitorio() {
            var out = document.getElementById('pun-preview-out');
            var porcentajeEl = document.getElementById('pun-porcentaje');
            var periodoEl = document.getElementById('pun-periodo');
            var graciaEl = document.getElementById('pun-gracia');
            if (!out || !porcentajeEl || !periodoEl || !graciaEl) return;

            var porcentaje = parseFloat(porcentajeEl.value);
            var periodo = parseInt(periodoEl.value, 10);
            var gracia = parseInt(graciaEl.value, 10);

            if (isNaN(porcentaje) || porcentaje < 0 || isNaN(periodo) || periodo < 1 || isNaN(gracia) || gracia < 0) {
                out.textContent = 'Completá porcentaje, período y gracia para ver la vista previa.';
                return;
            }

            var url = PUNITORIO_PREVIEW_URL + '?porcentaje=' + encodeURIComponent(porcentaje) +
                '&periodoDias=' + encodeURIComponent(periodo) + '&diasGracia=' + encodeURIComponent(gracia);

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data || !data.puntos) { out.textContent = ''; return; }
                    // El texto se arma acá; los importes vienen del calculador server-side
                    // (IPunitorioCalculator) — nunca se recalcula la fórmula en el cliente.
                    var partes = data.puntos.map(function (p) {
                        var importe = (p.importe === null || typeof p.importe === 'undefined')
                            ? '—'
                            : moneyPreview(p.importe);
                        return p.etiqueta + ': ' + importe + punitorioEstadoSufijo(p.estado);
                    });
                    out.textContent = 'Ejemplo sobre $100.000: ' + partes.join(' · ');
                })
                .catch(function () { /* previsualizacion best-effort: sin bloquear la edicion */ });
        }

        function programarPreviewPunitorio() {
            if (punitorioPreviewTimer) clearTimeout(punitorioPreviewTimer);
            punitorioPreviewTimer = setTimeout(ejecutarPreviewPunitorio, 250);
        }

        function inicializarPreviewPunitorio() {
            var inputs = document.querySelectorAll('[data-preview-punitorio]');
            if (inputs.length === 0) return;
            inputs.forEach(function (input) {
                input.addEventListener('input', programarPreviewPunitorio);
            });
            ejecutarPreviewPunitorio();
        }

        // ── PUN-ML8: modal de confirmacion retroactiva, con foco atrapado y retorno de foco ──
        var punitorioFocusReturnEl = null;
        var punitorioFocusTrapHandler = null;

        function punitorioFocusablesEnModal(modal) {
            return Array.prototype.slice
                .call(modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
                .filter(function (el) { return !el.disabled && el.offsetParent !== null; });
        }

        function abrirModalPunitorioRetro() {
            var modal = document.getElementById('m-punitorio-retro');
            if (!modal) return;

            punitorioFocusReturnEl = document.activeElement;
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';

            var focusables = punitorioFocusablesEnModal(modal);
            if (focusables.length > 0) focusables[0].focus();

            punitorioFocusTrapHandler = function (event) {
                if (event.key === 'Escape') {
                    event.preventDefault();
                    cerrarModalPunitorioRetro();
                    return;
                }
                if (event.key !== 'Tab') return;

                var items = punitorioFocusablesEnModal(modal);
                if (items.length === 0) return;

                var first = items[0];
                var last = items[items.length - 1];

                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            };
            document.addEventListener('keydown', punitorioFocusTrapHandler);
        }

        function cerrarModalPunitorioRetro() {
            var modal = document.getElementById('m-punitorio-retro');
            if (!modal) return;

            modal.classList.add('hidden');
            document.body.style.overflow = '';

            if (punitorioFocusTrapHandler) {
                document.removeEventListener('keydown', punitorioFocusTrapHandler);
                punitorioFocusTrapHandler = null;
            }
            if (punitorioFocusReturnEl && typeof punitorioFocusReturnEl.focus === 'function') {
                punitorioFocusReturnEl.focus();
            }
            punitorioFocusReturnEl = null;
        }

        function inicializarConfirmacionRetroactivaPunitorio() {
            var form = document.getElementById('punitorio-form');
            var modal = document.getElementById('m-punitorio-retro');
            if (!form || !modal) return;

            var hoyInput = document.getElementById('pun-hoy-comercial');
            var vigenteDesdeInput = document.getElementById('pun-vigente-desde');
            var motivoInput = document.getElementById('pun-motivo');
            var confirmado = false;

            form.addEventListener('submit', function (event) {
                if (confirmado) return; // ya se confirmo en el modal: dejar pasar el submit real.
                if (!hoyInput || !vigenteDesdeInput || !vigenteDesdeInput.value) return;

                var esRetroactiva = vigenteDesdeInput.value < hoyInput.value;
                if (!esRetroactiva) return;

                event.preventDefault();

                if (!motivoInput || motivoInput.value.trim() === '') {
                    if (motivoInput) motivoInput.focus();
                    return;
                }

                abrirModalPunitorioRetro();
            });

            modal.querySelectorAll('[data-punitorio-modal-close]').forEach(function (btn) {
                btn.addEventListener('click', cerrarModalPunitorioRetro);
            });

            modal.querySelectorAll('[data-punitorio-modal-backdrop]').forEach(function (backdrop) {
                backdrop.addEventListener('click', function (event) {
                    if (event.target === backdrop) cerrarModalPunitorioRetro();
                });
            });
            if (modal.hasAttribute('data-punitorio-modal-backdrop')) {
                modal.addEventListener('click', function (event) {
                    if (event.target === modal) cerrarModalPunitorioRetro();
                });
            }

            var confirmarBtn = document.getElementById('pun-confirmar-retro');
            if (confirmarBtn) {
                confirmarBtn.addEventListener('click', function () {
                    confirmado = true;
                    cerrarModalPunitorioRetro();
                    form.submit();
                });
            }
        }

        document.querySelectorAll('[data-open-modal]').forEach(function (btn) {
            btn.addEventListener('click', function () { openModal(btn.dataset.openModal, btn); });
        });

        document.querySelectorAll('[data-close-modal]').forEach(function (btn) {
            btn.addEventListener('click', function () { closeModal(btn.dataset.closeModal); });
        });

        document.querySelectorAll('[data-modal-backdrop]').forEach(function (backdrop) {
            backdrop.addEventListener('click', function (event) {
                if (event.target === backdrop) closeModal(backdrop.id);
            });
        });

        var nav = document.getElementById('sec-nav');
        if (nav) {
            nav.addEventListener('click', function (event) {
                var btn = event.target.closest('[data-target]');
                if (btn) showSection(btn.dataset.target);
            });
        }

        document.querySelectorAll('[data-summary]').forEach(function (input) {
            input.addEventListener('input', function () {
                updateSummary();
                updateCuotasMode();
            });
        });

        document.querySelectorAll('[data-cuota-card] input[type="checkbox"]').forEach(function (chk) {
            chk.addEventListener('change', updateCuotasMode);
        });

        // Tras un error de validacion en "Crear nueva version" (PUN-ML8) el controller
        // re-renderiza esta misma vista y pide activar s7 explicitamente via ViewData —
        // sin eso, el hash de la URL (que no cambia en un POST fallido) seguiria mandando.
        var initSection = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(activeSection));
        var initHash = window.location.hash.replace('#', '');
        showSection(initSection || (CREDIT_SECTIONS.indexOf(initHash) !== -1 ? initHash : 's1'));
        // El hash (#s1..#s7) hace que el navegador desplace el scroller del layout hasta la seccion y
        // deje afuera el encabezado con las pestañas Medios de pago / Credito personal: se vuelve al tope.
        if (window.location.hash) {
            var volverAlTope = function () {
                var el = document.getElementById('credito-config-form');
                while (el && el !== document.body) {
                    var oy = getComputedStyle(el).overflowY;
                    if ((oy === 'auto' || oy === 'scroll') && el.scrollHeight > el.clientHeight) { el.scrollTop = 0; }
                    el = el.parentElement;
                }
                window.scrollTo(0, 0);
            };
            // El navegador aplica el scroll al fragmento cuando termina de cargar: se repite el reset
            // en los tres momentos posibles (ahora, al terminar la carga y un instante despues).
            window.requestAnimationFrame(volverAlTope);
            window.addEventListener('load', function () { volverAlTope(); setTimeout(volverAlTope, 250); });
        }
        updateCuotasMode();
        inicializarPreviews();
        inicializarCsr();
        inicializarPreviewPunitorio();
        inicializarConfirmacionRetroactivaPunitorio();
    })();
    </script>
}
