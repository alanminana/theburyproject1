@using TheBuryProject.Models.Enums
@using System.Globalization
@model ConfiguracionPagoGlobalAdminViewModel
@{
    ViewData["Title"] = "Configuración de pagos";
    var puedeEditar = User.TienePermiso("configuracion", "update");

    static string TipoPagoDisplay(TipoPago tipoPago) => tipoPago switch
    {
        TipoPago.Efectivo => "Efectivo",
        TipoPago.Transferencia => "Transferencia",
        TipoPago.TarjetaDebito => "Tarjeta débito",
        TipoPago.TarjetaCredito => "Tarjeta crédito",
        TipoPago.Cheque => "Cheque",
        TipoPago.CreditoPersonal => "Crédito personal",
        TipoPago.MercadoPago => "Mercado Pago",
        TipoPago.CuentaCorriente => "Cuenta corriente",
        TipoPago.Tarjeta => "Tarjeta legacy",
        _ => tipoPago.ToString()
    };

    static string TipoTarjetaDisplay(TipoTarjeta tipoTarjeta) => tipoTarjeta switch
    {
        TipoTarjeta.Credito => "Crédito",
        TipoTarjeta.Debito => "Débito",
        _ => tipoTarjeta.ToString()
    };

    static string AjusteFirmado(decimal ajuste) => ajuste > 0m
        ? $"+{ajuste:0.##}%"
        : $"{ajuste:0.##}%";

    static string AjusteModo(decimal ajuste) => ajuste switch
    {
        > 0m => "recargo",
        < 0m => "descuento",
        _ => "sin ajuste"
    };

    static string AjusteClass(decimal ajuste) => ajuste switch
    {
        > 0m => "pay-badge pay-badge-warn",
        < 0m => "pay-badge pay-badge-ok",
        _ => "pay-badge pay-badge-muted"
    };

    static string EstadoClass(bool activo) => activo
        ? "pay-badge pay-badge-ok"
        : "pay-badge pay-badge-off";

    static string MetodoIcon(TipoPago tipoPago) => tipoPago switch
    {
        TipoPago.Efectivo => "payments",
        TipoPago.Transferencia => "account_balance",
        TipoPago.TarjetaDebito => "credit_card",
        TipoPago.TarjetaCredito => "credit_card",
        TipoPago.Cheque => "receipt_long",
        TipoPago.CreditoPersonal => "credit_score",
        TipoPago.MercadoPago => "qr_code_2",
        TipoPago.CuentaCorriente => "account_balance_wallet",
        _ => "tune"
    };

    // Fallback cuando el medio no tiene Descripcion propia cargada. Antes era un texto fijo
    // identico para los 6 medios; ahora refleja que hace cada uno realmente (tarjetas propias
    // vs. plan general vs. gestion aparte), sin inventar dato de negocio nuevo.
    static string MetodoCopyFallback(bool permiteTarjetas, bool permitePlanesGlobales) =>
        (permiteTarjetas, permitePlanesGlobales) switch
        {
            (true, _) => "Administra tarjetas propias y sus planes de cuotas por marca. Los planes usan cuotas exactas, no rangos.",
            (false, true) => "Usa un plan general de cuotas para todo el medio. Los planes usan cuotas exactas, no rangos.",
            _ => "Metodo con configuracion propia — ver detalle mas abajo."
        };

    var medioIdQuery = Context.Request.Query["medioId"].FirstOrDefault();
    var medioSeleccionado = Model.Medios.FirstOrDefault(m => m.Id.ToString() == medioIdQuery)
        ?? Model.Medios.FirstOrDefault(m => m.TipoPago == TipoPago.TarjetaCredito)
        ?? Model.Medios.FirstOrDefault(m => m.TipoPago == TipoPago.TarjetaDebito)
        ?? Model.Medios.FirstOrDefault();
    var mostrarQuitadas = Context.Request.Query["mostrarQuitadas"].FirstOrDefault() == "true";
}

@section Styles {
    <style>
        .payments-page {
            /* Tokens del modulo derivados de los tokens de tema reales (theme-ml.css /
               shared-components.css), no valores propios: si el tema ERP cambia, esta
               pantalla cambia con el resto en vez de divergir en silencio. --pay-soft se
               fusiona con --pay-text (el sistema de tema solo define 3 niveles de texto,
               no 4); --pay-ok/--pay-warn/--pay-danger usan los mismos tonos que
               .badge-erp-success/-warning/-danger (shared-components.css) para que el
               significado cromatico (descuento/recargo/inactivo) sea identico al resto
               del ERP, no solo parecido. */
            --pay-bg: var(--erp-bg);
            --pay-shell: var(--erp-surface);
            --pay-panel: var(--erp-surface-raised);
            --pay-row: var(--erp-bg);
            --pay-line: var(--erp-border);
            --pay-line-soft: var(--erp-border-muted);
            --pay-text: var(--erp-text);
            --pay-soft: var(--erp-text);
            --pay-muted: var(--erp-text-muted);
            --pay-dim: var(--erp-text-faint);
            --pay-accent: var(--erp-primary);
            --pay-ok: var(--pal-success-400);
            --pay-warn: var(--pal-warning-400);
            --pay-danger: var(--pal-danger-400);
            min-height: calc(100dvh - 5rem);
            /* Sin padding lateral: el shell alinea con el de Crédito personal (mismas x al cambiar de pestaña). */
            padding: .5rem 0 1.25rem;
            background: var(--pay-bg);
            color: var(--pay-text);
        }

        .payments-page * {
            box-sizing: border-box;
        }

        .payments-shell-card {
            width: 100%;
            margin: 0 auto;
            border: 1px solid var(--pay-line);
            /* Radio alineado a .hero-erp (shared-components.css), sin box-shadow propia:
               el resto del ERP distingue una superficie elevada con borde + fondo, no con
               sombra grande. */
            border-radius: 1.5rem;
            background: var(--pay-shell);
            overflow: hidden;
        }

        .payments-topbar {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 1rem;
            align-items: start;
            padding: 1.25rem;
            border-bottom: 1px solid var(--pay-line);
            background: linear-gradient(180deg, color-mix(in srgb, var(--pal-neutral-925) 98%, transparent), color-mix(in srgb, var(--pal-neutral-925) 98%, transparent));
        }

        .payments-eyebrow,
        .pay-label {
            color: var(--pay-muted);
            font-size: var(--erp-fs-min, 0.75rem);
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .payments-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: .55rem;
        }

        .payments-metrics {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            padding: 1rem 1.25rem 0;
        }

        .payments-metric {
            display: inline-flex;
            align-items: baseline;
            gap: .5rem;
            min-width: 0;
            border: 1px solid var(--pay-line);
            border-radius: 999px;
            background: var(--pay-panel);
            padding: .35rem .85rem;
        }

        .payments-metric strong {
            color: var(--pay-text);
            font-size: 1rem;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .payments-tabs-slot {
            margin-top: 1rem;
        }

        .payments-layout {
            display: grid;
            grid-template-columns: 220px minmax(0, 1fr);
            gap: .9rem;
            align-items: start;
            padding: 1.25rem;
        }

        .methods-sidebar {
            position: sticky;
            top: 1rem;
            border: 1px solid var(--pay-line);
            border-radius: 1rem;
            background: var(--pay-panel);
            padding: .75rem;
        }

        .methods-sidebar nav {
            display: grid;
            gap: .45rem;
            margin-top: .65rem;
        }

        .method-card {
            display: grid;
            grid-template-columns: 1.8rem minmax(0, 1fr) auto;
            gap: .55rem;
            align-items: center;
            min-height: 3.1rem;
            border: 1px solid transparent;
            border-radius: .8rem;
            background: var(--pal-neutral-800);
            padding: .55rem;
            color: var(--pay-soft);
            text-decoration: none;
            transition: border-color .18s ease, background-color .18s ease, transform .18s ease;
        }

        .method-card:hover,
        .method-card:focus-visible {
            border-color: color-mix(in srgb, var(--pal-accent) 50%, transparent);
            background: color-mix(in srgb, var(--pal-neutral-800) 88%, transparent);
            color: var(--pay-text);
            outline: none;
            transform: translateY(-1px);
        }

        .method-card.is-selected {
            border-color: color-mix(in srgb, var(--pal-accent) 58%, transparent);
            background: color-mix(in srgb, var(--pal-accent) 18%, transparent);
            box-shadow: inset 3px 0 0 var(--pay-accent);
        }

        .method-card .material-symbols-outlined {
            color: var(--pay-accent);
            font-size: 1.15rem;
        }

        .method-name,
        .card-title {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .method-name {
            display: block;
            font-size: .86rem;
            font-weight: 850;
        }

        .method-meta {
            display: block;
            margin-top: .1rem;
            color: var(--pay-dim);
            font-size: var(--erp-fs-min, 0.75rem);
            font-weight: 650;
        }

        .method-count {
            min-width: 1.65rem;
            border-radius: .5rem;
            background: color-mix(in srgb, var(--pal-neutral-925) 85%, transparent);
            padding: .2rem .35rem;
            color: var(--pay-muted);
            text-align: center;
            font-size: var(--erp-fs-min, 0.75rem);
            font-weight: 900;
            font-variant-numeric: tabular-nums;
        }

        .payments-main {
            display: grid;
            gap: .85rem;
            min-width: 0;
        }

        .method-panel {
            scroll-margin-top: 1rem;
            border: 1px solid var(--pay-line);
            border-radius: 1rem;
            background: var(--pay-panel);
            overflow: hidden;
        }

        .method-panel-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: .85rem;
            align-items: start;
            padding: 1rem;
            border-bottom: 1px solid var(--pay-line);
            background: color-mix(in srgb, var(--pal-neutral-925) 72%, transparent);
        }

        .method-heading {
            display: flex;
            flex-wrap: wrap;
            gap: .45rem;
            align-items: center;
        }

        .method-heading h2 {
            margin: 0;
            color: var(--pay-text);
            font-size: 1.08rem;
            font-weight: 900;
        }

        .method-copy {
            max-width: 54rem;
            margin: .45rem 0 0;
            color: var(--pay-muted);
            font-size: .83rem;
            line-height: 1.45;
        }

        .method-stats {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: .45rem;
        }

        .pay-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .3rem;
            min-height: 1.55rem;
            border: 1px solid var(--pay-line-soft);
            border-radius: .55rem;
            padding: .22rem .5rem;
            font-size: var(--erp-fs-min, 0.75rem);
            font-weight: 850;
            line-height: 1;
            white-space: nowrap;
        }

        .pay-badge-ok {
            border-color: color-mix(in srgb, var(--pal-success-400) 32%, transparent);
            background: color-mix(in srgb, var(--pal-success-400) 10%, transparent);
            color: var(--pal-success-200);
        }

        .pay-badge-warn {
            border-color: color-mix(in srgb, var(--pal-warning-400) 34%, transparent);
            background: color-mix(in srgb, var(--pal-warning-400) 10%, transparent);
            color: var(--pal-warning-200);
        }

        .pay-badge-off {
            border-color: color-mix(in srgb, var(--pal-danger-400) 32%, transparent);
            background: color-mix(in srgb, var(--pal-danger-400) 9%, transparent);
            color: var(--pal-danger-200);
        }

        .pay-badge-muted {
            border-color: color-mix(in srgb, var(--pal-neutral-450) 22%, transparent);
            background: color-mix(in srgb, var(--pal-neutral-450) 8%, transparent);
            color: var(--pal-neutral-300);
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .75rem;
            padding: 1rem;
        }

        /* Lista de tarjetas acoplables — una columna */
        .cards-list {
            display: grid;
            gap: .55rem;
            padding: .85rem 1rem;
        }

        /* Accordion por tarjeta */
        .payment-card-accordion {
            border: 1px solid var(--pay-line);
            border-radius: .9rem;
            background: var(--pay-panel);
            overflow: hidden;
            transition: border-color .18s ease;
        }

        .payment-card-accordion[open] {
            border-color: color-mix(in srgb, var(--pal-accent) 38%, transparent);
        }

        .payment-card-summary {
            display: grid;
            grid-template-columns: 1.3rem minmax(0, 1fr) auto;
            gap: .6rem;
            align-items: center;
            padding: .72rem .85rem;
            cursor: pointer;
            list-style: none;
            user-select: none;
            transition: background-color .15s ease;
        }

        .payment-card-summary::-webkit-details-marker {
            display: none;
        }

        .payment-card-summary:hover {
            background: color-mix(in srgb, var(--pal-neutral-800) 55%, transparent);
        }

        .payment-card-summary:focus-visible {
            outline: 2px solid var(--pay-accent);
            outline-offset: -2px;
            border-radius: .85rem;
        }

        .payment-card-chevron {
            color: var(--pay-dim);
            font-size: 1.15rem;
            flex-shrink: 0;
            transition: transform .18s ease;
        }

        .payment-card-accordion[open] .payment-card-chevron {
            transform: rotate(90deg);
        }

        .payment-card-main {
            display: flex;
            flex-wrap: wrap;
            gap: .4rem;
            align-items: center;
            min-width: 0;
        }

        .payment-card-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .3rem;
            align-items: center;
            justify-content: flex-end;
        }

        .payment-card-body {
            border-top: 1px solid var(--pay-line);
            background: color-mix(in srgb, var(--pal-neutral-925) 40%, transparent);
        }

        .payment-card-footer {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            padding: .65rem .85rem;
            border-top: 1px solid var(--pay-line);
            background: color-mix(in srgb, var(--pal-neutral-925) 30%, transparent);
        }

        .inactive-card-note {
            margin: .65rem .85rem .25rem;
            padding: .5rem .65rem;
            border: 1px solid color-mix(in srgb, var(--pal-danger-400) 35%, transparent);
            border-radius: .6rem;
            background: color-mix(in srgb, var(--pal-danger-400) 8%, transparent);
            color: var(--pal-danger-200);
            font-size: .78rem;
            font-weight: 700;
            line-height: 1.4;
        }

        .cards-quitadas-toggle {
            display: flex;
            align-items: center;
            gap: .5rem;
            padding-top: .25rem;
        }

        .cards-list-quitadas {
            opacity: .82;
        }

        .payment-card-quitada {
            border-color: color-mix(in srgb, var(--pal-danger-400) 22%, transparent);
        }

        .cards-quitadas-header {
            display: flex;
            align-items: center;
            gap: .4rem;
            padding: .3rem .2rem .1rem;
            color: var(--pal-danger-300);
            font-size: var(--erp-fs-min, 0.75rem);
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .payment-card,
        .pay-details {
            border: 1px solid var(--pay-line);
            border-radius: .9rem;
            background: var(--pay-panel);
        }

        .payment-card {
            min-width: 0;
            overflow: hidden;
        }

        .payment-card-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: .65rem;
            align-items: start;
            padding: .8rem;
            border-bottom: 1px solid var(--pay-line);
        }

        .card-title-row {
            display: flex;
            min-width: 0;
            flex-wrap: wrap;
            gap: .4rem;
            align-items: center;
        }

        .card-title {
            color: var(--pay-text);
            font-size: 1rem;
            font-weight: 900;
        }

        .card-subtitle,
        .empty-copy {
            margin-top: .25rem;
            color: var(--pay-dim);
            font-size: .75rem;
            line-height: 1.35;
        }

        .plan-list {
            display: grid;
            gap: .45rem;
            padding: .65rem;
        }

        .plan-row {
            border: 1px solid var(--pay-line);
            border-radius: .65rem;
            background: var(--pay-row);
            overflow: hidden;
        }

        .compact-summary {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: .55rem;
            align-items: center;
            cursor: pointer;
            list-style: none;
        }

        /* El plan es un unico control de expansion (toda la fila abre el form de edicion),
           no un boton "Editar" aislado + fila inerte alrededor) — el chevron comunica esa
           unica affordance, igual que .payment-card-chevron en el acordeon de tarjeta. */
        .plan-summary {
            display: grid;
            grid-template-columns: 1.1rem minmax(0, 1fr);
            gap: .5rem;
            align-items: center;
            cursor: pointer;
            list-style: none;
            padding: .52rem .6rem;
        }

        .plan-summary::-webkit-details-marker,
        .compact-summary::-webkit-details-marker {
            display: none;
        }

        .plan-chevron {
            color: var(--pay-dim);
            font-size: 1.05rem;
            flex-shrink: 0;
            transition: transform .18s ease;
        }

        .plan-row[open] .plan-chevron {
            transform: rotate(90deg);
        }

        .plan-main {
            display: flex;
            min-width: 0;
            flex-wrap: wrap;
            gap: .35rem;
            align-items: center;
            color: var(--pay-soft);
            font-size: .82rem;
            font-weight: 800;
        }

        .details-body {
            border-top: 1px solid var(--pay-line);
            padding: .75rem;
            background: color-mix(in srgb, var(--pal-neutral-925) 74%, transparent);
        }

        .compact-summary {
            padding: .7rem .8rem;
            color: var(--pay-soft);
            font-size: .82rem;
            font-weight: 900;
        }

        .compact-summary .material-symbols-outlined {
            color: var(--pay-accent);
            font-size: 1.05rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .65rem;
        }

        .form-grid .span-2 {
            grid-column: span 2;
        }

        .pay-field,
        .pay-select {
            width: 100%;
            min-height: 2.45rem;
            border: 1px solid color-mix(in srgb, var(--pal-neutral-450) 24%, transparent);
            border-radius: .65rem;
            background: var(--pay-row);
            color: var(--pay-text);
            padding: .52rem .65rem;
            font-size: .86rem;
            outline: none;
        }

        .pay-field:focus,
        .pay-select:focus {
            border-color: color-mix(in srgb, var(--pal-accent) 80%, transparent);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--pal-accent) 18%, transparent);
        }

        .pay-check {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            min-height: 2.45rem;
            border: 1px solid color-mix(in srgb, var(--pal-neutral-450) 24%, transparent);
            border-radius: .65rem;
            background: color-mix(in srgb, var(--pal-neutral-925) 85%, transparent);
            padding: .52rem .65rem;
            color: var(--pay-soft);
            font-size: .84rem;
            font-weight: 750;
        }

        .pay-button-row {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            align-items: center;
            margin-top: .75rem;
        }

        .pay-mini-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            min-height: 2rem;
            border: 1px solid color-mix(in srgb, var(--pal-neutral-450) 24%, transparent);
            border-radius: .6rem;
            background: color-mix(in srgb, var(--pal-neutral-925) 78%, transparent);
            padding: .4rem .6rem;
            color: var(--pay-soft);
            font-size: .76rem;
            font-weight: 850;
            line-height: 1;
            text-decoration: none;
            cursor: pointer;
            transition: background-color .18s ease, border-color .18s ease, transform .18s ease;
        }

        .pay-mini-button:hover,
        .pay-mini-button:focus-visible {
            border-color: color-mix(in srgb, var(--pal-accent) 50%, transparent);
            background: color-mix(in srgb, var(--pal-accent) 15%, transparent);
            color: var(--pay-text);
            outline: none;
            transform: translateY(-1px);
        }

        .pay-mini-button.primary {
            border-color: color-mix(in srgb, var(--pal-accent) 60%, transparent);
            background: var(--pay-accent);
            color: var(--pal-on-accent);
        }

        .pay-mini-button.danger {
            border-color: color-mix(in srgb, var(--pal-danger-400) 34%, transparent);
            color: var(--pal-danger-200);
        }

        .empty-state,
        .credit-debt {
            margin: 1rem;
            border: 1px solid var(--pay-line);
            border-radius: .9rem;
            background: color-mix(in srgb, var(--pal-neutral-925) 66%, transparent);
            padding: 1rem;
        }

        .credit-debt {
            border-color: color-mix(in srgb, var(--pal-warning-400) 28%, transparent);
            color: var(--pal-warning-200);
        }

        .legacy-note {
            margin-top: .5rem;
            color: var(--pay-dim);
            font-size: var(--erp-fs-min, 0.75rem);
        }

        .toast-msg {
            margin: 1rem 1.25rem 0;
        }

        /* Rango intermedio 701-1024px: ".payments-topbar"/".method-panel-header" siguen en 2
           columnas (ver @@media 700px mas abajo), pero a este ancho la columna de texto queda
           demasiado angosta para el h1/h2 clamp() y el titulo se envuelve en 2 lineas de forma
           antiestetica (confirmado en vivo en 1024x720/900). Se apilan antes, sin tocar el resto
           del layout de esta franja (sidebar de metodos, grillas de cards). */
        @@media (max-width: 1024px) {
            .payments-topbar,
            .method-panel-header {
                grid-template-columns: minmax(0, 1fr);
            }

            .payments-actions,
            .method-stats {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 980px) {
            .payments-layout {
                grid-template-columns: minmax(0, 1fr);
            }

            .methods-sidebar {
                position: static;
            }

            .methods-sidebar nav {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .cards-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @@media (max-width: 700px) {
            .pay-mini-button,
            .pay-button-row button,
            .pay-field,
            .pay-select {
                min-height: 2.75rem;
            }

            .payments-page {
                padding: .5rem 0 .75rem;
            }

            .payments-shell-card {
                border-radius: 18px;
            }

            .payments-topbar,
            .method-panel-header,
            .payment-card-header {
                grid-template-columns: minmax(0, 1fr);
            }

            .payments-actions,
            .method-stats {
                justify-content: flex-start;
            }

            .form-grid {
                grid-template-columns: minmax(0, 1fr);
            }

            .form-grid .span-2 {
                grid-column: span 1;
            }
        }

        @@media (max-width: 430px) {
            .payments-topbar,
            .payments-layout,
            .cards-grid,
            .cards-list,
            .method-panel-header {
                padding: .8rem;
            }

            .payments-metrics {
                padding: .8rem .8rem 0;
            }

            .methods-sidebar nav {
                grid-template-columns: minmax(0, 1fr);
            }

            .payment-card-summary {
                grid-template-columns: 1.3rem minmax(0, 1fr);
            }

            .payment-card-meta {
                display: none;
            }

            .pay-mini-button,
            .pay-button-row button {
                width: 100%;
            }

            .payment-card-footer .pay-mini-button {
                width: auto;
            }
        }

        .advanced-method-plans {
            border: 1px solid color-mix(in srgb, var(--pal-neutral-450) 15%, transparent);
            border-radius: .9rem;
            background: color-mix(in srgb, var(--pal-neutral-925) 35%, transparent);
            overflow: hidden;
        }

        .advanced-method-plans > summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .65rem;
            padding: .65rem .9rem;
            cursor: pointer;
            list-style: none;
            color: var(--pay-dim);
            font-size: .8rem;
            font-weight: 750;
            user-select: none;
            transition: background-color .15s ease, color .15s ease;
        }

        .advanced-method-plans > summary::-webkit-details-marker {
            display: none;
        }

        .advanced-method-plans > summary:hover {
            background: color-mix(in srgb, var(--pal-neutral-800) 35%, transparent);
            color: var(--pay-muted);
        }

        .advanced-method-plans-note {
            margin: 0;
            padding: .5rem .9rem .4rem;
            border-top: 1px solid var(--pay-line);
            background: color-mix(in srgb, var(--pal-neutral-925) 50%, transparent);
            color: var(--pay-dim);
            font-size: .76rem;
            line-height: 1.45;
        }
    </style>
}

<div class="payments-page">
    <section class="payments-shell-card" aria-labelledby="payments-title">
        <header class="payments-topbar">
            <div>
                <h1 id="payments-title" class="cfgpago-title">Configuración de pagos</h1>
                <p class="cfgpago-sub">
                    Administra medios, tarjetas y planes reutilizables. El ajuste se aplica una sola vez sobre el total.
                    Ajuste positivo = recargo, ajuste negativo = descuento. Cuotas indica la cantidad total de pagos.
                </p>
                <div class="payments-tabs-slot">
                    <partial name="_ConfiguracionPagoTabs" view-data="@(new ViewDataDictionary(ViewData) { { "ConfigPagoTab", "medios" } })" />
                </div>
            </div>
            <div class="payments-actions">
                <a asp-controller="Home" asp-action="Index" class="pay-mini-button">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Volver
                </a>
            </div>
        </header>

        @if (TempData["Error"] != null)
        {
            <div class="toast-msg flex items-center gap-3 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-sm font-semibold text-rose-200" role="alert">
                <span class="material-symbols-outlined">error</span>
                @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="toast-msg flex items-center gap-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm font-semibold text-emerald-200" role="status">
                <span class="material-symbols-outlined">check_circle</span>
                @TempData["Success"]
            </div>
        }

        <section class="payments-metrics" aria-label="Resumen">
            <article class="payments-metric">
                <span class="payments-eyebrow">Medios</span>
                <strong>@Model.TotalMedios</strong>
            </article>
            <article class="payments-metric">
                <span class="payments-eyebrow">Tarjetas</span>
                <strong>@Model.TotalTarjetas</strong>
            </article>
            <article class="payments-metric">
                <span class="payments-eyebrow">Planes</span>
                <strong>@Model.TotalPlanes</strong>
            </article>
            <article class="payments-metric">
                <span class="payments-eyebrow">Inactivos</span>
                <strong>@Model.TotalInactivos</strong>
            </article>
            @if (!puedeEditar)
            {
                <span class="pay-badge pay-badge-muted self-center">Solo lectura</span>
            }
        </section>

        @if (Model.Medios.Count == 0)
        {
            <section class="empty-state text-center">
                <span class="material-symbols-outlined text-5xl text-slate-600">payments</span>
                <h2 class="mt-2 text-xl font-black text-white">Sin medios configurados</h2>
                <p class="empty-copy">Todavia no hay configuracion global de pagos para administrar.</p>
                @if (puedeEditar)
                {
                    <form asp-controller="ConfiguracionPago" asp-action="CrearMedioPagoGlobal" method="post"
                          style="max-width:420px;margin:1.25rem auto 0;text-align:left">
                        @Html.AntiForgeryToken()
                        <div class="grid gap-2">
                            <div>
                                <label class="pay-label">Tipo</label>
                                <select name="TipoPago" class="pay-select">
                                    @foreach (var tipo in Enum.GetValues<TipoPago>().Where(t => t != TipoPago.Tarjeta).GroupBy(t => (int)t).Select(g => g.First()))
                                    {
                                        <option value="@tipo">@TipoPagoDisplay(tipo)</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="pay-label">Nombre</label>
                                <input name="Nombre" maxlength="100" required class="pay-field" placeholder="Ej: Efectivo, Visa, Transferencia" />
                            </div>
                            <label class="pay-check">
                                <input name="Activo" type="checkbox" value="true" checked />
                                Activo
                            </label>
                        </div>
                        <div class="pay-button-row" style="justify-content:center">
                            <button type="submit" class="pay-mini-button primary">
                                <span class="material-symbols-outlined text-[17px]">add_circle</span>
                                Crear primer medio
                            </button>
                        </div>
                    </form>
                }
            </section>
        }
        else
        {
            <div class="payments-layout">
                <aside class="methods-sidebar" aria-label="Metodos de pago">
                    <div class="payments-eyebrow">Metodos</div>
                    <nav>
                        @for (var i = 0; i < Model.Medios.Count; i++)
                        {
                            var medio = Model.Medios[i];
                            var totalPlanesMetodo = medio.Planes.Count;
                            var totalTarjetasMetodo = medio.Tarjetas.Count(t => t.Activa);
                            var esMedioSeleccionado = medioSeleccionado?.Id == medio.Id;
                            // Igual que en el panel principal: si el medio no admite ni tarjetas ni
                            // planes propios (hoy solo Credito personal), "0 tarjetas"/"0" sugeriria
                            // un estado vacio completable aca mismo, cuando en realidad esta bloqueado
                            // por diseno y se administra en su propia pantalla.
                            var permiteTarjetasMetodo = medio.TipoPago == TipoPago.TarjetaCredito || medio.TipoPago == TipoPago.TarjetaDebito;
                            var permitePlanesMetodo = medio.TipoPago != TipoPago.CreditoPersonal && medio.TipoPago != TipoPago.Tarjeta;
                            var gestionPropiaMetodo = !permiteTarjetasMetodo && !permitePlanesMetodo;
                            <a asp-controller="ConfiguracionPago"
                               asp-action="MediosPago"
                               asp-route-medioId="@medio.Id"
                               class="method-card @(esMedioSeleccionado ? "is-selected" : "")"
                               aria-current="@(esMedioSeleccionado ? "page" : null)">
                                <span class="material-symbols-outlined">@MetodoIcon(medio.TipoPago)</span>
                                <span class="min-w-0">
                                    <span class="method-name">@TipoPagoDisplay(medio.TipoPago)</span>
                                    <span class="method-meta">
                                        @(gestionPropiaMetodo
                                            ? "Config. propia"
                                            : $"{totalTarjetasMetodo} tarjeta{(totalTarjetasMetodo == 1 ? "" : "s")}")
                                    </span>
                                </span>
                                @if (gestionPropiaMetodo)
                                {
                                    <span class="method-count" title="Se administra en su propia pantalla">—</span>
                                }
                                else
                                {
                                    <span class="method-count" title="@totalPlanesMetodo planes">@totalPlanesMetodo</span>
                                }
                            </a>
                        }
                    </nav>
                    @if (puedeEditar)
                    {
                        <details class="pay-details" style="margin-top:.65rem">
                            <summary class="compact-summary">
                                <span class="inline-flex items-center gap-2">
                                    <span class="material-symbols-outlined">add_circle</span>
                                    Agregar metodo
                                </span>
                            </summary>
                            <div class="details-body">
                                <form asp-controller="ConfiguracionPago" asp-action="CrearMedioPagoGlobal" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="grid gap-2">
                                        <div>
                                            <label class="pay-label">Tipo</label>
                                            <select name="TipoPago" class="pay-select">
                                                @foreach (var tipo in Enum.GetValues<TipoPago>().Where(t => t != TipoPago.Tarjeta).GroupBy(t => (int)t).Select(g => g.First()))
                                                {
                                                    <option value="@tipo">@TipoPagoDisplay(tipo)</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label class="pay-label">Nombre</label>
                                            <input name="Nombre" maxlength="100" required class="pay-field" />
                                        </div>
                                        <label class="pay-check">
                                            <input name="Activo" type="checkbox" value="true" checked />
                                            Activo
                                        </label>
                                    </div>
                                    <div class="pay-button-row">
                                        <button type="submit" class="pay-mini-button primary">
                                            <span class="material-symbols-outlined text-[17px]">save</span>
                                            Crear
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </details>
                    }
                </aside>

                <div class="payments-main">
                    @if (medioSeleccionado != null)
                    {
                        var medio = medioSeleccionado;
                        var permiteTarjetas = medio.TipoPago == TipoPago.TarjetaCredito || medio.TipoPago == TipoPago.TarjetaDebito;
                        var permitePlanesGlobales = medio.TipoPago != TipoPago.CreditoPersonal && medio.TipoPago != TipoPago.Tarjeta;
                        var tarjetasActivas = medio.Tarjetas
                            .Where(t => t.Activa)
                            .OrderBy(t => t.TipoTarjeta)
                            .ThenBy(t => t.Nombre)
                            .ToList();
                        var tarjetasQuitadas = medio.Tarjetas
                            .Where(t => !t.Activa)
                            .OrderBy(t => t.TipoTarjeta)
                            .ThenBy(t => t.Nombre)
                            .ToList();
                        var planesGenerales = medio.Planes
                            .Where(p => p.ConfiguracionTarjetaId is null)
                            .OrderByDescending(p => p.Activo)
                            .ThenBy(p => p.Orden)
                            .ThenBy(p => p.CantidadCuotas)
                            .ToList();
                        var totalPlanes = medio.Planes.Count;

                        <section id="medio-@medio.Id" class="method-panel">
                            <header class="method-panel-header">
                                <div>
                                    <div class="method-heading">
                                        <span class="material-symbols-outlined text-blue-300">@MetodoIcon(medio.TipoPago)</span>
                                        <h2>@TipoPagoDisplay(medio.TipoPago)</h2>
                                        <span class="@EstadoClass(medio.Activo)">@(medio.Activo ? "Activo" : "Inactivo")</span>
                                        <span class="pay-badge pay-badge-muted">@medio.Nombre</span>
                                    </div>
                                    <p class="method-copy">
                                        @(!string.IsNullOrWhiteSpace(medio.Descripcion)
                                            ? medio.Descripcion
                                            : MetodoCopyFallback(permiteTarjetas, permitePlanesGlobales))
                                    </p>
                                    @if (medio.TieneRecargo || medio.PermiteDescuento)
                                    {
                                        <p class="legacy-note">
                                            Campos legacy de recargo/descuento conservados solo como compatibilidad; la configuracion operativa vive en planes.
                                        </p>
                                    }
                                </div>
                                <div class="method-stats">
                                    @* Estos badges solo tienen sentido para medios que realmente admiten tarjetas/planes
                                       propios (ver permiteTarjetas/permitePlanesGlobales). Para Credito personal (ninguno
                                       de los dos aplica) mostrar "0 tarjetas"/"0 planes" sugeria un estado vacio por
                                       completar aca mismo, cuando en realidad esta bloqueado por diseno: se administra en
                                       la pantalla de credito personal (ver aviso mas abajo). *@
                                    @if (permiteTarjetas)
                                    {
                                        <span class="pay-badge pay-badge-muted">@tarjetasActivas.Count tarjeta@(tarjetasActivas.Count == 1 ? "" : "s") activa@(tarjetasActivas.Count == 1 ? "" : "s")</span>
                                        @if (tarjetasQuitadas.Count > 0)
                                        {
                                            <span class="pay-badge pay-badge-off">@tarjetasQuitadas.Count quitada@(tarjetasQuitadas.Count == 1 ? "" : "s")</span>
                                        }
                                    }
                                    @if (permitePlanesGlobales)
                                    {
                                        <span class="pay-badge pay-badge-muted">@totalPlanes plan@(totalPlanes == 1 ? "" : "es")</span>
                                    }
                                    @if (puedeEditar)
                                    {
                                        <details class="pay-details" style="flex-basis:100%;margin-top:.5rem">
                                            <summary class="compact-summary">
                                                <span class="inline-flex items-center gap-2">
                                                    <span class="material-symbols-outlined">edit</span>
                                                    Editar metodo
                                                </span>
                                            </summary>
                                            <div class="details-body">
                                                <form asp-controller="ConfiguracionPago" asp-action="EditarMedioPagoGlobal" asp-route-id="@medio.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="grid gap-2">
                                                        <div>
                                                            <label class="pay-label">Nombre</label>
                                                            <input name="Nombre" maxlength="100" value="@medio.Nombre" required class="pay-field" />
                                                        </div>
                                                        <div>
                                                            <label class="pay-label">Descripcion</label>
                                                            <input name="Descripcion" maxlength="500" value="@medio.Descripcion" class="pay-field" />
                                                        </div>
                                                        <label class="pay-check">
                                                            <input name="Activo" type="checkbox" value="true" @(medio.Activo ? "checked" : "") />
                                                            Activo
                                                        </label>
                                                    </div>
                                                    <div class="pay-button-row">
                                                        <button type="submit" class="pay-mini-button primary">
                                                            <span class="material-symbols-outlined text-[17px]">save</span>
                                                            Guardar
                                                        </button>
                                                    </div>
                                                </form>
                                                <form asp-controller="ConfiguracionPago" asp-action="EliminarMedioPagoGlobal" asp-route-id="@medio.Id" method="post"
                                                      class="pay-button-row"
                                                      data-confirm="Eliminar este medio de pago? Se ocultara de la operatoria (soft delete).">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="pay-mini-button danger">
                                                        <span class="material-symbols-outlined text-[17px]">delete</span>
                                                        Eliminar metodo
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </header>

                            @if (medio.TipoPago == TipoPago.CreditoPersonal)
                            {
                                <div class="credit-debt">
                                    <strong>Credito personal tiene configuracion propia por tasa, scoring y perfiles de credito.</strong>
                                    <p class="mt-1 text-sm text-amber-100/80">Los cambios operativos se administran en la pantalla de configuracion de credito.</p>
                                    <a asp-controller="ConfiguracionPago" asp-action="CreditoPersonal" class="pay-mini-button mt-2">
                                        <span class="material-symbols-outlined text-[17px]">tune</span>
                                        @(puedeEditar ? "Administrar credito personal" : "Ver credito personal")
                                    </a>
                                </div>
                            }

                            <p class="px-4 py-2 text-xs text-slate-500">
                                Quitar oculta el elemento para nuevas operaciones, pero conserva el historial. Si se vuelve a cargar el mismo dato, se reactiva.
                            </p>

                            @if (permiteTarjetas)
                            {
                                <div class="cards-list" aria-label="Tarjetas activas del metodo">
                                    @foreach (var tarjeta in tarjetasActivas)
                                    {
                                        var planesTarjeta = medio.Planes
                                            .Where(p => p.ConfiguracionTarjetaId == tarjeta.Id)
                                            .OrderByDescending(p => p.Activo)
                                            .ThenBy(p => p.Orden)
                                            .ThenBy(p => p.CantidadCuotas)
                                            .ToList();
                                        var planesActivosTarjeta = planesTarjeta.Count(p => p.Activo);
                                        var planesInactivosTarjeta = planesTarjeta.Count(p => !p.Activo);

                                        <details class="payment-card-accordion">
                                            <summary class="payment-card-summary">
                                                <span class="payment-card-chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
                                                <span class="payment-card-main">
                                                    <strong class="card-title">@tarjeta.Nombre</strong>
                                                    <span class="pay-badge pay-badge-muted">@TipoTarjetaDisplay(tarjeta.TipoTarjeta)</span>
                                                    <span class="@EstadoClass(tarjeta.Activa)">@(tarjeta.Activa ? "Activa" : "Inactiva")</span>
                                                </span>
                                                <span class="payment-card-meta">
                                                    @if (planesActivosTarjeta > 0)
                                                    {
                                                        <span class="pay-badge pay-badge-ok">@planesActivosTarjeta cuota@(planesActivosTarjeta == 1 ? "" : "s") activa@(planesActivosTarjeta == 1 ? "" : "s")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="pay-badge pay-badge-muted">Sin cuotas activas</span>
                                                    }
                                                    @if (planesInactivosTarjeta > 0)
                                                    {
                                                        <span class="pay-badge pay-badge-off">@planesInactivosTarjeta inactiva@(planesInactivosTarjeta == 1 ? "" : "s")</span>
                                                    }
                                                </span>
                                            </summary>

                                            <div class="payment-card-body">
                                                @if (!tarjeta.Activa)
                                                {
                                                    <p class="inactive-card-note">
                                                        Tarjeta quitada para nuevas operaciones. Puede reactivarse desde el footer de este bloque.
                                                    </p>
                                                }

                                                <div class="plan-list">
                                                    @if (planesTarjeta.Count == 0)
                                                    {
                                                        <p class="empty-copy px-1">
                                                            Sin cuotas activas configuradas.
                                                            Agregar una cuota para que este disponible en Nueva Venta.
                                                        </p>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var plan in planesTarjeta)
                                                        {
                                                            <details class="plan-row">
                                                                <summary class="plan-summary">
                                                                    <span class="plan-chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
                                                                    <span class="plan-main">
                                                                        <span>@plan.CantidadCuotas cuota@(plan.CantidadCuotas == 1 ? "" : "s") exacta@(plan.CantidadCuotas == 1 ? "" : "s")</span>
                                                                        <span class="@AjusteClass(plan.AjustePorcentaje)">@AjusteFirmado(plan.AjustePorcentaje) @AjusteModo(plan.AjustePorcentaje)</span>
                                                                        <span class="@EstadoClass(plan.Activo)">@(plan.Activo ? "Activo" : "Inactivo")</span>
                                                                    </span>
                                                                </summary>

                                                                @if (puedeEditar && permitePlanesGlobales)
                                                                {
                                                                    <div class="details-body">
                                                                        <form asp-controller="ConfiguracionPago" asp-action="EditarPlanGlobal" asp-route-id="@plan.Id" method="post">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="ConfiguracionPagoId" value="@medio.Id" />
                                                                            <input type="hidden" name="ConfiguracionTarjetaId" value="@tarjeta.Id" />
                                                                            <input type="hidden" name="TipoAjuste" value="@plan.TipoAjuste" />
                                                                            <div class="form-grid">
                                                                                <div>
                                                                                    <label class="pay-label">Cuotas</label>
                                                                                    <input name="CantidadCuotas" type="number" min="1" value="@plan.CantidadCuotas" required class="pay-field" />
                                                                                </div>
                                                                                <div>
                                                                                    <label class="pay-label">Ajuste %</label>
                                                                                    <input name="AjustePorcentaje" type="number" step="0.0001" min="-100.0000" max="999.9999" value="@plan.AjustePorcentaje.ToString(CultureInfo.InvariantCulture)" required class="pay-field" />
                                                                                </div>
                                                                                <div>
                                                                                    <label class="pay-label">Orden</label>
                                                                                    <input name="Orden" type="number" value="@plan.Orden" class="pay-field" />
                                                                                </div>
                                                                                <label class="pay-check">
                                                                                    <input name="Activo" type="checkbox" value="true" checked="@plan.Activo" />
                                                                                    Activo
                                                                                </label>
                                                                                <div>
                                                                                    <label class="pay-label">Etiqueta</label>
                                                                                    <input name="Etiqueta" maxlength="100" value="@plan.Etiqueta" class="pay-field" />
                                                                                </div>
                                                                                <div class="span-2">
                                                                                    <label class="pay-label">Observaciones</label>
                                                                                    <input name="Observaciones" maxlength="500" value="@plan.Observaciones" class="pay-field" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="pay-button-row">
                                                                                <button type="submit" class="pay-mini-button primary">
                                                                                    <span class="material-symbols-outlined text-[17px]">save</span>
                                                                                    Guardar plan
                                                                                </button>
                                                                            </div>
                                                                        </form>
                                                                        <form asp-controller="ConfiguracionPago" asp-action="CambiarEstadoPlanGlobal" asp-route-id="@plan.Id" asp-route-medioId="@medio.Id" method="post" class="pay-button-row">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="activo" value="@(!plan.Activo)" />
                                                                            <button type="submit" class="pay-mini-button @(plan.Activo ? "danger" : "")">
                                                                                <span class="material-symbols-outlined text-[17px]">@(plan.Activo ? "toggle_off" : "toggle_on")</span>
                                                                                @(plan.Activo ? "Quitar cuota" : "Reactivar cuota")
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                }
                                                            </details>
                                                        }
                                                    }

                                                    @if (puedeEditar && permitePlanesGlobales)
                                                    {
                                                        <details class="pay-details">
                                                            <summary class="compact-summary">
                                                                <span class="flex items-center gap-2">
                                                                    <span class="material-symbols-outlined">add_circle</span>
                                                                    Agregar cuota
                                                                </span>
                                                                <span class="pay-badge pay-badge-muted">cuota exacta</span>
