                                                                <div>
                                                                    <label class="pay-label">Orden</label>
                                                                    <input name="Orden" type="number" value="0" class="pay-field" />
                                                                </div>
                                                                <label class="pay-check">
                                                                    <input name="Activo" type="checkbox" value="true" checked />
                                                                    Activo
                                                                </label>
                                                                <div>
                                                                    <label class="pay-label">Etiqueta</label>
                                                                    <input name="Etiqueta" maxlength="100" class="pay-field" />
                                                                </div>
                                                                <div class="span-2">
                                                                    <label class="pay-label">Observaciones</label>
                                                                    <input name="Observaciones" maxlength="500" class="pay-field" />
                                                                </div>
                                                            </div>
                                                            <div class="pay-button-row">
                                                                <button type="submit" class="pay-mini-button primary">
                                                                    <span class="material-symbols-outlined text-[17px]">save</span>
                                                                    Crear plan
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    </article>
                                </div>
                            }
                        </section>
                    }
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const root = document.querySelector('.payments-page');
            if (!root) {
                return;
            }

            // Spinner de envio delegado en el contenedor raiz (no por-formulario): sigue
            // funcionando en los forms que trae el reemplazo AJAX de seccion de abajo, sin
            // necesitar re-bind cada vez que cambia el panel.
            // Cada <label class="pay-label"> seguido de su input/select/textarea queda asociado por
            // for/id (los formularios se repiten por medio, tarjeta y plan: los ids se generan unicos).
            let labelSeq = 0;
            function associateLabels(scope) {
                scope.querySelectorAll('label.pay-label:not([for])').forEach((label) => {
                    const control = label.nextElementSibling;
                    if (!control || !/^(INPUT|SELECT|TEXTAREA)$/.test(control.tagName)) {
                        return;
                    }
                    if (!control.id) {
                        control.id = 'pay-ctl-' + (++labelSeq);
                    }
                    label.htmlFor = control.id;
                });
            }
            associateLabels(root);

            // Confirmacion de acciones destructivas con el dialogo del ERP (data-confirm),
            // en vez del confirm() nativo del navegador.
            root.addEventListener('submit', (event) => {
                const form = event.target.closest('form');
                if (!form || !form.hasAttribute('data-confirm') || form.dataset.confirmed === '1') {
                    return;
                }
                event.preventDefault();
                const message = form.getAttribute('data-confirm');
                const proceed = () => {
                    form.dataset.confirmed = '1';
                    form.requestSubmit();
                };
                if (window.TheBury && typeof window.TheBury.confirmAction === 'function') {
                    window.TheBury.confirmAction(message, proceed);
                } else if (window.confirm(message)) {
                    proceed();
                }
            });

            root.addEventListener('submit', (event) => {
                const form = event.target.closest('form');
                if (event.defaultPrevented || !form || !root.contains(form) || !form.checkValidity()) {
                    return;
                }

                const button = form.querySelector('button[type="submit"]');
                if (!button) {
                    return;
                }

                button.disabled = true;
                button.setAttribute('aria-busy', 'true');

                const icon = button.querySelector('.material-symbols-outlined');
                if (icon) {
                    icon.textContent = 'hourglass_top';
                }
            });

            // Cambiar de medio en el sidebar "METODOS" es una navegacion a otra URL
            // (?medioId=X): como el scroll real de la pagina vive en el contenedor
            // .overflow-y-auto de _Layout (no en el documento), cada navegacion completa
            // reiniciaba esa posicion aunque el usuario solo quisiera ver otra seccion.
            // Se reemplaza el nav de metodos + el panel del medio via fetch de la misma
            // URL en vez de navegar de verdad, asi el documento nunca se recarga y el
            // scroll no se mueve. Los links siguen siendo <a href> reales (progressive
            // enhancement): si el fetch falla, se cae a la navegacion normal.
            let sidebarNav = root.querySelector('.methods-sidebar nav');
            let mainPanel = root.querySelector('.payments-main');
            if (!sidebarNav || !mainPanel) {
                return;
            }

            let loadToken = 0;

            function bindNav(nav) {
                nav.addEventListener('click', (event) => {
                    const link = event.target.closest('a.method-card');
                    if (!link || !nav.contains(link)) {
                        return;
                    }
                    event.preventDefault();
                    loadMedio(link.href, true);
                });
            }

            async function loadMedio(url, pushHistory) {
                const token = ++loadToken;
                root.setAttribute('aria-busy', 'true');
                try {
                    const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) {
                        throw new Error('MediosPago fetch status ' + response.status);
                    }
                    const html = await response.text();
                    if (token !== loadToken) {
                        return;
                    }

                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    const newNav = doc.querySelector('.methods-sidebar nav');
                    const newMain = doc.querySelector('.payments-main');
                    if (!newNav || !newMain) {
                        throw new Error('MediosPago fetch: markup inesperado');
                    }

                    sidebarNav.replaceWith(newNav);
                    mainPanel.replaceWith(newMain);
                    sidebarNav = newNav;
                    mainPanel = newMain;
                    bindNav(sidebarNav);
                    associateLabels(mainPanel);

                    if (pushHistory) {
                        history.pushState({ mediosPago: true }, '', url);
                    }
                    if (doc.title) {
                        document.title = doc.title;
                    }

                    const activeLink = sidebarNav.querySelector('[aria-current="page"]');
                    if (activeLink) {
                        activeLink.focus({ preventScroll: true });
                    }
                } catch (err) {
                    window.location.href = url;
                } finally {
                    if (token === loadToken) {
                        root.removeAttribute('aria-busy');
                    }
                }
            }

            bindNav(sidebarNav);

            window.addEventListener('popstate', () => {
                loadMedio(location.href, false);
            });
        })();
    </script>
}
