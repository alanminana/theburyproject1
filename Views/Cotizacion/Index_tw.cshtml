@{
    ViewData["Title"] = "Cotizacion";
    ViewData["MetaDescription"] = "Simulador read-only de medios de pago para cotizaciones.";
}

@* Vista fina: el cuerpo del cotizador vive en _CotizadorForm, compartido con la
   pestaña Cotizar de Venta/Create. El wrapper .cotz-standalone es el que activa
   el modo pantalla completa en cotizacion-simulador.css; embebido no aplica. *@
<div class="cotz-standalone">
    @Html.AntiForgeryToken()
    <partial name="_CotizadorForm" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/cotizacion-simulador.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/cotizacion-simulador-ui.js" asp-append-version="true"></script>
    <script src="~/js/cotizacion-simulador.js" asp-append-version="true"></script>
}
