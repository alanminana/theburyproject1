@using TheBuryProject.Models.Enums
@using TheBuryProject.Services.Models
@model CotizacionListadoResultado

@{
    ViewData["Title"] = "Cotizaciones guardadas";
    var busqueda = ViewBag.Busqueda as string;
    var estado = ViewBag.Estado as EstadoCotizacion?;
    var fechaDesde = ViewBag.FechaDesde as DateTime?;
    var fechaHasta = ViewBag.FechaHasta as DateTime?;

    string QuoteBadgeClass(EstadoCotizacion e) => e switch
    {
        EstadoCotizacion.Emitida        => "quote-state-badge quote-state-badge--emitida",
        EstadoCotizacion.ConvertidaAVenta => "quote-state-badge quote-state-badge--convertida",
        EstadoCotizacion.Cancelada      => "quote-state-badge quote-state-badge--cancelada",
        EstadoCotizacion.Vencida        => "quote-state-badge quote-state-badge--vencida",
        _                               => "quote-state-badge"
    };

    string QuoteBadgeLabel(EstadoCotizacion e) => e switch
    {
        EstadoCotizacion.ConvertidaAVenta => "Convertida",
        _ => e.ToString()
    };

    string QuoteBadgeIcon(EstadoCotizacion e) => e switch
    {
        EstadoCotizacion.Emitida          => "pending",
        EstadoCotizacion.ConvertidaAVenta => "check_circle",
        EstadoCotizacion.Cancelada        => "cancel",
        EstadoCotizacion.Vencida          => "schedule",
        _                                 => "fiber_manual_record"
    };
}

<div class="mx-auto w-full max-w-7xl space-y-6">
    <section class="rounded-lg border border-slate-800 bg-slate-900/60 p-5">
        @* Sin hero (ERP-UI-STANDARD §4): el título lo da la barra global; la acción primaria va en la
           cabecera de este card. *@
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <h1 class="sr-only">Cotizaciones guardadas</h1>
            <p class="text-sm text-slate-400">Presupuestos persistidos sin venta, caja, factura ni stock.</p>
            <a href="@Url.Action("Index", "Cotizacion")"
               class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-bold text-white transition-colors hover:bg-primary/90">
                <span class="material-symbols-outlined text-lg">add</span>
                Nueva cotización
            </a>
        </div>
        <form method="get" class="grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1fr)_12rem_11rem_11rem_auto] lg:items-end">
            <div>
                <label for="cotlist-busqueda" class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Buscar</label>
                <input id="cotlist-busqueda" name="busqueda" value="@busqueda" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2.5 text-sm text-white" />
            </div>
            <div>
                <label for="cotlist-estado" class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Estado</label>
                <select id="cotlist-estado" name="estado" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2.5 text-sm text-white">
                    <option value="">Todos</option>
                    @foreach (var item in Enum.GetValues<EstadoCotizacion>())
                    {
                        <option value="@item" selected="@(estado == item)">@item</option>
                    }
                </select>
            </div>
            <div>
                <label for="cotlist-desde" class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Desde</label>
                <input id="cotlist-desde" type="date" name="fechaDesde" value="@fechaDesde?.ToString("yyyy-MM-dd")" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2.5 text-sm text-white" />
            </div>
            <div>
                <label for="cotlist-hasta" class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Hasta</label>
                <input id="cotlist-hasta" type="date" name="fechaHasta" value="@fechaHasta?.ToString("yyyy-MM-dd")" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2.5 text-sm text-white" />
            </div>
            <button type="submit" class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-slate-700 bg-slate-800 px-4 text-sm font-bold text-slate-200 hover:bg-slate-700">
                <span class="material-symbols-outlined text-lg">search</span>
                Filtrar
            </button>
        </form>
    </section>

    <section class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60">
        <div class="overflow-x-auto">
            <table data-erp-cards class="w-full min-w-[860px] text-left">
                <thead class="bg-slate-800/60">
                    <tr>
                        <th data-card="title" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Número</th>
                        <th data-card="half" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Fecha</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Cliente</th>
                        <th data-card="half" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Estado</th>
                        <th data-card="half" class="px-4 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-400">Total base</th>
                        <th data-card="half" class="px-4 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-400">Seleccionado</th>
                        <th data-card="actions" class="px-4 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-400">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-white/5">
                            <td class="px-4 py-3 text-sm font-bold text-white">@item.Numero</td>
                            <td class="px-4 py-3 text-sm text-slate-300">@item.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 py-3 text-sm text-slate-300">@item.Cliente</td>
                            <td class="px-4 py-3">
                                <span class="@QuoteBadgeClass(item.Estado)">
                                    <span class="material-symbols-outlined">@QuoteBadgeIcon(item.Estado)</span>
                                    @QuoteBadgeLabel(item.Estado)
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right text-sm font-bold text-white">@item.TotalBase.ToString("C")</td>
                            <td class="px-4 py-3 text-right text-sm text-slate-300">@(item.TotalSeleccionado?.ToString("C") ?? "-")</td>
                            <td class="px-4 py-3 text-right">
                                <a href="@Url.Action("Detalles", "Cotizacion", new { id = item.Id })" class="text-sm font-bold text-primary hover:text-primary/80">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Items.Any())
        {
            <div class="px-4 py-10 text-center text-sm text-slate-500">No hay cotizaciones guardadas para los filtros actuales.</div>
        }
    </section>
</div>
