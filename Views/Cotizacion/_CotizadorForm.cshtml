    <!-- ============================ MODAL: FACTURAR AL CONFIRMAR ============================ -->
    @* COTIZACION-MIVENTA-02 (§10/§11/§12 del pedido): reutiliza EXACTAMENTE el mismo partial
       que ya usa el modal "Emitir factura" de Venta/Details — Views/Venta/_FacturaCamposEmision.cshtml
       — no un segundo cálculo de IVA ni un select A/B/C simplificado. Diferencia clave: como
       todavía no existe una Venta, "Guardar configuración" (nunca "Emitir factura") sólo
       captura la intención en state.facturarConfig — la factura recién se emite al confirmar
       (ConfirmarYFacturarSiCorrespondeAsync, ya existente). Subtotal/IVA/alícuotas se piden a
       /conversion/factura-preview (mismo cálculo que ConvertirAVentaAsync, ver
       CotizacionConversionService.PreviewFacturaAsync) — nunca se recalculan en este JS. *@
    <div id="modal-facturar-config" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm overflow-y-auto" onclick="if(event.target===this)closeModal('modal-facturar-config')" role="dialog" aria-modal="true" aria-labelledby="cotizacion-facturar-modal-title">
        <div class="min-h-full flex items-center justify-center p-4">
            <div class="cotz-modal panel w-full max-w-lg p-4">
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-emerald-400" style="font-size:20px">receipt_long</span>
                    </div>
                    <div class="min-w-0">
                        <h3 id="cotizacion-facturar-modal-title" class="text-base font-semibold text-white">Facturar al confirmar</h3>
                        <p class="text-sm text-slate-400 mt-0.5">Se emitirá recién al confirmar la venta — esto sólo guarda la configuración.</p>
                    </div>
                </div>
                <div class="mt-4 space-y-3">
                    @* IncludeNames=false: cuando este parcial se embebe en Venta/Create, el
                       Cotizador vive DENTRO de #venta-form (ver comentario de cabecera de este
                       archivo) — ningún input propio lleva `name` para no filtrar al POST de la
                       venta; este modal nunca hace un submit real, sólo lee por id. *@
                    @{ ViewData["IdPrefix"] = "cotizacion-factura-"; ViewData["IncludeNames"] = false; }
                    <partial name="_FacturaCamposEmision" model="new FacturaViewModel()" view-data="ViewData" />
                </div>
                <div class="mt-4 flex justify-end gap-2">
                    <button type="button" id="cotizacion-facturar-cancelar" class="btn btn-ghost">Cancelar</button>
                    <button type="button" id="cotizacion-facturar-guardar" class="btn btn-primary">
                        <span class="material-symbols-outlined" style="font-size:18px">save</span> Guardar configuración
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================ MODAL: CONFIRMAR VENTA ============================ -->
    @* Venta/Create no tiene hoy un paso de confirmación previo al submit final (auditado
       antes de implementar esto) — se agrega uno liviano acá porque §CONFIRMACIÓN FINAL del
       pedido lo pide explícitamente para la POC; no reemplaza ninguna validación real, sólo
       resume lo que ya se va a enviar. *@
    <div id="modal-confirmar-venta" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm overflow-y-auto" onclick="if(event.target===this)closeModal('modal-confirmar-venta')" role="dialog" aria-modal="true" aria-labelledby="confirmar-venta-title">
        <div class="min-h-full flex items-center justify-center p-4">
            <div class="cotz-modal panel w-full max-w-md p-4">
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-emerald-400" style="font-size:20px">task_alt</span>
                    </div>
                    <div class="min-w-0">
                        <h3 id="confirmar-venta-title" class="text-base font-semibold text-white">Confirmar Mi Venta</h3>
                        <p class="text-sm text-slate-400 mt-0.5">Revisá antes de continuar.</p>
                    </div>
                </div>
                <dl id="cotizacion-confirmar-resumen" class="mt-4 space-y-1.5 text-sm"></dl>
                <div class="mt-4 flex justify-end gap-2">
                    <button type="button" id="cotizacion-confirmar-cancelar" class="btn btn-ghost">Cancelar</button>
                    <button type="button" id="cotizacion-confirmar-aceptar" class="btn btn-primary">
                        <span class="material-symbols-outlined" style="font-size:18px">task_alt</span>
                        <span data-confirmar-aceptar-label>Confirmar Mi Venta</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================ MODAL: QUITAR PRODUCTO ============================ -->
    <div id="modal-quitar-producto" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm overflow-y-auto" onclick="if(event.target===this)closeModal('modal-quitar-producto')" role="dialog" aria-modal="true" aria-labelledby="quitar-title">
        <div class="min-h-full flex items-center justify-center p-4">
            <div class="cotz-modal panel w-full max-w-md p-4">
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-lg bg-red-500/10 border border-red-500/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-red-400" style="font-size:20px">warning</span>
                    </div>
                    <div>
                        <h3 id="quitar-title" class="text-base font-semibold text-white">Quitar producto</h3>
                        <p class="text-sm text-slate-400 mt-0.5">Los resultados simulados quedarán desactualizados.</p>
                    </div>
                </div>
                <div class="mt-4 flex justify-end gap-2">
                    <button type="button" class="btn btn-ghost" onclick="closeModal('modal-quitar-producto')">Cancelar</button>
                    <button type="button" id="cotizacion-quitar-confirm" class="btn btn-amber">
                        <span class="material-symbols-outlined" style="font-size:18px">delete</span> Quitar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>
