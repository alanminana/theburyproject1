                                placeholder="Ej: Cliente con legajo en trámite, aprobado por gerencia..."></textarea>
                            <p id="plan-excepcion-motivo-error" class="hidden text-[11px] text-red-500 mt-1">El motivo es obligatorio.</p>
                        </div>
                        <div class="flex gap-2">
