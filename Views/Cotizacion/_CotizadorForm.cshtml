                            </button>
                            <button type="button" data-cotizacion-excepcion-cancelar
                                class="flex-1 py-2.5 text-[11px] font-bold text-slate-500 bg-slate-800 rounded-lg hover:bg-slate-700 transition-all">
                                Cancelar
                            </button>
                        </div>
                    </div>
                    <div id="plan-excepcion-resumen-wrap" class="hidden">
                        <p class="text-xs font-bold text-orange-400 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">shield_question</span>
                            Excepción solicitada
                        </p>
                        <p class="text-[11px] text-slate-400 mt-1">
                            Pendiente de autorización — se aplica al continuar. Motivo: <span id="plan-excepcion-resumen"></span>
                        </p>
