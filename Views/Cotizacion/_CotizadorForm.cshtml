                        <span data-simular-label>Simular cotización</span>
                    </button>
                    @* Contextual, no ambiental: sólo se muestra para pending/error (setQuoteState
                       en cotizacion-simulador-ui.js). El estado permanente vive únicamente en
                       #estado-banner del topbar. *@
                    <p id="cotizacion-simular-estado" class="hidden" aria-live="polite"></p>
                </div>
            </div>
        </div>

        <!-- =================== RESULTADOS · COMPARADOR =================== -->
        <div class="col" data-zone="resultados">
            <section class="panel flex-1">
                <div class="panel-head panel-head--stack">
                    <div class="min-w-0">
                        <h2 class="sec-title">Comparar alternativas de pago</h2>
                        <p class="sec-sub">Elegí la mejor opción para tu cliente. Los importes incluyen recargos del plan.</p>
                    </div>
                    @* §3/§11: los filtros de medios dejan de ocupar una banda permanente de
                       chips arriba del comparador (ruido fijo para una acción ocasional) y
                       pasan a un desplegable. Mismos checkboxes, mismos data-cotizacion-medio
                       — buildRequest() los sigue leyendo con el mismo selector. *@
                    <details class="medios-filtro ml-auto">
                        <summary class="link-sub">
                            <span class="material-symbols-outlined" style="font-size:14px">filter_alt</span> Filtrar medios
                        </summary>
                        <div class="medios-filtro__body">
                            <label class="medio-chip"><input type="checkbox" data-cotizacion-medio="incluirEfectivo" checked>Efectivo</label>
                            <label class="medio-chip"><input type="checkbox" data-cotizacion-medio="incluirTransferencia" checked>Transferencia</label>
                            <label class="medio-chip"><input type="checkbox" data-cotizacion-medio="incluirTarjetaCredito" checked>T. crédito</label>
                            <label class="medio-chip"><input type="checkbox" data-cotizacion-medio="incluirTarjetaDebito" checked>T. débito</label>
                            <label class="medio-chip"><input type="checkbox" data-cotizacion-medio="incluirMercadoPago" checked>MercadoPago</label>
                            <label class="medio-chip"><input type="checkbox" data-cotizacion-medio="incluirCreditoPersonal" checked>Crédito personal</label>
                        </div>
                    </details>
                </div>

                <div class="panel-body" style="padding:0">
                    @* §26: vacío compacto, con la acción que lo resuelve nombrada. *@
                    <div id="cotizacion-resultados-vacio" class="empty-mini empty-mini--block">
                        <span class="material-symbols-outlined" style="font-size:20px">payments</span>
                        <span><strong class="text-slate-200 font-medium">Sin simulación todavía.</strong> Simulá la cotización para comparar opciones.</span>
                    </div>

                    <!-- resultados -->
                    <div id="cotizacion-resultados" class="hidden">
                        <table class="rtable">
                            <thead>
                                <tr>
                                    <th>Medio de pago</th>
                                    <th class="r">Total final</th>
                                    <th>Plan / cuotas</th>
                                    <th class="r">Cuota estimada</th>
                                    <th class="r">Recargo</th>
                                    <th>Estado</th>
                                    <th class="r">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="cotizacion-resultados-tbody"></tbody>
                        </table>
                    </div>
                </div>

            </section>

            <!-- =================== SELECCIÓN + CONTINUAR =================== -->
            @* §16/§17: el flujo termina acá, debajo del comparador — resumen de la
               opción elegida + como máximo una acción primaria ("Continuar con esta
               opción"), con Guardar cotización explícitamente secundaria (§10: ya no
               es una barra verde a ancho completo). Post-guardado, el mismo pie
               cambia a "Pasar a venta" / Ver / Nueva, sin mover el punto de cierre. *@
            <div class="panel-foot seleccion-bar">
                <div id="cotizacion-seleccion-resumen" class="seleccion-resumen" aria-live="polite">
                    <span class="seleccion-resumen__label">Sin opción elegida</span>
                    <span class="seleccion-resumen__valor">Simulá y elegí una alternativa para continuar.</span>
                </div>
                @* COTIZACION-MIVENTA-02 (§4/§CIERRE MI VENTA del pedido): bloque contextual
                   que reemplaza el intento silencioso de "Confirmar Mi Venta" cuando el
                   preflight (/conversion/preflight, sólo lectura) detecta que no puede
                   terminar — nunca se crea la Venta a ciegas ni se navega sola al wizard.
                   Cada bloqueo puede traer una acción resolutiva puntual (Abrir caja en una
                   pestaña nueva sin perder el estado del Cotizador, o Continuar con wizard
                   cuando el propio backend exige el paso de configuración de Crédito
                   personal). Ver renderBloqueos() en cotizacion-simulador.js. *@
                <div id="cotizacion-bloqueos" class="hidden cotz-bloqueos" role="alert" aria-live="assertive">
                    <div class="cotz-bloqueos__title">
                        <span class="material-symbols-outlined" style="font-size:16px">block</span>
                        <span id="cotizacion-bloqueos-titulo">No se puede confirmar todavía</span>
                    </div>
                    <ul id="cotizacion-bloqueos-lista" class="cotz-bloqueos__lista"></ul>
                </div>
                <div id="cotizacion-acciones-pre" class="seleccion-acciones">
                    <button id="cotizacion-guardar" type="button" class="btn btn-soft" disabled>
                        <span class="material-symbols-outlined" style="font-size:16px">save</span> Guardar cotización
                    </button>
                    @* COTIZACION-MIVENTA-02 (§7/§8/§26 del pedido): segundo camino explícito
                       para poder comparar ambas experiencias durante la POC — nunca deriva
                       silenciosamente, sólo se activa con este click. Crea la Venta SIN
                       confirmar (mismo ConvertirAVentaAsync existente, ConfirmarVenta=false)
                       y va siempre a Venta/Edit, que ya reconstituye el wizard completo
                       desde la Venta persistida (cliente, productos, medio, plan, envío,
                       observaciones) — no hace falta ningún DTO ni mecanismo nuevo. Secundaria:
                       nunca compite en peso visual con la acción primaria. *@
                    <button id="cotizacion-continuar-wizard" type="button" class="btn btn-soft" disabled>
                        Continuar con wizard <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
                    </button>
                    @* COTIZACION-WORKSTATION-01 (§16/§17): antes "Guardar" era la única
                       acción de pre-guardado y hacía las DOS cosas (guardar + convertir a
                       venta) con peso de CTA primario verde. Se separan en dos intenciones
                       distintas con jerarquía explícita: Guardar cotización (secundaria,
                       sólo persiste) y Continuar con esta opción (primaria, guarda y pasa
                       a venta con la alternativa elegida). Mismos endpoints y misma
                       secuencia interna — ver guardarCotizacion()/continuarConOpcion() en
                       cotizacion-simulador.js; no cambia ninguna regla de negocio. *@
                    @* COTIZACION-MIVENTA-02: "Confirmar Mi Venta" corre el preflight ANTES
                       de crear la Venta (§NUEVA REGLA FUNDAMENTAL del pedido) — sólo si
                       Listo=true guarda, convierte, confirma y factura si corresponde, y
                       termina SIEMPRE en Venta/Details. Si el preflight dice que no puede
                       terminar, se queda en esta pantalla mostrando #cotizacion-bloqueos —
                       nunca crea la Venta a ciegas ni redirige sola al wizard. *@
                    <button id="cotizacion-continuar" type="button" class="btn btn-primary" disabled>
                        <span class="material-symbols-outlined" style="font-size:16px">check</span>
                        <span data-continuar-label>Confirmar Mi Venta</span>
                    </button>
                </div>
                <div id="cotizacion-acciones-post" class="hidden seleccion-acciones">
                    <a id="cotizacion-ver-guardada" href="#" class="link-sub no-underline">
                        <span class="material-symbols-outlined" style="font-size:14px">visibility</span> Ver cotización
                    </a>
                    <button id="cotizacion-nueva" type="button" class="link-sub">
                        <span class="material-symbols-outlined" style="font-size:14px">add</span> Nueva
                    </button>
                    <button id="cotizacion-pasar-venta" type="button" class="btn btn-primary">
                        <span class="material-symbols-outlined" style="font-size:18px">point_of_sale</span> Pasar a venta
                    </button>
                </div>
            </div>

        </div>

    </div>

    <!-- ============================ MODAL: PLAN DETAIL (drawer) ============================ -->
    <div id="modal-plan" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-labelledby="plan-title">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeModal('modal-plan')"></div>
        <aside class="absolute right-0 top-0 h-full w-full sm:w-105 bg-slate-950 border-l border-slate-800 shadow-2xl flex flex-col">
            <header class="px-4 py-3.5 border-b border-slate-800 flex items-start justify-between gap-3">
                <div>
                    <div class="text-[11px] text-slate-500 uppercase tracking-wide">Detalle del plan</div>
