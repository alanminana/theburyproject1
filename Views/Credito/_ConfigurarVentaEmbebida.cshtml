@model ConfiguracionCreditoVentaViewModel
@using TheBuryProject.Models.Enums
@{
    // Fragmento embebido del configurador canónico de Crédito Personal, reutilizado
    // dentro del paso "Crédito" del wizard de Venta (Crear/Editar). Comparte modelo,
    // ids y JS (configurar-venta-credito.js) con la vista standalone ConfigurarVenta_tw:
    // ver ese archivo para la versión de página completa. No incluye <form> propio
    // (vive dentro de #venta-form) ni las acciones de navegación de página completa
    // (volver/cancelar/editar cliente): esas quedan en el wizard.
    var clienteConfig = Model.ClienteConfigPersonalizada;
    var perfilesActivos = Model.PerfilesActivos;
}

<div data-credito-config-embedded data-credito-config>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CreditoId" />
    <input type="hidden" asp-for="VentaId" id="hdn-venta-id" />
    <input type="hidden" asp-for="ClienteId" />
    <input type="hidden" asp-for="Monto" id="hdn-monto-venta" />
    <input type="hidden" asp-for="MontoFinanciado" id="hdn-monto-financiado" />
    @* ML6: Método/Fuente ya no son elegibles en la UI (el porcentaje sale únicamente del
       plan de cuotas). Se transportan como hidden fijos en Global sólo por compatibilidad
       de binding — MetodoCalculo tiene [Required] en el POST y necesita viajar igual. *@
    <input type="hidden" asp-for="MetodoCalculo" id="hdn-metodo-calculo" />
    <input type="hidden" asp-for="FuenteConfiguracion" id="hdn-fuente-configuracion" />
    <input type="hidden" id="hdn-venta-row-version" value="@Model.VentaRowVersionBase64" />

    @if (Model.CreditoEstaConfigurado)
    {
        <div class="alert alert-ok" style="margin-bottom:1rem" data-credito-embebido-ya-configurado>
            <span class="material-symbols-outlined">check_circle</span>
            <span>Crédito configurado. Podés revisar los valores abajo o continuar.</span>
        </div>
    }

    @* ── 4. Configuración editable / 5. Resumen financiero ──────────────
       Configuración = lo que el operador modifica (cuotas, anticipo, gastos, fecha).
       Resumen = el resultado calculado por el servidor. Los valores de sólo lectura
       que antes convivían con los campos editables (precio final, saldo a financiar)
       se sacaron de acá: ya son la fuente principal del Resumen, a la derecha, para no
       repetir el mismo importe con igual jerarquía en dos lugares (VENTA-FORM-PAGO-CREDITO-02B). *@
    @* VENTA-FORM-PAGO-CREDITO-1024-FIX: dentro del wizard este fragmento no ocupa el
       viewport completo — la propia grilla del wizard (venta-page-wizard.css, columna de
       totales con piso de 20rem) ya le deja a este paso un contenedor angosto e independiente
       del viewport (~220px de ancho real a 1024px de viewport, ~480px a 1280px, pero ~590px
       a 768px porque ahí el wizard todavía no arma esa columna — no es monótono con el
       viewport). El split Configuración 2/3 + Resumen 1/3 (antes "lg:grid-cols-3") no gana
       nada partiéndose en un contenedor así de angosto en ningún checkpoint del wizard, así
       que queda apilado siempre acá (Resumen a ancho completo debajo, sin recortarse); la
       grilla interna de "Valores del credito" (antes "md:grid-cols-3") sí reacciona al ancho
       real vía container query (CSS plano en credito-module.css, scopeado a
       [data-credito-config-embedded] — no vía utilities de Tailwind, porque tailwind.css es
       un artefacto pre-compilado que no se regenera en este micro-lote). Igual en standalone
       (ConfigurarVenta_tw.cshtml, markup propio con sus breakpoints originales intactos, no
       se toca) y embebido. *@
    <div class="grid grid-cols-1 gap-4">
        <div class="space-y-4">
            @* VENTA-CREDITO-ARQUITECTURA-VISUAL-01: "Cantidad de cuotas" y "Valores del
               credito" eran dos secciones-card independientes (numeradas 1 y 2), lo que las
               presentaba como dos pasos principales del mismo peso. Se unifican en una sola
               sección "Configurar plan": mismos campos/ids/JS, sólo cambia el agrupamiento
               visual — separadores livianos (border-top) en vez de un límite de card nuevo,
               mismo patrón que ya usaban "Porcentaje de recargo" y "Primera cuota" dentro de
               la vieja sección 2. *@
            <section class="card card-pad">
                <div class="sec-head">
                    <div class="sec-num">1</div>
                    <div>
                        <div class="sec-title">Configurar plan</div>
                        <div class="sec-sub" id="cuotas-rango-info">
                            @if (Model.SinPlanesCompatibles)
                            {
                                <text>Sin cuotas disponibles para esta combinacion de productos.</text>
                            }
                            else
                            {
                                <text>Rango permitido: @Model.CuotasMinPermitidas a @Model.CuotasMaxPermitidas cuotas.</text>
                                @if (!string.IsNullOrWhiteSpace(Model.RestriccionCreditoProductoDescripcion))
                                {
                                    <span>@Model.RestriccionCreditoProductoDescripcion</span>
                                }
                            }
                        </div>
                    </div>
                </div>
                @if (Model.MaxCuotasBase > Model.CuotasMaxPermitidas && Model.MaxCuotasCreditoProducto.HasValue)
                {
                    <div class="alert alert-warn" style="margin-bottom:1rem" data-credito-restriccion-cuotas-producto>
                        <span class="material-symbols-outlined">info</span>
                        <span>
                            Maximo de cuotas reducido por condiciones del producto. El rango base permitia hasta
                            <strong>@Model.MaxCuotasBase cuotas</strong>, pero la configuracion de un producto limita el credito personal a
                            <strong>@Model.MaxCuotasCreditoProducto!.Value cuotas</strong>.
                        </span>
                    </div>
                }
                @if (Model.SinPlanesCompatibles)
                {
                    <div class="alert alert-bad" style="margin-bottom:1rem" data-credito-sin-planes-compatibles>
                        <span class="material-symbols-outlined">block</span>
                        <span>@Model.ClienteConfigPersonalizada.MotivoSinPlanes</span>
                    </div>
                }
                <label asp-for="CantidadCuotas" for="txt-cuotas" class="label">Cantidad de cuotas</label>
                <input asp-for="CantidadCuotas"
                       type="number"
                       min="@Model.CuotasMinPermitidas"
                       max="@Model.CuotasMaxPermitidas"
                       class="field"
                       list="cuotas-habilitadas-list"
                       id="txt-cuotas"
                       disabled="@Model.SinPlanesCompatibles" />
                <datalist id="cuotas-habilitadas-list">
                    @foreach (var plan in Model.ClienteConfigPersonalizada.CuotasHabilitadas)
                    {
                        <option value="@plan.CantidadCuotas">@plan.CantidadCuotas cuotas - @(plan.TasaMensual.HasValue ? $"{plan.TasaMensual.Value:N2}% recargo" : "tasa global")</option>
                    }
                </datalist>

                @* Sólo campos editables acá: precio final y saldo a financiar son resultado,
                   no configuración — su única fuente visual ahora es el Resumen del plan. *@
                <div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid var(--line)">
                    <p class="hint" style="margin-bottom:.75rem">El backend valida los importes finales; esta pantalla solo previsualiza.</p>
                    <div class="grid grid-cols-1 gap-4" data-credito-config-valores-grid>
                        <div>
                            <label asp-for="Anticipo" for="txt-anticipo" class="label">Anticipo</label>
                            <div class="field-money">
                                <span class="cur">$</span>
                                <input asp-for="Anticipo" type="number" step="0.01" min="0" class="field" id="txt-anticipo" />
                            </div>
                        </div>
                        <div>
                            <label asp-for="GastosAdministrativos" for="txt-gastos" class="label">Gastos administrativos</label>
                            <div class="field-money">
                                <span class="cur">$</span>
                                <input asp-for="GastosAdministrativos" type="number" step="0.01" min="0" class="field" id="txt-gastos" />
                            </div>
                            <p class="hint" style="margin-top:.35rem">Concepto informativo aparte: no se distribuye en las cuotas ni forma parte del saldo a financiar.</p>
                        </div>
                        <div>
                            <label asp-for="FechaPrimeraCuota" for="txt-fecha-primera-cuota" class="label">Primera fecha de vencimiento</label>
                            <input asp-for="FechaPrimeraCuota" type="date" class="field" id="txt-fecha-primera-cuota" />
                        </div>
                    </div>
                </div>

                @* Porcentaje de recargo: no es un dato que se edite acá (lo fija el plan de
                   cuotas elegido arriba), por eso queda separado de los campos editables en
                   vez de competir con ellos en la misma grilla. *@
                <div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid var(--line)">
                    <div class="flex items-center justify-between" style="max-width:280px">
                        <label class="label">Porcentaje de recargo total del plan</label>
                        <span id="badge-tasa-fuente" class="chip chip-info hidden"></span>
                    </div>
                    <div style="max-width:280px">
                        @* ML6: read-only, ver ConfigurarVenta_tw.cshtml. *@
                        <input class="field bg-slate-100 dark:bg-slate-800/50 cursor-not-allowed" readonly id="txt-tasa" />
                    </div>
                    <p class="hint" style="margin-top:.35rem">El porcentaje se agrega una sola vez sobre el saldo restante después del anticipo. No es una tasa mensual ni interés compuesto. Lo define el plan de cuotas elegido, no es editable.</p>
                </div>

                <div id="plan-simulando" class="hint hidden" style="margin-top:.75rem" aria-live="polite" data-plan-simulando>
                    <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">progress_activity</span>
                    Calculando el plan con los valores actuales…
                </div>
                <div id="plan-error" class="alert alert-bad hidden" style="margin-top:.75rem" role="alert" aria-live="assertive" tabindex="-1" data-plan-error></div>

                @* CREDITO-VISUAL-02B: "Primera cuota" es un subgrupo dentro de "Configurar
                   plan" — no lleva su propia card completa (border+rounded+fondo), que la
                   pondría visualmente al mismo nivel que la sección entera. Mismo patrón de
                   separador liviano que ya usa "Porcentaje de recargo total del plan" arriba. *@
                <div class="mt-4" style="padding-top:1rem;border-top:1px solid var(--line)"
                     id="primera-cuota-panel" data-primera-cuota-panel>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined" style="color:#f5c518;font-size:16px">payments</span>
                        <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-wide">Primera cuota</h3>
                    </div>

                    <p class="muted text-sm mb-3" id="primera-cuota-no-aplica" data-primera-cuota-no-aplica>
                        El cobro inmediato solo está disponible cuando la primera cuota vence hoy.
                    </p>

                    <div id="primera-cuota-aplica" data-primera-cuota-aplica class="hidden space-y-3">
                        <label class="flex cursor-pointer items-center gap-2 font-semibold text-slate-100">
                            <input asp-for="CobrarPrimeraCuota" type="checkbox" value="true"
                                   class="h-4 w-4 accent-sky-500"
                                   id="chk-cobrar-primera-cuota" data-primera-cuota-cobrar />
                            <span>Cobrar la primera cuota al confirmar la venta</span>
                        </label>

                        <div id="primera-cuota-medio-container" data-primera-cuota-medio-container class="hidden">
                            <label asp-for="MedioPagoPrimeraCuota" for="select-medio-primera-cuota" class="label">Medio de pago</label>
                            <select asp-for="MedioPagoPrimeraCuota" class="field"
                                    id="select-medio-primera-cuota" data-primera-cuota-medio>
                                <option value="Efectivo">Efectivo</option>
                                <option value="Transferencia">Transferencia</option>
                                <option value="Tarjeta Débito">Tarjeta Débito</option>
                                <option value="Tarjeta Crédito">Tarjeta Crédito</option>
                                <option value="Cheque">Cheque</option>
                            </select>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <aside>
            <div class="card card-pad">
                <h3 class="font-semibold text-white mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined" style="color:#f5c518;font-size:20px">summarize</span>
                    Resumen del plan
                </h3>

                @* VENTA-CREDITO-ARQUITECTURA-VISUAL-01: mini-resumen vivo — sólo lo que hace
                   falta para decidir si el plan sirve (cuota, total financiado, cantidad,
                   primer vencimiento). El resto (precio final, anticipo, % de recargo,
                   importe del recargo, gastos, cuotas sin recargo) es apoyo de verificación,
                   no la decisión en sí: pasa a detalle expandible. Mismos ids, mismo JS
                   (configurar-venta-credito.js) — sólo cambia dónde vive cada nodo en el
                   árbol, nunca se duplica un valor ni se agrega una segunda autoridad. *@
                <div id="plan-resumen" class="space-y-3">
                    <div id="plan-resumen-contenido">
                        <div class="result-card is-ok">
                            <div class="result-label" id="plan-cuota-detalle">Cuota</div>
                            <div class="result-value" id="plan-cuota-estimada">$ 0,00</div>
                        </div>
                        <dl class="kv mt-3">
                            <div class="kv-row"><dt>Total financiado</dt><dd class="num" id="plan-total" style="color:#34d399;font-weight:600">$ 0,00</dd></div>
                            <div class="kv-row"><dt>Cantidad de cuotas</dt><dd id="plan-cuotas-label">@Model.CantidadCuotas</dd></div>
                        </dl>
                        <div id="plan-fecha-container" class="alert alert-info hidden" style="margin-top:.8rem">
                            <span class="material-symbols-outlined">event_upcoming</span>
                            <span>Primer vencimiento: <strong id="plan-fecha-pago">-</strong></span>
                        </div>
                        <details class="mt-3" data-plan-detalle-financiero>
                            <summary class="sec-title" style="font-size:.8rem">Ver detalle financiero ▸</summary>
                            <dl class="kv mt-2">
                                <div class="kv-row"><dt>Precio final de venta</dt><dd class="num" id="plan-precio-final">$ @Model.Monto.ToString("N2")</dd></div>
                                <div class="kv-row"><dt>Anticipo</dt><dd class="num" id="plan-anticipo">$ 0,00</dd></div>
                                <div class="kv-row"><dt>Saldo a financiar</dt><dd class="num" id="plan-capital">$ @Model.MontoFinanciado.ToString("N2")</dd></div>
                                <div class="kv-row"><dt>% de recargo total</dt><dd id="plan-tasa">0%</dd></div>
                                <div class="kv-row"><dt>Importe del recargo</dt><dd class="num" id="plan-interes">$ 0,00</dd></div>
                                <div class="kv-row"><dt>Gastos administrativos</dt><dd class="num" id="plan-gastos">$ 0,00</dd></div>
                                <div class="kv-row"><dt>Cuotas sin recargo</dt><dd id="plan-cuotas-sin-recargo">Ninguna</dd></div>
                            </dl>
                        </details>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    @* ── 6. Detalle por cuota — ancho completo ───────────────────────────
       CSR-ML6: tabla completa por cuota — fuente visual final del vector que devuelve
       el servidor (SimularPlanCredito). No se recalcula acá capital, recargo ni total:
       cada fila pinta tal cual cuotas[i] de la respuesta. Antes vivía angosta dentro del
       aside de 1/3 de ancho; en desktop (>=1024) ahora ocupa el ancho completo del paso
       para mostrar N°/Capital/Recargo/Total sin scroll innecesario (VENTA-FORM-PAGO-CREDITO-02B).
       CREDITO-VISUAL-02B: el Resumen del plan ya muestra cantidad de cuotas, monto de
       cuota, total financiado y primer vencimiento — esta tabla es detalle de
       verificación, no información primaria de decisión. Pasa a <details>/<summary>
       nativo, colapsada por defecto: menos densidad visual sin perder la tabla completa
       a un clic, sin accordion JS ni estado de expansión manejado por atributo ARIA
       (accesibilidad nativa del navegador: Enter/Espacio, foco, marcador abierto/cerrado).
       El <summary> se alimenta
       de la misma autoridad JS que ya pinta el Resumen (data.cuotaEstimada, ver
       formatearResumenDetalleCuotas en configurar-venta-credito.js) — nunca recalcula. *@
    <section class="card card-pad mt-4" data-plan-cuotas-detalle>
        <details data-plan-cuotas-detalle-details>
            <summary class="sec-title" data-plan-cuotas-detalle-summary>Detalle por cuota</summary>
            <div class="tbl-wrap" style="border:1px solid var(--line);border-radius:10px;margin-top:.75rem">
                <table class="tbl" id="plan-cuotas-tabla">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th style="text-align:right">Capital</th>
                            <th style="text-align:right">Recargo</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody id="plan-cuotas-tabla-body"></tbody>
                </table>
            </div>
        </details>
    </section>

    @* ── 7. Evaluación preliminar / 8. Acción / Documentación contractual ──
       Mismo contenido y comportamiento que antes (semáforo sin cambios de reglas ni
       colores), reagrupados debajo de la tabla en vez de al costado: quedan subordinados
       a elegibilidad, bloqueantes, configuración y resumen, que se ven primero. Se
       mantiene el ancho angosto que tenían en el aside (mismo agrupamiento, nueva
       posición) para no convertir "Guardar configuración" en un botón de ancho completo,
       sólo en desktop — por debajo de 1024px pasa a ancho completo (ver
       venta-page-wizard.css) para no dejar un hueco vacío a la izquierda cuando
       Configuración/Resumen ya se apilaron a una sola columna. *@
    <div class="mt-4 credito-embebido-cierre">
        <section class="card-2" style="padding:1rem" aria-labelledby="semaforo-title">
            <div class="sec-title" id="semaforo-title">Evaluacion preliminar</div>
            @* VENTA-FORM-RIESGO-01: aclaración siempre visible (no depende del resultado del
               semáforo) de que este indicador es asesorio: informa el riesgo del plan, no
               reemplaza la evaluación crediticia ni condiciona "Guardar configuración" — esa
               elegibilidad ya se resolvió en los bloqueantes/cupo mostrados más arriba. *@
            <p class="hint" style="margin-top:.35rem">Indicador orientativo del riesgo del plan: no determina la aprobación del crédito ni bloquea la confirmación.</p>
            @* VENTA-CREDITO-ARQUITECTURA-VISUAL-01: el badge (dot+label+tag, ej. "Riesgo
               alto · No bloquea") es ya el resumen compacto de una línea — queda siempre
               visible. Mensaje + alertas son la ampliación descriptiva: pasan a un <details>
               propio, colapsado por defecto. Mismos ids, mismo actualizarSemaforo() en
               configurar-venta-credito.js — no se toca el JS, sólo la posición de mensaje/
               alertas dentro del árbol. *@
            <div id="semaforo-panel" class="hidden" style="margin-top:.8rem">
                <div id="semaforo-badge" class="flex items-center justify-between p-3 rounded-lg">
                    <div class="flex items-center gap-3">
                        <div id="semaforo-dot" class="size-4 rounded-full animate-pulse"></div>
                        <span id="semaforo-label" class="font-bold"></span>
                    </div>
                    <span id="semaforo-tag" class="text-[10px] uppercase font-black"></span>
                </div>
                <details class="mt-3" data-semaforo-detalle>
                    <summary class="cursor-pointer text-[11px] font-semibold text-slate-400">Ver evaluación ▸</summary>
                    <p id="semaforo-mensaje" class="muted text-sm italic mt-3"></p>
                    <div id="semaforo-alertas" class="space-y-3 mt-3"></div>
                </details>
            </div>
            <div id="semaforo-vacio" class="ph" style="margin-top:.8rem;padding:1.25rem">
                <span class="material-symbols-outlined">query_stats</span>
                <div class="ph-label">completa condiciones para evaluar</div>
            </div>
        </section>

        @* VENTA-CREDITO-ARQUITECTURA-VISUAL-01: "Confirmar crédito" era ambiguo — este botón
           persiste la configuración del plan (anticipo/cuotas/fecha), no aprueba elegibilidad
           (eso ya se resolvió arriba, en bloqueantes/cupo). Copy alineado con la acción real;
           mismo id/data-hook/comportamiento (venta-credito-embebido.js). *@
        <div class="flex flex-col gap-2" style="margin-top:1rem">
            <button type="button"
                    class="btn btn-success btn-block"
                    id="btn-confirmar-credito"
                    data-credito-embebido-confirmar
                    disabled="@Model.SinPlanesCompatibles">
                <span class="material-symbols-outlined">check_circle</span>
                Guardar configuración
            </button>
            <p id="credito-embebido-confirmar-feedback" class="hint hidden" role="status"></p>
            @* VENTA-CREDITO-ARQUITECTURA-VISUAL-02 (§9): con el plan ya guardado, el paso
               siguiente natural es Revisión — no obligar al operador a buscar el CTA
               contextual del wizard. Sólo aparece cuando el servidor ya confirma el
               crédito configurado (misma condición que el aviso "Crédito configurado" de
               arriba); el click delega en window.VentaWizard.setActiveStep, la misma
               autoridad de navegación que ya usa el resto del wizard. *@
            @if (Model.CreditoEstaConfigurado)
            {
                <button type="button"
                        class="btn btn-block btn-sm"
                        data-credito-embebido-continuar-revision
                        style="margin-top:.5rem">
                    <span class="material-symbols-outlined">arrow_forward</span>
                    Continuar a revisión
                </button>
            }
        </div>

        <section class="card-2" style="margin-top:1rem;padding:1rem" data-credito-embebido-contrato-seccion>
            <div class="sec-title">Documentacion contractual</div>
            @if (Model.ContratoGenerado)
            {
                <p class="hint" data-credito-embebido-contrato-estado>Contrato generado.</p>
                <a asp-controller="ContratoVentaCredito" asp-action="Ver" asp-route-ventaId="@Model.VentaId"
                   target="_blank" rel="noopener" class="btn btn-success btn-block btn-sm" style="margin-top:.75rem">
                    <span class="material-symbols-outlined">print</span>
                    Ver / imprimir contrato
                </a>
            }
            else if (!Model.PlantillaActivaDisponible)
            {
                <div class="alert alert-bad" style="margin-top:.75rem" data-credito-embebido-contrato-estado>
                    <span class="material-symbols-outlined">error</span>
                    <span>No hay ninguna plantilla de contrato activa y vigente.</span>
                </div>
            }
            else
            {
                <p class="hint" data-credito-embebido-contrato-estado>
                    @(Model.CreditoEstaConfigurado ? "Generá el contrato para poder confirmar la venta." : "Confirmá el crédito para habilitar el contrato.")
                </p>
                <button type="button"
                        id="btn-generar-contrato"
                        data-credito-embebido-generar-contrato
                        class="btn btn-amber btn-block btn-sm"
                        style="margin-top:.75rem"
                        disabled="@(!Model.CreditoEstaConfigurado)">
                    <span class="material-symbols-outlined">picture_as_pdf</span>
                    Generar contrato de venta
                </button>
            }
        </section>
    </div>
</div>

<script id="cliente-config-data" data-credito-json="cliente-config" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clienteConfig, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>
