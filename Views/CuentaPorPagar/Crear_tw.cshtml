@model TheBuryProject.ViewModels.ComprobanteProveedorFormViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Nuevo comprobante de proveedor";
    var d = Model.Datos;
    // Formulario nuevo = importes vacíos; si se re-renderiza tras un error, se conserva lo escrito (incluido un IVA en 0).
    var sinImportes = d.ImporteNeto == 0 && d.ImporteIva == 0 && d.ImporteTotal == 0;
    string Importe(decimal v) => sinImportes ? "" : v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<partial name="_CxpAlertas" />

<section class="card-erp-panel mb-4 p-4">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400">
        <a asp-action="Index" class="no-underline hover:text-primary">Cuentas por pagar</a>
        <span class="material-symbols-outlined text-xs" aria-hidden="true">chevron_right</span>
        <span class="text-primary">Nuevo comprobante</span>
    </nav>
    <h1 class="mt-2 text-lg font-bold tracking-tight text-white">Nuevo comprobante de proveedor</h1>
    <p class="mt-1 text-sm text-slate-400">Cargá los datos tal como figuran en el comprobante del proveedor. El ERP no calcula IVA ni modifica costos o stock.</p>
</section>

@if (Model.Proveedor is null)
{
    <section class="card-erp-panel p-4" aria-labelledby="cxp-elegir-proveedor">
        <h2 id="cxp-elegir-proveedor" class="text-base font-bold text-white">1. Elegí el proveedor</h2>
        <form asp-action="Crear" method="get" class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-12">
            <div class="md:col-span-8">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="proveedorId">Proveedor</label>
                <select id="proveedorId" name="proveedorId" required class="@CuentaPorPagarUiHelper.InputClass">
                    <option value="">Seleccioná un proveedor…</option>
                    @foreach (var p in Model.Proveedores)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>
            <input type="hidden" name="tipo" value="@d.Tipo" />
            <div class="flex items-end md:col-span-4">
                <button type="submit" class="btn-erp-primary btn-sm w-full">Continuar</button>
            </div>
        </form>
        @if (!Model.Proveedores.Any())
        {
            <p class="mt-3 text-sm text-slate-400">No hay proveedores cargados. Creá uno desde Proveedores para poder registrar comprobantes.</p>
        }
    </section>
}
else
{
    <form asp-action="Crear" method="post" data-prevent-double-submit class="card-erp-panel space-y-4 p-4" aria-label="Alta de comprobante de proveedor">
        <input type="hidden" name="ProveedorId" value="@Model.Proveedor.Id" />
        <p class="text-sm text-slate-300">Proveedor: <strong class="text-white">@Model.Proveedor.Nombre</strong>
            <a asp-action="Crear" class="ml-2 text-xs text-primary">cambiar</a></p>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
            <div class="md:col-span-3">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="Tipo">Tipo</label>
                <select id="Tipo" name="Tipo" class="@CuentaPorPagarUiHelper.InputClass">
                    @foreach (var t in Enum.GetValues<TipoComprobanteProveedor>())
                    {
                        <option value="@t" selected="@(d.Tipo == t)">@CuentaPorPagarUiHelper.NombreTipo(t)</option>
                    }
                </select>
            </div>
            <div class="md:col-span-5">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="NumeroComprobante">Número de comprobante</label>
                <input id="NumeroComprobante" name="NumeroComprobante" type="text" maxlength="50" required autocomplete="off"
                       value="@d.NumeroComprobante" class="@CuentaPorPagarUiHelper.InputClass" placeholder="Ej.: A-0001-00001234" />
            </div>
            <div class="md:col-span-4">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="OrdenCompraId">Orden de compra (opcional)</label>
                <select id="OrdenCompraId" name="OrdenCompraId" class="@CuentaPorPagarUiHelper.InputClass">
                    <option value="">Sin orden de compra</option>
                    @foreach (var oc in Model.OrdenesCompra)
                    {
                        <option value="@oc.Id" selected="@(d.OrdenCompraId == oc.Id)">@oc.Numero</option>
                    }
                </select>
            </div>
            <div class="md:col-span-3">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="FechaEmision">Fecha de emisión</label>
                <input id="FechaEmision" name="FechaEmision" type="date" required
                       value="@((d.FechaEmision ?? Reloj.HoyComercial()).ToString("yyyy-MM-dd"))" class="@CuentaPorPagarUiHelper.InputClass" />
            </div>
            <div class="md:col-span-3">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="FechaVencimiento">Vencimiento (opcional)</label>
                <input id="FechaVencimiento" name="FechaVencimiento" type="date"
                       value="@d.FechaVencimiento?.ToString("yyyy-MM-dd")" class="@CuentaPorPagarUiHelper.InputClass" />
            </div>
        </div>

        <fieldset class="grid grid-cols-1 gap-4 md:grid-cols-12">
            <legend class="@CuentaPorPagarUiHelper.LabelClass">Importes informados por el proveedor</legend>
            <div class="md:col-span-4">
                <label class="text-sm text-slate-300" for="ImporteNeto">Neto</label>
                <input id="ImporteNeto" name="ImporteNeto" type="number" step="0.01" min="0" inputmode="decimal" required
                       value="@Importe(d.ImporteNeto)" class="@CuentaPorPagarUiHelper.InputClass" />
            </div>
            <div class="md:col-span-4">
                <label class="text-sm text-slate-300" for="ImporteIva">IVA</label>
                <input id="ImporteIva" name="ImporteIva" type="number" step="0.01" min="0" inputmode="decimal" required
                       value="@Importe(d.ImporteIva)" class="@CuentaPorPagarUiHelper.InputClass" />
            </div>
            <div class="md:col-span-4">
                <label class="text-sm text-slate-300" for="ImporteTotal">Total</label>
                <input id="ImporteTotal" name="ImporteTotal" type="number" step="0.01" min="0.01" inputmode="decimal" required
                       value="@Importe(d.ImporteTotal)" class="@CuentaPorPagarUiHelper.InputClass" />
            </div>
            <p class="text-xs text-slate-400 md:col-span-12">Neto + IVA debe coincidir con el total (tolerancia de $0,01). Con cero IVA ingresá 0.</p>
        </fieldset>

        <div>
            <label class="@CuentaPorPagarUiHelper.LabelClass" for="Observaciones">Observaciones (opcional)</label>
            <textarea id="Observaciones" name="Observaciones" rows="2" maxlength="1000" class="@CuentaPorPagarUiHelper.InputClass">@d.Observaciones</textarea>
        </div>

        <div class="flex flex-wrap justify-end gap-2">
            <a asp-action="Index" class="btn-erp-ghost btn-sm no-underline">Cancelar</a>
            <button type="submit" class="btn-erp-primary btn-sm">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">save</span>
                Registrar comprobante
            </button>
        </div>
    </form>
}

<partial name="~/Views/CuentaPorPagar/_AyudaCuentasPorPagar.cshtml" />
