@model TheBuryProject.ViewModels.PagoProveedorFormViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Registrar pago a proveedor";
    var d = Model.Datos;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var filas = Model.Pendientes;
    // Las filas se reenvían en el mismo orden que las pendientes; si el POST falló, se conservan los importes cargados.
    decimal? MontoPrevio(int comprobanteId) =>
        d.Imputaciones.FirstOrDefault(i => i.ComprobanteId == comprobanteId)?.Monto;
}

<partial name="_CxpAlertas" />

<section class="card-erp-panel mb-4 p-4">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400">
        <a asp-action="Index" class="no-underline hover:text-primary">Cuentas por pagar</a>
        <span class="material-symbols-outlined text-xs" aria-hidden="true">chevron_right</span>
        <span class="text-primary">Registrar pago</span>
    </nav>
    <h1 class="mt-2 text-lg font-bold tracking-tight text-white">Registrar pago a proveedor</h1>
    <p class="mt-1 text-sm text-slate-400">Registro administrativo: el pago no genera movimientos de Caja ni cambia el estado de un cheque.</p>
</section>

@if (Model.Proveedor is null)
{
    <section class="card-erp-panel p-4" aria-labelledby="cxp-elegir-proveedor">
        <h2 id="cxp-elegir-proveedor" class="text-base font-bold text-white">1. Elegí el proveedor</h2>
        <form asp-action="Pagar" method="get" class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-12">
            <div class="md:col-span-8">
                <label class="@CuentaPorPagarUiHelper.LabelClass" for="proveedorId">Proveedor</label>
                <select id="proveedorId" name="proveedorId" required class="@CuentaPorPagarUiHelper.InputClass">
                    <option value="">Seleccioná un proveedor…</option>
                    @foreach (var p in Model.Proveedores)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>
            <div class="flex items-end md:col-span-4">
                <button type="submit" class="btn-erp-primary btn-sm w-full">Continuar</button>
            </div>
        </form>
    </section>
}
else if (!filas.Any())
{
    <section class="card-erp-panel px-6 py-12 text-center" data-cxp-vacio>
        <span class="material-symbols-outlined text-4xl text-slate-500" aria-hidden="true">task_alt</span>
        <p class="mt-2 text-base font-semibold text-slate-200">@Model.Proveedor.Nombre no tiene comprobantes con saldo pendiente.</p>
        <a asp-action="Index" asp-route-ProveedorId="@Model.Proveedor.Id" class="btn-erp-secondary btn-sm mt-3 inline-flex no-underline">Ver comprobantes</a>
    </section>
}
else
{
    <form asp-action="Pagar" method="post" class="space-y-4" data-cxp-imputacion aria-label="Registro de pago a proveedor">
        <input type="hidden" name="ProveedorId" value="@Model.Proveedor.Id" />
        <input type="hidden" name="ClaveIdempotencia" value="@d.ClaveIdempotencia" />

        <section class="card-erp-panel space-y-4 p-4" aria-labelledby="cxp-pago-datos">
            <h2 id="cxp-pago-datos" class="text-base font-bold text-white">Pago a @Model.Proveedor.Nombre</h2>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
                <div class="md:col-span-3">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="Fecha">Fecha del pago</label>
                    <input id="Fecha" name="Fecha" type="date" required
                           value="@((d.Fecha ?? Reloj.HoyComercial()).ToString("yyyy-MM-dd"))" class="@CuentaPorPagarUiHelper.InputClass" />
                </div>
                <div class="md:col-span-3">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="Medio">Medio</label>
                    <select id="Medio" name="Medio" class="@CuentaPorPagarUiHelper.InputClass">
                        @foreach (var m in Enum.GetValues<MedioPagoProveedor>())
                        {
                            <option value="@m" selected="@(d.Medio == m)">@CuentaPorPagarUiHelper.NombreMedio(m)</option>
                        }
                    </select>
                </div>
                <div class="md:col-span-3">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="Monto">Monto del pago</label>
                    <input id="Monto" name="Monto" type="number" step="0.01" min="0.01" inputmode="decimal" required data-cxp-monto-pago
                           value="@(d.Monto == 0 ? "" : d.Monto.ToString(inv))" class="@CuentaPorPagarUiHelper.InputClass" />
                </div>
                <div class="md:col-span-3">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="Referencia">Referencia</label>
                    <input id="Referencia" name="Referencia" type="text" maxlength="100" autocomplete="off"
                           value="@d.Referencia" class="@CuentaPorPagarUiHelper.InputClass" placeholder="Nº de transferencia, recibo…" />
                </div>
                <div class="md:col-span-6">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="OrigenFondosId">Origen de los fondos</label>
                    <select id="OrigenFondosId" name="OrigenFondosId" required class="@CuentaPorPagarUiHelper.InputClass">
                        <option value="">Elegí un origen…</option>
                        @foreach (var o in Model.Origenes)
                        {
                            <option value="@o.Id" selected="@(d.OrigenFondosId == o.Id)">@o.Nombre</option>
                        }
                    </select>
                    @if (!Model.Origenes.Any())
                    {
                        <p class="mt-1 text-xs text-amber-300">No hay orígenes de fondos activos: un administrador debe crearlos en <a asp-controller="Tesoreria" asp-action="Index" class="underline">Tesorería</a>.</p>
                    }
                </div>
                <div class="md:col-span-6">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="ChequeId">Cheque emitido (solo con medio Cheque)</label>
                    <select id="ChequeId" name="ChequeId" aria-describedby="cxp-pago-cheque-ayuda" class="@CuentaPorPagarUiHelper.InputClass">
                        <option value="">Sin cheque</option>
                        @foreach (var c in Model.Cheques)
                        {
                            <option value="@c.Id" selected="@(d.ChequeId == c.Id)">@c.Descripcion</option>
                        }
                    </select>
                    <p id="cxp-pago-cheque-ayuda" class="mt-1 text-xs text-slate-400">Un cheque físico respalda un único pago (que puede imputarse a varias facturas) y su importe debe coincidir con el monto.</p>
                </div>
                <div class="md:col-span-6">
                    <label class="@CuentaPorPagarUiHelper.LabelClass" for="Observaciones">Observaciones (opcional)</label>
                    <input id="Observaciones" name="Observaciones" type="text" maxlength="1000"
                           value="@d.Observaciones" class="@CuentaPorPagarUiHelper.InputClass" />
                </div>
            </div>
        </section>

        <section class="card-erp-panel" aria-labelledby="cxp-pago-imputar">
            <div class="border-b border-slate-800 px-4 py-3">
                <h2 id="cxp-pago-imputar" class="text-base font-bold text-white">Imputación a comprobantes pendientes</h2>
                <p class="text-xs text-slate-400">Indicá cuánto del pago se aplica a cada comprobante. La suma debe ser igual al monto del pago y ninguna fila puede superar su saldo.</p>
            </div>
            <div class="table-erp-wrapper" role="region" aria-label="Comprobantes pendientes del proveedor" tabindex="0">
                <table data-erp-cards class="w-full border-collapse text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-800">
                            <th scope="col" data-card="title" class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-400">Comprobante</th>
                            <th scope="col" data-card="half" class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-400">Vencimiento</th>
                            <th scope="col" data-card="half" class="px-3 py-2 text-right text-xs font-bold uppercase tracking-wider text-slate-400">Saldo</th>
                            <th scope="col" data-card="actions" class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-400">Importe a imputar</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        @for (var i = 0; i < filas.Count; i++)
                        {
                            var c = filas[i];
                            var previo = MontoPrevio(c.Id);
                            <tr>
                                <td class="px-3 py-2">
                                    <span class="block font-bold text-primary">@c.NumeroComprobante</span>
                                    <span class="block text-xs text-slate-400">@CuentaPorPagarUiHelper.NombreTipo(c.Tipo)</span>
                                </td>
                                <td class="px-3 py-2 whitespace-nowrap @(c.DiasVencido > 0 ? "text-rose-300 font-semibold" : "text-slate-400")">
                                    @CuentaPorPagarUiHelper.Fecha(c.FechaVencimiento)
                                    @if (c.DiasVencido > 0) { <span class="block text-xs">Vencido hace @c.DiasVencido día@(c.DiasVencido == 1 ? "" : "s")</span> }
                                </td>
                                <td class="px-3 py-2 text-right whitespace-nowrap font-medium">@CuentaPorPagarUiHelper.Moneda(c.SaldoPendiente)</td>
                                <td class="px-3 py-2">
                                    <input type="hidden" name="Imputaciones[@i].ComprobanteId" value="@c.Id" />
                                    <div class="flex items-center gap-2">
                                        <input type="number" step="0.01" min="0" max="@c.SaldoPendiente.ToString(inv)" inputmode="decimal"
                                               name="Imputaciones[@i].Monto" data-cxp-imputar
                                               aria-label="Importe a imputar al comprobante @c.NumeroComprobante"
                                               value="@(previo.HasValue && previo.Value != 0 ? previo.Value.ToString(inv) : "")"
                                               class="@CuentaPorPagarUiHelper.InputClass" />
                                        <button type="button" class="btn-erp-ghost btn-sm shrink-0" data-cxp-saldo="@c.SaldoPendiente.ToString(inv)"
                                                aria-label="Imputar el saldo completo de @c.NumeroComprobante">Saldo</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-800 px-4 py-3">
                <p class="text-sm text-slate-300" role="status" aria-live="polite" data-cxp-resumen>
                    Imputado: <strong data-cxp-total>$ 0,00</strong> · <span data-cxp-diferencia>Ingresá el monto del pago.</span>
                </p>
                <div class="flex gap-2">
                    <a asp-action="Index" class="btn-erp-ghost btn-sm no-underline">Cancelar</a>
                    <button type="submit" class="btn-erp-primary btn-sm" data-cxp-submit>
                        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">payments</span>
                        Registrar pago
                    </button>
                </div>
            </div>
        </section>
    </form>
}

@section Scripts {
    <script src="~/js/cuenta-por-pagar-imputacion.js" asp-append-version="true"></script>
}
