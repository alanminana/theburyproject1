@model TheBuryProject.ViewModels.DashboardViewModel
@using TheBuryProject.ViewModels
@using TheBuryProject.Models.DTOs
@{
    ViewData["Title"] = "Dashboard";
    ViewData["MetaDescription"] = "Panel de control principal del ERP TheBuryProject con métricas de ventas, créditos y alertas operativas.";
    var cuotasVencidas = Model.CuotasVencidasLista ?? new List<CuotaVencidaDto>();
    var cuotasProximas = Model.CuotasProximasVencer ?? new List<CuotaProximaVencerDto>();
    var cuotasVencidasCount = cuotasVencidas.Count;
    // La lista viene acotada (Top 20); los conteos que se muestran salen del total real.
    var cuotasVencidasTotal = Model.CuotasVencidasTotal;
    var stockBajo = Model.ProductosStockBajo;
    var cuotasProximasCount = cuotasProximas.Count;
    var alertasStock = Model.AlertasStockRecientes ?? new List<StockAlertaDto>();
    var destacados = Model.ProductosDestacados ?? new List<ProductoDestacadoDto>();
    // Si el servicio falló el controller entrega un modelo vacío: sin este flag la pantalla diría
    // "Todo al día" con $0, que es un falso positivo peor que mostrar el error.
    var cargaFallida = ViewData["CargaFallida"] is true;
    var puedeVerClientes = User.TienePermiso("clientes", "view");
    // La actividad mezcla ventas (con importes) y clientes: cada tipo exige el permiso de su módulo.
    var actividad = (Model.ActividadReciente ?? new List<ActividadRecienteDto>())
        .Where(a => a.Tipo != "venta" || User.TienePermiso("ventas", "view"))
        .Where(a => a.Tipo != "cliente" || puedeVerClientes)
        .ToList();
    // Origen para "Volver" desde la pantalla de pago de cuota abierta desde este dashboard.
    var pagoCuotaReturnUrl = Url.Action("Index", "Dashboard");
    // Las tablas muestran las primeras filas de listas acotadas por el servicio (Top 20).
    const int filasVisibles = 5;
    const int topServicio = 20;
    var puedeVerCreditos = User.TienePermiso("creditos", "view");
    var puedeReponer = User.TienePermiso("ordenescompra", "create");
    var puedeVerCatalogo = User.TienePermiso("productos", "view");
    // Los importes de ventas y de cuotas son datos financieros: cada bloque exige el permiso de su módulo
    // (el gate del controller es solo dashboard.view). El servicio sigue siendo la autoridad de los datos.
    var puedeVerVentas = User.TienePermiso("ventas", "view");
    var puedeCobrar = User.TienePermiso("cobranzas", "payinstallment");
    // Cobrar (Vencidas) o ver el crédito (Próximas y, sin permiso de cobro, también Vencidas).
    // Sin ninguna acción permitida no se dibuja la columna: un encabezado sobre celdas vacías confunde.
    var mostrarAcciones = puedeCobrar || puedeVerCreditos;
    var colspanCuotas = mostrarAcciones ? 5 : 4;
    // Cada acceso apunta a un controller con [PermisoRequerido] propio: se muestran solo los
    // permitidos para no llevar al usuario a un 403 (el servidor sigue siendo la autoridad).
    var accesosRapidos = new List<(string Controller, string Action, string Icon, string Label, string Tone)>();
    if (User.TienePermiso("ventas", "create")) accesosRapidos.Add(("Venta", "Create", "add_shopping_cart", "Nueva Venta", "success"));
    if (User.TienePermiso("clientes", "create")) accesosRapidos.Add(("Cliente", "Create", "person_add", "Nuevo Cliente", "info"));
    if (User.TienePermiso("reportes", "view")) accesosRapidos.Add(("Reporte", "Index", "receipt_long", "Reportes", "violet"));
    if (puedeVerCatalogo) accesosRapidos.Add(("Catalogo", "Index", "box_edit", "Catálogo", "violet"));
    if (User.TienePermiso("caja", "view")) accesosRapidos.Add(("Caja", "Index", "point_of_sale", "Caja", "success"));
    if (puedeVerCreditos) accesosRapidos.Add(("Credito", "Index", "credit_card", "Créditos", "info"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-module.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/horizontal-scroll-affordance.css" asp-append-version="true" />
}

<div class="space-y-6">

    <!-- Header de página (ERP-UI-STANDARD §4): el título visible ya lo muestra la barra global
         (_Layout usa <h2>), así que el <h1> queda solo para lectores de pantalla y lo único
         visible es el estado real del día: qué está pendiente o "Todo al día". Sin breadcrumb
         (Dashboard es la raíz de navegación) ni acciones primarias (las cubre "Accesos rápidos"). -->
    <div>
        <h1 class="sr-only">Dashboard</h1>
        <p data-dashboard-status role="status" class="dashboard-status text-base text-slate-300">
            @if (cargaFallida)
            {
                <span class="inline-flex items-center gap-1.5 font-semibold text-red-400">
                    <span class="material-symbols-outlined text-xl" aria-hidden="true">error</span>
                    No pudimos cargar los datos del día
                </span>
            }
            else if ((!puedeVerCreditos || cuotasVencidasTotal == 0) && stockBajo == 0)
            {
                <span class="inline-flex items-center gap-1.5 font-semibold text-emerald-400">
                    <span class="material-symbols-outlined text-xl" aria-hidden="true">check_circle</span>
                    Todo al día
                </span>
                <span>@(puedeVerCreditos ? "Sin cuotas vencidas ni productos por reponer." : "Sin productos por reponer.")</span>
            }
            else
            {
                @if (puedeVerCreditos && cuotasVencidasTotal > 0)
                {
                    <a href="#cuotas-por-cobrar" class="dashboard-status-link inline-flex items-center gap-1.5 font-semibold text-red-400">
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">schedule</span>
                        @cuotasVencidasTotal @(cuotasVencidasTotal == 1 ? "cuota vencida" : "cuotas vencidas")
                    </a>
                }
                @if (stockBajo > 0)
                {
                    <a href="#alertas-stock" class="dashboard-status-link inline-flex items-center gap-1.5 font-semibold text-orange-400">
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">inventory_2</span>
                        @stockBajo @(stockBajo == 1 ? "producto por reponer" : "productos por reponer")
                    </a>
                }
            }
        </p>
    </div>

    <!-- Main + Sidebar -->
    <div class="dashboard-main-grid grid gap-6">

        <!-- Accesos rápidos: primera acción de mostrador. En una columna (mobile/tablet) van arriba, no al final. -->
        @if (accesosRapidos.Count > 0)
        {
            <div class="dashboard-area-accesos">
                <section class="card-erp-panel p-4">
                    <div class="dashboard-acceso-head mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-slate-400 text-[18px]" aria-hidden="true">bolt</span>
                        <h2 class="text-xs font-bold uppercase tracking-wide text-slate-300">Accesos rápidos</h2>
                    </div>
                    <div class="dashboard-accesos grid grid-cols-2 gap-2">
                        @foreach (var acceso in accesosRapidos)
                        {
                            <a asp-controller="@acceso.Controller" asp-action="@acceso.Action"
                               class="dash-tone-@acceso.Tone flex flex-col items-center justify-center gap-1.5 rounded-xl border border-slate-800 bg-slate-800/30 py-3 px-2 text-center transition-colors hover:bg-slate-800/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 no-underline text-inherit">
                                <span class="dash-chip dash-chip--lg" aria-hidden="true"><span class="material-symbols-outlined">@acceso.Icon</span></span>
                                <span class="text-xs font-bold uppercase text-slate-300">@acceso.Label</span>
                            </a>
                        }
                    </div>
                </section>
            </div>
        }

        <!-- Main column -->
        <div class="dashboard-area-main space-y-6">
                <!-- Resumen: 4 métricas de igual ancho. Monto vencido va primero y toma énfasis de peligro solo
                     si hay deuda; Stock bajo toma énfasis de advertencia solo si hay productos por reponer.
                     En cero ambas quedan neutras. Cada tarjeta navega a la sección que la detalla. -->
                @if (!cargaFallida)
                {
                <div class="dashboard-kpis grid gap-4">
                    @if (puedeVerCreditos)
                    {
                    <a href="#cuotas-por-cobrar" class="@(cuotasVencidasTotal > 0 ? "card-erp-metric card-erp-metric-danger dashboard-kpi-alert" : "card-erp-metric") dashboard-kpi-link">
                        <p class="text-xs text-slate-400 uppercase tracking-wide">Monto vencido</p>
                        <p class="dashboard-kpi-value mt-1 font-bold @(cuotasVencidasTotal > 0 ? "text-red-400" : "text-slate-100")">@Model.MontoVencidoTotal.ToString("C")</p>
                        <p class="text-xs text-slate-400 mt-1">@cuotasVencidasTotal @(cuotasVencidasTotal == 1 ? "cuota vencida" : "cuotas vencidas")</p>
                        <span class="dash-chip dash-kpi-chip @(cuotasVencidasTotal > 0 ? "dash-tone-danger" : "dash-tone-neutral")" aria-hidden="true"><span class="material-symbols-outlined">schedule</span></span>
                    </a>
                    }
                    @if (puedeVerVentas)
                    {
                    <a asp-controller="Venta" asp-action="Index" class="card-erp-metric dashboard-kpi-link">
                        <p class="text-xs text-slate-400 uppercase tracking-wide">Ventas del mes</p>
                        <p class="dashboard-kpi-value mt-1 font-bold text-slate-100">@Model.VentasTotalesMes.ToString("C")</p>
                        <p class="text-xs text-slate-400 mt-1">@Model.CantidadVentasMes ventas</p>
                        <span class="dash-chip dash-kpi-chip dash-tone-success" aria-hidden="true"><span class="material-symbols-outlined">receipt_long</span></span>
                    </a>
                    }
                    @if (puedeVerCreditos)
                    {
                    <a asp-controller="Credito" asp-action="Index" class="card-erp-metric dashboard-kpi-link">
                        <p class="text-xs text-slate-400 uppercase tracking-wide">Cobranza del mes</p>
                        <p class="dashboard-kpi-value mt-1 font-bold text-slate-100">@Model.CobranzaMes.ToString("C")</p>
                        <p class="text-xs text-slate-400 mt-1">cuotas cobradas</p>
                        <span class="dash-chip dash-kpi-chip dash-tone-success" aria-hidden="true"><span class="material-symbols-outlined">credit_card</span></span>
                    </a>
                    }
                    <a href="#alertas-stock" class="@(stockBajo > 0 ? "card-erp-metric card-erp-metric-warning" : "card-erp-metric") dashboard-kpi-link">
                        <p class="text-xs text-slate-400 uppercase tracking-wide">Stock bajo</p>
                        <p class="dashboard-kpi-value mt-1 font-bold @(stockBajo > 0 ? "text-orange-400" : "text-slate-100")">@stockBajo</p>
                        <p class="text-xs text-slate-400 mt-1">productos a reponer</p>
                        <span class="dash-chip dash-kpi-chip @(stockBajo > 0 ? "dash-tone-warning" : "dash-tone-neutral")" aria-hidden="true"><span class="material-symbols-outlined">inventory_2</span></span>
                    </a>
                </div>
                }

                @if (cargaFallida)
                {
                <section role="alert" class="card-erp-panel p-6 text-center">
                    <span class="material-symbols-outlined text-3xl text-red-400" aria-hidden="true">cloud_off</span>
                    <h2 class="mt-2 text-base font-semibold text-slate-100">No pudimos cargar el panel</h2>
                    <p class="mx-auto mt-1 max-w-md text-sm text-slate-300">Los importes y alertas no se muestran para no darte datos incompletos. Probá de nuevo; si sigue fallando, avisá a quien administra el sistema.</p>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-erp-secondary mt-4 no-underline">
                        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">refresh</span>
                        Reintentar
                    </a>
                </section>
                }

                <!-- Payments Table -->
                @if (puedeVerCreditos && !cargaFallida)
                {
                <section id="cuotas-por-cobrar" class="dashboard-section card-erp-panel p-4 sm:p-5">
                    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-3">
                            <span class="dash-kicker dash-tone-info" aria-hidden="true"><span class="material-symbols-outlined">schedule</span>Cobranzas</span>
                            <h2 class="text-base font-semibold text-slate-100 section-header-erp">Cuotas por cobrar</h2>
                        </div>
                        <div class="flex items-center gap-2">
                                <div class="dashboard-tabs flex gap-1" data-dashboard-tabs role="tablist"
                                     aria-label="Cuotas vencidas o próximas a vencer">
                                    <button id="tabVencidas" type="button" data-dashboard-tab="vencidas"
                                            data-dashboard-tab-tone="danger" role="tab" aria-selected="true"
                                            aria-controls="tbodyVencidas"
                                            class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-red-500/10 text-red-400 border border-red-500/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">Vencidas <span class="dashboard-tab-count">@cuotasVencidasTotal</span></button>
                                    <button id="tabProximas" type="button" data-dashboard-tab="proximas"
                                            data-dashboard-tab-tone="info" role="tab" aria-selected="false"
                                            aria-controls="tbodyProximas" tabindex="-1"
                                            class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">Próximas <span class="dashboard-tab-count">@(cuotasProximasCount >= topServicio ? $"{topServicio}+" : cuotasProximasCount.ToString())</span></button>
                                </div>
                            </div>
                        </div>
                        <div data-oc-scroll data-dashboard-cuotas-scroll style="--oc-scroll-min-width: 28rem;" class="dashboard-table-wrap">
                            <div class="border-b border-slate-800 px-4 py-3">
                                <p data-oc-scroll-hint hidden
                                   class="text-xs font-semibold text-slate-400">
                                    Deslizá horizontalmente para ver cliente, monto y estado completo.
                                </p>
                            </div>
                            <div class="relative">
                                <div data-oc-scroll-fade="left" hidden
                                     class="pointer-events-none absolute inset-y-0 left-0 z-[1] w-8 bg-gradient-to-r from-slate-900 via-slate-900/95 to-transparent">
                                </div>
                                <div data-oc-scroll-fade="right" hidden
                                     class="pointer-events-none absolute inset-y-0 right-0 z-[1] w-8 bg-gradient-to-l from-slate-900 via-slate-900/95 to-transparent">
                                </div>
                                <div data-oc-scroll-region tabindex="0" role="region" aria-label="Cuotas por cobrar" class="overflow-x-auto overscroll-x-contain">
                                    <table data-erp-cards class="min-w-[var(--oc-scroll-min-width)] w-full text-left border-collapse">
                                        <thead>
                                            <tr
                                                class="bg-slate-800/50 text-slate-400 text-xs font-bold uppercase tracking-wider">
                                                <th data-card="title" class="dash-cell py-3">Cliente</th>
                                                <th class="dash-cell py-3">Concepto</th>
                                                <th data-card="half" class="dash-cell py-3">Vencimiento</th>
                                                <th data-card="half" class="dash-cell py-3">Monto</th>
                                                @if (mostrarAcciones)
                                                {
                                                    <th class="dash-cell py-3 text-right">Acciones</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyVencidas" data-dashboard-tab-panel="vencidas"
                                               data-empty="@(cuotasVencidasCount == 0 ? "true" : "false")"
                                               role="tabpanel" aria-labelledby="tabVencidas"
                                               class="divide-y divide-slate-800">
                                            @if (cuotasVencidasCount == 0)
                                            {
                                                <tr data-dashboard-empty>
                                                    <td colspan="@colspanCuotas" class="px-4 py-8 text-center text-sm text-slate-400">
                                                        <span class="material-symbols-outlined text-2xl text-emerald-500/70 block mb-1" aria-hidden="true">check_circle</span>
                                                        <p>No hay cuotas vencidas.</p>
                                                        <p class="text-xs text-slate-400">Todas las cuotas exigibles están al día.</p>
                                                    </td>
                                                </tr>
                                            }
                                            @foreach (var cuota in cuotasVencidas.Take(5))
                                            {
                                                var productos = cuota.ProductosAsociados ?? new List<CreditoProductoAsociadoViewModel>();
                                                var productosResumen = productos
                                                    .Take(2)
                                                    .Select(p => $"{(string.IsNullOrWhiteSpace(p.ProductoCodigo) ? "" : p.ProductoCodigo + " - ")}{p.ProductoNombre}{(p.Cantidad > 1 ? $" x{p.Cantidad}" : "")}")
                                                    .ToList();
                                                var productosRestantes = productos.Count - productosResumen.Count;
                                                <tr class="hover:bg-slate-800/30 transition-colors">
                                                    <td class="dash-cell py-3">
                                                        <p class="break-words font-bold text-sm">@cuota.ClienteNombre</p>
                                                        <p class="flex flex-wrap gap-x-2 text-xs text-slate-400">@if (!string.IsNullOrWhiteSpace(cuota.ClienteDocumento)){<span class="whitespace-nowrap">DNI: @cuota.ClienteDocumento</span>}<span class="whitespace-nowrap">ID: @cuota.ClienteId</span></p>
                                                    </td>
                                                    <td class="dash-cell py-3">
                                                        <p class="text-sm text-slate-200">Cuota @cuota.NumeroCuota - <span class="whitespace-nowrap">@cuota.CreditoNumero</span></p>
                                                        @if (productosResumen.Any())
                                                        {
                                                            <p class="mt-1 flex min-w-0 items-center gap-1 text-xs text-slate-400" data-dashboard-productos>
                                                                <span class="material-symbols-outlined text-[14px] text-slate-400" aria-hidden="true">inventory_2</span>
                                                                <span class="max-w-[18rem] truncate">@string.Join(", ", productosResumen)</span>
                                                                @if (productosRestantes > 0)
                                                                {
                                                                    <span class="shrink-0 font-bold text-slate-300">+@productosRestantes</span>
                                                                }
                                                            </p>
                                                        }
                                                    </td>
                                                    <td class="dash-cell py-3">
                                                        <span class="whitespace-nowrap rounded bg-red-500/10 px-2 py-0.5 text-xs font-semibold text-red-400"><span class="sr-only">Vencida </span>Hace @cuota.DiasVencidos d</span>
                                                    </td>
                                                    <td class="whitespace-nowrap dash-cell py-3 text-sm font-bold tabular-nums">@cuota.Monto.ToString("C")</td>
                                                    @if (mostrarAcciones)
                                                    {
                                                        <td class="dash-cell py-3 text-right">
                                                            @if (puedeCobrar)
                                                            {
                                                                <a asp-controller="Credito" asp-action="PagarCuota"
                                                                   asp-route-id="@cuota.CuotaId"
                                                                   asp-route-returnUrl="@pagoCuotaReturnUrl"
                                                                   class="row-action row-action--primary no-underline"
                                                                   aria-label="Registrar pago de la cuota @cuota.NumeroCuota de @cuota.ClienteNombre"
                                                                   title="Registrar pago">
                                                                    <span class="material-symbols-outlined icon-erp-md">send_money</span>
                                                                </a>
                                                            }
                                                            else if (puedeVerCreditos)
                                                            {
                                                                <a asp-controller="Credito" asp-action="Details"
                                                                   asp-route-id="@cuota.CreditoId"
                                                                   class="row-action row-action--primary no-underline"
                                                                   aria-label="Ver crédito @cuota.CreditoNumero de @cuota.ClienteNombre"
                                                                   title="Ver crédito">
                                                                    <span class="material-symbols-outlined icon-erp-md">visibility</span>
                                                                </a>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                                }
                                            </tbody>
                                            <tbody id="tbodyProximas" data-dashboard-tab-panel="proximas"
                                                   data-empty="@(cuotasProximasCount == 0 ? "true" : "false")"
                                                   role="tabpanel" aria-labelledby="tabProximas"
                                                   class="divide-y divide-slate-800 hidden">
                                                @if (cuotasProximasCount == 0)
                                                {
                                                    <tr data-dashboard-empty>
                                                        <td colspan="@colspanCuotas" class="px-4 py-8 text-center text-sm text-slate-400">
                                                            <span class="material-symbols-outlined text-2xl text-slate-400 block mb-1" aria-hidden="true">check_circle</span>
                                                            <p>No hay cuotas próximas a vencer.</p>
                                                            <p class="text-xs text-slate-400">Las cuotas que venzan pronto aparecerán acá.</p>
                                                        </td>
                                                    </tr>
                                                }
                                                @foreach (var cuota in cuotasProximas.Take(5))
                                                {
                                                    var productos = cuota.ProductosAsociados ?? new List<CreditoProductoAsociadoViewModel>();
                                                    var productosResumen = productos
                                                        .Take(2)
                                                        .Select(p => $"{(string.IsNullOrWhiteSpace(p.ProductoCodigo) ? "" : p.ProductoCodigo + " - ")}{p.ProductoNombre}{(p.Cantidad > 1 ? $" x{p.Cantidad}" : "")}")
                                                        .ToList();
                                                    var productosRestantes = productos.Count - productosResumen.Count;
                                                    <tr class="hover:bg-slate-800/30 transition-colors">
                                                        <td class="dash-cell py-3">
                                                            <p class="break-words font-bold text-sm">@cuota.ClienteNombre</p>
                                                            <p class="flex flex-wrap gap-x-2 text-xs text-slate-400">@if (!string.IsNullOrWhiteSpace(cuota.ClienteDocumento)){<span class="whitespace-nowrap">DNI: @cuota.ClienteDocumento</span>}<span class="whitespace-nowrap">ID: @cuota.ClienteId</span></p>
                                                        </td>
                                                        <td class="dash-cell py-3">
                                                            <p class="text-sm text-slate-200">Cuota @cuota.NumeroCuota - <span class="whitespace-nowrap">@cuota.CreditoNumero</span></p>
                                                            @if (productosResumen.Any())
                                                            {
                                                                <p class="mt-1 flex min-w-0 items-center gap-1 text-xs text-slate-400" data-dashboard-productos>
                                                                    <span class="material-symbols-outlined text-[14px] text-slate-400" aria-hidden="true">inventory_2</span>
                                                                    <span class="max-w-[18rem] truncate">@string.Join(", ", productosResumen)</span>
                                                                    @if (productosRestantes > 0)
                                                                    {
                                                                        <span class="shrink-0 font-bold text-slate-300">+@productosRestantes</span>
                                                                    }
                                                                </p>
                                                            }
                                                        </td>
                                                        <td class="dash-cell py-3">
                                                            <span class="whitespace-nowrap rounded bg-slate-800 px-2 py-0.5 text-xs font-semibold text-slate-300">@cuota.FechaVencimiento.ToString("dd MMM")</span>
                                                            @if (cuota.DiasParaVencer <= 1)
                                                            {
                                                                <p class="mt-1 flex items-center gap-1.5 text-orange-400">
                                                                    <span class="size-1.5 rounded-full bg-orange-500" aria-hidden="true"></span>
                                                                    <span class="text-xs font-bold">Por vencer</span>
                                                                </p>
                                                            }
                                                            else
                                                            {
                                                                <p class="mt-1 flex items-center gap-1.5 text-blue-400">
                                                                    <span class="size-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
                                                                    <span class="text-xs font-bold">Programado</span>
                                                                </p>
                                                            }
                                                        </td>
                                                        <td class="whitespace-nowrap dash-cell py-3 text-sm font-bold tabular-nums">@cuota.Monto.ToString("C")</td>
                                                        @if (mostrarAcciones)
                                                        {
                                                            <td class="dash-cell py-3 text-right">
                                                                @if (puedeVerCreditos)
                                                                {
                                                                    <a asp-controller="Credito" asp-action="Details"
                                                                       asp-route-id="@cuota.CreditoId"
                                                                       class="row-action row-action--primary no-underline"
                                                                       aria-label="Ver crédito @cuota.CreditoNumero de @cuota.ClienteNombre"
                                                                       title="Ver crédito">
                                                                        <span class="material-symbols-outlined icon-erp-md">visibility</span>
                                                                    </a>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            @* Las listas vienen acotadas: se avisa cuando hay más filas de las que se ven y se ofrece la salida. *@
                            @if (cuotasVencidasTotal > filasVisibles || cuotasProximasCount > filasVisibles)
                            {
                                <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs text-slate-400">
                                    <p data-dashboard-tab-note="vencidas" hidden>
                                        @(cuotasVencidasTotal > filasVisibles ? $"Mostrando las {filasVisibles} más antiguas de {cuotasVencidasTotal}." : "")
                                    </p>
                                    <p data-dashboard-tab-note="proximas" hidden>
                                        @(cuotasProximasCount > filasVisibles ? $"Mostrando las {filasVisibles} más próximas a vencer." : "")
                                    </p>
                                    @if (puedeVerCreditos)
                                    {
                                        <a asp-controller="Credito" asp-action="Index" class="dashboard-link-more font-semibold text-blue-400 no-underline hover:underline">Ver créditos</a>
                                    }
                                </div>
                            }
                        </section>
                }

            @if (!cargaFallida)
            {
            <!-- Inventory Alerts -->
            <section id="alertas-stock" class="dashboard-section card-erp-panel p-4 sm:p-5">
                <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center gap-3">
                        <span class="dash-kicker dash-tone-warning" aria-hidden="true"><span class="material-symbols-outlined">warning</span>Inventario</span>
                        <h2 class="text-base font-semibold text-slate-100 section-header-erp">Alertas de stock</h2>
                    </div>
                    @{
                        // Si el usuario puede entrar a Catálogo, "Ver alertas" lleva directo a la
                        // pestaña Alertas (Fase 7); si no, cae a la pantalla standalone para no
                        // regresionar a nadie que tenga stock.viewalerts sin cotizaciones.view.
                        var alertasEnCatalogo = User.TienePermiso("cotizaciones", "view");
                    }
                    <a asp-controller="@(alertasEnCatalogo ? "Catalogo" : "AlertaStock")" asp-action="Index"
                       asp-route-tab="@(alertasEnCatalogo ? "alertas" : null)"
                       class="btn-erp-ghost btn-erp-sm no-underline">
                        <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                        Ver alertas
                    </a>
                </div>
                <div data-oc-scroll style="--oc-scroll-min-width: 30rem;" class="dashboard-table-wrap">
                    <div class="border-b border-slate-800 px-4 py-3">
                        <p data-oc-scroll-hint hidden
                           class="text-xs font-semibold text-slate-400">
                            Deslizá horizontalmente para ver el detalle completo.
                        </p>
                    </div>
                    <div class="relative">
                        <div data-oc-scroll-fade="left" hidden
                             class="pointer-events-none absolute inset-y-0 left-0 z-[1] w-8 bg-gradient-to-r from-slate-900 via-slate-900/95 to-transparent">
                        </div>
                        <div data-oc-scroll-fade="right" hidden
                             class="pointer-events-none absolute inset-y-0 right-0 z-[1] w-8 bg-gradient-to-l from-slate-900 via-slate-900/95 to-transparent">
                        </div>
                        <div data-oc-scroll-region tabindex="0" role="region" aria-label="Alertas de stock" class="overflow-x-auto overscroll-x-contain">
                            <table data-erp-cards class="min-w-[var(--oc-scroll-min-width)] w-full text-left border-collapse">
                                <thead>
                                    <tr
                                        class="bg-slate-800/50 text-slate-400 text-xs font-bold uppercase tracking-wider">
                                        <th data-card="half" class="px-4 py-3">SKU</th>
                                        <th data-card="title" class="px-4 py-3">Producto</th>
                                        <th data-card="half" class="px-4 py-3">Stock</th>
                                        <th data-card="half" class="px-4 py-3">Estado</th>
                                        @if (puedeReponer)
                                        {
                                            <th class="px-4 py-3 text-right">Acciones</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800">
                                    @if (alertasStock.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@(puedeReponer ? 5 : 4)" class="px-6 py-8 text-center text-sm text-slate-400">
                                                <span
                                                class="material-symbols-outlined text-2xl text-emerald-500/70 block mb-1" aria-hidden="true">inventory_2</span>
                                                No hay productos por debajo del stock mínimo.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var alerta in alertasStock)
                                        {
                                            var stockColor = alerta.Severidad == "bajo" ? "text-orange-400" : "text-red-400";
                                            var badgeClass = alerta.Severidad == "bajo"
                                                ? "bg-orange-500/10 text-orange-400 border border-orange-500/20"
                                                : "bg-red-500/10 text-red-400 border border-red-500/20";
                                            <tr class="hover:bg-slate-800/30 transition-colors">
                                                <td class="px-4 py-4 text-xs font-bold text-slate-400 uppercase">@alerta.Codigo
                                                </td>
                                                <td class="px-4 py-4 text-sm font-bold break-words">@alerta.Nombre</td>
                                                <td class="px-4 py-4 text-sm font-bold @stockColor">
                                                    @alerta.StockActual.ToString("0.##")</td>
                                                    <td class="px-4 py-4">
                                                        <span
                                                        class="whitespace-nowrap text-xs font-bold uppercase px-2 py-0.5 rounded @badgeClass">@alerta.SeveridadTexto</span>
                                                    </td>
                                                    @if (puedeReponer)
                                                    {
                                                        <td class="px-4 py-4 text-right">
                                                            <a asp-controller="OrdenCompra" asp-action="Create"
                                                               asp-route-productoId="@alerta.ProductoId"
                                                               class="btn-erp-ghost btn-erp-sm no-underline"
                                                               aria-label="Reponer @alerta.Nombre: crear orden de compra"
                                                               title="Crear orden de compra para reponer">Reponer</a>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                        <!-- Productos destacados -->
                        <section class="card-erp-panel p-4 sm:p-5">
                            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                <div class="flex items-center gap-3">
                                    <span class="dash-kicker dash-tone-violet" aria-hidden="true"><span class="material-symbols-outlined">star</span>Destacados</span>
                                    <h2 class="text-base font-semibold text-slate-100 section-header-erp">Productos destacados</h2>
                                </div>
                                @if (puedeVerCatalogo)
                                {
                                    <a asp-controller="Catalogo" asp-action="Index" class="btn-erp-ghost btn-erp-sm no-underline">
                                        <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                        Ver catálogo
                                    </a>
                                }
                            </div>
                            @if (destacados.Count == 0)
                            {
                                <div class="rounded-xl border border-slate-800 bg-slate-800/20 px-4 py-8 text-center">
                                    <span class="material-symbols-outlined text-2xl text-slate-400 block mb-1" aria-hidden="true">star</span>
                                    <p class="text-sm text-slate-400">No hay productos destacados.</p>
                                    <p class="text-xs text-slate-400">Marcá productos como destacados desde el catálogo.</p>
                                </div>
                            }
                            else
                            {
                                <ul class="grid gap-x-6 @(destacados.Count > 1 ? "sm:grid-cols-2" : "")">
                                    @foreach (var prod in destacados)
                                    {
                                        var stockTone = prod.StockActual <= 0 ? "text-red-400"
                                            : prod.StockActual <= prod.StockMinimo ? "text-orange-400"
                                            : "text-emerald-400";
                                        var stockTexto = prod.StockActual <= 0 ? "Sin stock"
                                            : prod.StockActual <= prod.StockMinimo ? "Stock bajo"
                                            : "En stock";
                                        <li class="flex items-center gap-3 border-b border-slate-800/70 py-2.5">
                                            <div class="min-w-0 flex-1">
                                                <p class="truncate text-sm font-bold text-slate-100">@prod.Nombre</p>
                                                <p class="text-xs text-slate-400">
                                                    <span class="font-semibold uppercase">@prod.Codigo</span>
                                                    <span class="mx-1.5 text-slate-600">·</span>
                                                    <span class="@stockTone font-semibold">@stockTexto</span>
                                                </p>
                                            </div>
                                            <span class="shrink-0 text-sm font-bold tabular-nums text-slate-100">@prod.PrecioVenta.ToString("C")</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
            }
                    </div>

                    <!-- Right Sidebar -->
                    <aside class="dashboard-area-rail space-y-4">

                        <!-- Notas rápidas (mismas notas que el desplegable del header, guardadas por usuario) -->
                        <section data-dashboard-notes class="card-erp-panel notas-card overflow-hidden">
                            <div class="dash-rail-head dash-tone-info flex items-center gap-2 px-4 pt-4 pb-3">
                                <span class="dash-chip dash-chip--sm" aria-hidden="true"><span class="material-symbols-outlined">checklist</span></span>
                                <h2 class="text-xs font-bold uppercase tracking-wide text-slate-300">Notas rápidas</h2>
                            </div>
                            <partial name="_NotasRapidasContenido" model="@("dashboard")" />
                        </section>

                        <!-- Actividad reciente -->
                        <section class="card-erp-panel p-4">
                            <div class="dash-rail-head dash-tone-violet mb-3 flex items-center gap-2 pb-3">
                                <span class="dash-chip dash-chip--sm" aria-hidden="true"><span class="material-symbols-outlined">monitoring</span></span>
                                <h2 class="text-xs font-bold uppercase tracking-wide text-slate-300">Actividad reciente</h2>
                            </div>
                            <div class="space-y-3 max-h-80 overflow-y-auto">
                                @if (actividad.Count == 0)
                                {
                                    <p class="text-xs text-slate-400">Sin actividad reciente todavía.</p>
                                }
                                else
                                {
                                    @foreach (var item in actividad)
                                    {
                                        var bulletColor = item.Color == "primary" ? "bg-blue-400"
                                            : item.Color == "orange" ? "bg-orange-500"
                                            : "bg-emerald-500";
                                        <div class="flex gap-2.5">
                                            <div class="mt-1.5 size-1.5 shrink-0 rounded-full @bulletColor"></div>
                                            <div>
                                                <p class="text-xs text-slate-200"><span class="font-semibold">@item.Titulo</span>
                                                    @item.Detalle</p>
                                                <p class="text-xs text-slate-400">@item.TiempoRelativo</p>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </section>

        </aside>

    </div>
</div>
@section Scripts {
                    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
                    <script src="~/js/dashboard-index.js" asp-append-version="true"></script>
                }
