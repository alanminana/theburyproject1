@using TheBuryProject.Models.Enums
@using TheBuryProject.Services.Interfaces
@model List<TheBuryProject.Models.Entities.DocumentoGenerado>
@{
    ViewData["Title"] = "Documentos emitidos";
    var tipos = (List<TheBuryProject.Models.Entities.TipoDocumento>)ViewBag.Tipos;
    var filtro = (TheBuryProject.Services.Interfaces.DocumentoFiltro)ViewBag.Filtro;
    int total = ViewBag.Total;
    var tamano = Math.Clamp(filtro.Tamano, 5, 100);
    var pagina = Math.Max(1, filtro.Pagina);
    var paginas = Math.Max(1, (int)Math.Ceiling(total / (double)tamano));
    var conteos = (Dictionary<VistaDocumento, int>)ViewBag.ConteoVistas;
    var vistas = new (VistaDocumento Vista, string Texto, string Icono)[]
    {
        (VistaDocumento.Todos, "Todos", "list"),
        (VistaDocumento.Pendientes, "Pendientes de firma", "edit_note"),
        (VistaDocumento.Finalizados, "Finalizados", "task_alt"),
        (VistaDocumento.Anulados, "Anulados", "block")
    };
    var estadosVista = filtro.Vista switch
    {
        VistaDocumento.Finalizados => new[] { EstadoDocumentoGenerado.Generado, EstadoDocumentoGenerado.Firmado },
        VistaDocumento.Anulados => new[] { EstadoDocumentoGenerado.Cancelado, EstadoDocumentoGenerado.Reemplazado },
        VistaDocumento.Pendientes => Array.Empty<EstadoDocumentoGenerado>(),
        _ => Enum.GetValues<EstadoDocumentoGenerado>()
    };
    var hayFiltroSecundario = filtro.TipoDocumentoId.HasValue || filtro.Estado.HasValue || filtro.Desde.HasValue || filtro.Hasta.HasValue;
    int? VistaRuta(VistaDocumento v) => v == VistaDocumento.Todos ? null : (int)v;
    var puedeConfig = User.TienePermiso("documentos", "managetemplates");
    var puedeReimprimir = User.TienePermiso("documentos", "reprint");
    // Los enlaces a la operación respetan el permiso de ver de cada módulo; sin él se muestra el dato como texto.
    var puedeVerVentas = User.TienePermiso("ventas", "view");
    var puedeVerCotizaciones = User.TienePermiso("cotizaciones", "view");
    var puedeVerCreditos = User.TienePermiso("creditos", "view");
    string ChipClase(EstadoDocumentoGenerado e) => e switch
    {
        EstadoDocumentoGenerado.Generado or EstadoDocumentoGenerado.Firmado => "doc-chip doc-chip-ok",
        EstadoDocumentoGenerado.PendienteFirma => "doc-chip doc-chip-warn",
        _ => "doc-chip doc-chip-off"
    };
    string EstadoTexto(EstadoDocumentoGenerado e) => e switch
    {
        EstadoDocumentoGenerado.Generado => "Generado",
        EstadoDocumentoGenerado.PendienteFirma => "Pendiente de firma",
        EstadoDocumentoGenerado.Firmado => "Firmado",
        EstadoDocumentoGenerado.Cancelado => "Cancelado",
        _ => "Reemplazado"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos-module.css" asp-append-version="true" />
}

<div class="doc-module">
    <header class="doc-head">
        <div class="doc-head-text">
            <h1 class="doc-title">Documentos emitidos</h1>
            <p class="doc-sub">Registro histórico de contratos, pagarés, recibos y demás documentos del sistema: ver@(puedeReimprimir ? " o reimprimir" : "") muestra siempre el contenido original.</p>
        </div>
        @if (puedeConfig)
        {
            <a asp-controller="DocumentosConfig" asp-action="Plantillas" class="doc-btn">
                <span class="material-symbols-outlined" aria-hidden="true">tune</span><span>Configurar plantillas y reglas</span>
            </a>
        }
    </header>

    <partial name="~/Views/DocumentosConfig/_Flash.cshtml" />

    <nav class="doc-tabs" aria-label="Estado de los documentos">
        @foreach (var v in vistas)
        {
            <a asp-action="Index" class="doc-tab" aria-current="@(filtro.Vista == v.Vista ? "page" : null)"
               asp-route-Vista="@VistaRuta(v.Vista)"
               asp-route-Texto="@filtro.Texto" asp-route-TipoDocumentoId="@filtro.TipoDocumentoId"
               asp-route-Desde="@filtro.Desde?.ToString("yyyy-MM-dd")" asp-route-Hasta="@filtro.Hasta?.ToString("yyyy-MM-dd")">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">@v.Icono</span>@v.Texto
                <span class="doc-muted">(@conteos.GetValueOrDefault(v.Vista))</span>
            </a>
        }
    </nav>

    <section class="doc-card">
        <form method="get" class="doc-filtros" role="search" aria-label="Filtrar documentos">
            <input type="hidden" name="Vista" value="@((int)filtro.Vista)" />
            <div class="doc-field doc-field-texto">
                <label for="Texto">Número o cliente</label>
                <input id="Texto" name="Texto" value="@filtro.Texto" class="doc-input" maxlength="100" />
            </div>
            <button type="button" class="doc-filtros-toggle" data-doc-filtros-toggle aria-expanded="true" aria-controls="doc-filtros-mas">
                <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>Más filtros
            </button>
            <div class="doc-filtros-mas-body" id="doc-filtros-mas" data-doc-filtros-body data-activo="@(hayFiltroSecundario ? "1" : "0")">
                <div class="doc-field">
                    <label for="TipoDocumentoId">Tipo</label>
                    <select id="TipoDocumentoId" name="TipoDocumentoId" class="doc-select">
                        <option value="">Todos</option>
                        @foreach (var t in tipos)
                        {
                            <option value="@t.Id" selected="@(filtro.TipoDocumentoId == t.Id)">@t.Nombre</option>
                        }
                    </select>
                </div>
                @if (estadosVista.Length > 1)
                {
                    <div class="doc-field">
                        <label for="Estado">Estado</label>
                        <select id="Estado" name="Estado" class="doc-select">
                            <option value="">Todos</option>
                            @foreach (var e in estadosVista)
                            {
                                <option value="@((int)e)" selected="@(filtro.Estado == e)">@EstadoTexto(e)</option>
                            }
                        </select>
                    </div>
                }
                <div class="doc-field">
                    <label for="Desde">Desde</label>
                    <input id="Desde" name="Desde" type="date" value="@filtro.Desde?.ToString("yyyy-MM-dd")" class="doc-input" />
                </div>
                <div class="doc-field">
                    <label for="Hasta">Hasta</label>
                    <input id="Hasta" name="Hasta" type="date" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" class="doc-input" />
                </div>
            </div>
            <div class="doc-actions">
                <button type="submit" class="doc-btn doc-btn-primary">Filtrar</button>
                <a asp-action="Index" asp-route-Vista="@VistaRuta(filtro.Vista)" class="doc-btn">Limpiar</a>
            </div>
        </form>
    </section>

    <section class="doc-card">
        @if (Model.Count == 0)
        {
            <p class="doc-muted">No hay documentos para los filtros elegidos.</p>
        }
        else
        {
            <div class="doc-table-wrap">
                <table class="doc-table" data-erp-cards>
                    <thead><tr><th data-card="title">Número</th><th data-card="half">Documento</th><th>Cliente</th><th data-card="half">Operación</th><th data-card="half">Fecha</th><th data-card="half">Estado</th><th data-card="actions"><span class="sr-only">Acciones</span></th></tr></thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="doc-mono">@d.Numero</td>
                            <td>@d.TipoDocumento.Nombre</td>
                            <td>@(d.Cliente != null ? $"{d.Cliente.Apellido}, {d.Cliente.Nombre}" : "—")</td>
                            <td>
                                @if (d.VentaId != null)
                                {
                                    if (puedeVerVentas) { <a asp-controller="Venta" asp-action="Details" asp-route-id="@d.VentaId">Venta #@d.VentaId</a> }
                                    else { <text>Venta #@d.VentaId</text> }
                                }
                                else if (d.CotizacionId != null)
                                {
                                    if (puedeVerCotizaciones) { <a asp-controller="Cotizacion" asp-action="Detalles" asp-route-id="@d.CotizacionId">Cotización #@d.CotizacionId</a> }
                                    else { <text>Cotización #@d.CotizacionId</text> }
                                }
                                else { <text>—</text> }
                                @if (d.PagoCuotaId != null)
                                {
                                    <div class="doc-muted">
                                        Pago #@d.PagoCuotaId
                                        @if (d.CreditoId != null)
                                        {
                                            <text> · </text>
                                            if (puedeVerCreditos) { <a asp-controller="Credito" asp-action="Details" asp-route-id="@d.CreditoId">Crédito #@d.CreditoId</a> }
                                            else { <text>Crédito #@d.CreditoId</text> }
                                        }
                                    </div>
                                }
                            </td>
                            <td class="doc-fecha">@d.FechaGeneracionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="@ChipClase(d.Estado)">@EstadoTexto(d.Estado)</span></td>
                            <td>
                                <div class="doc-actions">
                                    <a class="doc-btn" target="_blank" rel="noopener" asp-action="Ver" asp-route-id="@d.Id">Ver</a>
                                    @if (puedeReimprimir)
                                    {
                                        <a class="doc-btn" target="_blank" rel="noopener" asp-action="Reimprimir" asp-route-ids="@d.Id">Imprimir</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="doc-actions doc-actions-between">
                <span class="doc-muted">@total documento(s) · página @pagina de @paginas</span>
                <div class="doc-actions">
                    @if (pagina > 1)
                    {
                        <a class="doc-btn" asp-action="Index" asp-route-Texto="@filtro.Texto" asp-route-TipoDocumentoId="@filtro.TipoDocumentoId"
                           asp-route-Estado="@(filtro.Estado.HasValue ? (int?)filtro.Estado.Value : null)" asp-route-Vista="@VistaRuta(filtro.Vista)" asp-route-Desde="@filtro.Desde?.ToString("yyyy-MM-dd")" asp-route-Hasta="@filtro.Hasta?.ToString("yyyy-MM-dd")"
                           asp-route-Pagina="@(pagina - 1)" asp-route-Tamano="@tamano">Anterior</a>
                    }
                    @if (pagina < paginas)
                    {
                        <a class="doc-btn" asp-action="Index" asp-route-Texto="@filtro.Texto" asp-route-TipoDocumentoId="@filtro.TipoDocumentoId"
                           asp-route-Estado="@(filtro.Estado.HasValue ? (int?)filtro.Estado.Value : null)" asp-route-Vista="@VistaRuta(filtro.Vista)" asp-route-Desde="@filtro.Desde?.ToString("yyyy-MM-dd")" asp-route-Hasta="@filtro.Hasta?.ToString("yyyy-MM-dd")"
                           asp-route-Pagina="@(pagina + 1)" asp-route-Tamano="@tamano">Siguiente</a>
                    }
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.querySelector('[data-doc-filtros-toggle]');
            var body = document.querySelector('[data-doc-filtros-body]');
            if (!btn || !body) return;
            var mobile = window.matchMedia('(max-width: 720px)');
            function set(open) { body.classList.toggle('is-collapsed', !open); btn.setAttribute('aria-expanded', open ? 'true' : 'false'); }
            btn.addEventListener('click', function () { set(body.classList.contains('is-collapsed')); });
            function sync() { set(!mobile.matches || body.getAttribute('data-activo') === '1'); }
            sync(); mobile.addEventListener('change', sync);
        })();
    </script>
}
