@using TheBuryProject.Models.Enums
@model List<TheBuryProject.Models.Entities.DocumentoGenerado>
@{
    ViewData["Title"] = "Documentos emitidos";
    var tipos = (List<TheBuryProject.Models.Entities.TipoDocumento>)ViewBag.Tipos;
    var filtro = (TheBuryProject.Services.Interfaces.DocumentoFiltro)ViewBag.Filtro;
    int total = ViewBag.Total;
    var tamano = Math.Clamp(filtro.Tamano, 5, 100);
    var pagina = Math.Max(1, filtro.Pagina);
    var paginas = Math.Max(1, (int)Math.Ceiling(total / (double)tamano));
    var puedeConfig = User.TienePermiso("documentos", "managetemplates");
    string ChipClase(EstadoDocumentoGenerado e) => e switch
    {
        EstadoDocumentoGenerado.Generado or EstadoDocumentoGenerado.Firmado => "doc-chip doc-chip-ok",
        EstadoDocumentoGenerado.PendienteFirma => "doc-chip doc-chip-warn",
        _ => "doc-chip doc-chip-off"
    };
    string EstadoTexto(EstadoDocumentoGenerado e) => e switch
    {
        EstadoDocumentoGenerado.Generado => "Generado",
        EstadoDocumentoGenerado.PendienteFirma => "Pendiente de firma",
        EstadoDocumentoGenerado.Firmado => "Firmado",
        EstadoDocumentoGenerado.Cancelado => "Cancelado",
        _ => "Reemplazado"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos-module.css" asp-append-version="true" />
}

<div class="doc-module">
    <header class="doc-head">
        <h1 class="doc-title">Documentos emitidos</h1>
        <p class="doc-sub">Contratos, pagarés, recibos y demás documentos generados por el sistema. Son un registro histórico: ver o reimprimir muestra siempre el contenido original.</p>
        @if (puedeConfig)
        {
            <p style="margin:.6rem 0 0">
                <a asp-controller="DocumentosConfig" asp-action="Plantillas" class="doc-btn">
                    <span class="material-symbols-outlined" aria-hidden="true">tune</span>Configurar plantillas y reglas
                </a>
            </p>
        }
    </header>

    <partial name="~/Views/DocumentosConfig/_Flash.cshtml" />

    <section class="doc-card">
        <form method="get" class="doc-grid-3" style="align-items:end">
            <div class="doc-field">
                <label for="Texto">Número o cliente</label>
                <input id="Texto" name="Texto" value="@filtro.Texto" class="doc-input" maxlength="100" />
            </div>
            <div class="doc-field">
                <label for="TipoDocumentoId">Tipo</label>
                <select id="TipoDocumentoId" name="TipoDocumentoId" class="doc-select">
                    <option value="">Todos</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.Id" selected="@(filtro.TipoDocumentoId == t.Id)">@t.Nombre</option>
                    }
                </select>
            </div>
            <div class="doc-field">
                <label for="Estado">Estado</label>
                <select id="Estado" name="Estado" class="doc-select">
                    <option value="">Todos</option>
                    @foreach (var e in Enum.GetValues<EstadoDocumentoGenerado>())
                    {
                        <option value="@((int)e)" selected="@(filtro.Estado == e)">@EstadoTexto(e)</option>
                    }
                </select>
            </div>
            <div class="doc-field">
                <label for="Desde">Desde</label>
                <input id="Desde" name="Desde" type="date" value="@filtro.Desde?.ToString("yyyy-MM-dd")" class="doc-input" />
            </div>
            <div class="doc-field">
                <label for="Hasta">Hasta</label>
                <input id="Hasta" name="Hasta" type="date" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" class="doc-input" />
            </div>
            <div class="doc-actions">
                <button type="submit" class="doc-btn doc-btn-primary">Filtrar</button>
                <a asp-action="Index" class="doc-btn">Limpiar</a>
            </div>
        </form>
    </section>

    <section class="doc-card">
        @if (Model.Count == 0)
        {
            <p class="doc-muted" style="margin:0">No hay documentos para los filtros elegidos.</p>
        }
        else
        {
            <div class="doc-table-wrap">
                <table class="doc-table" data-erp-cards>
                    <thead><tr><th data-card="title">Número</th><th data-card="half">Documento</th><th data-card="half">Cliente</th><th data-card="half">Operación</th><th data-card="half">Fecha</th><th data-card="half">Estado</th><th data-card="actions"><span class="sr-only">Acciones</span></th></tr></thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="doc-mono">@d.Numero</td>
                            <td>@d.TipoDocumento.Nombre</td>
                            <td>@(d.Cliente != null ? $"{d.Cliente.Apellido}, {d.Cliente.Nombre}" : "—")</td>
                            <td>
                                @if (d.VentaId != null)
                                {
                                    <a asp-controller="Venta" asp-action="Details" asp-route-id="@d.VentaId">Venta #@d.VentaId</a>
                                }
                                else { <text>—</text> }
                                @if (d.PagoCuotaId != null) { <div class="doc-muted">Pago #@d.PagoCuotaId</div> }
                            </td>
                            <td>@d.FechaGeneracionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="@ChipClase(d.Estado)">@EstadoTexto(d.Estado)</span></td>
                            <td>
                                <div class="doc-actions">
                                    <a class="doc-btn" target="_blank" rel="noopener" asp-action="Ver" asp-route-id="@d.Id">Ver</a>
                                    @if (User.TienePermiso("documentos", "reprint"))
                                    {
                                        <a class="doc-btn" target="_blank" rel="noopener" asp-action="Reimprimir" asp-route-ids="@d.Id">Imprimir</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="doc-actions" style="justify-content:space-between;margin-top:.8rem">
                <span class="doc-muted">@total documento(s) · página @pagina de @paginas</span>
                <div class="doc-actions">
                    @if (pagina > 1)
                    {
                        <a class="doc-btn" asp-action="Index" asp-route-Texto="@filtro.Texto" asp-route-TipoDocumentoId="@filtro.TipoDocumentoId"
                           asp-route-Estado="@(filtro.Estado.HasValue ? (int?)filtro.Estado.Value : null)" asp-route-Desde="@filtro.Desde?.ToString("yyyy-MM-dd")" asp-route-Hasta="@filtro.Hasta?.ToString("yyyy-MM-dd")"
                           asp-route-Pagina="@(pagina - 1)" asp-route-Tamano="@tamano">Anterior</a>
                    }
                    @if (pagina < paginas)
                    {
                        <a class="doc-btn" asp-action="Index" asp-route-Texto="@filtro.Texto" asp-route-TipoDocumentoId="@filtro.TipoDocumentoId"
                           asp-route-Estado="@(filtro.Estado.HasValue ? (int?)filtro.Estado.Value : null)" asp-route-Desde="@filtro.Desde?.ToString("yyyy-MM-dd")" asp-route-Hasta="@filtro.Hasta?.ToString("yyyy-MM-dd")"
                           asp-route-Pagina="@(pagina + 1)" asp-route-Tamano="@tamano">Siguiente</a>
                    }
                </div>
            </div>
        }
    </section>
</div>
