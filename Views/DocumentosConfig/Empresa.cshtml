@model TheBuryProject.Services.Interfaces.EmpresaInput
@{
    ViewData["Title"] = "Datos de la empresa";
    ViewData["DocTab"] = "empresa";
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos-module.css" asp-append-version="true" />
}

<div class="doc-module">
    <header class="doc-head">
        <h1 class="doc-title">Documentos</h1>
        <p class="doc-sub">Datos de la empresa que aparecen en los contratos, pagarés y demás documentos (variables <span class="doc-mono">{{empresa.nombre}}</span>, <span class="doc-mono">{{empresa.cuit}}</span>, etc.). Los documentos ya emitidos no cambian.</p>
        <partial name="_Tabs" />
    </header>

    <partial name="_Flash" />

    <form method="post" asp-action="Empresa" class="doc-form">
        @Html.AntiForgeryToken()

        <section class="doc-card">
            <h2>Empresa</h2>
            <div class="doc-grid-2">
                <div class="doc-field">
                    <label asp-for="Nombre">Nombre o razón social</label>
                    <input asp-for="Nombre" class="doc-input" maxlength="200" required />
                </div>
                <div class="doc-field">
                    <label asp-for="Cuit">CUIT</label>
                    <input asp-for="Cuit" class="doc-input doc-mono" maxlength="20" inputmode="numeric" placeholder="30-12345678-9" />
                </div>
            </div>
            <div class="doc-grid-2" style="margin-top:.9rem">
                <div class="doc-field">
                    <label asp-for="Domicilio">Domicilio</label>
                    <input asp-for="Domicilio" class="doc-input" maxlength="300" required />
                </div>
                <div class="doc-field">
                    <label asp-for="Dni">DNI (si firma una persona física)</label>
                    <input asp-for="Dni" class="doc-input doc-mono" maxlength="20" inputmode="numeric" />
                </div>
            </div>
            <div class="doc-grid-3" style="margin-top:.9rem">
                <div class="doc-field">
                    <label asp-for="Ciudad">Ciudad de firma</label>
                    <input asp-for="Ciudad" class="doc-input" maxlength="120" required />
                </div>
                <div class="doc-field">
                    <label asp-for="Jurisdiccion">Jurisdicción</label>
                    <input asp-for="Jurisdiccion" class="doc-input" maxlength="200" required />
                </div>
                <div class="doc-field">
                    <label asp-for="InteresMoraDiarioPorcentaje">Interés por mora diario (%)</label>
                    <input asp-for="InteresMoraDiarioPorcentaje" type="number" step="0.0001" min="0" max="100" class="doc-input" />
                </div>
            </div>
        </section>

        <section class="doc-card">
            <h2>Presentación en los comprobantes</h2>
            <p class="doc-sub">Textos que usan el presupuesto, el pagaré, el contrato y el recibo. Si se dejan vacíos se usan los datos de arriba.</p>
            <div class="doc-grid-3">
                <div class="doc-field">
                    <label asp-for="NombreComercial">Nombre comercial</label>
                    <input asp-for="NombreComercial" class="doc-input" maxlength="200" />
                </div>
                <div class="doc-field">
                    <label asp-for="DomicilioCompleto">Domicilio completo (contrato)</label>
                    <input asp-for="DomicilioCompleto" class="doc-input" maxlength="300" />
                </div>
                <div class="doc-field">
                    <label asp-for="CondicionFiscalClientePorDefecto">Condición fiscal del cliente</label>
                    <input asp-for="CondicionFiscalClientePorDefecto" class="doc-input" maxlength="60" placeholder="Consumidor Final" />
                </div>
            </div>
        </section>

        <section class="doc-card">
            <h2>Vencimiento del pagaré</h2>
            <p class="doc-sub">El sistema no asume ninguna regla: mientras no se defina, el pagaré sale con la línea en blanco para completar a mano.</p>
            <div class="doc-grid-2">
                <div class="doc-field">
                    <label asp-for="PagareVencimientoModo">Cómo se determina</label>
                    <select asp-for="PagareVencimientoModo" class="doc-input">
                        <option value="">@TheBuryProject.Models.Entities.PagareVencimientoModos.Etiqueta(null)</option>
                        @foreach (var modo in TheBuryProject.Models.Entities.PagareVencimientoModos.Todos)
                        {
                            <option value="@modo">@TheBuryProject.Models.Entities.PagareVencimientoModos.Etiqueta(modo)</option>
                        }
                    </select>
                </div>
                <div class="doc-field">
                    <label asp-for="PagareVencimientoDias">Días desde la operación</label>
                    <input asp-for="PagareVencimientoDias" type="number" min="1" max="3650" class="doc-input" />
                </div>
            </div>
        </section>

        <div class="doc-actions">
            <button type="submit" class="doc-btn doc-btn-primary">
                <span class="material-symbols-outlined" aria-hidden="true">save</span>Guardar
            </button>
        </div>
    </form>
</div>
