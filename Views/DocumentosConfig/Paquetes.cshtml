@model List<TheBuryProject.Models.Entities.PaqueteDocumental>
@{
    ViewData["Title"] = "Paquetes de documentos";
    ViewData["DocTab"] = "paquetes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos-module.css" asp-append-version="true" />
}

<div class="doc-module">
    <header class="doc-head">
        <h1 class="doc-title">Documentos</h1>
        <p class="doc-sub">Un paquete agrupa documentos que se usan juntos (por ejemplo contrato + pagaré). Siguen siendo documentos independientes: cada uno tiene su número, estado y firma, y pueden imprimirse en conjunto.</p>
        <partial name="_Tabs" />
    </header>

    <partial name="_Flash" />

    <div class="doc-actions" style="justify-content:flex-end">
        <a asp-action="PaqueteEdit" class="doc-btn doc-btn-primary">
            <span class="material-symbols-outlined" aria-hidden="true">add</span>Nuevo paquete
        </a>
    </div>

    <section class="doc-card">
        @if (Model.Count == 0)
        {
            <p class="doc-muted" style="margin:0">Todavía no hay paquetes.</p>
        }
        else
        {
            <div class="doc-table-wrap">
                <table class="doc-table" data-erp-cards>
                    <thead><tr><th data-card="title">Paquete</th><th>Documentos (en orden)</th><th data-card="half">Estado</th><th data-card="actions"><span class="sr-only">Acciones</span></th></tr></thead>
                    <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><strong>@p.Nombre</strong><div class="doc-muted doc-mono">@p.Codigo</div></td>
                            <td>@string.Join(" → ", p.Items.OrderBy(i => i.Orden).Select(i => i.PlantillaDocumento.Nombre))</td>
                            <td>@if (p.Activo) { <span class="doc-chip doc-chip-ok">Activo</span> } else { <span class="doc-chip doc-chip-off">Inactivo</span> }</td>
                            <td><a asp-action="PaqueteEdit" asp-route-id="@p.Id" class="doc-btn">Editar</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
