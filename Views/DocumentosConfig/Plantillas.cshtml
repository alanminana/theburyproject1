@model List<TheBuryProject.Models.Entities.PlantillaDocumento>
@{
    ViewData["Title"] = "Plantillas de documentos";
    ViewData["DocTab"] = "plantillas";
    var tipos = (List<TheBuryProject.Models.Entities.TipoDocumento>)ViewBag.Tipos;
    int? tipoId = ViewBag.TipoId as int?;
    var hoy = DateTime.UtcNow.Date;
}

@section Styles {
    <link rel="stylesheet" href="~/css/documentos-module.css" asp-append-version="true" />
}

<div class="doc-module">
    <header class="doc-head">
        <h1 class="doc-title">Documentos</h1>
        <p class="doc-sub">Plantillas de contratos, pagarés, recibos y otros documentos. Cada cambio de contenido crea una versión nueva: los documentos ya emitidos conservan la versión con la que se generaron.</p>
        <partial name="_Tabs" />
    </header>

    <partial name="_Flash" />

    <section class="doc-card">
        <div class="doc-actions" style="justify-content:space-between;margin-bottom:.75rem">
            <form method="get" class="doc-actions">
                <label for="tipoId" class="doc-label">Tipo</label>
                <select id="tipoId" name="tipoId" class="doc-select" style="width:auto" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.Id" selected="@(tipoId == t.Id)">@t.Nombre</option>
                    }
                </select>
            </form>
            <a asp-action="PlantillaEdit" asp-route-tipoId="@tipoId" class="doc-btn doc-btn-primary">
                <span class="material-symbols-outlined" aria-hidden="true">add</span>Nueva plantilla
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <p class="doc-muted">No hay plantillas para el filtro elegido.</p>
        }
        else
        {
            <div class="doc-table-wrap">
                <table class="doc-table" data-erp-cards>
                    <thead>
                        <tr><th data-card="title">Plantilla</th><th data-card="half">Tipo</th><th data-card="half">Versión</th><th>Vigencia</th><th data-card="half">Firma</th><th data-card="half">Estado</th><th data-card="actions"><span class="sr-only">Acciones</span></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model)
                    {
                        var vigente = p.Activa && p.VigenteDesde.Date <= hoy && (!p.VigenteHasta.HasValue || p.VigenteHasta.Value.Date >= hoy);
                        <tr>
                            <td>
                                <strong>@p.Nombre</strong>
                                <div class="doc-muted doc-mono">@p.Codigo</div>
                            </td>
                            <td>@p.TipoDocumento.Nombre</td>
                            <td>v@(p.VersionActual)</td>
                            <td>@p.VigenteDesde.ToString("dd/MM/yyyy")@(p.VigenteHasta.HasValue ? $" – {p.VigenteHasta.Value:dd/MM/yyyy}" : " – sin fin")</td>
                            <td>@(p.RequiereFirma ? (string.IsNullOrWhiteSpace(p.FirmantesRequeridos) ? "Sí" : p.FirmantesRequeridos) : "No")</td>
                            <td>
                                @if (vigente) { <span class="doc-chip doc-chip-ok">Vigente</span> }
                                else if (p.Activa) { <span class="doc-chip doc-chip-warn">Fuera de vigencia</span> }
                                else { <span class="doc-chip doc-chip-off">Inactiva</span> }
                            </td>
                            <td>
                                <div class="doc-actions">
                                    <button type="button" class="doc-btn" data-doc-preview-url="@Url.Action("PlantillaVistaPreviaPdf", new { id = p.Id })" data-doc-preview-title="@p.Nombre (v@(p.VersionActual))">
                                        <span class="material-symbols-outlined" aria-hidden="true">visibility</span>Vista previa
                                    </button>
                                    <a asp-action="PlantillaEdit" asp-route-id="@p.Id" class="doc-btn">Editar</a>
                                    <form method="post" asp-action="PlantillaActivar">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="activa" value="@((!p.Activa).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="doc-btn">@(p.Activa ? "Desactivar" : "Activar")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
