@* Navegación única de la configuración documental. Cada pestaña se muestra solo si el usuario tiene el permiso del área. *@
@{
    var activa = ViewData["DocTab"] as string ?? "plantillas";
    var puedePlantillas = User.TienePermiso("documentos", "managetemplates");
    var puedeReglas = User.TienePermiso("documentos", "managerules");
    var puedeTipos = User.TienePermiso("documentos", "managetypes");
}
<nav class="doc-tabs doc-tabs-scroll" aria-label="Configuración de documentos">
    @if (puedePlantillas)
    {
        <a asp-controller="DocumentosConfig" asp-action="Plantillas" class="doc-tab" aria-current="@(activa == "plantillas" ? "page" : null)">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">article</span>Plantillas
        </a>
    }
    @if (puedeReglas)
    {
        <a asp-controller="DocumentosConfig" asp-action="Reglas" class="doc-tab" aria-current="@(activa == "reglas" ? "page" : null)">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">rule</span>Reglas
        </a>
        <a asp-controller="DocumentosConfig" asp-action="Paquetes" class="doc-tab" aria-current="@(activa == "paquetes" ? "page" : null)">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">inventory_2</span>Paquetes
        </a>
    }
    @if (puedeTipos)
    {
        <a asp-controller="DocumentosConfig" asp-action="Tipos" class="doc-tab" aria-current="@(activa == "tipos" ? "page" : null)">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">category</span>Tipos
        </a>
    }
    @if (puedePlantillas)
    {
        <a asp-controller="DocumentosConfig" asp-action="Empresa" class="doc-tab" aria-current="@(activa == "empresa" ? "page" : null)">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">apartment</span>Empresa
        </a>
        <a asp-controller="DocumentosConfig" asp-action="Variables" class="doc-tab" aria-current="@(activa == "variables" ? "page" : null)">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">data_object</span>Variables
        </a>
    }
</nav>

@* Modal compartido: muestra el documento final (PDF) tal como se imprime, con datos de ejemplo. *@
<dialog id="doc-preview-modal" class="doc-modal" aria-labelledby="doc-preview-modal-title">
    <div class="doc-modal-head">
        <h2 id="doc-preview-modal-title" data-doc-modal-title>Vista previa</h2>
        <div class="doc-actions">
            <a href="#" target="_blank" rel="noopener" class="doc-btn" data-doc-modal-open hidden>
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>Abrir en pestaña
            </a>
            <button type="button" class="doc-btn" data-doc-modal-close>
                <span class="material-symbols-outlined" aria-hidden="true">close</span>Cerrar
            </button>
        </div>
    </div>
    <p class="doc-hint doc-hint-flush doc-mb-sm">Así se imprime el documento. Los datos son de ejemplo y el número queda sin asignar; no se guarda nada.</p>
    <p class="doc-muted" data-doc-modal-status role="status"></p>
    <iframe title="Vista previa del documento" class="doc-modal-frame" hidden></iframe>
</dialog>
<script src="~/js/documentos-preview.js" asp-append-version="true"></script>
<script>(function(){var a=document.querySelector('.doc-tabs-scroll [aria-current="page"]');if(a&&a.scrollIntoView)a.scrollIntoView({inline:'center',block:'nearest'});})();</script>
