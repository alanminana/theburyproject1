@model TheBuryProject.ViewModels.FijarPrecioViewModel
@{
    ViewData["Title"] = "Fijar precio";
}

<div class="inv-screen inv-screen--medio inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-action="Precios" asp-route-id="@Model.ListaId" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Precios de «@Model.ListaNombre»</a>
            <h1>Fijar precio de @Model.ProductoCodigo</h1>
            <p>@Model.ProductoNombre · lista «@Model.ListaNombre». El precio anterior queda en el historial con su vigencia.</p>
        </div>
    </header>

    <partial name="_ListaPrecioAlertas" />

    <form asp-action="FijarPrecio" asp-route-listaId="@Model.ListaId" asp-route-productoId="@Model.ProductoId" method="post"
          class="inv-panel" aria-label="Fijar precio manual" data-prevent-double-submit
          data-lp-sim-origen data-costo="@ListaPrecioUiHelper.Numero(Model.CostoProducto)"
          data-margen="@ListaPrecioUiHelper.Numero(Model.MargenPorcentaje)" data-recargo="@ListaPrecioUiHelper.Numero(Model.RecargoPorcentaje)"
          data-minimo="@ListaPrecioUiHelper.Numero(Model.MargenMinimoPorcentaje)" data-redondeo="@Model.ReglaRedondeo">
        <dl class="inv-resumen">
            <div><dt>Costo del producto</dt><dd>@ListaPrecioUiHelper.Moneda(Model.CostoProducto)</dd></div>
            <div><dt>Precio base</dt><dd>@ListaPrecioUiHelper.Moneda(Model.PrecioBase)</dd></div>
            <div><dt>Sugerido por la lista</dt><dd>@(Model.PrecioSugerido.HasValue ? ListaPrecioUiHelper.Moneda(Model.PrecioSugerido.Value) : "—")</dd></div>
            <div><dt class="lp-label-row">Margen mínimo <partial name="_ListaPrecioInfo" model='"margen-minimo"' /></dt><dd>@ListaPrecioUiHelper.Porcentaje(Model.MargenMinimoPorcentaje)</dd></div>
        </dl>

        <div class="inv-campos">
            <div class="inv-campo">
                <label class="inv-campo__etiqueta" for="precio">Precio de venta (con IVA)</label>
                <input id="precio" name="precio" type="number" step="0.01" min="0.01" max="20000000" inputmode="decimal" required
                       value="@ListaPrecioUiHelper.Numero(Model.Precio ?? Model.PrecioSugerido)" class="inv-control" aria-describedby="fijar-ayuda" />
            </div>
            <div class="inv-campo inv-campo--doble">
                <label class="inv-campo__etiqueta" for="notas">Motivo o notas (opcional)</label>
                <input id="notas" name="notas" type="text" maxlength="500" value="@Model.Notas" class="inv-control" />
            </div>
        </div>
        <p id="fijar-ayuda" class="inv-ayuda-texto">El costo se toma del producto; no se modifica. Rige desde ahora. El sugerido solo se cobra si lo guardás acá, y Venta y Cotización lo usan solo si esta lista es la predeterminada.</p>

        <div class="inv-actions">
            <a asp-action="Precios" asp-route-id="@Model.ListaId" class="inv-btn inv-btn--ghost">Cancelar</a>
            <button type="submit" class="inv-btn inv-btn--primary">Fijar precio</button>
        </div>
    </form>

    <section class="inv-panel inv-panel--tabla" aria-labelledby="lp-historial-titulo">
        <div class="inv-panel__cabecera">
            <h2 id="lp-historial-titulo" class="inv-panel__titulo">Historial en esta lista</h2>
            <a asp-controller="CambiosPrecios" asp-action="Historial" asp-route-productoId="@Model.ProductoId" asp-route-listaId="@Model.ListaId" class="inv-link">Ver historial completo</a>
        </div>
        @if (!Model.Historial.Any())
        {
            <p class="inv-empty" data-lp-vacio>Este producto todavía no tiene precios en esta lista.</p>
        }
        else
        {
            <div class="inv-table-wrap" role="region" aria-label="Historial de precios del producto en la lista" tabindex="0">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Vigente desde</th>
                            <th scope="col">Hasta</th>
                            <th scope="col" class="inv-col-num">Precio</th>
                            <th scope="col" class="inv-col-num">Margen</th>
                            <th scope="col">Origen</th>
                            <th scope="col">Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historial)
                        {
                            <tr>
                                <th scope="row">@ListaPrecioUiHelper.Fecha(h.VigenciaDesde)@(h.EsVigente ? " · vigente" : "")</th>
                                <td data-label="Hasta">@ListaPrecioUiHelper.Fecha(h.VigenciaHasta)</td>
                                <td data-label="Precio" class="inv-col-num"><span class="inv-importe">@ListaPrecioUiHelper.Moneda(h.Precio)</span></td>
                                <td data-label="Margen" class="inv-col-num">@ListaPrecioUiHelper.Porcentaje(h.MargenPorcentaje)</td>
                                <td data-label="Origen">@(h.EsManual ? "Manual" : "Lote")</td>
                                <td data-label="Usuario">@(h.CreadoPor ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<partial name="_ListaPrecioAyuda" />

@section Scripts {
    <script src="~/js/lista-precio-ayuda.js" asp-append-version="true"></script>
}
