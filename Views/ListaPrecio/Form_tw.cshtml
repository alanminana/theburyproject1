@model TheBuryProject.ViewModels.ListaPrecioFormViewModel
@using TheBuryProject.Models.Enums
@{
    var titulo = Model.EsNueva ? "Nueva lista de precios" : "Editar lista de precios";
    ViewData["Title"] = titulo;
    var accion = Model.EsNueva ? "Crear" : "Editar";
    var redondeos = new[]
    {
        ("", "Sin definir (se redondea a la centena)"),
        ("ninguno", "Sin redondeo"),
        ("unidad", "A la unidad"),
        ("decena", "A la decena"),
        ("centena", "A la centena")
    };
}

<div class="inv-screen inv-screen--medio inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Listas de precios</a>
            <h1>@titulo</h1>
            <p>El margen, el recargo y el redondeo se usan para sugerir precios. Cambiar la lista no modifica los precios ya cargados.</p>
        </div>
    </header>

    <partial name="_ListaPrecioAlertas" />

    <form asp-action="@accion" asp-route-id="@(Model.EsNueva ? null : Model.Id.ToString())" method="post" class="inv-screen" aria-label="@titulo" novalidate data-prevent-double-submit>
        <input type="hidden" asp-for="Id" />
        @if (Model.RowVersion is { Length: > 0 })
        {
            <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
        }
        <input type="hidden" asp-for="EraPredeterminada" />

        <section class="inv-panel" aria-labelledby="lp-datos">
            <h2 id="lp-datos" class="inv-panel__titulo">Datos</h2>
            <div class="inv-campos">
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="Nombre">Nombre</label>
                        <partial name="_ListaPrecioInfo" model='"nombre"' />
                    </div>
                    <input id="Nombre" name="Nombre" type="text" maxlength="100" required autocomplete="off" value="@Model.Nombre" class="inv-control" placeholder="Ej.: Contado" />
                    <span asp-validation-for="Nombre" class="inv-campo__error"></span>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="Codigo">Código</label>
                        <partial name="_ListaPrecioInfo" model='"codigo"' />
                    </div>
                    <input id="Codigo" name="Codigo" type="text" maxlength="20" required autocomplete="off" value="@Model.Codigo" class="inv-control inv-control--mayusculas" placeholder="Ej.: CONTADO" />
                    <span asp-validation-for="Codigo" class="inv-campo__error"></span>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="Tipo">Tipo</label>
                        <partial name="_ListaPrecioInfo" model='"tipo"' />
                    </div>
                    <select id="Tipo" name="Tipo" class="inv-control">
                        @foreach (var t in Enum.GetValues<TipoListaPrecio>())
                        {
                            <option value="@t" selected="@(Model.Tipo == t)">@ListaPrecioUiHelper.NombreTipo(t)</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        <fieldset class="inv-panel">
            <legend class="sr-only">Reglas de cálculo</legend>
            <p class="inv-panel__titulo" aria-hidden="true">Reglas de cálculo</p>
            <div class="inv-campos">
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="MargenPorcentaje">Margen sobre costo (%)</label>
                        <partial name="_ListaPrecioInfo" model='"margen"' />
                    </div>
                    <input id="MargenPorcentaje" name="MargenPorcentaje" type="number" step="0.01" min="0" max="999.99" inputmode="decimal" value="@ListaPrecioUiHelper.Numero(Model.MargenPorcentaje)" class="inv-control" />
                    <span asp-validation-for="MargenPorcentaje" class="inv-campo__error"></span>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="MargenMinimoPorcentaje">Margen mínimo (%)</label>
                        <partial name="_ListaPrecioInfo" model='"margen-minimo"' />
                    </div>
                    <input id="MargenMinimoPorcentaje" name="MargenMinimoPorcentaje" type="number" step="0.01" min="0" max="999.99" inputmode="decimal" value="@ListaPrecioUiHelper.Numero(Model.MargenMinimoPorcentaje)" class="inv-control" aria-describedby="lp-ayuda-minimo" />
                    <span asp-validation-for="MargenMinimoPorcentaje" class="inv-campo__error"></span>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="RecargoPorcentaje">Recargo (%)</label>
                        <partial name="_ListaPrecioInfo" model='"recargo"' />
                    </div>
                    <input id="RecargoPorcentaje" name="RecargoPorcentaje" type="number" step="0.01" min="0" max="999.99" inputmode="decimal" value="@ListaPrecioUiHelper.Numero(Model.RecargoPorcentaje)" class="inv-control" />
                    <span asp-validation-for="RecargoPorcentaje" class="inv-campo__error"></span>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="CantidadCuotas">Cantidad de cuotas</label>
                        <partial name="_ListaPrecioInfo" model='"cuotas"' />
                    </div>
                    <input id="CantidadCuotas" name="CantidadCuotas" type="number" step="1" min="1" max="60" inputmode="numeric" value="@Model.CantidadCuotas" class="inv-control" />
                    <span asp-validation-for="CantidadCuotas" class="inv-campo__error"></span>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="ReglaRedondeo">Redondeo</label>
                        <partial name="_ListaPrecioInfo" model='"redondeo"' />
                    </div>
                    <select id="ReglaRedondeo" name="ReglaRedondeo" class="inv-control">
                        @foreach (var (valor, texto) in redondeos)
                        {
                            <option value="@valor" selected="@((Model.ReglaRedondeo ?? "") == valor)">@texto</option>
                        }
                    </select>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="Orden">Orden</label>
                        <partial name="_ListaPrecioInfo" model='"orden"' />
                    </div>
                    <input id="Orden" name="Orden" type="number" step="1" min="0" max="9999" inputmode="numeric" value="@Model.Orden" class="inv-control" />
                </div>
            </div>
            <p id="lp-ayuda-minimo" class="inv-ayuda-texto">El margen mínimo no puede superar al margen. Al fijar un precio manual, la lista rechaza los que queden por debajo de su margen mínimo.</p>
        </fieldset>

        <section class="inv-panel" aria-labelledby="lp-uso">
            <h2 id="lp-uso" class="inv-panel__titulo">Uso y notas</h2>
            <div class="inv-checks inv-checks--columna">
                <div class="lp-label-row">
                    <label>
                        <input type="checkbox" name="Activa" value="true" checked="@Model.Activa" class="inv-check" />
                        <input type="hidden" name="Activa" value="false" />
                        Activa
                    </label>
                    <partial name="_ListaPrecioInfo" model='"activa"' />
                </div>
                @if (Model.EraPredeterminada)
                {
                    <input type="hidden" name="EsPredeterminada" value="true" />
                    <div class="lp-label-row">
                        <p><span class="inv-pill inv-pill--accent">Predeterminada</span> Para cambiarla, marcá otra lista como predeterminada.</p>
                        <partial name="_ListaPrecioInfo" model='"predeterminada"' />
                    </div>
                }
                else
                {
                    <div class="lp-label-row">
                        <label>
                            <input type="checkbox" name="EsPredeterminada" value="true" checked="@Model.EsPredeterminada" class="inv-check" />
                            <input type="hidden" name="EsPredeterminada" value="false" />
                            Lista predeterminada (la usan Venta y Cotización)
                        </label>
                        <partial name="_ListaPrecioInfo" model='"predeterminada"' />
                    </div>
                }
            </div>
            <div class="inv-grid-2">
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="Descripcion">Descripción (opcional)</label>
                        <partial name="_ListaPrecioInfo" model='"descripcion"' />
                    </div>
                    <textarea id="Descripcion" name="Descripcion" rows="2" maxlength="500" class="inv-control">@Model.Descripcion</textarea>
                </div>
                <div class="inv-campo">
                    <div class="lp-label-row">
                        <label class="inv-campo__etiqueta" for="Notas">Notas (opcional)</label>
                        <partial name="_ListaPrecioInfo" model='"notas"' />
                    </div>
                    <textarea id="Notas" name="Notas" rows="2" maxlength="1000" class="inv-control">@Model.Notas</textarea>
                </div>
            </div>
        </section>

        <div class="inv-actions">
            <a asp-action="Index" class="inv-btn inv-btn--ghost">Cancelar</a>
            <button type="submit" class="inv-btn inv-btn--primary">@(Model.EsNueva ? "Crear lista" : "Guardar cambios")</button>
        </div>
    </form>
</div>

<partial name="_ListaPrecioAyuda" />

@section Scripts {
    <script src="~/js/lista-precio-ayuda.js" asp-append-version="true"></script>
}
