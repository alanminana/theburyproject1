@model TheBuryProject.ViewModels.ListaPreciosPagina
@using TheBuryProject.Models.Entities
@{
    var lista = (ListaPrecio)ViewBag.Lista;
    var busqueda = ViewBag.Busqueda as string;
    var puedeFijar = (bool)ViewBag.PuedeFijar;
    var sugeridos = (Dictionary<int, decimal?>)ViewBag.Sugeridos;
    ViewData["Title"] = $"Precios de {lista.Nombre}";

    Dictionary<string, string> Ruta(int pagina) => new Dictionary<string, string?>
    {
        ["id"] = lista.Id.ToString(),
        ["busqueda"] = busqueda,
        ["pagina"] = pagina.ToString()
    }.Where(kv => !string.IsNullOrEmpty(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value!);
}

<partial name="_ListaPrecioAlertas" />

<section class="card-erp-panel mb-4 p-4" data-lp-sim-origen data-margen="@ListaPrecioUiHelper.Numero(lista.MargenPorcentaje)"
         data-recargo="@ListaPrecioUiHelper.Numero(lista.RecargoPorcentaje)" data-minimo="@ListaPrecioUiHelper.Numero(lista.MargenMinimoPorcentaje)"
         data-redondeo="@lista.ReglaRedondeo">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400">
        <a asp-action="Index" class="no-underline hover:text-primary">Listas de precios</a>
        <span class="material-symbols-outlined text-xs" aria-hidden="true">chevron_right</span>
        <span class="text-primary">@lista.Nombre</span>
    </nav>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-lg font-bold tracking-tight text-white">Precios de «@lista.Nombre»</h1>
        <partial name="_ListaPrecioAyudaBoton" />
    </div>
    <p class="mt-1 text-sm text-slate-400">
        Margen @ListaPrecioUiHelper.Porcentaje(lista.MargenPorcentaje) · recargo @ListaPrecioUiHelper.Porcentaje(lista.RecargoPorcentaje)
        · @ListaPrecioUiHelper.NombreRedondeo(lista.ReglaRedondeo).ToLowerInvariant().
        @if (lista.EsPredeterminada)
        {
            <text>Es la lista predeterminada: los productos sin precio en ella usan su precio base.</text>
        }
        else
        {
            <text>No es la lista predeterminada: Venta y Cotización no usan estos precios.</text>
        }
    </p>
    <dl class="lp-glosario">
        <div><dt>Costo</dt><dd>El costo real del producto en Inventario.</dd></div>
        <div><dt>Precio en la lista</dt><dd>El importe guardado (fijado) para el producto.</dd></div>
        <div><dt>Sugerido</dt><dd>Cálculo con las reglas de la lista. No se cobra hasta fijarlo.</dd></div>
    </dl>
</section>

<form asp-action="Precios" asp-route-id="@lista.Id" method="get" class="filter-panel-erp mb-4" aria-label="Buscar productos">
    <div class="grid grid-cols-1 gap-4 p-4 md:grid-cols-12">
        <div class="md:col-span-8">
            <label class="@ListaPrecioUiHelper.LabelClass" for="f-busqueda">Producto</label>
            <input id="f-busqueda" type="text" name="busqueda" value="@busqueda" maxlength="100"
                   class="@ListaPrecioUiHelper.InputClass" placeholder="Código o nombre" />
        </div>
        <div class="flex items-end gap-2 md:col-span-4">
            <button type="submit" class="btn-erp-primary btn-sm flex-1">Buscar</button>
            <a asp-action="Precios" asp-route-id="@lista.Id" class="btn-erp-ghost btn-sm no-underline" title="Limpiar búsqueda" aria-label="Limpiar búsqueda">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">filter_alt_off</span>
            </a>
        </div>
    </div>
</form>

<section class="card-erp-panel mb-4" aria-label="Precios por producto">
    <div class="table-erp-wrapper" role="region" aria-label="Tabla de precios de la lista" tabindex="0">
        <table data-erp-cards class="w-full border-collapse text-left">
            <thead>
                <tr class="border-b border-slate-800">
                    <th scope="col" data-card="title" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 whitespace-nowrap">Producto</th>
                    <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Costo</th>
                    <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Precio en la lista</th>
                    <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Sugerido</th>
                    <th scope="col" data-card="actions" class="pl-3 pr-2 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                @foreach (var p in Model.Items)
                {
                    <tr class="transition-colors hover:bg-slate-800/50">
                        <td class="px-3 py-2.5">
                            <span class="block font-bold text-primary">@p.Codigo</span>
                            <span class="block text-xs text-slate-400">@p.Nombre</span>
                        </td>
                        <td class="px-3 py-2.5 text-right whitespace-nowrap">@ListaPrecioUiHelper.Moneda(p.CostoProducto)</td>
                        <td class="px-3 py-2.5 text-right font-bold whitespace-nowrap">
                            @if (p.PrecioEnLista.HasValue)
                            {
                                @ListaPrecioUiHelper.Moneda(p.PrecioEnLista.Value)
                                <span class="block text-xs font-normal text-slate-400">margen @ListaPrecioUiHelper.Porcentaje(p.MargenPorcentaje) · desde @ListaPrecioUiHelper.Fecha(p.VigenciaDesde)</span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold text-slate-400">Sin precio fijado (precio base @ListaPrecioUiHelper.Moneda(p.PrecioBase))</span>
                            }
                        </td>
                        <td class="px-3 py-2.5 text-right text-slate-300 whitespace-nowrap">@(sugeridos.GetValueOrDefault(p.ProductoId) is decimal s ? ListaPrecioUiHelper.Moneda(s) : "—")</td>
                        <td class="pl-3 pr-2 py-2.5 text-right whitespace-nowrap">
                            <div class="flex flex-nowrap justify-end gap-1">
                                @if (puedeFijar)
                                {
                                    <a asp-action="FijarPrecio" asp-route-listaId="@lista.Id" asp-route-productoId="@p.ProductoId"
                                       class="row-action row-action--primary no-underline"
                                       aria-label="Fijar el precio de @p.Codigo en @lista.Nombre" title="Fijar precio">
                                        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                        <span class="row-action__label">Fijar precio</span>
                                    </a>
                                }
                                <a asp-controller="CambiosPrecios" asp-action="Historial" asp-route-productoId="@p.ProductoId" asp-route-listaId="@lista.Id"
                                   class="row-action row-action--primary no-underline"
                                   aria-label="Historial de precios de @p.Codigo en @lista.Nombre" title="Historial">
                                    <span class="material-symbols-outlined" aria-hidden="true">history</span>
                                    <span class="row-action__label">Historial</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="px-6 py-12 text-center" data-lp-vacio>
            <span class="material-symbols-outlined text-4xl text-slate-500" aria-hidden="true">inventory_2</span>
            <p class="mt-2 text-base font-semibold text-slate-200">@(string.IsNullOrWhiteSpace(busqueda) ? "No hay productos cargados." : "Ningún producto coincide con la búsqueda.")</p>
        </div>
    }

    @if (Model.TotalPaginas > 1)
    {
        <nav class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-800 px-4 py-3" aria-label="Paginación de productos">
            <p class="text-sm text-slate-400">Página @Model.Pagina de @Model.TotalPaginas · @Model.Total productos</p>
            <div class="flex items-center gap-2">
                @if (Model.Pagina > 1)
                {
                    <a asp-action="Precios" asp-all-route-data="@Ruta(Model.Pagina - 1)" rel="prev" class="btn-erp-ghost btn-sm no-underline">Anterior</a>
                }
                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a asp-action="Precios" asp-all-route-data="@Ruta(Model.Pagina + 1)" rel="next" class="btn-erp-ghost btn-sm no-underline">Siguiente</a>
                }
            </div>
        </nav>
    }
</section>

<partial name="_ListaPrecioAyuda" />

@section Styles {
    <link rel="stylesheet" href="~/css/lista-precio.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/lista-precio-ayuda.js" asp-append-version="true"></script>
}
