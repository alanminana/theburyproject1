@model TheBuryProject.ViewModels.ListaPreciosPagina
@using TheBuryProject.Models.Entities
@{
    var lista = (ListaPrecio)ViewBag.Lista;
    var busqueda = ViewBag.Busqueda as string;
    var puedeFijar = (bool)ViewBag.PuedeFijar;
    var sugeridos = (Dictionary<int, decimal?>)ViewBag.Sugeridos;
    ViewData["Title"] = $"Precios de {lista.Nombre}";

    Dictionary<string, string> Ruta(int pagina) => new Dictionary<string, string?>
    {
        ["id"] = lista.Id.ToString(),
        ["busqueda"] = busqueda,
        ["pagina"] = pagina.ToString()
    }.Where(kv => !string.IsNullOrEmpty(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value!);
}

<div class="inv-screen inv-page">
    <header class="inv-head" data-lp-sim-origen data-margen="@ListaPrecioUiHelper.Numero(lista.MargenPorcentaje)"
            data-recargo="@ListaPrecioUiHelper.Numero(lista.RecargoPorcentaje)" data-minimo="@ListaPrecioUiHelper.Numero(lista.MargenMinimoPorcentaje)"
            data-redondeo="@lista.ReglaRedondeo">
        <div class="inv-head__titulo">
            <a asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Listas de precios</a>
            <h1>Precios de «@lista.Nombre»</h1>
            <p>
                Margen @ListaPrecioUiHelper.Porcentaje(lista.MargenPorcentaje) · recargo @ListaPrecioUiHelper.Porcentaje(lista.RecargoPorcentaje)
                · @ListaPrecioUiHelper.NombreRedondeo(lista.ReglaRedondeo).ToLowerInvariant().
                @if (lista.EsPredeterminada)
                {
                    <text>Es la lista predeterminada: los productos sin precio en ella usan su precio base.</text>
                }
                else
                {
                    <text>No es la lista predeterminada: Venta y Cotización no usan estos precios.</text>
                }
            </p>
        </div>
    </header>

    <partial name="_ListaPrecioAlertas" />

    <section class="inv-panel inv-panel--tabla" aria-label="Precios por producto">
        <form asp-action="Precios" asp-route-id="@lista.Id" method="get" class="inv-filters" role="search" aria-label="Buscar productos">
            <div class="inv-search">
                <label class="sr-only" for="f-busqueda">Producto</label>
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input id="f-busqueda" type="search" name="busqueda" value="@busqueda" maxlength="100" class="inv-control" placeholder="Código o nombre" />
            </div>
            <button type="submit" class="inv-btn inv-btn--ghost">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(busqueda))
            {
                <a asp-action="Precios" asp-route-id="@lista.Id" class="inv-btn inv-btn--ghost">Limpiar búsqueda</a>
            }
        </form>

        <dl class="lp-glosario">
            <div><dt>Costo</dt><dd>El costo real del producto en Inventario.</dd></div>
            <div><dt>Precio en la lista</dt><dd>El importe guardado (fijado) para el producto.</dd></div>
            <div><dt>Sugerido</dt><dd>Cálculo con las reglas de la lista. No se cobra hasta fijarlo.</dd></div>
        </dl>

        @if (Model.Items.Any())
        {
            <div class="inv-table-wrap" role="region" aria-label="Tabla de precios de la lista" tabindex="0">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="inv-col-num">Costo</th>
                            <th scope="col" class="inv-col-num">Precio en la lista</th>
                            <th scope="col" class="inv-col-num">Sugerido</th>
                            <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                <th scope="row" class="inv-celda-principal">
                                    <strong>@p.Codigo</strong>
                                    <p class="inv-ayuda-texto">@p.Nombre</p>
                                </th>
                                <td data-label="Costo" class="inv-col-num">@ListaPrecioUiHelper.Moneda(p.CostoProducto)</td>
                                <td data-label="Precio en la lista" class="inv-col-num">
                                    @if (p.PrecioEnLista.HasValue)
                                    {
                                        <span class="inv-importe">@ListaPrecioUiHelper.Moneda(p.PrecioEnLista.Value)</span>
                                        <p class="inv-sub">margen @ListaPrecioUiHelper.Porcentaje(p.MargenPorcentaje) · desde @ListaPrecioUiHelper.Fecha(p.VigenciaDesde)</p>
                                    }
                                    else
                                    {
                                        <p class="inv-sub">Sin precio fijado (precio base @ListaPrecioUiHelper.Moneda(p.PrecioBase))</p>
                                    }
                                </td>
                                <td data-label="Sugerido" class="inv-col-num">@(sugeridos.GetValueOrDefault(p.ProductoId) is decimal s ? ListaPrecioUiHelper.Moneda(s) : "—")</td>
                                <td class="inv-col-actions">
                                    <div class="inv-row-actions">
                                        @if (puedeFijar)
                                        {
                                            <a asp-action="FijarPrecio" asp-route-listaId="@lista.Id" asp-route-productoId="@p.ProductoId"
                                               class="inv-btn inv-btn--ghost inv-btn--sm" aria-label="Fijar el precio de @p.Codigo en @lista.Nombre">Fijar precio</a>
                                        }
                                        <a asp-controller="CambiosPrecios" asp-action="Historial" asp-route-productoId="@p.ProductoId" asp-route-listaId="@lista.Id"
                                           class="inv-icon-btn" aria-label="Historial de precios de @p.Codigo en @lista.Nombre" title="Historial">
                                            <span class="material-symbols-outlined" aria-hidden="true">history</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="inv-empty" data-lp-vacio>
                <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
                <p class="inv-empty__title">@(string.IsNullOrWhiteSpace(busqueda) ? "No hay productos cargados." : "Ningún producto coincide con la búsqueda.")</p>
            </div>
        }

        @if (Model.TotalPaginas > 1)
        {
            <nav class="inv-pager" aria-label="Paginación de productos">
                @if (Model.Pagina > 1)
                {
                    <a asp-action="Precios" asp-all-route-data="@Ruta(Model.Pagina - 1)" rel="prev" class="inv-btn inv-btn--ghost">Anterior</a>
                }
                <span aria-current="page">Página @Model.Pagina de @Model.TotalPaginas · @Model.Total productos</span>
                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a asp-action="Precios" asp-all-route-data="@Ruta(Model.Pagina + 1)" rel="next" class="inv-btn inv-btn--ghost">Siguiente</a>
                }
            </nav>
        }
    </section>
</div>

<partial name="_ListaPrecioAyuda" />

@section Scripts {
    <script src="~/js/lista-precio-ayuda.js" asp-append-version="true"></script>
}
