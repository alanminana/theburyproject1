@model TheBuryProject.ViewModels.MoraIndexViewModel
@using TheBuryProject.Services.Interfaces
@using TheBuryProject.Models.Entities
@section Styles {
    <link rel="stylesheet" href="~/css/mora-module.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Mora y cobranzas";
    var returnUrl = ViewData["ReturnUrl"] as string;

    // El controller deja ViewBag.KPIs sin asignar cuando falla la carga (catch): la vista lo
    // trata como estado de error en vez de inventar ceros.
    var kpis = ViewBag.KPIs as DashboardMoraKPIs;
    var logs = ViewBag.HistorialEjecuciones as List<LogMora> ?? new List<LogMora>();
    var cargaFallida = kpis == null;

    var puedeGestionar = User.TienePermiso("mora", "manage");
    var puedeConfigurar = User.TienePermiso("mora", "config");

    string ClasePrioridad(PrioridadAlerta p) => p switch
    {
        PrioridadAlerta.Critica => "badge-erp-danger",
        PrioridadAlerta.Alta => "badge-erp-warning",
        PrioridadAlerta.Media => "badge-erp-info",
        _ => "badge-erp-neutral"
    };
}

<div class="space-y-6" data-mora-index>
    <section class="card-erp-panel-padded">
        <header class="flex flex-col gap-6">
            <div class="space-y-4">
                <nav aria-label="Breadcrumb" class="flex text-sm font-medium text-slate-400">
                    <ol class="inline-flex flex-wrap items-center gap-y-1">
                        <li><a asp-controller="Home" asp-action="Index" class="hover:text-primary no-underline">Inicio</a></li>
                        <li><span class="mx-2 text-slate-400">/</span></li>
                        <li class="text-slate-100">Mora</li>
                    </ol>
                </nav>
                <div class="space-y-3">
                    <span class="badge-erp badge-erp-primary">
                        <span class="material-symbols-outlined text-sm">alarm</span>
                        Cobranzas
                    </span>
                    <div class="space-y-2">
                        <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">Mora y cobranzas</h1>
                        <p class="max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base">
                            Estado de la cartera vencida, alertas activas y últimas ejecuciones del proceso automático.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mora-actions">
                <a asp-controller="Mora" asp-action="ClientesMora" class="btn-erp-secondary sm:py-2.5 no-underline">
                    <span class="material-symbols-outlined text-[20px]">groups</span>
                    Clientes en mora
                </a>
                <a asp-controller="Mora" asp-action="Alertas" class="btn-erp-secondary sm:py-2.5 no-underline">
                    <span class="material-symbols-outlined text-[20px]">notifications_active</span>
                    Alertas
                </a>
                <a asp-controller="Mora" asp-action="Logs" class="btn-erp-secondary sm:py-2.5 no-underline">
                    <span class="material-symbols-outlined text-[20px]">history</span>
                    Historial
                </a>
                @if (puedeConfigurar)
                {
                    <a asp-controller="Mora" asp-action="ConfiguracionExpandida" class="btn-erp-ghost sm:py-2.5 no-underline">
                        <span class="material-symbols-outlined text-[20px]">tune</span>
                        Configuración
                    </a>
                }
                @if (puedeGestionar)
                {
                    <form asp-controller="Mora" asp-action="EjecutarJob" method="post">
                        @Html.AntiForgeryToken()
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        }
                        <button type="submit" class="btn-erp-primary w-full sm:w-auto sm:py-2.5">
                            <span class="material-symbols-outlined text-[20px]">play_arrow</span>
                            Ejecutar proceso ahora
                        </button>
                    </form>
                }
            </div>
        </header>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400" role="status">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-3 rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400" role="alert">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    @if (cargaFallida)
    {
        <section class="card-erp-panel-padded text-center" data-mora-estado="error">
            <span class="material-symbols-outlined text-4xl text-rose-400" aria-hidden="true">cloud_off</span>
            <h2 class="mt-3 text-lg font-bold text-white">No se pudo cargar el resumen de mora</h2>
            <p class="mx-auto mt-1 max-w-md text-sm text-slate-400">
                Los indicadores no están disponibles en este momento. Recargá la página; si persiste, revisá el registro del servidor.
            </p>
            <a asp-controller="Mora" asp-action="Index" class="btn-erp-secondary mt-4 inline-flex no-underline">
                <span class="material-symbols-outlined text-[20px]">refresh</span>
                Reintentar
            </a>
        </section>
    }
    else
    {
        <!-- ============ Indicadores ============ -->
        <section aria-labelledby="mora-kpis-titulo" data-mora-kpis>
            <h2 id="mora-kpis-titulo" class="sr-only">Indicadores de mora</h2>
            <div class="mora-kpi-grid">
                <div class="card-erp-metric">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Clientes en mora</p>
                    <p class="mora-kpi-value" data-kpi="clientes-mora">@kpis!.TotalClientesMora</p>
                    <p class="mt-1 text-xs text-slate-500">@kpis.ClientesSinGestion sin gestión reciente</p>
                </div>
                <div class="card-erp-metric-danger">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Monto vencido</p>
                    <p class="mora-kpi-value" data-kpi="monto-vencido">@kpis.MontoTotalVencido.ToString("C2")</p>
                    <p class="mt-1 text-xs text-slate-500">Mora calculada: @kpis.MoraTotal.ToString("C2")</p>
                </div>
                <div class="card-erp-metric-warning">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Alertas activas</p>
                    <p class="mora-kpi-value" data-kpi="alertas-activas">@kpis.AlertasActivas</p>
                    <p class="mt-1 text-xs text-slate-500">Críticas: @kpis.AlertasCriticas</p>
                </div>
                <div class="card-erp-metric">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Atraso promedio</p>
                    <p class="mora-kpi-value" data-kpi="atraso-promedio">@kpis.DiasPromedioAtraso.ToString("0.#") días</p>
                    <p class="mt-1 text-xs text-slate-500">Sobre las alertas activas</p>
                </div>
                <div class="card-erp-metric-info">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Promesas de pago</p>
                    <p class="mora-kpi-value" data-kpi="promesas-activas">@kpis.PromesasActivas</p>
                    <p class="mt-1 text-xs text-slate-500">@kpis.PromesasVencenHoy vencen hoy · @kpis.PromesasVencidas vencidas</p>
                </div>
                <div class="card-erp-metric-success">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Acuerdos activos</p>
                    <p class="mora-kpi-value" data-kpi="acuerdos-activos">@kpis.AcuerdosActivos</p>
                    <p class="mt-1 text-xs text-slate-500">Saldo: @kpis.MontoAcuerdosActivos.ToString("C2")</p>
                </div>
                <div class="card-erp-metric">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Contactos</p>
                    <p class="mora-kpi-value" data-kpi="contactos-hoy">@kpis.ContactosHoy</p>
                    <p class="mt-1 text-xs text-slate-500">hoy · @kpis.ContactosSemana en la semana</p>
                </div>
                <div class="card-erp-metric">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Proceso automático</p>
                    <p class="mt-1">
                        <span class="badge-erp @(kpis.ProcesoActivo ? "badge-erp-success" : "badge-erp-neutral")" data-kpi="proceso-estado">
                            @(kpis.ProcesoActivo ? "Activo" : "Inactivo")
                        </span>
                    </p>
                    <p class="mt-2 text-xs text-slate-500">
                        Última ejecución:
                        @(kpis.UltimaEjecucion.HasValue ? kpis.UltimaEjecucion.Value.ToString("dd/MM/yyyy HH:mm") : "sin ejecuciones registradas")
                    </p>
                </div>
            </div>
        </section>

        <!-- ============ Alertas activas ============ -->
        <section class="card-erp-panel-padded" aria-labelledby="mora-alertas-titulo" data-mora-alertas>
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">notifications_active</span>
                    <h2 id="mora-alertas-titulo" class="text-xl font-bold text-white">Alertas activas</h2>
                </div>
                <p class="text-xs text-slate-400">
                    Mostrando @Model.Alertas.Count de @Model.TotalAlertas · pendientes @Model.AlertasPendientes
                </p>
            </div>

            @if (!Model.Alertas.Any())
            {
                <div class="py-10 text-center" data-mora-estado="alertas-vacio">
                    <span class="material-symbols-outlined text-4xl text-emerald-400" aria-hidden="true">task_alt</span>
                    <p class="mt-2 text-base font-semibold text-white">No hay alertas de mora activas</p>
                    <p class="text-sm text-slate-400">Cuando una cuota venza, la alerta aparece acá luego de ejecutar el proceso.</p>
                </div>
            }
            else
            {
                <div class="table-erp-wrapper overflow-x-auto" data-oc-scroll-region>
                    <table data-erp-cards class="mora-table w-full text-left text-sm">
                        <thead class="border-b border-slate-800 text-xs uppercase tracking-wide text-slate-400">
                            <tr>
                                <th scope="col" data-card="title" class="px-4 py-3 font-semibold">Cliente</th>
                                <th scope="col" data-card="half" class="px-4 py-3 font-semibold">Prioridad</th>
                                <th scope="col" data-card="half" class="px-4 py-3 font-semibold">Fecha</th>
                                <th scope="col" data-card="half" class="px-4 py-3 text-right font-semibold">Cuotas vencidas</th>
                                <th scope="col" data-card="half" class="px-4 py-3 text-right font-semibold">Monto vencido</th>
                                <th scope="col" data-card="hide" class="px-4 py-3 font-semibold">Detalle</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach (var a in Model.Alertas)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <span class="block font-semibold text-slate-100">@(string.IsNullOrWhiteSpace(a.ClienteNombre) ? "Cliente sin nombre" : a.ClienteNombre)</span>
                                        @if (!string.IsNullOrWhiteSpace(a.ClienteDocumento))
                                        {
                                            <span class="block text-xs text-slate-500">@a.ClienteDocumento</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3"><span class="badge-erp @ClasePrioridad(a.Prioridad)">@a.Prioridad</span></td>
                                    <td class="px-4 py-3 text-slate-300">@a.FechaAlerta.ToString("dd/MM/yyyy")</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-slate-300">@a.CuotasVencidas</td>
                                    <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-100">@a.MontoVencido.ToString("C2")</td>
                                    <td class="px-4 py-3 text-slate-400">@a.Mensaje</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TotalAlertas > Model.Alertas.Count)
                {
                    <p class="mt-3 text-right text-sm">
                        <a asp-controller="Mora" asp-action="Alertas" class="text-primary no-underline hover:underline">Ver las @Model.TotalAlertas alertas</a>
                    </p>
                }
            }
        </section>

        <!-- ============ Últimas ejecuciones ============ -->
        <section class="card-erp-panel-padded" aria-labelledby="mora-logs-titulo" data-mora-logs>
            <div class="mb-4 flex items-center gap-2 border-b border-slate-800 pb-3">
                <span class="material-symbols-outlined text-primary">history</span>
                <h2 id="mora-logs-titulo" class="text-xl font-bold text-white">Últimas ejecuciones</h2>
            </div>

            @if (!logs.Any())
            {
                <div class="py-8 text-center" data-mora-estado="logs-vacio">
                    <p class="text-base font-semibold text-white">Todavía no hay ejecuciones registradas</p>
                    <p class="text-sm text-slate-400">El proceso automático o la ejecución manual generan el primer registro.</p>
                </div>
            }
            else
            {
                <div class="table-erp-wrapper overflow-x-auto" data-oc-scroll-region>
                    <table data-erp-cards class="mora-table w-full text-left text-sm">
                        <thead class="border-b border-slate-800 text-xs uppercase tracking-wide text-slate-400">
                            <tr>
                                <th scope="col" data-card="title" class="px-4 py-3 font-semibold">Fecha</th>
                                <th scope="col" data-card="half" class="px-4 py-3 font-semibold">Resultado</th>
                                <th scope="col" data-card="half" class="px-4 py-3 text-right font-semibold">Cuotas procesadas</th>
                                <th scope="col" data-card="half" class="px-4 py-3 text-right font-semibold">Alertas generadas</th>
                                <th scope="col" data-card="half" class="px-4 py-3 text-right font-semibold">Errores</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach (var l in logs.Take(5))
                            {
                                <tr>
                                    <td class="px-4 py-3 text-slate-100">@l.FechaEjecucion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="px-4 py-3">
                                        <span class="badge-erp @(l.Exitoso ? "badge-erp-success" : "badge-erp-danger")">@(l.Exitoso ? "Exitoso" : "Con errores")</span>
                                    </td>
                                    <td class="px-4 py-3 text-right tabular-nums text-slate-300">@l.CuotasProcesadas</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-slate-300">@l.AlertasGeneradas</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-slate-300">@l.Errores</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="mt-3 text-right text-sm">
                    <a asp-controller="Mora" asp-action="Logs" class="text-primary no-underline hover:underline">Ver historial completo</a>
                </p>
            }
        </section>
    }
</div>
