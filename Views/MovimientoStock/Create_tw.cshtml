@model TheBuryProject.ViewModels.AjusteStockViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Registrar ajuste de stock";
    var tieneProducto = Model?.ProductoId > 0 && !string.IsNullOrEmpty(Model?.ProductoNombre);
}

<div class="inv-screen inv-screen--form inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-controller="MovimientoStock" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Movimientos</a>
            <h1>Registrar ajuste de stock</h1>
            <p>El stock se gestiona por producto. No registra unidades con número de serie.</p>
        </div>
    </header>

    <form method="post" asp-controller="MovimientoStock" asp-action="Create" class="inv-panel"
          data-ajuste-inline data-prevent-double-submit
          data-producto="@(tieneProducto ? Model!.ProductoNombre : "")"
          data-stock-actual="@(tieneProducto ? Model!.StockActual.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")">
        @* Identifica esta intención: reenviar el formulario (doble clic, refresco) no duplica el movimiento. *@
        <input type="hidden" name="RequestId" value="@(Model?.RequestId ?? Guid.NewGuid())" />

        <div asp-validation-summary="ModelOnly" class="inv-aviso inv-aviso--error inv-resumen-errores" role="alert"></div>

        @if (tieneProducto)
        {
            <dl class="inv-resumen">
                <div><dt>Producto</dt><dd>@Model!.ProductoNombre</dd></div>
                @if (!string.IsNullOrEmpty(Model.ProductoCodigo))
                {
                    <div><dt>Código</dt><dd>@Model.ProductoCodigo</dd></div>
                }
                <div><dt>Stock actual</dt><dd>@Model.StockActual.ToString("G29")</dd></div>
            </dl>
        }

        <div class="inv-campo">
            <label asp-for="ProductoId" class="inv-campo__etiqueta">Producto</label>
            <select asp-for="ProductoId" asp-items="ViewBag.Productos" id="select-producto" class="inv-control">
                <option value="">Seleccioná un producto</option>
            </select>
            <span asp-validation-for="ProductoId" class="inv-campo__error"></span>
        </div>

        <div class="inv-campo">
            <label asp-for="Tipo" class="inv-campo__etiqueta" for="select-tipo">Tipo de movimiento</label>
            <select asp-for="Tipo" asp-items="ViewBag.Tipos" id="select-tipo" class="inv-control" aria-describedby="tipo-ayuda"></select>
            <p id="tipo-ayuda" class="inv-campo__ayuda">Entrada suma, Salida resta y Ajuste fija el stock en el valor exacto indicado.</p>
            <span asp-validation-for="Tipo" class="inv-campo__error"></span>
        </div>

        <div class="inv-campo">
            <label asp-for="Cantidad" class="inv-campo__etiqueta">Cantidad</label>
            <input asp-for="Cantidad" type="number" min="0" step="0.01" inputmode="decimal" class="inv-control" />
            <span asp-validation-for="Cantidad" class="inv-campo__error"></span>
        </div>

        <div class="inv-campo">
            <label asp-for="Motivo" class="inv-campo__etiqueta">Motivo</label>
            <input asp-for="Motivo" type="text" maxlength="500" class="inv-control" placeholder="Ej.: inventario físico, devolución a proveedor" />
            <span asp-validation-for="Motivo" class="inv-campo__error"></span>
        </div>

        <div class="inv-campo">
            <label asp-for="Referencia" class="inv-campo__etiqueta">Referencia <span class="inv-campo__requerido">(opcional)</span></label>
            <input asp-for="Referencia" type="text" maxlength="200" class="inv-control" placeholder="Ej.: remito 456" />
            <span asp-validation-for="Referencia" class="inv-campo__error"></span>
        </div>

        <div class="inv-actions">
            <a asp-controller="MovimientoStock" asp-action="Index" class="inv-btn inv-btn--ghost">Cancelar</a>
            <button type="submit" class="inv-btn inv-btn--primary">Registrar ajuste</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/ajuste-stock-modal.js" asp-append-version="true"></script>
}
