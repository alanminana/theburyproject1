@model TheBuryProject.ViewModels.MovimientoStockFilterViewModel
@{
    ViewData["Title"] = "Movimientos de Stock";
}


<div class="inv-screen inv-page">

    @if (TempData["Success"] != null)
    {
        <div role="status" class="flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400">
            <span class="material-symbols-outlined">check_circle</span>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div role="alert" class="flex items-center gap-3 rounded-xl border border-red-500/20 bg-red-500/10 p-4 text-sm font-semibold text-red-400">
            <span class="material-symbols-outlined">error</span>@TempData["Error"]
        </div>
    }

    <h1 class="sr-only">Movimientos de stock</h1>
    @if (User.TienePermiso("movimientos", "create"))
    {
        <div class="inv-actions">
            <button type="button" data-ajuste-stock-open class="inv-btn inv-btn--primary">
                <span class="material-symbols-outlined" aria-hidden="true">add</span>
                Registrar ajuste
            </button>
        </div>
    }

    @await Html.PartialAsync("_MovimientoStockListadoPartial", new TheBuryProject.ViewModels.MovimientoStockListadoPartialViewModel
    {
        Filtro = Model ?? new TheBuryProject.ViewModels.MovimientoStockFilterViewModel(),
        Productos = ViewBag.Productos,
        Tipos = ViewBag.Tipos,
        Embed = false
    })

</div>

@if (User.TienePermiso("movimientos", "create"))
{
    @await Html.PartialAsync("_AjusteStockModal", new TheBuryProject.ViewModels.AjusteStockModalViewModel
    {
        Ajuste = new TheBuryProject.ViewModels.AjusteStockViewModel { ReturnUrl = Url.Action("Index", "MovimientoStock") },
        ProductoBloqueado = false,
        Productos = ViewBag.ProductosActivosParaAjuste,
        Tipos = ViewBag.Tipos
    })
}

@section Scripts {
    <script src="~/js/ajuste-stock-modal.js" asp-append-version="true"></script>
}
