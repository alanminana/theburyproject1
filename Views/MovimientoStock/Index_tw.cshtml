@model TheBuryProject.ViewModels.MovimientoStockFilterViewModel
@{
    ViewData["Title"] = "Movimientos de Stock";
}

@section Styles {
    <link rel="stylesheet" href="~/css/horizontal-scroll-affordance.css" asp-append-version="true" />
}

<div class="space-y-6">

    @if (TempData["Success"] != null)
    {
        <div role="status" class="flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400">
            <span class="material-symbols-outlined">check_circle</span>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div role="alert" class="flex items-center gap-3 rounded-xl border border-red-500/20 bg-red-500/10 p-4 text-sm font-semibold text-red-400">
            <span class="material-symbols-outlined">error</span>@TempData["Error"]
        </div>
    }

    <!-- Header -->
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">swap_vert</span>
                Movimientos de stock
            </h1>
            <p class="text-slate-400 text-sm mt-0.5">Historial general de entradas, salidas y ajustes por SKU</p>
        </div>
        <a asp-controller="MovimientoStock" asp-action="Create"
           class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-bold text-white hover:bg-primary/90 transition-colors">
            <span class="material-symbols-outlined text-base">add</span>
            Registrar ajuste
        </a>
    </div>

    <!-- Banner SKU -->
    <div class="flex items-start gap-3 rounded-xl border border-amber-500/20 bg-amber-500/5 px-5 py-3">
        <span class="material-symbols-outlined text-amber-400 mt-0.5 shrink-0">info</span>
        <p class="text-sm text-amber-300/80">
            Este listado muestra movimientos por SKU/producto. No identifica unidades físicas individuales ni trazabilidad serial.
        </p>
    </div>

    @await Html.PartialAsync("_MovimientoStockListadoPartial", new TheBuryProject.ViewModels.MovimientoStockListadoPartialViewModel
    {
        Filtro = Model ?? new TheBuryProject.ViewModels.MovimientoStockFilterViewModel(),
        Productos = ViewBag.Productos,
        Tipos = ViewBag.Tipos,
        Embed = false
    })

</div>

@section Scripts {
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-oc-scroll]').forEach(function (root) {
            window.TheBury?.initHorizontalScrollAffordance?.(root);
        });
    </script>
}
