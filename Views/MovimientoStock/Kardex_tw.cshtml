@model IEnumerable<TheBuryProject.ViewModels.MovimientoStockViewModel>
@using TheBuryProject.Models.Enums

@{
    var producto = ViewBag.Producto as TheBuryProject.Models.Entities.Producto;
    ViewData["Title"] = producto != null ? $"Kardex — {producto.Nombre}" : "Kardex de Movimientos";
    var movs = Model?.ToList() ?? new List<TheBuryProject.ViewModels.MovimientoStockViewModel>();
    var movsDesc = movs.OrderByDescending(x => x.Fecha).ToList();
    // Registrar un ajuste escribe stock: exige movimientos.create (el servidor lo vuelve a validar).
    var puedeRegistrarMovimientos = User.TienePermiso("movimientos", "create");

    // KPIs
    var totalEntradas = movs.Where(m => m.Tipo == TipoMovimiento.Entrada).Sum(m => m.Cantidad);
    var totalSalidas  = movs.Where(m => m.Tipo == TipoMovimiento.Salida).Sum(m => Math.Abs(m.Cantidad));
    var ultimoMov     = movsDesc.FirstOrDefault();
    var ultimoCostoU  = ultimoMov?.CostoUnitarioAlMomento ?? 0m;
    var stockActual   = producto?.StockActual ?? 0m;
    var valorizSaldo  = stockActual * ultimoCostoU;

    string TipoTexto(TipoMovimiento t) => t switch {
        TipoMovimiento.Entrada => "Entrada",
        TipoMovimiento.Salida  => "Salida",
        TipoMovimiento.Ajuste  => "Ajuste",
        _                      => t.ToString()
    };
    string FuenteLbl(string? f) => f switch {
        "VentaDetalleSnapshot" => "Venta",
        "OrdenCompraDetalle"   => "OC",
        "ProductoActual"       => "Costo actual",
        "AjusteManual"         => "Ajuste manual",
        "Legacy"               => "Histórico",
        _                      => ""
    };

    bool EsEntrada(TipoMovimiento t, decimal ant, decimal nvo) =>
        t == TipoMovimiento.Entrada || (t == TipoMovimiento.Ajuste && nvo > ant);
    bool EsSalida(TipoMovimiento t, decimal ant, decimal nvo) =>
        t == TipoMovimiento.Salida || (t == TipoMovimiento.Ajuste && nvo < ant);

    // Totales footer
    decimal footEnt = 0, footSal = 0;
    foreach (var m in movsDesc) {
        if (EsEntrada(m.Tipo, m.StockAnterior, m.StockNuevo)) footEnt += Math.Abs(m.Cantidad);
        else if (EsSalida(m.Tipo, m.StockAnterior, m.StockNuevo)) footSal += Math.Abs(m.Cantidad);
    }
    var ultimoStock = movsDesc.FirstOrDefault()?.StockNuevo ?? 0m;
    var ultimoValor = ultimoStock * ultimoCostoU;

    // SVG chart — evolución del saldo
    var movsAsc = movs.OrderBy(m => m.Fecha).ToList();
    var chartPts = new List<(double x, double y, decimal stock)>();
    if (movsAsc.Any())
    {
        double maxS = (double)movsAsc.Max(m => m.StockNuevo);
        double minS = (double)movsAsc.Min(m => m.StockNuevo);
        double rng = maxS - minS;
        if (rng < 1) { rng = Math.Max(maxS * 0.2, 2); minS = Math.Max(0, maxS - rng); }
        double lo = Math.Max(0, minS - rng * 0.15);
        double hi = maxS + rng * 0.15;
        double span = hi - lo < 0.001 ? 1 : hi - lo;
        for (int i = 0; i < movsAsc.Count; i++)
        {
            double x = movsAsc.Count == 1 ? 160.0 : i / (double)(movsAsc.Count - 1) * 320.0;
            double norm = ((double)movsAsc[i].StockNuevo - lo) / span;
            double y = 10 + (1 - norm) * 120;
            chartPts.Add((x, y, movsAsc[i].StockNuevo));
        }
    }
    var polyStr  = string.Join(" ", chartPts.Select(p => $"{p.x:F0},{p.y:F0}"));
    var areaSb   = new System.Text.StringBuilder();
    if (chartPts.Any()) {
        areaSb.Append($"M{chartPts[0].x:F0},{chartPts[0].y:F0}");
        for (int i = 1; i < chartPts.Count; i++) areaSb.Append($" L{chartPts[i].x:F0},{chartPts[i].y:F0}");
        areaSb.Append($" L{chartPts[^1].x:F0},140 L{chartPts[0].x:F0},140 Z");
    }
    var chartMinStk = chartPts.Any() ? chartPts.Min(p => p.stock) : 0;
    var chartMaxStk = chartPts.Any() ? chartPts.Max(p => p.stock) : 0;
    var chartLastX  = chartPts.Any() ? chartPts[^1].x.ToString("F0") : "320";
    var chartLastY  = chartPts.Any() ? chartPts[^1].y.ToString("F0") : "70";

    string FormatMoney(decimal v) =>
        v.ToString("C", new System.Globalization.CultureInfo("es-AR"));
}

<div class="inv-screen inv-page inv-imprimible">
    <header class="inv-head">
        <div class="inv-head__titulo">
            @* Sin productos.view el catálogo responde «Acceso denegado»: la miga vuelve al listado propio. *@
            @if (User.TienePermiso("productos", "view"))
            {
                <a asp-controller="Catalogo" asp-action="Index" class="inv-crumb inv-no-print"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Inventario</a>
            }
            else
            {
                <a asp-controller="MovimientoStock" asp-action="Index" class="inv-crumb inv-no-print"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Movimientos</a>
            }
            <h1>Kardex de inventario</h1>
            @if (producto != null)
            {
                <p>@producto.Nombre · @producto.Codigo · movimientos por producto, sin identificar unidades</p>
            }
        </div>
        <div class="inv-head__acciones inv-no-print">
            @if (producto != null && User.TienePermiso("productos", "view"))
            {
                <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@producto.Id" class="inv-btn inv-btn--ghost">Unidades físicas</a>
            }
            <button type="button" class="inv-btn inv-btn--ghost" data-action="print">
                <span class="material-symbols-outlined" aria-hidden="true">print</span>
                Imprimir / PDF
            </button>
            @if (producto != null && puedeRegistrarMovimientos)
            {
                <button type="button" data-ajuste-stock-open class="inv-btn inv-btn--primary">Registrar ajuste</button>
            }
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    @if (ViewBag.ProductoEliminado == true)
    {
        <p class="inv-aviso inv-aviso--info">Producto eliminado: el historial queda en modo solo lectura.</p>
    }
    else if (producto != null && !producto.Activo)
    {
        <p class="inv-aviso inv-aviso--info">Producto inactivo: el historial queda disponible en modo solo lectura.</p>
    }

    <dl class="inv-panel inv-resumen" aria-label="Resumen de stock">
        <div><dt>Stock del producto</dt><dd>@stockActual.ToString("G29")</dd></div>
        <div><dt>Entradas históricas</dt><dd class="inv-text-ok">+@totalEntradas.ToString("G29")</dd></div>
        <div><dt>Salidas históricas</dt><dd class="inv-text-danger">@(totalSalidas > 0 ? "−" : "")@totalSalidas.ToString("G29")</dd></div>
        <div><dt>Último costo unitario</dt><dd>@FormatMoney(ultimoCostoU)</dd></div>
        <div><dt title="Stock del producto × último costo unitario">Valorización del saldo</dt><dd>@FormatMoney(valorizSaldo)</dd></div>
    </dl>

    @if (chartPts.Any())
    {
        <details class="inv-panel inv-no-print">
            <summary class="inv-panel__titulo">Evolución del saldo <span class="inv-campo__requerido">(mínimo @chartMinStk.ToString("G29") · máximo @chartMaxStk.ToString("G29"))</span></summary>
            <svg viewBox="0 0 320 140" class="inv-grafico" preserveAspectRatio="none" role="img"
                 aria-label="Saldo a lo largo de @movs.Count movimientos: mínimo @chartMinStk.ToString("G29"), máximo @chartMaxStk.ToString("G29"), actual @stockActual.ToString("G29")">
                <line x1="0" y1="20" x2="320" y2="20" />
                <line x1="0" y1="60" x2="320" y2="60" />
                <line x1="0" y1="100" x2="320" y2="100" />
                <path d="@areaSb.ToString()" />
                <polyline points="@polyStr" />
            </svg>
        </details>
    }

    <section class="inv-panel inv-panel--tabla" aria-labelledby="kdx-titulo">
        <div class="inv-panel__cabecera">
            <h2 id="kdx-titulo" class="inv-panel__titulo">Movimientos</h2>
            <p class="inv-ayuda-texto">
                <span id="kdx-vis-count">@movsDesc.Count</span> @(movsDesc.Count == 1 ? "movimiento" : "movimientos")
                @if (movsDesc.Any())
                {
                    <text> · saldo final @ultimoStock.ToString("G29")</text>
                }
            </p>
        </div>

        @if (!movsDesc.Any())
        {
            <div class="inv-empty">
                <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span>
                <p class="inv-empty__title">Sin movimientos registrados</p>
                @if (producto != null && puedeRegistrarMovimientos)
                {
                    <button type="button" data-ajuste-stock-open class="inv-btn inv-btn--primary">Registrar el primer ajuste</button>
                }
            </div>
        }
        else
        {
            <form id="kdx-filtros" class="inv-filters inv-no-print" aria-label="Filtrar movimientos">
                <div class="inv-filtros-linea">
                    <label class="inv-fecha"><span>Desde</span><input id="kdx-f-desde" type="date" class="inv-control" /></label>
                    <label class="inv-fecha"><span>Hasta</span><input id="kdx-f-hasta" type="date" class="inv-control" /></label>
                    <label class="sr-only" for="kdx-f-tipo">Tipo</label>
                    <select id="kdx-f-tipo" class="inv-control">
                        <option value="">Todos los tipos</option>
                        <option value="Entrada">Entradas</option>
                        <option value="Salida">Salidas</option>
                        <option value="Ajuste">Ajustes</option>
                    </select>
                    <label class="sr-only" for="kdx-f-busca">Referencia o motivo</label>
                    <input id="kdx-f-busca" type="search" class="inv-control" placeholder="Referencia o motivo" />
                    <button type="reset" class="inv-btn inv-btn--ghost">Limpiar</button>
                </div>
                <p id="kdx-filter-info" class="inv-ayuda-texto" role="status"></p>
            </form>

            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Historial de movimientos del producto">
                <table class="inv-table inv-table--apilable" id="kdx-table">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col">Movimiento</th>
                            <th scope="col" class="inv-col-num">Entrada</th>
                            <th scope="col" class="inv-col-num">Salida</th>
                            <th scope="col" class="inv-col-num">Saldo</th>
                            <th scope="col" class="inv-col-num" title="Saldo × costo unitario de cada movimiento">Saldo valorizado</th>
                            <th scope="col">Usuario</th>
                        </tr>
                    </thead>
                    <tbody id="kdx-tbody">
                        @foreach (var m in movsDesc)
                        {
                            bool esEnt = EsEntrada(m.Tipo, m.StockAnterior, m.StockNuevo);
                            bool esSal = EsSalida(m.Tipo, m.StockAnterior, m.StockNuevo);
                            var fuente = FuenteLbl(m.FuenteCosto);
                            var referencia = ReferenciaStockUi.Legible(m.Referencia);

                            <tr data-fecha="@m.Fecha.AHoraComercial().ToString("yyyy-MM-dd")"
                                data-tipo="@m.Tipo.ToString()"
                                data-ref="@($"{m.Referencia} {referencia}".ToLowerInvariant())"
                                data-motivo="@((m.Motivo ?? "").ToLowerInvariant())"
                                data-ent="@(esEnt ? Math.Abs(m.Cantidad).ToString("G29", System.Globalization.CultureInfo.InvariantCulture) : "0")"
                                data-sal="@(esSal ? Math.Abs(m.Cantidad).ToString("G29", System.Globalization.CultureInfo.InvariantCulture) : "0")">
                                <th scope="row">
                                    @m.Fecha.AHoraComercial().ToString("dd/MM/yyyy")
                                    <p class="inv-ayuda-texto">@m.Fecha.AHoraComercial().ToString("HH:mm")</p>
                                </th>
                                <td data-label="Movimiento" class="inv-celda-detalle">
                                    <strong>@TipoTexto(m.Tipo)</strong>@(referencia is null ? "" : " · " + referencia)
                                    <p class="inv-ayuda-texto">@(string.IsNullOrWhiteSpace(m.Motivo) ? "Sin motivo" : m.Motivo)</p>
                                </td>
                                <td data-label="Entrada" class="inv-col-num"><span class="@(esEnt ? "inv-text-ok" : null)">@(esEnt ? $"+{Math.Abs(m.Cantidad):G29}" : "—")</span></td>
                                <td data-label="Salida" class="inv-col-num"><span class="@(esSal ? "inv-text-danger" : null)">@(esSal ? $"−{Math.Abs(m.Cantidad):G29}" : "—")</span></td>
                                <td data-label="Saldo" class="inv-col-num"><span class="inv-importe">@m.StockNuevo.ToString("G29")</span></td>
                                <td data-label="Saldo valorizado" class="inv-col-num">
                                    @FormatMoney(m.StockNuevo * m.CostoUnitarioAlMomento)
                                    <p class="inv-sub">a @FormatMoney(m.CostoUnitarioAlMomento)@(string.IsNullOrEmpty(fuente) ? "" : " · " + fuente)</p>
                                </td>
                                <td data-label="Usuario">@(m.CreatedBy ?? "—")</td>
                            </tr>
                        }
                        <tr id="kdx-empty-row" hidden>
                            <td colspan="7" class="inv-empty">
                                Ningún movimiento coincide con los filtros.
                                <button type="button" class="inv-link" data-kdx-limpiar>Limpiar filtros</button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="2" id="kdx-foot-label">Totales del historial</th>
                            <td data-label="Entradas" class="inv-col-num inv-text-ok" id="kdx-foot-ent">+@footEnt.ToString("G29")</td>
                            <td data-label="Salidas" class="inv-col-num inv-text-danger" id="kdx-foot-sal">−@footSal.ToString("G29")</td>
                            <td data-label="Saldo" class="inv-col-num">@ultimoStock.ToString("G29")</td>
                            <td data-label="Saldo valorizado" class="inv-col-num">@FormatMoney(ultimoValor)</td>
                            <td class="inv-celda-vacia"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    @if (User.TienePermiso("movimientos", "view"))
    {
        <p class="inv-no-print"><a asp-controller="MovimientoStock" asp-action="Index" class="inv-link">Ver los movimientos de todos los productos</a></p>
    }
</div>

@if (producto != null && puedeRegistrarMovimientos)
{
    @await Html.PartialAsync("_AjusteStockModal", new TheBuryProject.ViewModels.AjusteStockModalViewModel
    {
        Ajuste = new TheBuryProject.ViewModels.AjusteStockViewModel
        {
            ProductoId = producto.Id,
            ProductoNombre = producto.Nombre,
            ProductoCodigo = producto.Codigo,
            StockActual = producto.StockActual,
            ReturnUrl = Url.Action("Kardex", "MovimientoStock", new { id = producto.Id })
        },
        ProductoBloqueado = true,
        Tipos = ViewBag.Tipos
    })
}

@section Scripts {
    <script src="~/js/ajuste-stock-modal.js" asp-append-version="true"></script>
    <script src="~/js/kardex.js" asp-append-version="true"></script>
}
