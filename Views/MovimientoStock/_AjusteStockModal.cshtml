@model TheBuryProject.ViewModels.AjusteStockModalViewModel
@using System.Globalization
@{
    var a = Model.Ajuste;
}
@* Diálogo «Registrar ajuste de stock» (Movimientos, Kardex y ficha de inventario). POST real a MovimientoStock/Create
   con ReturnUrl: el servidor valida y responde con TempData. Antes de enviar se confirma qué cambia; si el servidor
   rechaza, ajuste-stock-modal.js reabre el diálogo con lo escrito y el motivo del rechazo. *@
<dialog id="modal-ajuste-stock" class="inv-dialog" aria-labelledby="modal-ajuste-stock-title"
        data-error="@(TempData.Peek("Error") as string)">
    <form id="form-ajuste-stock" method="post" asp-controller="MovimientoStock" asp-action="Create" class="inv-dialog__panel" data-prevent-double-submit
          data-stock-actual="@(Model.ProductoBloqueado ? a.StockActual.ToString(CultureInfo.InvariantCulture) : "")">
        <input type="hidden" name="ReturnUrl" value="@a.ReturnUrl" />
        <input type="hidden" name="RequestId" value="@(TheBuryProject.Controllers.MovimientoStockController.RequestIdParaFormulario(TempData))" />

        <header class="inv-dialog__header">
            <h2 id="modal-ajuste-stock-title" class="inv-dialog__title">Registrar ajuste de stock</h2>
        </header>

        <div class="inv-dialog__body">
            <p class="inv-aviso inv-aviso--error" data-ajuste-error role="alert" hidden></p>

            @if (Model.ProductoBloqueado)
            {
                <input type="hidden" name="ProductoId" value="@a.ProductoId" />
                <dl class="inv-datos">
                    <div class="inv-datos__fila">
                        <dt>Producto</dt>
                        <dd data-ajuste-producto-nombre>@a.ProductoCodigo · @a.ProductoNombre</dd>
                    </div>
                    <div class="inv-datos__fila">
                        <dt>Stock actual</dt>
                        <dd>@a.StockActual.ToString("G29")</dd>
                    </div>
                </dl>
            }
            else
            {
                <div class="inv-campo">
                    <label class="inv-campo__etiqueta" for="ajuste-stock-producto">Producto</label>
                    <select name="ProductoId" id="ajuste-stock-producto" asp-items="Model.Productos" required class="inv-control">
                        <option value="">Seleccioná un producto</option>
                    </select>
                    <p id="ajuste-stock-actual" class="inv-campo__ayuda" aria-live="polite"></p>
                </div>
            }

            <div class="inv-campo">
                <label class="inv-campo__etiqueta" for="ajuste-stock-tipo">Tipo de movimiento</label>
                <select name="Tipo" id="ajuste-stock-tipo" asp-items="Model.Tipos" class="inv-control" aria-describedby="ajuste-stock-hint"></select>
                <p id="ajuste-stock-hint" class="inv-campo__ayuda"></p>
            </div>

            <div class="inv-campo">
                <label class="inv-campo__etiqueta" for="ajuste-stock-cantidad">Cantidad</label>
                <input name="Cantidad" id="ajuste-stock-cantidad" type="number" min="0" step="0.01" required inputmode="decimal" class="inv-control" />
            </div>

            <div class="inv-campo">
                <label class="inv-campo__etiqueta" for="ajuste-stock-motivo">Motivo</label>
                <input name="Motivo" id="ajuste-stock-motivo" type="text" maxlength="500" required class="inv-control"
                       placeholder="Ej.: inventario físico, devolución a proveedor" />
            </div>

            <div class="inv-campo">
                <label class="inv-campo__etiqueta" for="ajuste-stock-referencia">Referencia <span class="inv-campo__requerido">(opcional)</span></label>
                <input name="Referencia" id="ajuste-stock-referencia" type="text" maxlength="200" class="inv-control" placeholder="Ej.: remito 456" />
            </div>
        </div>

        <footer class="inv-dialog__footer">
            <button type="button" data-ajuste-stock-close class="inv-btn inv-btn--ghost">Cancelar</button>
            <button type="submit" class="inv-btn inv-btn--primary">Registrar ajuste</button>
        </footer>
    </form>
</dialog>
