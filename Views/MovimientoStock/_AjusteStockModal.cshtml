@model TheBuryProject.ViewModels.AjusteStockModalViewModel
@using TheBuryProject.Models.Enums
@{
    var a = Model.Ajuste;
}
@* Modal "Registrar ajuste de stock" — reemplaza la navegación de página completa a
   MovimientoStock/Create_tw. Reusa el mismo endpoint POST MovimientoStock/Create con
   ReturnUrl (el mismo mecanismo que ya usa el form inline de Producto/FichaInventario):
   sigue siendo un POST real de formulario, no AJAX — al guardar, el navegador recarga la
   página de origen con el banner de éxito/error vía TempData. Cero cambios de contrato en
   el controller. *@
<div id="modal-ajuste-stock" role="dialog" aria-modal="true" aria-labelledby="modal-ajuste-stock-title"
     class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6">
    <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm" data-ajuste-stock-close></div>

    <div class="relative w-full max-w-lg max-h-[90vh] overflow-hidden bg-[#111827] rounded-xl shadow-2xl border border-slate-800 flex flex-col">
        <header class="flex items-center justify-between border-b border-slate-800 px-6 py-4">
            <div class="flex flex-col">
                <h2 id="modal-ajuste-stock-title" class="text-xl font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit_note</span>
                    Registrar ajuste de stock
                </h2>
                <p class="text-sm text-slate-400">El stock se gestiona por SKU/producto, sin número de serie.</p>
            </div>
            <button type="button" data-ajuste-stock-close class="p-2 hover:bg-slate-800 rounded-full transition-colors text-slate-400">
                <span class="material-symbols-outlined">close</span>
            </button>
        </header>

        <form method="post" asp-controller="MovimientoStock" asp-action="Create" class="flex-1 overflow-y-auto flex flex-col min-h-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@a.ReturnUrl" />

            <div class="flex-1 overflow-y-auto p-6 space-y-5">
                @if (Model.ProductoBloqueado)
                {
                    <input type="hidden" name="ProductoId" value="@a.ProductoId" />
                    <div class="rounded-lg border border-slate-800 bg-slate-900/50 px-4 py-3 flex items-center gap-3">
                        <span class="material-symbols-outlined text-slate-400">inventory_2</span>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-white truncate">@a.ProductoNombre</p>
                            <p class="text-xs text-slate-400">
                                @a.ProductoCodigo · Stock actual: <strong class="text-slate-300">@a.StockActual.ToString("N0")</strong> unidades
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        <label for="ajuste-stock-producto" class="block text-sm font-semibold text-slate-300 mb-1.5">
                            Producto <span class="text-red-400">*</span>
                        </label>
                        <select name="ProductoId" id="ajuste-stock-producto" asp-items="Model.Productos" required
                                class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                            <option value="">— Seleccioná un producto —</option>
                        </select>
                    </div>
                }

                <div>
                    <label for="ajuste-stock-tipo" class="block text-sm font-semibold text-slate-300 mb-1.5">
                        Tipo de movimiento <span class="text-red-400">*</span>
                    </label>
                    <select name="Tipo" id="ajuste-stock-tipo" asp-items="Model.Tipos"
                            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                    </select>
                    <p id="ajuste-stock-hint-entrada" class="hidden text-xs text-emerald-400/80 mt-1">
                        <span class="material-symbols-outlined text-sm align-middle">arrow_upward</span>
                        Entrada: suma unidades al stock actual del producto.
                    </p>
                    <p id="ajuste-stock-hint-salida" class="hidden text-xs text-rose-400/80 mt-1">
                        <span class="material-symbols-outlined text-sm align-middle">arrow_downward</span>
                        Salida: resta unidades del stock actual del producto.
                    </p>
                    <p id="ajuste-stock-hint-ajuste" class="hidden text-xs text-amber-400/80 mt-1">
                        <span class="material-symbols-outlined text-sm align-middle">tune</span>
                        Ajuste: fija el stock al valor exacto indicado (inventario físico).
                    </p>
                </div>

                <div>
                    <label for="ajuste-stock-cantidad" class="block text-sm font-semibold text-slate-300 mb-1.5">
                        Cantidad <span class="text-red-400">*</span>
                    </label>
                    <input name="Cantidad" id="ajuste-stock-cantidad" type="number" min="0" step="0.01" required
                           class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                           placeholder="0" />
                </div>

                <div>
                    <label for="ajuste-stock-motivo" class="block text-sm font-semibold text-slate-300 mb-1.5">
                        Motivo <span class="text-red-400">*</span>
                    </label>
                    <input name="Motivo" id="ajuste-stock-motivo" type="text" maxlength="500" required
                           class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                           placeholder="Ej: Inventario físico, devolución de proveedor..." />
                </div>

                <div>
                    <label for="ajuste-stock-referencia" class="block text-sm font-semibold text-slate-300 mb-1.5">
                        Referencia <span class="text-slate-500 font-normal text-xs">(opcional)</span>
                    </label>
                    <input name="Referencia" id="ajuste-stock-referencia" type="text" maxlength="200"
                           class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                           placeholder="Ej: OC-2024-001, Remito 456..." />
                </div>
            </div>

            <footer class="flex items-center justify-end gap-3 px-6 py-4 border-t border-slate-800 bg-slate-900/50">
                <button type="button" data-ajuste-stock-close
                        class="px-6 py-2.5 rounded-lg border border-slate-800 text-slate-300 font-bold text-sm hover:bg-slate-800 transition-colors">
                    Cancelar
                </button>
                <button type="submit"
                        class="px-6 py-2.5 rounded-lg bg-primary text-white font-bold text-sm hover:bg-primary/90 shadow-lg shadow-primary/20 transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Registrar ajuste
                </button>
            </footer>
        </form>
    </div>
</div>
