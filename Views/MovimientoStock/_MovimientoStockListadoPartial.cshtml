@model TheBuryProject.ViewModels.MovimientoStockListadoPartialViewModel
@using TheBuryProject.Models.Enums
@{
    var filtro = Model.Filtro;
    var movimientos = filtro.Movimientos?.OrderByDescending(x => x.Fecha).ToList() ?? new List<TheBuryProject.ViewModels.MovimientoStockViewModel>();
    var dinero = new System.Globalization.CultureInfo("es-AR");

    // Embebido en la pestaña Movimientos de Inventario: filtros y paginado apuntan al catálogo y conservan la pestaña.
    var ctrl = Model.Embed ? "Catalogo" : "MovimientoStock";
    string Nombre(string campo) => Model.Embed ? $"mov.{campo}" : campo;

    var rutaBase = new Dictionary<string, string>();
    if (Model.Embed) { rutaBase["tab"] = "movimientos"; }
    if (filtro.ProductoId.HasValue) { rutaBase[Nombre("ProductoId")] = filtro.ProductoId.Value.ToString(); }
    if (filtro.Tipo.HasValue) { rutaBase[Nombre("Tipo")] = filtro.Tipo.Value.ToString(); }
    if (filtro.FechaDesde.HasValue) { rutaBase[Nombre("FechaDesde")] = filtro.FechaDesde.Value.ToString("yyyy-MM-dd"); }
    if (filtro.FechaHasta.HasValue) { rutaBase[Nombre("FechaHasta")] = filtro.FechaHasta.Value.ToString("yyyy-MM-dd"); }
    Dictionary<string, string> RutaPagina(int pagina) => new(rutaBase) { [Nombre("PageNumber")] = pagina.ToString() };
    var hayFiltros = rutaBase.Count > (Model.Embed ? 1 : 0);

    string FuenteCosto(string? fuente) => fuente switch
    {
        "VentaDetalleSnapshot" => "Venta",
        "OrdenCompraDetalle" => "Orden de compra",
        "ProductoActual" => "Costo actual",
        "AjusteManual" => "Ajuste manual",
        "Legacy" => "Histórico migrado",
        _ => "Sin informar"
    };
}

<section class="inv-panel inv-panel--tabla" aria-label="Movimientos de stock">
    <form method="get" asp-controller="@ctrl" asp-action="Index" class="inv-filters" role="search" aria-label="Filtrar movimientos">
        @if (Model.Embed)
        {
            <input type="hidden" name="tab" value="movimientos" />
        }
        <div class="inv-filtros-linea">
            <label class="sr-only" for="filtro-producto-id">Producto</label>
            <select id="filtro-producto-id" name="@Nombre("ProductoId")" asp-items="Model.Productos" class="inv-control inv-control--ancho">
                <option value="">Todos los productos</option>
            </select>
            <label class="sr-only" for="filtro-tipo">Tipo</label>
            <select id="filtro-tipo" name="@Nombre("Tipo")" asp-items="Model.Tipos" class="inv-control">
                <option value="">Todos los tipos</option>
            </select>
            <label class="inv-fecha"><span>Desde</span>
                <input id="filtro-fecha-desde" type="date" name="@Nombre("FechaDesde")" value="@filtro.FechaDesde?.ToString("yyyy-MM-dd")" class="inv-control" />
            </label>
            <label class="inv-fecha"><span>Hasta</span>
                <input id="filtro-fecha-hasta" type="date" name="@Nombre("FechaHasta")" value="@filtro.FechaHasta?.ToString("yyyy-MM-dd")" class="inv-control" />
            </label>
            <button type="submit" class="inv-btn inv-btn--ghost">Filtrar</button>
        </div>
    </form>

    <div class="inv-results__bar">
        <p class="inv-results__count">
            <strong>@filtro.TotalResultados</strong> @(filtro.TotalResultados == 1 ? "movimiento" : "movimientos")
            @if (filtro.TotalResultados > 0)
            {
                <text> · entradas <strong>+@filtro.TotalEntradas.ToString("N0")</strong> · salidas <strong>−@Math.Abs(filtro.TotalSalidas).ToString("N0")</strong> · ajustes <strong>@filtro.TotalAjustes</strong></text>
            }
        </p>
        @if (hayFiltros)
        {
            <a class="inv-link" asp-controller="@ctrl" asp-action="Index" asp-all-route-data="@(Model.Embed ? new Dictionary<string, string> { ["tab"] = "movimientos" } : new Dictionary<string, string>())">Limpiar filtros</a>
        }
    </div>

    @if (!movimientos.Any())
    {
        <div class="inv-empty">
            <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span>
            <p class="inv-empty__title">No hay movimientos con esos filtros.</p>
        </div>
    }
    else
    {
        <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Historial de movimientos de stock">
            <table class="inv-table inv-table--apilable">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col">Fecha</th>
                        <th scope="col" class="inv-col-num">Cantidad</th>
                        <th scope="col" class="inv-col-num">Costo total</th>
                        <th scope="col">Referencia</th>
                        <th scope="col">Usuario</th>
                        <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in movimientos)
                    {
                        // El signo sale del cambio de saldo en los ajustes (fijan un valor) y del tipo en entradas y salidas.
                        var sube = m.Tipo == TipoMovimiento.Entrada || (m.Tipo == TipoMovimiento.Ajuste && m.StockNuevo > m.StockAnterior);
                        var baja = m.Tipo == TipoMovimiento.Salida || (m.Tipo == TipoMovimiento.Ajuste && m.StockNuevo < m.StockAnterior);
                        <tr>
                            <th scope="row">
                                @(m.ProductoNombre ?? "—")
                                <p class="inv-ayuda-texto">@m.ProductoCodigo</p>
                            </th>
                            <td data-label="Fecha">
                                @m.Fecha.AHoraComercial().ToString("dd/MM/yyyy")
                                <p class="inv-sub">@m.Fecha.AHoraComercial().ToString("HH:mm:ss")</p>
                            </td>
                            <td data-label="Cantidad" class="inv-col-num">
                                <span class="inv-importe @(baja ? "inv-text-danger" : sube ? "inv-text-ok" : null)">@(sube ? "+" : baja ? "−" : "")@Math.Abs(m.Cantidad).ToString("N0")</span>
                                <p class="inv-sub">@m.Tipo · saldo @m.StockNuevo.ToString("N0")</p>
                            </td>
                            <td data-label="Costo total" class="inv-col-num">
                                @m.CostoTotalAlMomento.ToString("C", dinero)
                                <p class="inv-sub" title="Costo unitario y origen usado para valuar el movimiento">@m.CostoUnitarioAlMomento.ToString("C", dinero) · @FuenteCosto(m.FuenteCosto)</p>
                            </td>
                            <td data-label="Referencia">
                                @if (m.ReferenciaTipo == "OrdenCompra" && m.OrdenCompraId.HasValue)
                                {
                                    <a class="inv-link" asp-controller="OrdenCompra" asp-action="Details" asp-route-id="@m.OrdenCompraId">Compra @(m.OrdenCompraNumero ?? $"#{m.OrdenCompraId}")</a>
                                    @if (!string.IsNullOrWhiteSpace(m.ProveedorNombre))
                                    {
                                        <p class="inv-sub">
                                            @if (m.ProveedorId.HasValue)
                                            {
                                                <a asp-controller="Proveedor" asp-action="Details" asp-route-id="@m.ProveedorId">Proveedor: @m.ProveedorNombre</a>
                                            }
                                            else
                                            {
                                                <text>Proveedor: @m.ProveedorNombre</text>
                                            }
                                        </p>
                                    }
                                }
                                else if (m.ReferenciaTipo == "Venta" && m.VentaId.HasValue)
                                {
                                    <a class="inv-link" asp-controller="Venta" asp-action="Details" asp-route-id="@m.VentaId">Venta @m.VentaNumero</a>
                                    <p class="inv-sub">
                                        @if (m.ClienteId.HasValue && !string.IsNullOrWhiteSpace(m.ClienteNombre))
                                        {
                                            <a asp-controller="Cliente" asp-action="Details" asp-route-id="@m.ClienteId">@m.ClienteNombre</a>
                                        }
                                        else
                                        {
                                            <text>Consumidor final</text>
                                        }
                                        @(string.IsNullOrWhiteSpace(m.MedioPagoTexto) ? "" : " · " + m.MedioPagoTexto)
                                    </p>
                                }
                                else
                                {
                                    @(m.ReferenciaTexto ?? ReferenciaStockUi.Legible(m.Referencia) ?? "—")
                                }
                            </td>
                            <td data-label="Usuario">@(m.CreatedBy ?? "—")</td>
                            <td class="inv-col-actions">
                                <div class="inv-row-actions">
                                    <a asp-controller="MovimientoStock" asp-action="Kardex" asp-route-id="@m.ProductoId" class="inv-icon-btn"
                                       aria-label="Kardex de @(m.ProductoNombre ?? "este producto")" title="Kardex">
                                        <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (filtro.TotalPages > 1)
        {
            <nav class="inv-pager" aria-label="Páginas de movimientos">
                @if (filtro.HasPreviousPage)
                {
                    <a asp-controller="@ctrl" asp-action="Index" asp-all-route-data="RutaPagina(filtro.PageNumber - 1)" class="inv-btn inv-btn--ghost" rel="prev">Anterior</a>
                }
                <span aria-current="page">Página @filtro.PageNumber de @filtro.TotalPages</span>
                @if (filtro.HasNextPage)
                {
                    <a asp-controller="@ctrl" asp-action="Index" asp-all-route-data="RutaPagina(filtro.PageNumber + 1)" class="inv-btn inv-btn--ghost" rel="next">Siguiente</a>
                }
            </nav>
        }
    }
</section>
