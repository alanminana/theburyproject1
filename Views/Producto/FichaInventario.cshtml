@model ProductoUnidadesViewModel
@using TheBuryProject.Models.Enums
@using TheBuryProject.ViewModels

@{
    var movs = (ViewBag.Movimientos as IEnumerable<MovimientoStockViewModel>)
                    ?.OrderByDescending(x => x.Fecha).ToList()
               ?? new List<MovimientoStockViewModel>();

    var conciliacion = Model.Conciliacion;
    // Registrar un ajuste escribe stock: exige movimientos.create (el servidor lo vuelve a validar).
    var puedeRegistrarMovimientos = User.TienePermiso("movimientos", "create");
    ViewData["Title"] = $"Inventario — {Model.Nombre}";

    var tabQs = Context.Request.Query["tab"].ToString();
    // "fisicas" (alta de unidades físicas inline) solo aplica a productos no serializados.
    var tabValido = tabQs == "unidades" || tabQs == "movimientos"
                    || (tabQs == "fisicas" && !Model.RequiereNumeroSerie);
    var tabInicial = tabValido
        ? tabQs
        : (Model.RequiereNumeroSerie ? "unidades" : "movimientos");

    var totalEntradas = movs.Where(m => m.Tipo == TipoMovimiento.Entrada).Sum(m => Math.Abs(m.Cantidad));
    var totalSalidas  = movs.Where(m => m.Tipo == TipoMovimiento.Salida).Sum(m => Math.Abs(m.Cantidad));

    string LblMov(TipoMovimiento t) => t switch {
        TipoMovimiento.Entrada => "Entrada",
        TipoMovimiento.Salida  => "Salida",
        TipoMovimiento.Ajuste  => "Ajuste",
        _                      => t.ToString()
    };
    // Positiva: el stock supera a las unidades identificadas. Negativa: hay más unidades que stock.
    var diferencia = conciliacion.DiferenciaStockVsUnidadesEnStock;
    var hayDiferencia = Model.RequiereNumeroSerie && conciliacion.HayDiferencia;
    var tabs = new List<(string Clave, string Texto, int Cantidad)>
    {
        ("unidades", Model.RequiereNumeroSerie ? "Unidades" : "Stock", Model.RequiereNumeroSerie ? conciliacion.TotalUnidadesRegistradas : -1)
    };
    if (!Model.RequiereNumeroSerie)
    {
        tabs.Add(("fisicas", "Unidades físicas", conciliacion.TotalUnidadesRegistradas));
    }
    tabs.Add(("movimientos", "Movimientos", movs.Count));
}

<div class="inv-screen inv-page" data-ficha-inventario>
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-controller="Catalogo" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Inventario</a>
            <h1>
                @Model.Nombre
                <span class="inv-pill">@(Model.RequiereNumeroSerie ? "Serializado" : "No serializado")</span>
                @if (hayDiferencia)
                {
                    <span class="inv-pill inv-pill--warning">Diferencia en stock</span>
                }
            </h1>
            <p>Ficha de inventario · código @Model.Codigo</p>
        </div>
        <div class="inv-head__acciones">
            @if (Model.RequiereNumeroSerie)
            {
                <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId" class="inv-btn inv-btn--ghost">Gestionar unidades</a>
            }
            @if (User.TienePermiso("movimientos", "view"))
            {
                <a asp-controller="MovimientoStock" asp-action="Kardex" asp-route-id="@Model.ProductoId" class="inv-btn inv-btn--ghost">Kardex completo</a>
            }
            @if (puedeRegistrarMovimientos)
            {
                <button type="button" data-ajuste-stock-open class="inv-btn inv-btn--primary">Registrar ajuste</button>
            }
        </div>
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <dl class="inv-panel inv-resumen" aria-label="Resumen de inventario">
        <div><dt>Stock del producto</dt><dd>@Model.StockActual.ToString("G29")</dd></div>
        @if (Model.RequiereNumeroSerie)
        {
            <div><dt>Unidades en stock</dt><dd>@conciliacion.UnidadesEnStock</dd></div>
            <div>
                <dt>Diferencia (stock − unidades)</dt>
                <dd>
                    @if (hayDiferencia)
                    {
                        <span class="inv-pill inv-pill--warning">@(diferencia > 0 ? "+" : "")@diferencia.ToString("G29")</span>
                    }
                    else
                    {
                        <span class="inv-text-ok">Sin diferencia</span>
                    }
                </dd>
            </div>
            <div><dt>Unidades registradas</dt><dd>@conciliacion.TotalUnidadesRegistradas</dd></div>
        }
        <div><dt>Entradas históricas</dt><dd class="inv-text-ok">+@totalEntradas.ToString("G29")</dd></div>
        <div><dt>Salidas históricas</dt><dd class="inv-text-danger">@(totalSalidas > 0 ? "−" : "")@totalSalidas.ToString("G29")</dd></div>
    </dl>

    @if (hayDiferencia)
    {
        <div class="inv-aviso inv-aviso--atencion">
            <p>
                @if (diferencia > 0)
                {
                    <text><strong>El stock supera en @diferencia.ToString("G29") a las unidades identificadas.</strong></text>
                }
                else
                {
                    <text><strong>Hay @Math.Abs(diferencia).ToString("G29") unidades en stock de más respecto del stock del producto.</strong> No cargues más unidades.</text>
                }
                Revisá los movimientos y los registros de las unidades antes de cambiar cantidades.
                <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId" asp-fragment="conciliar" class="inv-link">Revisar conciliación</a>
            </p>
        </div>
    }

    <div class="inv-tablist">
        <div class="inv-tablist__pista" role="tablist" aria-label="Ficha de inventario">
            @foreach (var tab in tabs)
            {
                var activa = tabInicial == tab.Clave;
                <button type="button" role="tab" class="inv-tab" id="fi-tab-@tab.Clave"
                        data-fi-tab="@tab.Clave" aria-controls="fi-panel-@tab.Clave"
                        aria-selected="@(activa ? "true" : "false")" tabindex="@(activa ? "0" : "-1")">
                    @tab.Texto
                    @if (tab.Cantidad >= 0)
                    {
                        <span class="inv-tab-count">@tab.Cantidad</span>
                    }
                </button>
            }
        </div>
    </div>

    <section id="fi-panel-unidades" data-fi-panel="unidades" role="tabpanel" aria-labelledby="fi-tab-unidades"
             class="inv-pila" hidden="@(tabInicial != "unidades")">
        @if (Model.RequiereNumeroSerie)
        {
            <div class="inv-panel inv-panel--tabla">
                @if (!Model.Unidades.Any())
                {
                    <div class="inv-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">inbox</span>
                        <p class="inv-empty__title">No hay unidades registradas para este producto</p>
                        <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId" class="inv-link">Abrir la gestión de unidades</a>
                    </div>
                }
                else
                {
                    <partial name="_FichaUnidadesTabla" model="Model" />
                }
            </div>
        }
        else if (puedeRegistrarMovimientos)
        {
            @* Stock por cantidad: se registra sin salir de la ficha, contra el mismo endpoint que Movimientos. *@
            <div class="inv-panel">
                <div>
                    <h2 class="inv-panel__titulo">Registrar un movimiento de stock</h2>
                    <p class="inv-ayuda-texto">Este producto no usa número de serie: el stock se gestiona por cantidad. El movimiento queda en el Kardex.</p>
                </div>
                <form method="post" asp-controller="MovimientoStock" asp-action="Create"
                      data-ajuste-inline data-prevent-double-submit
                      data-producto="@Model.Nombre" data-stock-actual="@Model.StockActual.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RequestId" value="@(TheBuryProject.Controllers.MovimientoStockController.RequestIdParaFormulario(TempData))" />
                    <input type="hidden" name="ProductoId" value="@Model.ProductoId" />
                    <input type="hidden" name="ReturnUrl"
                           value="@Url.Action("Inventario", "Producto", new { productoId = Model.ProductoId, tab = "movimientos" })" />

                    <div class="inv-campos">
                        <div class="inv-campo">
                            <label for="fi-stock-tipo" class="inv-campo__etiqueta">Tipo</label>
                            <select id="fi-stock-tipo" name="Tipo" class="inv-control">
                                <option value="@TipoMovimiento.Entrada" selected>Entrada (+ suma)</option>
                                <option value="@TipoMovimiento.Salida">Salida (− resta)</option>
                                <option value="@TipoMovimiento.Ajuste">Ajuste (stock exacto)</option>
                            </select>
                        </div>
                        <div class="inv-campo">
                            <label for="fi-stock-cantidad" class="inv-campo__etiqueta">Cantidad</label>
                            <input id="fi-stock-cantidad" name="Cantidad" type="number" min="0.01" step="0.01" inputmode="decimal" required class="inv-control" />
                        </div>
                        <div class="inv-campo inv-campo--doble">
                            <label for="fi-stock-motivo" class="inv-campo__etiqueta">Motivo</label>
                            <input id="fi-stock-motivo" name="Motivo" type="text" maxlength="500" required class="inv-control" placeholder="Ej.: compra a proveedor, inventario físico" />
                        </div>
                    </div>

                    <div class="inv-actions">
                        <button type="submit" class="inv-btn inv-btn--primary">Registrar movimiento</button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <p class="inv-aviso inv-aviso--info">El stock de este producto se gestiona por cantidad. Tu usuario puede consultarlo, pero no registrar movimientos.</p>
        }
    </section>

    @if (!Model.RequiereNumeroSerie)
    {
        <section id="fi-panel-fisicas" data-fi-panel="fisicas" role="tabpanel" aria-labelledby="fi-tab-fisicas"
                 class="inv-pila" hidden="@(tabInicial != "fisicas")">
            @if (User.TienePermiso("productos", "edit"))
            {
                <div class="inv-panel">
                    <div>
                        <h2 class="inv-panel__titulo">Agregar unidades físicas</h2>
                        <p class="inv-ayuda-texto">Crea unidades individuales sin número de serie, con código interno automático. <strong>No modifica el stock del producto.</strong></p>
                    </div>
                    <form method="post" asp-controller="Producto" asp-action="AgregarUnidadesFisicasInline"
                          data-uf-form data-producto="@Model.Nombre" data-prevent-double-submit>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductoId" value="@Model.ProductoId" />
                        <input type="hidden" name="ReturnUrl"
                               value="@Url.Action("Inventario", "Producto", new { productoId = Model.ProductoId, tab = "fisicas" })" />

                        <div class="inv-campos">
                            <div class="inv-campo">
                                <label for="fi-uf-cantidad" class="inv-campo__etiqueta">Cantidad</label>
                                <input id="fi-uf-cantidad" name="Cantidad" type="number" min="1" step="1" max="200" inputmode="numeric" required class="inv-control" />
                            </div>
                            <div class="inv-campo">
                                <label for="fi-uf-ubicacion" class="inv-campo__etiqueta">Ubicación <span class="inv-campo__requerido">(opcional)</span></label>
                                <input id="fi-uf-ubicacion" name="UbicacionActual" type="text" maxlength="200" class="inv-control" placeholder="Ej.: depósito, estante A" />
                            </div>
                            <div class="inv-campo inv-campo--doble">
                                <label for="fi-uf-obs" class="inv-campo__etiqueta">Observaciones <span class="inv-campo__requerido">(opcional)</span></label>
                                <input id="fi-uf-obs" name="Observaciones" type="text" maxlength="500" class="inv-control" />
                            </div>
                        </div>

                        <div class="inv-actions">
                            <button type="submit" class="inv-btn inv-btn--primary">Agregar unidades</button>
                        </div>
                    </form>
                </div>
            }

            <div class="inv-panel inv-panel--tabla">
                @if (!Model.Unidades.Any())
                {
                    <div class="inv-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">inbox</span>
                        <p class="inv-empty__title">Todavía no hay unidades físicas registradas</p>
                    </div>
                }
                else
                {
                    <partial name="_FichaUnidadesTabla" model="Model" />
                }
            </div>
        </section>
    }

    <section id="fi-panel-movimientos" data-fi-panel="movimientos" role="tabpanel" aria-labelledby="fi-tab-movimientos"
             class="inv-pila" hidden="@(tabInicial != "movimientos")">
        <div class="inv-panel inv-panel--tabla">
            @if (!movs.Any())
            {
                <div class="inv-empty">
                    <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span>
                    <p class="inv-empty__title">No hay movimientos registrados para este producto</p>
                    @if (puedeRegistrarMovimientos)
                    {
                        <button type="button" data-ajuste-stock-open class="inv-link">Registrar el primer ajuste de stock</button>
                    }
                </div>
            }
            else
            {
                <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Historial de movimientos">
                    <table class="inv-table inv-table--apilable">
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Movimiento</th>
                                <th scope="col" class="inv-col-num">Cantidad</th>
                                <th scope="col" class="inv-col-num">Saldo</th>
                                <th scope="col">Usuario</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in movs)
                            {
                                var esEntrada = m.Tipo == TipoMovimiento.Entrada
                                    || (m.Tipo == TipoMovimiento.Ajuste && m.StockNuevo > m.StockAnterior);
                                var esSalida = m.Tipo == TipoMovimiento.Salida
                                    || (m.Tipo == TipoMovimiento.Ajuste && m.StockNuevo < m.StockAnterior);
                                var signo = esEntrada ? "+" : esSalida ? "−" : "±";
                                var referencia = ReferenciaStockUi.Legible(m.Referencia);
                                <tr>
                                    <th scope="row">
                                        @m.Fecha.AHoraComercial().ToString("dd/MM/yyyy")
                                        <p class="inv-ayuda-texto">@m.Fecha.AHoraComercial().ToString("HH:mm")</p>
                                    </th>
                                    <td data-label="Movimiento" class="inv-celda-detalle">
                                        <strong>@LblMov(m.Tipo)</strong>@(referencia is null ? "" : " · " + referencia)
                                        @if (!string.IsNullOrWhiteSpace(m.Motivo))
                                        {
                                            <p class="inv-ayuda-texto">@m.Motivo</p>
                                        }
                                        @if (m.VentaCliente != null)
                                        {
                                            <p class="inv-ayuda-texto">@m.VentaCliente · @m.VentaMedioPago</p>
                                        }
                                    </td>
                                    <td data-label="Cantidad" class="inv-col-num"><span class="@(esEntrada ? "inv-text-ok" : esSalida ? "inv-text-danger" : null)">@signo@Math.Abs(m.Cantidad).ToString("G29")</span></td>
                                    <td data-label="Saldo" class="inv-col-num"><span class="inv-importe">@m.StockNuevo.ToString("G29")</span></td>
                                    <td data-label="Usuario">@(m.CreatedBy ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@* Ruta completa: desde Views/Producto/, un nombre corto solo buscaría en
   Views/Producto/ y Views/Shared/, no en Views/MovimientoStock/. *@
@if (puedeRegistrarMovimientos)
{
@await Html.PartialAsync("~/Views/MovimientoStock/_AjusteStockModal.cshtml", new TheBuryProject.ViewModels.AjusteStockModalViewModel
{
    Ajuste = new TheBuryProject.ViewModels.AjusteStockViewModel
    {
        ProductoId = Model.ProductoId,
        ProductoNombre = Model.Nombre,
        ProductoCodigo = Model.Codigo,
        StockActual = Model.StockActual,
        ReturnUrl = Url.Action("Inventario", "Producto", new { productoId = Model.ProductoId, tab = "movimientos" })
    },
    ProductoBloqueado = true,
    Tipos = ViewBag.Tipos
})
}

@section Scripts {
    <script src="~/js/ajuste-stock-modal.js" asp-append-version="true"></script>
    <script src="~/js/ficha-inventario.js" asp-append-version="true"></script>
}
