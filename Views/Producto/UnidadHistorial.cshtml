@model ProductoUnidadHistorialViewModel

@{
    ViewData["Title"] = $"Historial - {Model.CodigoInternoUnidad}";
}

<div class="inv-screen inv-page">
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId" class="inv-crumb">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Unidades
            </a>
            <h1>@Model.CodigoInternoUnidad <partial name="_EstadoUnidadBadge" model="Model.EstadoActual" /></h1>
            <p>@Model.ProductoCodigo · @Model.ProductoNombre@(string.IsNullOrWhiteSpace(Model.NumeroSerie) ? "" : " · serie " + Model.NumeroSerie)</p>
        </div>
    </header>

    <section class="inv-panel inv-panel--tabla" aria-label="Historial de la unidad">
        @if (Model.Movimientos.Any())
        {
            <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Tabla del historial de la unidad">
                <table class="inv-table inv-table--apilable">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col">Cambio de estado</th>
                            <th scope="col">Motivo</th>
                            <th scope="col">Origen</th>
                            <th scope="col">Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movimiento in Model.Movimientos)
                        {
                            <tr>
                                <th scope="row">@movimiento.FechaCambio.AHoraComercial().ToString("dd/MM/yyyy HH:mm")</th>
                                <td data-label="Cambio de estado">
                                    <partial name="_EstadoUnidadBadge" model="movimiento.EstadoAnterior" />
                                    <span aria-hidden="true">→</span><span class="sr-only">a</span>
                                    <partial name="_EstadoUnidadBadge" model="movimiento.EstadoNuevo" />
                                </td>
                                <td data-label="Motivo">@movimiento.Motivo</td>
                                <td data-label="Origen">@(ReferenciaStockUi.Legible(movimiento.OrigenReferencia) ?? "—")</td>
                                <td data-label="Usuario">@(movimiento.UsuarioResponsable ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="inv-empty"><p class="inv-empty__title">Esta unidad no tiene movimientos registrados.</p></div>
        }
    </section>
</div>
