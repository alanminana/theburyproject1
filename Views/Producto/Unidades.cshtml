@model ProductoUnidadesViewModel
@using TheBuryProject.Models.Enums

@{
    ViewData["Title"] = $"Unidades - {Model.Nombre}";
    var estados = Enum.GetValues<EstadoUnidad>();

    var conciliacion = Model.Conciliacion;
    var diferenciaTexto = conciliacion.DiferenciaStockVsUnidadesEnStock > 0
        ? $"+{conciliacion.DiferenciaStockVsUnidadesEnStock:G29}"
        : conciliacion.DiferenciaStockVsUnidadesEnStock.ToString("G29");
    var diferenciaPositiva = conciliacion.DiferenciaStockVsUnidadesEnStock > 0;
    var diferenciaNegativa = conciliacion.DiferenciaStockVsUnidadesEnStock < 0;
    var puedeAjustarStockAgregado = conciliacion.RequiereNumeroSerie && conciliacion.HayDiferencia;
    var stockNoTrazado = Model.StockActual - (decimal)conciliacion.UnidadesEnStock;
    var altaComunBloqueada = (decimal)conciliacion.UnidadesEnStock >= Model.StockActual;
    var ajusteAbsoluto = Math.Abs(conciliacion.DiferenciaStockVsUnidadesEnStock);
    var textoAjuste = diferenciaPositiva
        ? $"Reducir stock agregado en {ajusteAbsoluto:G29}"
        : $"Aumentar stock agregado en {ajusteAbsoluto:G29}";
    // La comparación stock ↔ unidades solo tiene sentido si el producto exige identificar cada unidad.
    var comparaUnidades = conciliacion.RequiereNumeroSerie;
    var hayDiferenciaRelevante = comparaUnidades && conciliacion.HayDiferencia;
    // Cada acción visible refleja el permiso que exige su POST (ProductoController); el servidor sigue siendo el control.
    var puedeGestionarUnidades = User.TienePermiso("productos", "edit");
    var puedeAjustarStock = puedeGestionarUnidades && User.TienePermiso("movimientos", "create");
    var puedeVerKardex = User.TienePermiso("movimientos", "view");
    var hayDesgloseVisible = conciliacion.UnidadesVendidas > 0
        || conciliacion.UnidadesFaltantes > 0
        || conciliacion.UnidadesBaja > 0
        || conciliacion.UnidadesDevueltas > 0
        || conciliacion.UnidadesReservadas > 0
        || conciliacion.UnidadesEnReparacion > 0;

    Func<EstadoUnidad, string> BChipClass = e => e switch {
        EstadoUnidad.EnStock      => "inv-pill inv-pill--ok",
        EstadoUnidad.Faltante     => "inv-pill inv-pill--danger",
        EstadoUnidad.Reservada    => "inv-pill inv-pill--accent",
        EstadoUnidad.EnReparacion => "inv-pill inv-pill--warning",
        EstadoUnidad.Devuelta     => "inv-pill inv-pill--warning",
        EstadoUnidad.Baja         => "inv-pill inv-pill--muted",
        EstadoUnidad.Anulada      => "inv-pill inv-pill--muted",
        _                         => "inv-pill"
    };
    Func<EstadoUnidad, string> BChipLabel = e => e switch {
        EstadoUnidad.EnStock      => "En stock",
        EstadoUnidad.Vendida      => "Vendida",
        EstadoUnidad.Entregada    => "Entregada",
        EstadoUnidad.Faltante     => "Faltante",
        EstadoUnidad.Baja         => "Baja",
        EstadoUnidad.Anulada      => "Anulada",
        EstadoUnidad.Reservada    => "Reservada",
        EstadoUnidad.EnReparacion => "En reparación",
        EstadoUnidad.Devuelta     => "Devuelta",
        _                         => e.ToString()
    };
    Func<EstadoUnidad, string> EstadoOpcionLabel = e => e switch {
        EstadoUnidad.EnStock      => "En stock",
        EstadoUnidad.Vendida      => "Vendida",
        EstadoUnidad.Entregada    => "Entregada",
        EstadoUnidad.Faltante     => "Faltante",
        EstadoUnidad.Baja         => "Baja",
        EstadoUnidad.Anulada      => "Anulada",
        EstadoUnidad.Reservada    => "Reservada",
        EstadoUnidad.EnReparacion => "En reparación",
        EstadoUnidad.Devuelta     => "Devuelta",
        _                         => e.ToString()
    };

    // Estado inicial del radio de disponibilidad
    var dispoFilter = Model.Filtros.SoloDisponibles ? "disponibles"
                    : Model.Filtros.SoloVendidas    ? "vendidas"
                    : "todas";
}

<div class="inv-screen inv-page pu-page">

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-controller="Catalogo" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Inventario</a>
            <h1>
                @Model.Nombre
                @if (hayDiferenciaRelevante)
                {
                    <span class="inv-pill inv-pill--warning">Con diferencia</span>
                }
            </h1>
            <p>@Model.Codigo · @(Model.RequiereNumeroSerie ? "La venta exige elegir una unidad" : "La venta no exige elegir una unidad")</p>
        </div>
        <div class="inv-head__acciones">
            @if (puedeVerKardex)
            {
                <a asp-controller="MovimientoStock" asp-action="Kardex" asp-route-id="@Model.ProductoId" class="inv-btn inv-btn--ghost">
                    <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
                    Kardex
                </a>
            }
            @if (puedeGestionarUnidades && !altaComunBloqueada)
            {
                <button type="button" data-action="call" data-fn="activateTab" data-args='["agregar"]' class="inv-btn inv-btn--primary">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                    Agregar unidades
                </button>
            }
        </div>
    </header>

    <dl class="inv-panel inv-resumen">
        <div><dt>Stock del producto</dt><dd>@Model.StockActual.ToString("G29")</dd></div>
        <div><dt>Unidades disponibles</dt><dd>@conciliacion.UnidadesEnStock</dd></div>
        @if (comparaUnidades)
        {
            <div><dt>Stock sin unidad identificada</dt><dd class="@(stockNoTrazado < 0 ? "inv-text-danger" : null)">@stockNoTrazado.ToString("G29")</dd></div>
        }
        <div><dt>Unidades registradas</dt><dd>@conciliacion.TotalUnidadesRegistradas</dd></div>
    </dl>

    @* TABS — z-30 igual que standalone *@
    <nav class="inv-tablist" role="tablist" aria-label="Modos de unidades">
        <div class="inv-tablist__pista">
            <button type="button" id="tab-ver" role="tab" data-tab-target="ver" aria-controls="ver" aria-selected="true" tabindex="0" class="inv-tab">
                Ver unidades
            </button>
            @if (puedeGestionarUnidades)
            {
            <button type="button" id="tab-agregar" role="tab" data-tab-target="agregar" aria-controls="agregar" aria-selected="false" tabindex="-1" class="inv-tab">
                Agregar unidades
            </button>
            }
            <button type="button" id="tab-conciliar" role="tab" data-tab-target="conciliar" aria-controls="conciliar" aria-selected="false" tabindex="-1" class="inv-tab">
                Conciliar stock
            </button>
            <button type="button" id="tab-trazabilidad" role="tab" data-tab-target="trazabilidad" aria-controls="trazabilidad" aria-selected="false" tabindex="-1" class="inv-tab">
                Trazabilidad
            </button>
        </div>
    </nav>

    @* ================================================================
       PANEL: VER UNIDADES
       ================================================================ *@
    <section id="ver" role="tabpanel" data-tab-panel="ver" aria-labelledby="tab-ver" class="space-y-5">
        <p class="inv-estados">
            <span>Mostrando <strong>@Model.Unidades.Count</strong></span>
            @foreach (var r in Model.ResumenEstados)
            {
                <span class="@BChipClass(r.Estado)">@BChipLabel(r.Estado) · @r.Cantidad</span>
            }
        </p>

        <form method="get" asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId"
              class="inv-panel inv-filtros-unidades" id="filter-form" role="search" aria-label="Filtrar unidades">
            <div class="inv-filtros-linea">
                <label class="sr-only" for="f-texto">Código de unidad o número de serie</label>
                <input id="f-texto" type="search" name="texto" value="@Model.Filtros.Texto" class="inv-control inv-control--ancho" placeholder="Código de unidad o serie" />
                <label class="sr-only" for="f-estado">Estado</label>
                <select id="f-estado" name="estado" class="inv-control">
                    <option value="">Todos los estados</option>
                    @foreach (var estado in estados)
                    {
                        <option value="@estado" selected="@(Model.Filtros.Estado == estado)">@EstadoOpcionLabel(estado)</option>
                    }
                </select>
                <div class="inv-opciones" role="group" aria-label="Disponibilidad">
                    @foreach (var (valor, texto) in new[] { ("todas", "Todas"), ("disponibles", "Disponibles"), ("vendidas", "Vendidas") })
                    {
                        <label><input type="radio" name="disponibilidadVista" class="inv-check" value="@valor" checked="@(dispoFilter == valor)" data-change-fn="puDispoChange" data-args='["@valor"]' /> @texto</label>
                    }
                </div>
                <label class="inv-opciones"><input type="checkbox" name="soloSinNumeroSerie" value="true" checked="@Model.Filtros.SoloSinNumeroSerie" class="inv-check" /> Sin número de serie</label>
                <button type="submit" class="inv-btn inv-btn--ghost">Filtrar</button>
                <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId" class="inv-link">Limpiar</a>
            </div>
            @* Los parámetros que lee el servidor; los opciones de arriba los activan. *@
            <input type="checkbox" id="filter-soloDisponibles" name="soloDisponibles" value="true" hidden
                   checked="@Model.Filtros.SoloDisponibles" disabled="@(!Model.Filtros.SoloDisponibles)" />
            <input type="checkbox" id="filter-soloVendidas" name="soloVendidas" value="true" hidden
                   checked="@Model.Filtros.SoloVendidas" disabled="@(!Model.Filtros.SoloVendidas)" />
        </form>

        <div id="listado-unidades" class="inv-panel inv-panel--tabla">
            @if (Model.Unidades.Any())
            {
                <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Unidades físicas del producto">
                    <table class="inv-table inv-table--apilable">
                        <thead>
                            <tr>
                                <th scope="col">Unidad</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Ubicación</th>
                                <th scope="col">Ingreso</th>
                                <th scope="col">Cliente / venta</th>
                                <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unidad in Model.Unidades)
                            {
                                var conAcciones = puedeGestionarUnidades && (unidad.PuedeMarcarFaltante || unidad.PuedeDarBaja || unidad.PuedeReintegrarAStock || unidad.PuedeFinalizarReparacion);
                                var acciones = new List<object>();
                                if (unidad.PuedeReintegrarAStock) acciones.Add(new { value = "reintegrar", label = "Reintegrar a stock" });
                                if (unidad.PuedeDarBaja) acciones.Add(new { value = "baja", label = "Dar de baja" });
                                if (unidad.PuedeMarcarFaltante) acciones.Add(new { value = "faltante", label = "Marcar faltante" });
                                if (unidad.PuedeFinalizarReparacion) acciones.Add(new { value = "reparacion", label = "Finalizar reparacion" });
                                var argumentos = System.Text.Json.JsonSerializer.Serialize(new object[] { unidad.Id.ToString(), unidad.CodigoInternoUnidad, unidad.NumeroSerie ?? "—", BChipLabel(unidad.Estado), BChipClass(unidad.Estado), acciones });
                                <tr>
                                    <th scope="row" class="inv-celda-principal">
                                        <strong>@unidad.CodigoInternoUnidad</strong>
                                        <p class="inv-ayuda-texto">@(unidad.NumeroSerie is null ? "Sin número de serie" : "Serie " + unidad.NumeroSerie)</p>
                                        @if (unidad.Observaciones != null)
                                        {
                                            <p class="inv-ayuda-texto" title="@unidad.Observaciones">@unidad.Observaciones</p>
                                        }
                                    </th>
                                    <td data-label="Estado"><span class="@BChipClass(unidad.Estado)">@BChipLabel(unidad.Estado)</span></td>
                                    <td data-label="Ubicación">@(unidad.UbicacionActual ?? "—")</td>
                                    <td data-label="Ingreso">@unidad.FechaIngreso.AHoraComercial().ToString("dd/MM/yyyy")</td>
                                    <td data-label="Cliente / venta">
                                        @if (unidad.ClienteAsociado != null || unidad.VentaDetalleId.HasValue)
                                        {
                                            @(unidad.ClienteAsociado ?? "")@(unidad.VentaDetalleId.HasValue ? $" · #{unidad.VentaDetalleId}" : "")
                                            @if (unidad.FechaVenta.HasValue)
                                            {
                                                <p class="inv-sub">@unidad.FechaVenta.Value.AHoraComercial().ToString("dd/MM/yyyy")</p>
                                            }
                                        }
                                        else
                                        {
                                            <text>—</text>
                                        }
                                    </td>
                                    <td class="inv-col-actions">
                                        <div class="inv-row-actions">
                                            @if (conAcciones)
                                            {
                                                <button type="button" data-action="call" data-fn="puOpenManage" data-args="@argumentos" class="inv-btn inv-btn--ghost inv-btn--sm"
                                                        aria-label="Gestionar la unidad @unidad.CodigoInternoUnidad">Gestionar</button>
                                            }
                                            <a asp-controller="Producto" asp-action="UnidadHistorial" asp-route-unidadId="@unidad.Id" class="inv-icon-btn"
                                               aria-label="Historial de la unidad @unidad.CodigoInternoUnidad" title="Historial">
                                                <span class="material-symbols-outlined" aria-hidden="true">history</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="inv-empty">
                    <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
                    <p class="inv-empty__title">No hay unidades con esos filtros.</p>
                    <p><a class="inv-link" asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId">Limpiar filtros</a></p>
                </div>
            }
        </div>
    </section>

    @if (puedeGestionarUnidades)
    {
    @* ================================================================
       PANEL: AGREGAR UNIDADES
       ================================================================ *@
    <section id="agregar" role="tabpanel" data-tab-panel="agregar" aria-labelledby="tab-agregar" class="space-y-5" hidden>
        <div>
            <h2 class="text-lg font-semibold text-white">Agregar unidades</h2>
            <p class="text-sm text-slate-400">Registrar identificadores físicos para unidades ya existentes en el inventario.</p>
        </div>

        @if (altaComunBloqueada)
        {
            <div class="rounded-lg border border-amber-500/40 bg-amber-500/5 px-4 py-4 flex gap-3">
                <span class="material-symbols-outlined text-amber-300 shrink-0">block</span>
                <div>
                    @if (Model.StockActual <= 0)
                    {
                        <p class="text-sm font-semibold text-amber-200">Alta bloqueada: stock lógico es 0</p>
                        <p class="mt-1 text-sm text-amber-100/80">El stock lógico es 0. No hay unidades para registrar. Registrá una entrada en Kardex primero o usá Conciliación.</p>
                    }
                    else
                    {
                        <p class="text-sm font-semibold text-amber-200">Alta bloqueada: todas las unidades ya fueron registradas</p>
                        <p class="mt-1 text-sm text-amber-100/80">No podés agregar más unidades físicas porque ya registraste todas las unidades disponibles según el stock lógico (@conciliacion.UnidadesEnStock de @Model.StockActual.ToString("G29")). Usá Conciliación si encontraste una unidad adicional.</p>
                    }
                    <div class="mt-3">
                        <button type="button" data-action="call" data-fn="activateTab" data-args='["conciliar"]'
                                class="inv-btn inv-btn--primary">
                            <span class="material-symbols-outlined" style="font-size:16px">balance</span>
                            Ir a Conciliación
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-lg border border-blue-500/30 bg-blue-500/5 px-4 py-3 flex gap-3">
                <span class="material-symbols-outlined text-blue-300 shrink-0">info</span>
                <p class="text-sm text-blue-100/90">
                    Crear unidades físicas no modifica el stock del producto ni genera movimientos de Kardex. Esta acción solo registra identificadores para el seguimiento de unidades ya existentes en el inventario.
                </p>
            </div>
        }

        @* Con el alta bloqueada no se muestran formularios inertes; si el servidor devolvió errores o una vista previa, siguen visibles. *@
        <div class="grid gap-4 lg:grid-cols-2" hidden="@(altaComunBloqueada && ViewData.ModelState.IsValid && !Model.CargaMasiva.PreviewListo)">
            @* Alta individual *@
            <div class="inv-panel">
                <div class="flex items-center gap-2 mb-1">
                    <span class="material-symbols-outlined text-slate-400">person_add</span>
                    <h3 class="font-semibold text-white">Alta individual</h3>
                </div>
                <p class="text-xs text-slate-400 mb-4">Cargar una unidad física a la vez. El código interno se genera automáticamente y la unidad queda En stock.</p>

                <form method="post" asp-controller="Producto" asp-action="CrearUnidad" asp-fragment="agregar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CrearUnidad.ProductoId" value="@Model.ProductoId" />
                    <div asp-validation-summary="ModelOnly" class="mb-3 text-sm font-semibold text-red-300"></div>
                    <div class="space-y-3">
                        <div>
                            <label class="inv-campo__etiqueta" for="ind-serie">Número de serie <span class="font-normal text-slate-600">(Opcional)</span></label>
                            <input id="ind-serie" asp-for="CrearUnidad.NumeroSerie" maxlength="100"
                                   class="inv-control"
                                   placeholder="Ej. SN-9988234B" />
                            <span asp-validation-for="CrearUnidad.NumeroSerie" class="mt-1 block text-xs font-semibold text-red-300"></span>
                        </div>
                        <div>
                            <label class="inv-campo__etiqueta" for="ind-ubic">Ubicación actual</label>
                            <input id="ind-ubic" asp-for="CrearUnidad.UbicacionActual" maxlength="200"
                                   class="inv-control"
                                   placeholder="Opcional" />
                            <span asp-validation-for="CrearUnidad.UbicacionActual" class="mt-1 block text-xs font-semibold text-red-300"></span>
                        </div>
                        <div>
                            <label class="inv-campo__etiqueta" for="ind-obs">Observaciones</label>
                            <textarea id="ind-obs" asp-for="CrearUnidad.Observaciones" maxlength="500" rows="3"
                                      class="inv-control"
                                      placeholder="Notas internas, condición, etc."></textarea>
                            <span asp-validation-for="CrearUnidad.Observaciones" class="mt-1 block text-xs font-semibold text-red-300"></span>
                        </div>
                    </div>
                    <div class="mt-4 flex justify-end">
                        <button type="submit" class="inv-btn inv-btn--primary" disabled="@altaComunBloqueada">
                            <span class="material-symbols-outlined" style="font-size:18px">add</span>
                            Agregar unidad
                        </button>
                    </div>
                </form>
            </div>

            @* Carga masiva *@
            <div class="inv-panel">
                <div class="flex items-center gap-2 mb-1">
                    <span class="material-symbols-outlined text-slate-400">stacks</span>
                    <h3 class="font-semibold text-white">Carga masiva</h3>
                </div>
                <p class="text-xs text-slate-400 mb-4">Cargar varias unidades a la vez. Funciona en dos pasos: primero la vista previa y después la confirmación.</p>

                <form id="form-carga-masiva-unidades" method="post" asp-controller="Producto" asp-action="CrearUnidadesMasivas" asp-fragment="form-carga-masiva-unidades">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CargaMasiva.ProductoId" value="@Model.ProductoId" />

                    <div class="space-y-3">
                        <div class="grid gap-3 sm:grid-cols-2">
                            <div>
                                <label class="inv-campo__etiqueta" for="bulk-qty">Cantidad sin serie</label>
                                <input id="bulk-qty" asp-for="CargaMasiva.CantidadSinSerie" min="0" max="200" type="number"
                                       class="inv-control" />
                                <span asp-validation-for="CargaMasiva.CantidadSinSerie" class="mt-1 block text-xs font-semibold text-red-300"></span>
                            </div>
                            <div>
                                <label class="inv-campo__etiqueta" for="bulk-ubic">Ubicación global</label>
                                <input id="bulk-ubic" asp-for="CargaMasiva.UbicacionActual" maxlength="200"
                                       class="inv-control"
                                       placeholder="Opcional" />
                                <span asp-validation-for="CargaMasiva.UbicacionActual" class="mt-1 block text-xs font-semibold text-red-300"></span>
                            </div>
                        </div>
                        <div>
                            <label class="inv-campo__etiqueta" for="bulk-series">Series múltiples (una por línea)</label>
                            <textarea id="bulk-series" asp-for="CargaMasiva.NumerosSerieTexto" rows="5" maxlength="12000"
                                      class="inv-control inv-control--mono"
                                      placeholder="Una serie por línea"></textarea>
                            <p class="mt-1 text-xs text-slate-500">Las unidades sin serie se cargarán como "Sin serie".</p>
                            <span asp-validation-for="CargaMasiva.NumerosSerieTexto" class="mt-1 block text-xs font-semibold text-red-300"></span>
                        </div>
                        <div>
                            <label class="inv-campo__etiqueta" for="bulk-obs">Observaciones</label>
                            <textarea id="bulk-obs" asp-for="CargaMasiva.Observaciones" rows="2" maxlength="500"
                                      class="inv-control"
                                      placeholder="Opcional"></textarea>
                            <span asp-validation-for="CargaMasiva.Observaciones" class="mt-1 block text-xs font-semibold text-red-300"></span>
                        </div>
                        <div class="flex justify-end">
                            <button type="submit" name="CargaMasiva.Confirmar" value="false"
                                    class="inv-btn inv-btn--primary" disabled="@altaComunBloqueada">
                                <span class="material-symbols-outlined" style="font-size:18px">visibility</span>
                                Previsualizar
                            </button>
                        </div>
                    </div>

                    @if (Model.CargaMasiva.PreviewListo && Model.CargaMasiva.Preview.Any())
                    {
                        <div class="mt-5 space-y-3">
                            <div class="rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2.5">
                                <p class="text-xs font-bold uppercase tracking-wider text-emerald-300">Vista previa lista</p>
                                <p class="mt-0.5 text-sm font-semibold text-white">@Model.CargaMasiva.TotalUnidades unidades &mdash; todas quedan En stock</p>
                            </div>
                            <div class="grid grid-cols-3 gap-2">
                                <div class="rounded-lg bg-slate-800/60 border border-slate-700 p-2.5 text-center">
                                    <div class="text-xs text-slate-400">Total</div>
                                    <div class="text-lg font-semibold text-white">@Model.CargaMasiva.TotalUnidades</div>
                                </div>
                                <div class="rounded-lg bg-slate-800/60 border border-slate-700 p-2.5 text-center">
                                    <div class="text-xs text-slate-400">Con serie</div>
                                    <div class="text-lg font-semibold text-emerald-400">@Model.CargaMasiva.Preview.Count(p => p.NumeroSerie != null)</div>
                                </div>
                                <div class="rounded-lg bg-slate-800/60 border border-slate-700 p-2.5 text-center">
                                    <div class="text-xs text-slate-400">Sin serie</div>
                                    <div class="text-lg font-semibold text-amber-300">@Model.CargaMasiva.Preview.Count(p => p.NumeroSerie == null)</div>
                                </div>
                            </div>
                            <div class="rounded-lg border border-slate-800 overflow-hidden max-h-64 overflow-y-auto">
                                <table class="w-full text-sm">
                                    <thead class="bg-slate-900/70 sticky top-0">
                                        <tr>
                                            <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-slate-400 w-10">#</th>
                                            <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-slate-400">Serie</th>
                                            <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-slate-400">Estado inicial</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-800 text-xs">
                                        @foreach (var item in Model.CargaMasiva.Preview)
                                        {
                                            <tr>
                                                <td class="px-3 py-2 text-slate-500">@item.Orden</td>
                                                <td class="px-3 py-2 font-mono @(item.NumeroSerie != null ? "text-slate-200" : "text-slate-500 italic")">
                                                    @(item.NumeroSerie ?? "(Sin serie)")
                                                </td>
                                                <td class="px-3 py-2">
                                                    <span class="inv-pill inv-pill--ok">En stock</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
                                <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@Model.ProductoId"
                                   class="inv-btn inv-btn--ghost justify-center">
                                    <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                                    Volver a editar
                                </a>
                                <button type="submit" name="CargaMasiva.Confirmar" value="true"
                                        class="inv-btn inv-btn--primary justify-center">
                                    <span class="material-symbols-outlined" style="font-size:18px">check</span>
                                    Confirmar carga
                                </button>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>
    </section>

    }

    @* ================================================================
       PANEL: CONCILIAR STOCK
       ================================================================ *@
    <section id="conciliar" role="tabpanel" data-tab-panel="conciliar" aria-labelledby="tab-conciliar" class="space-y-5" hidden>
        <div>
            <h2 class="text-lg font-semibold text-white">Conciliar stock</h2>
            @if (comparaUnidades)
            {
                <p class="text-sm text-slate-400">Comparación entre stock del producto y unidades físicas disponibles (estado En stock).</p>
            }
        </div>

        @if (!comparaUnidades)
        {
            <p class="inv-aviso inv-aviso--info">
                Este producto no requiere identificar cada unidad, así que su stock no se compara con las unidades cargadas.
                Las unidades que registres son seguimiento opcional.
            </p>
        }
        else if (diferenciaPositiva)
        {
            <div class="inv-aviso inv-aviso--atencion">
                <p><strong>Hay @ajusteAbsoluto.ToString("G29") @(ajusteAbsoluto == 1 ? "unidad de stock sin una unidad física que la respalde" : "unidades de stock sin unidades físicas que las respalden").</strong></p>
                <p>Antes de cargar o ajustar nada, revisá los movimientos de stock y el listado de unidades (vendidas, faltantes, dadas de baja o en reparación) para encontrar de dónde sale la diferencia.</p>
            </div>
        }
        else if (diferenciaNegativa)
        {
            <div class="inv-aviso inv-aviso--atencion">
                <p><strong>Hay @ajusteAbsoluto.ToString("G29") @(ajusteAbsoluto == 1 ? "unidad física" : "unidades físicas") más que el stock registrado.</strong></p>
                <p>Revisá los movimientos de stock y el registro de cada unidad: puede haber una salida mal cargada o una unidad que ya no está. No corresponde crear más unidades.</p>
            </div>
        }
        else
        {
            <p class="inv-aviso inv-aviso--ok">Conciliado: el stock del producto coincide con las unidades físicas disponibles.</p>
        }

        @if (comparaUnidades)
        {
        <dl class="inv-panel inv-resumen">
            <div><dt>Stock del producto</dt><dd>@conciliacion.StockActual.ToString("G29")</dd></div>
            <div><dt>Unidades disponibles</dt><dd>@conciliacion.UnidadesEnStock</dd></div>
            <div><dt>Diferencia</dt><dd class="@(conciliacion.HayDiferencia ? "inv-text-danger" : "inv-text-ok")">@diferenciaTexto</dd></div>
            <div><dt>Unidades registradas</dt><dd>@conciliacion.TotalUnidadesRegistradas</dd></div>
        </dl>

        @if (hayDesgloseVisible)
        {
            <section class="inv-panel" aria-labelledby="desglose-titulo">
                <h3 id="desglose-titulo" class="inv-panel__titulo">Desglose por estado</h3>
                <dl class="inv-resumen">
                    <div><dt>Vendidas</dt><dd>@conciliacion.UnidadesVendidas</dd></div>
                    <div><dt>Faltantes</dt><dd>@conciliacion.UnidadesFaltantes</dd></div>
                    <div><dt>Baja</dt><dd>@conciliacion.UnidadesBaja</dd></div>
                    <div><dt>Devueltas</dt><dd>@conciliacion.UnidadesDevueltas</dd></div>
                    <div><dt>Reservadas</dt><dd>@conciliacion.UnidadesReservadas</dd></div>
                    <div><dt>En reparación</dt><dd>@conciliacion.UnidadesEnReparacion</dd></div>
                </dl>
            </section>
        }

        <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500">
            <span>Último movimiento de stock: @(conciliacion.UltimoMovimientoStockFecha?.AHoraComercial().ToString("dd/MM/yyyy HH:mm") ?? "Sin movimientos")</span>
            <span>Último movimiento de unidad: @(conciliacion.UltimoMovimientoUnidadFecha?.AHoraComercial().ToString("dd/MM/yyyy HH:mm") ?? "Sin movimientos")</span>
        </div>

        }

        @if (hayDiferenciaRelevante)
        {
            <div class="inv-panel space-y-4">
                <div>
                    <h3 class="font-semibold text-white">Revisar la diferencia</h3>
                    <p class="text-sm text-slate-400">Nada se modifica automáticamente.</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    @if (puedeVerKardex)
                    {
                        <a asp-controller="MovimientoStock" asp-action="Kardex" asp-route-id="@Model.ProductoId" class="inv-btn inv-btn--ghost">
                            <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
                            Revisar movimientos
                        </a>
                    }
                    <button type="button" class="inv-btn inv-btn--ghost" data-action="call" data-fn="activateTab" data-args='["ver"]'>
                        <span class="material-symbols-outlined" aria-hidden="true">list</span>
                        Revisar unidades
                    </button>
                    @if (puedeGestionarUnidades && diferenciaPositiva)
                    {
                        <button type="button" class="inv-btn inv-btn--ghost" data-action="call" data-fn="activateTab" data-args='["agregar"]'>
                            <span class="material-symbols-outlined" aria-hidden="true">add</span>
                            Cargar unidades no registradas
                        </button>
                    }
                </div>

                @if (puedeAjustarStock && puedeAjustarStockAgregado)
                {
                    var accionAjuste = diferenciaPositiva ? "AjustarStockAgregadoHaciaAbajo" : "AjustarStockAgregadoAUnidadesFisicas";
                    var confirmacionAjuste = System.Text.Json.JsonSerializer.Serialize(new
                    {
                        titulo = "¿Ajustar el stock del producto?",
                        datos = new object[]
                        {
                            new[] { "Producto", Model.Nombre },
                            new[] { "Stock", $"{conciliacion.StockActual:G29} → {conciliacion.UnidadesEnStock}" },
                            new { etiqueta = "Motivo", campo = "Motivo" }
                        },
                        consecuencias = new[]
                        {
                            "Se registra un movimiento en el Kardex con tu usuario.",
                            "Las unidades físicas no se modifican."
                        },
                        etiquetaConfirmar = "Ajustar stock",
                        tono = "primario"
                    });
                    <details id="adjust-panel" class="rounded-lg border border-slate-800 p-4">
                        <summary class="cursor-pointer text-sm font-semibold text-slate-200">Ajustar el stock a las unidades físicas (@conciliacion.StockActual.ToString("G29") → @conciliacion.UnidadesEnStock)</summary>
                        <form method="post" asp-controller="Producto" asp-action="@accionAjuste" asp-fragment="conciliar"
                              class="mt-3 space-y-3" data-inv-confirm="@confirmacionAjuste" data-prevent-double-submit>
                            <input type="hidden" name="ProductoId" value="@conciliacion.ProductoId" />
                            <div class="inv-campo">
                                <label class="inv-campo__etiqueta" for="ajuste-conciliacion-motivo">Motivo del ajuste</label>
                                <textarea id="ajuste-conciliacion-motivo" name="Motivo" maxlength="500" required rows="2" class="inv-control"
                                          placeholder="Ej.: el recuento físico confirma las unidades disponibles"></textarea>
                            </div>
                            <button type="submit" class="inv-btn inv-btn--primary">Ajustar stock</button>
                        </form>
                    </details>
                }
            </div>
        }
    </section>

    @* ================================================================
       PANEL: TRAZABILIDAD
       ================================================================ *@
    <section id="trazabilidad" role="tabpanel" data-tab-panel="trazabilidad" aria-labelledby="tab-trazabilidad" class="space-y-5" hidden>
        <div>
            <h2 class="text-lg font-semibold text-white">Trazabilidad</h2>
            <p class="text-sm text-slate-400">Configurá si este producto requiere identificar una unidad física específica al vender.</p>
        </div>

        @{
            var puedeDesactivar = Model.RequiereNumeroSerie && Model.Conciliacion.TotalUnidadesActivas == 0;
            var bloqueadaConUnidades = Model.RequiereNumeroSerie && Model.Conciliacion.TotalUnidadesActivas > 0;
        }

        @if (Model.RequiereNumeroSerie)
        {
            <div class="inv-panel">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-emerald-400">verified</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="text-lg font-semibold text-white">Trazabilidad Activada</h3>
                            <span class="text-xs px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">ON</span>
                        </div>
                        <p class="text-sm text-slate-300 mt-1">Este producto requiere seleccionar una unidad física al vender.</p>
                    </div>
                </div>

                @if (bloqueadaConUnidades)
                {
                    <div class="mt-4 rounded-lg border border-amber-500/40 bg-amber-500/5 p-3 flex gap-2.5">
                        <span class="material-symbols-outlined text-amber-300 shrink-0" style="font-size:20px">warning</span>
                        <div class="text-sm text-amber-100/90">
                            No se puede desactivar todavía. Existen <strong>@Model.Conciliacion.TotalUnidadesActivas unidad@(Model.Conciliacion.TotalUnidadesActivas != 1 ? "es" : "") activa@(Model.Conciliacion.TotalUnidadesActivas != 1 ? "s" : "")</strong>.
                            Primero tenés que revisar, vender, dar de baja o resolver esas unidades.
                            <div class="mt-1.5">
                                <button type="button" data-action="call" data-fn="activateTab" data-args='["ver"]' class="text-amber-300 underline underline-offset-2 hover:text-amber-200 text-sm">
                                    Ver unidades activas &rarr;
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 flex flex-wrap gap-2 items-center">
                        <span class="inv-btn inv-btn--ghost opacity-50 cursor-not-allowed" aria-disabled="true">
                            <span class="material-symbols-outlined" style="font-size:18px">power_off</span>
                            Desactivar trazabilidad
                        </span>
                    </div>
                }
                else if (puedeDesactivar)
                {
                    <div class="mt-4 flex flex-wrap gap-2 items-center">
                    @if (puedeGestionarUnidades)
                    {
                        <form method="post" asp-controller="Producto" asp-action="DesactivarTrazabilidad" asp-route-productoId="@Model.ProductoId"
                              data-prevent-double-submit data-inv-confirm="@System.Text.Json.JsonSerializer.Serialize(new {
                                  titulo = "¿Desactivar la trazabilidad individual?",
                                  datos = new[] { new[] { "Producto", Model.Nombre } },
                                  consecuencias = new[] { "Las ventas dejan de pedir la unidad física.", "El stock deja de compararse con las unidades registradas.", "Las unidades y su historial se conservan." },
                                  etiquetaConfirmar = "Desactivar trazabilidad" })">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inv-btn inv-btn--ghost">
                                <span class="material-symbols-outlined" style="font-size:18px">power_off</span>
                                Desactivar trazabilidad
                            </button>
                        </form>
                    }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="inv-panel">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-slate-400">block</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="text-lg font-semibold text-white">Trazabilidad Desactivada</h3>
                            <span class="text-xs px-2 py-0.5 rounded-md bg-slate-700/40 text-slate-300 border border-slate-700">OFF</span>
                        </div>
                        <p class="text-sm text-slate-300 mt-1">Este producto no requiere seleccionar una unidad física al vender.</p>
                    </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-2 items-center">
                    @if (puedeGestionarUnidades)
                    {
                    <form method="post" asp-controller="Producto" asp-action="ActivarTrazabilidad" asp-route-productoId="@Model.ProductoId"
                          data-prevent-double-submit data-inv-confirm="@System.Text.Json.JsonSerializer.Serialize(new {
                              titulo = "¿Activar la trazabilidad individual?",
                              datos = new[] { new[] { "Producto", Model.Nombre }, new[] { "Unidades disponibles hoy", conciliacion.UnidadesEnStock.ToString() }, new[] { "Stock del producto", Model.StockActual.ToString("G29") } },
                              consecuencias = new[] { "Desde ahora, cada venta de este producto exige elegir una unidad física." },
                              etiquetaConfirmar = "Activar trazabilidad",
                              tono = "primario" })">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inv-btn inv-btn--primary">
                            <span class="material-symbols-outlined" style="font-size:18px">power_settings_new</span>
                            Activar trazabilidad
                        </button>
                    </form>
                    }
                </div>
            </div>
        }
    </section>

    @* ================================================================
       FORMULARIOS REALES OCULTOS — usados por modal gestionar
       Preservan contratos POST exactos sin cambiar backend
       ================================================================ *@
    <div class="hidden" aria-hidden="true" id="pu-real-forms">
        @foreach (var unidad in Model.Unidades)
        {
            @if (unidad.PuedeMarcarFaltante)
            {
                <form id="rmf-faltante-@unidad.Id" method="post" asp-controller="Producto" asp-action="MarcarUnidadFaltante">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductoUnidadId" value="@unidad.Id" />
                    <input type="hidden" name="Motivo" value="" />
                </form>
            }
            @if (unidad.PuedeReintegrarAStock)
            {
                <form id="rmf-reintegrar-@unidad.Id" method="post" asp-controller="Producto" asp-action="ReintegrarUnidadAStock">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductoUnidadId" value="@unidad.Id" />
                    <input type="hidden" name="Motivo" value="" />
                </form>
            }
            @if (unidad.PuedeDarBaja)
            {
                <form id="rmf-baja-@unidad.Id" method="post" asp-controller="Producto" asp-action="DarUnidadBaja">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductoUnidadId" value="@unidad.Id" />
                    <input type="hidden" name="Motivo" value="" />
                </form>
            }
            @if (unidad.PuedeFinalizarReparacion)
            {
                <form id="rmf-reparacion-@unidad.Id" method="post" asp-controller="Producto" asp-action="FinalizarReparacionUnidad">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductoUnidadId" value="@unidad.Id" />
                    <input type="hidden" name="EstadoDestino" value="" />
                    <input type="hidden" name="Motivo" value="" />
                </form>
            }
        }
    </div>

    @* Gestionar unidad: el propio diálogo es la confirmación (estado actual → resultante y consecuencias).
       No trae ninguna acción elegida: el operador decide antes de poder confirmar. *@
    <dialog id="modal-manage" class="inv-dialog" aria-labelledby="manage-title">
        <form id="manage-form" class="inv-dialog__panel" novalidate>
            <header class="inv-dialog__header">
                <h2 id="manage-title" class="inv-dialog__title">Gestionar unidad</h2>
            </header>
            <div class="inv-dialog__body">
                <dl class="inv-datos">
                    <div class="inv-datos__fila"><dt>Código</dt><dd id="manage-code"></dd></div>
                    <div class="inv-datos__fila"><dt>Serie</dt><dd id="manage-serial"></dd></div>
                    <div class="inv-datos__fila"><dt>Estado actual</dt><dd id="manage-current-state"></dd></div>
                </dl>
                <div class="inv-campo">
                    <label class="inv-campo__etiqueta" for="manage-action">Qué querés hacer</label>
                    <select id="manage-action" class="inv-control" required autofocus></select>
                    <p id="manage-action-error" class="inv-campo__error" hidden>Elegí una acción.</p>
                </div>
                <div class="inv-campo" id="manage-destino-wrap" hidden>
                    <label class="inv-campo__etiqueta" for="manage-destino">Destino de la reparación</label>
                    <select id="manage-destino" class="inv-control">
                        <option value="">Elegí el destino</option>
                        <option value="EnStock">Reintegrar a stock</option>
                        <option value="Baja">Dar de baja (no reparable)</option>
                        <option value="Devuelta">Marcar como devuelta</option>
                    </select>
                    <p id="manage-destino-error" class="inv-campo__error" hidden>Elegí el destino de la unidad.</p>
                </div>
                <div class="inv-campo">
                    <label class="inv-campo__etiqueta" for="manage-motivo">Motivo</label>
                    <textarea id="manage-motivo" rows="3" maxlength="500" required class="inv-control" placeholder="Detalle, evidencia, contexto"></textarea>
                    <p id="manage-motivo-error" class="inv-campo__error" hidden>Escribí el motivo.</p>
                </div>
                <ul id="manage-consecuencias" class="inv-dialog__consecuencias" aria-live="polite" hidden></ul>
            </div>
            <footer class="inv-dialog__footer">
                <button type="button" class="inv-btn inv-btn--ghost" data-manage-close>Cancelar</button>
                <button type="submit" id="manage-confirm-btn" class="inv-btn inv-btn--primary">Confirmar</button>
            </footer>
        </form>
    </dialog>

</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ============================================================
    // TABS
    // ============================================================
    var panelByHash = {
        'ver':                        'ver',
        'agregar':                    'agregar',
        'conciliar':                  'conciliar',
        'trazabilidad':               'trazabilidad',
        'listado-unidades':           'ver',
        'form-carga-masiva-unidades': 'agregar',
        'adjust-panel':               'conciliar'
    };

    var tablist = document.querySelector('[role="tablist"][aria-label="Modos de unidades"]');
    if (!tablist) return;
    var tabs   = Array.from(tablist.querySelectorAll('[role="tab"][data-tab-target]'));
    var panels = Array.from(document.querySelectorAll('[data-tab-panel]'));

    function normalizeHash(hash) {
        return (hash || '').replace(/^#/, '');
    }

    function panelIdFromHash(hash) {
        var requested = normalizeHash(hash);
        return panelByHash[requested] || 'ver';
    }

    function setActivePanel(panelId) {
        panels.forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-tab-panel') !== panelId;
        });
        tabs.forEach(function (tab) {
            var selected = tab.getAttribute('data-tab-target') === panelId;
            tab.setAttribute('aria-selected', selected ? 'true' : 'false');
            tab.setAttribute('tabindex', selected ? '0' : '-1');
        });
    }

    function updateHash(hash) {
        if (!hash || location.hash === hash) return;
        history.replaceState(null, '', hash);
    }

    function activateFromHash(hash, shouldUpdateHash) {
        var targetPanelId = panelIdFromHash(hash);
        setActivePanel(targetPanelId);
        if (shouldUpdateHash) updateHash(hash || '#' + targetPanelId);
    }

    activateFromHash(location.hash, false);

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            activateFromHash('#' + tab.getAttribute('data-tab-target'), true);
        });
        tab.addEventListener('keydown', function (event) {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            var idx = tabs.indexOf(tab);
            var dir = event.key === 'ArrowRight' ? 1 : -1;
            var next = tabs[(idx + dir + tabs.length) % tabs.length];
            next.focus();
            activateFromHash('#' + next.getAttribute('data-tab-target'), true);
        });
    });

    document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href^="#"]');
        if (!link) return;
        var hash = link.getAttribute('href');
        if (!panelByHash[normalizeHash(hash)]) return;
        event.preventDefault();
        activateFromHash(hash, true);
    });

    window.addEventListener('hashchange', function () {
        activateFromHash(location.hash, false);
    });

    window.activateTab = function (name) {
        activateFromHash('#' + name, true);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // ============================================================
    // GESTIONAR UNIDAD
    // ============================================================
    var dialogo = document.getElementById('modal-manage');
    var formulario = document.getElementById('manage-form');
    var accion = document.getElementById('manage-action');
    var destino = document.getElementById('manage-destino');
    var motivo = document.getElementById('manage-motivo');
    var confirmar = document.getElementById('manage-confirm-btn');
    var unidadActual = null;

    var SIN_KARDEX = 'No ajusta el stock del producto ni genera Kardex: si corresponde, conciliá el stock después.';
    var ACCIONES = {
        reintegrar: { boton: 'Reintegrar a stock', tono: 'inv-btn--primary', efectos: ['La unidad vuelve a estado «En stock».'] },
        baja: { boton: 'Dar de baja', tono: 'inv-btn--danger', efectos: ['La unidad queda dada de baja y no se puede vender.', SIN_KARDEX] },
        faltante: { boton: 'Marcar faltante', tono: 'inv-btn--danger', efectos: ['La unidad queda como faltante y no se puede vender.', SIN_KARDEX] },
        reparacion: { boton: 'Finalizar reparación', tono: 'inv-btn--primary', efectos: ['La reparación se cierra y la unidad pasa al destino elegido.'] }
    };

    function pintarAccion() {
        var cfg = ACCIONES[accion.value];
        document.getElementById('manage-destino-wrap').hidden = accion.value !== 'reparacion';
        var lista = document.getElementById('manage-consecuencias');
        lista.innerHTML = '';
        lista.hidden = !cfg;
        (cfg ? cfg.efectos : []).forEach(function (texto) {
            var li = document.createElement('li');
            li.textContent = texto;
            lista.appendChild(li);
        });
        confirmar.textContent = cfg ? cfg.boton : 'Confirmar';
        confirmar.className = 'inv-btn ' + (cfg ? cfg.tono : 'inv-btn--primary');
    }

    function marcar(campo, idError, invalido) {
        var error = document.getElementById(idError);
        error.hidden = !invalido;
        if (invalido) {
            campo.setAttribute('aria-invalid', 'true');
            campo.setAttribute('aria-describedby', idError);
        } else {
            campo.removeAttribute('aria-invalid');
            campo.removeAttribute('aria-describedby');
        }
        return invalido;
    }

    var panel = window.InvUI.panelFormulario(dialogo, { cierres: '[data-manage-close]' });

    window.puOpenManage = function (unidadId, code, serial, stateLabel, chipClass, actions) {
        unidadActual = unidadId;
        formulario.reset();
        document.getElementById('manage-code').textContent = code;
        document.getElementById('manage-serial').textContent = serial;
        document.getElementById('manage-current-state').textContent = stateLabel;
        accion.innerHTML = '';
        [{ value: '', label: 'Elegí una acción' }].concat(actions).forEach(function (a) {
            var opcion = document.createElement('option');
            opcion.value = a.value;
            opcion.textContent = a.label;
            accion.appendChild(opcion);
        });
        marcar(accion, 'manage-action-error', false);
        marcar(destino, 'manage-destino-error', false);
        marcar(motivo, 'manage-motivo-error', false);
        pintarAccion();
        panel.abrir();
        accion.focus();
    };

    accion.addEventListener('change', function () { marcar(accion, 'manage-action-error', false); pintarAccion(); });
    destino.addEventListener('change', function () { marcar(destino, 'manage-destino-error', false); });
    motivo.addEventListener('input', function () { if (motivo.value.trim()) marcar(motivo, 'manage-motivo-error', false); });

    formulario.addEventListener('submit', function (e) {
        e.preventDefault();
        var invalidos = [
            marcar(accion, 'manage-action-error', !accion.value) && accion,
            marcar(destino, 'manage-destino-error', accion.value === 'reparacion' && !destino.value) && destino,
            marcar(motivo, 'manage-motivo-error', !motivo.value.trim()) && motivo
        ].filter(Boolean);
        if (invalidos.length) { invalidos[0].focus(); return; }

        var real = document.getElementById('rmf-' + accion.value + '-' + unidadActual);
        if (!real) return;
        real.querySelector('[name="Motivo"]').value = motivo.value.trim();
        if (accion.value === 'reparacion') real.querySelector('[name="EstadoDestino"]').value = destino.value;
        confirmar.disabled = true;
        real.submit();
    });

    // ============================================================
    // FILTROS: radio disponibilidad <-> checkboxes backend
    // ============================================================
    window.puDispoChange = function (selected) {
        var cbDispo   = document.getElementById('filter-soloDisponibles');
        var cbVendidas = document.getElementById('filter-soloVendidas');
        if (!cbDispo || !cbVendidas) return;
        cbDispo.disabled    = (selected !== 'disponibles');
        cbDispo.checked     = (selected === 'disponibles');
        cbVendidas.disabled = (selected !== 'vendidas');
        cbVendidas.checked  = (selected === 'vendidas');
    };

}());
</script>
}
