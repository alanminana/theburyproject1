@model ProductoUnidadesGlobalViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = "Inventario global";
    var resumen = Model.Resumen;
    var filtros = Model.Filtros;
    var puedeVerMovimientos = User.TienePermiso("movimientos", "view");
    // Los enlaces antiguos "solo…" equivalen a un estado: se reflejan en el selector para no perderlos al volver a filtrar.
    EstadoUnidad? estadoActivo = filtros.Estado
        ?? (filtros.SoloDisponibles ? EstadoUnidad.EnStock
          : filtros.SoloVendidas ? EstadoUnidad.Vendida
          : filtros.SoloFaltantes ? EstadoUnidad.Faltante
          : filtros.SoloBaja ? EstadoUnidad.Baja
          : filtros.SoloDevueltas ? EstadoUnidad.Devuelta
          : (EstadoUnidad?)null);
    var hayFiltros = filtros.ProductoId.HasValue || estadoActivo.HasValue
        || !string.IsNullOrWhiteSpace(filtros.Texto) || filtros.SoloSinNumeroSerie;
    var totales = new (string Texto, int Cantidad, EstadoUnidad? Estado, bool Siempre)[]
    {
        ("Registradas", resumen.TotalUnidades, null, true),
        ("En stock", resumen.TotalEnStock, EstadoUnidad.EnStock, true),
        ("Vendidas", resumen.TotalVendidas, EstadoUnidad.Vendida, true),
        ("Faltantes", resumen.TotalFaltantes, EstadoUnidad.Faltante, true),
        ("Baja", resumen.TotalBaja, EstadoUnidad.Baja, true),
        ("Devueltas", resumen.TotalDevueltas, EstadoUnidad.Devuelta, false),
        ("En reparación", resumen.TotalEnReparacion, EstadoUnidad.EnReparacion, false),
        ("Anuladas", resumen.TotalAnuladas, EstadoUnidad.Anulada, false),
        ("Reservadas", resumen.TotalReservadas, EstadoUnidad.Reservada, false)
    };
}

<div class="inv-screen inv-page" data-invg-root>
    <header class="inv-head">
        <div class="inv-head__titulo">
            <a asp-controller="Catalogo" asp-action="Index" class="inv-crumb"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Inventario</a>
            <h1>Inventario global</h1>
            <p>Unidades físicas individuales de todos los productos. No reemplaza el stock por producto ni el Kardex.</p>
        </div>
        @* Sin JavaScript no hay pestañas: este enlace da acceso a los movimientos. *@
        @if (puedeVerMovimientos)
        {
            <div class="inv-head__acciones" data-invg-nojs>
                <a asp-controller="MovimientoStock" asp-action="Index" class="inv-btn inv-btn--ghost">Movimientos de inventario</a>
            </div>
        }
    </header>

    <partial name="~/Views/CambiosPrecios/_LoteAvisos.cshtml" />

    @if (puedeVerMovimientos)
    {
        <div class="inv-tablist" data-invg-tablist hidden>
            <div class="inv-tablist__pista" role="tablist" aria-label="Secciones de inventario global">
                <button type="button" class="inv-tab" role="tab" id="invg-tab-unidades" aria-controls="invg-panel-unidades" data-invg-tab="unidades" aria-selected="true">Unidades físicas</button>
                <button type="button" class="inv-tab" role="tab" id="invg-tab-movimientos" aria-controls="invg-panel-movimientos" data-invg-tab="movimientos" aria-selected="false" tabindex="-1">Movimientos</button>
            </div>
        </div>
    }

    <div class="inv-pila" data-invg-panel="unidades" id="invg-panel-unidades" role="tabpanel" aria-labelledby="invg-tab-unidades">
        <nav class="inv-panel inv-totales" aria-label="Totales por estado (con los filtros actuales)">
            @foreach (var t in totales.Where(x => x.Siempre || x.Cantidad > 0))
            {
                <a asp-controller="Producto" asp-action="UnidadesGlobal"
                   asp-route-productoId="@filtros.ProductoId" asp-route-estado="@t.Estado" asp-route-texto="@filtros.Texto"
                   asp-route-soloSinNumeroSerie="@(filtros.SoloSinNumeroSerie ? "true" : null)"
                   aria-current="@(estadoActivo == t.Estado ? "true" : null)">
                    <span>@t.Texto</span>
                    <strong>@t.Cantidad</strong>
                </a>
            }
        </nav>

        <div class="inv-panel inv-panel--tabla">
            <form method="get" asp-controller="Producto" asp-action="UnidadesGlobal" class="inv-filters" role="search" aria-label="Filtrar unidades">
                <div class="inv-filtros-linea inv-filtros-linea--llena">
                    <label class="sr-only" for="filtro-texto">Buscar por código, serie o producto</label>
                    <input id="filtro-texto" type="search" name="texto" value="@filtros.Texto" class="inv-control inv-control--busqueda" placeholder="Código, serie o producto" />
                    <label class="sr-only" for="filtro-producto">Producto</label>
                    <select id="filtro-producto" name="productoId" class="inv-control inv-control--ancho">
                        <option value="">Todos los productos</option>
                        @foreach (SelectListItem item in ViewBag.ProductosDropdown)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                    <label class="sr-only" for="filtro-estado">Estado</label>
                    <select id="filtro-estado" name="estado" class="inv-control">
                        <option value="">Todos los estados</option>
                        @foreach (SelectListItem item in ViewBag.EstadosDropdown)
                        {
                            <option value="@item.Value" selected="@(estadoActivo.HasValue && item.Value == ((int)estadoActivo.Value).ToString())">@item.Text</option>
                        }
                    </select>
                    <label class="inv-opciones"><input type="checkbox" name="soloSinNumeroSerie" value="true" class="inv-check" checked="@filtros.SoloSinNumeroSerie" /> Sin número de serie</label>
                    <button type="submit" class="inv-btn inv-btn--ghost">Filtrar</button>
                    @if (hayFiltros)
                    {
                        <a asp-controller="Producto" asp-action="UnidadesGlobal" class="inv-link">Limpiar</a>
                    }
                </div>
            </form>

            @if (!Model.Items.Any())
            {
                <div class="inv-empty">
                    <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
                    @if (hayFiltros)
                    {
                        <p class="inv-empty__title">No se encontraron unidades con esos filtros</p>
                        <a asp-controller="Producto" asp-action="UnidadesGlobal" class="inv-link">Limpiar filtros</a>
                    }
                    else
                    {
                        <p class="inv-empty__title">Todavía no hay unidades físicas registradas</p>
                        <p>Se cargan desde la ficha de cada producto que se controla por unidad.</p>
                    }
                </div>
            }
            else
            {
                <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Unidades físicas">
                    <table class="inv-table inv-table--apilable">
                        <caption class="sr-only">@Model.Items.Count @(Model.Items.Count == 1 ? "unidad" : "unidades")</caption>
                        <thead>
                            <tr>
                                <th scope="col">Unidad</th>
                                <th scope="col">Producto</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Ubicación</th>
                                <th scope="col">Venta</th>
                                <th scope="col">Ingreso</th>
                                <th scope="col" class="inv-col-actions"><span class="sr-only">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <th scope="row">
                                        <span class="inv-control--mono">@item.CodigoInternoUnidad</span>
                                        <p class="inv-ayuda-texto">@(item.NumeroSerie is null ? "Sin número de serie" : "Serie " + item.NumeroSerie)</p>
                                    </th>
                                    <td data-label="Producto" class="inv-celda-detalle">
                                        <a asp-controller="Producto" asp-action="Unidades" asp-route-productoId="@item.ProductoId" class="inv-link">@item.ProductoNombre</a>
                                        <p class="inv-ayuda-texto">@item.ProductoCodigo</p>
                                    </td>
                                    <td data-label="Estado"><partial name="_EstadoUnidadBadge" model="item.Estado" /></td>
                                    <td data-label="Ubicación">@(item.UbicacionActual ?? "—")</td>
                                    <td data-label="Venta">
                                        @(item.ClienteNombre ?? "—")
                                        @if (item.FechaVenta.HasValue)
                                        {
                                            <p class="inv-ayuda-texto">@item.FechaVenta.Value.AHoraComercial().ToString("dd/MM/yyyy")</p>
                                        }
                                    </td>
                                    <td data-label="Ingreso">@item.FechaIngreso.AHoraComercial().ToString("dd/MM/yyyy")</td>
                                    <td class="inv-col-actions">
                                        <a asp-controller="Producto" asp-action="UnidadHistorial" asp-route-unidadId="@item.Id" class="inv-btn inv-btn--ghost inv-btn--sm"
                                           aria-label="Historial de la unidad @item.CodigoInternoUnidad">Historial</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="inv-pager">@Model.Items.Count @(Model.Items.Count == 1 ? "unidad" : "unidades")</p>
            }
        </div>
    </div>

    @if (puedeVerMovimientos)
    {
        <div class="inv-pila" data-invg-panel="movimientos" id="invg-panel-movimientos" role="tabpanel" aria-labelledby="invg-tab-movimientos" hidden>
            <div class="inv-panel inv-panel--tabla">
                <div class="inv-panel__cabecera">
                    <div>
                        <h2 class="inv-panel__titulo">Movimientos de inventario</h2>
                        <p id="invg-mov-summary" class="inv-ayuda-texto" role="status"></p>
                    </div>
                    <a asp-controller="MovimientoStock" asp-action="Index" class="inv-link">Historial completo</a>
                </div>
                <div class="inv-table-wrap" tabindex="0" role="region" aria-label="Movimientos recientes">
                    <table class="inv-table inv-table--apilable">
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Movimiento</th>
                                <th scope="col">Producto</th>
                                <th scope="col" class="inv-col-num">Cantidad</th>
                                <th scope="col" class="inv-col-num">Stock</th>
                                <th scope="col">Usuario</th>
                            </tr>
                        </thead>
                        <tbody id="invg-mov-body">
                            <tr><td colspan="6" class="inv-empty">Cargando movimientos…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/inventario-global.js" asp-append-version="true"></script>
}
