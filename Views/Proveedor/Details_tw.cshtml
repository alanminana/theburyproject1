@model TheBuryProject.ViewModels.ProveedorViewModel
@{
    ViewData["Title"] = $"Detalle - {Model.RazonSocial}";
    var cuitFormatted = Model.Cuit.Length == 11
        ? $"{Model.Cuit[..2]}-{Model.Cuit[2..10]}-{Model.Cuit[10]}"
        : Model.Cuit;
    var ciudadProvincia = string.Join(", ",
        new[] { Model.Ciudad, Model.Provincia }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // La edición exige proveedores.update en ProveedorController; sin el permiso no se ofrece ni el botón ni el drawer.
    var puedeEditar = User.TienePermiso("proveedores", "update");
    var puedeVerOrdenes = User.TienePermiso("ordenescompra", "view");
    var modales = new ProveedorModalesViewModel
    {
        PuedeCrear = false,
        PuedeEditar = puedeEditar,
        Categorias = Model.CategoriasDisponibles,
        Marcas = Model.MarcasDisponibles,
        ProductosPickerJson = Model.ProductosPickerJson
    };
}

@section Styles {
    <partial name="_ProveedorModuleStyles" />
}

<div data-proveedor-details data-proveedor-id="@Model.Id" class="space-y-6">
    @if (TempData["Success"] != null)
    {
        <div class="alert-erp alert-erp-success toast-msg" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-erp alert-erp-error toast-msg" role="alert">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            @TempData["Error"]
        </div>
    }

    <section class="hero-erp sm:p-8">
        <header class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
            <div class="min-w-0 space-y-3">
                <nav aria-label="Breadcrumb" class="flex text-sm font-medium text-slate-400">
                    <ol class="inline-flex flex-wrap items-center gap-y-1">
                        <li><a asp-controller="Proveedor" asp-action="Index" class="hover:text-primary no-underline">Proveedores</a></li>
                        <li aria-hidden="true"><span class="mx-2 text-slate-400">/</span></li>
                        <li class="text-slate-100" aria-current="page">Detalle</li>
                    </ol>
                </nav>

                <div class="space-y-2">
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="min-w-0 text-3xl font-black tracking-tight text-white sm:text-4xl">@Model.RazonSocial</h1>
                        @if (Model.Activo)
                        {
                            <span class="chip-erp chip-erp-success">
                                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="chip-erp">
                                <span class="h-1.5 w-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>
                                Inactivo
                            </span>
                        }
                    </div>
                    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-400">
                        <span class="font-mono text-slate-300">CUIT @cuitFormatted</span>
                        @if (!string.IsNullOrWhiteSpace(Model.NombreFantasia))
                        {
                            <span class="h-1 w-1 rounded-full bg-slate-600" aria-hidden="true"></span>
                            <span>@Model.NombreFantasia</span>
                        }
                    </p>
                </div>
            </div>

            <div class="proveedor-details-hero-actions flex w-full flex-col gap-3 sm:flex-row xl:w-auto">
                <a asp-action="Index"
                   class="proveedor-details-hero-action btn-erp-ghost no-underline">
                    <span class="material-symbols-outlined text-[20px]" aria-hidden="true">arrow_back</span>
                    Volver a Proveedores
                </a>
                @if (puedeVerOrdenes)
                {
                    <a asp-controller="OrdenCompra" asp-action="Index" asp-route-ProveedorId="@Model.Id"
                       class="proveedor-details-hero-action btn-erp-secondary no-underline">
                        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">local_shipping</span>
                        Órdenes de compra
                    </a>
                }
                @if (puedeEditar)
                {
                    <button type="button" data-proveedor-modal-action="open" data-proveedor-modal="edit" data-proveedor-id="@Model.Id"
                            class="proveedor-details-hero-action btn-erp-primary">
                        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">edit</span>
                        Editar proveedor
                    </button>
                }
            </div>
        </header>

        <dl class="mt-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
            <div class="card-erp-metric">
                <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Órdenes de compra</dt>
                <dd class="mt-2 text-2xl font-black text-white">@Model.TotalOrdenesCompra</dd>
                <dd class="mt-1 text-xs text-slate-400">registradas</dd>
            </div>
            <div class="card-erp-metric">
                <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Cheques vigentes</dt>
                <dd class="mt-2 text-2xl font-black text-white">@Model.ChequesVigentes</dd>
                <dd class="mt-1 text-xs text-slate-400">sin cobrar ni anular</dd>
            </div>
            <div class="card-erp-metric">
                <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Total en órdenes</dt>
                <dd class="mt-2 text-2xl font-black text-white">$@Model.TotalDeuda.ToString("N0")</dd>
                <dd class="mt-1 text-xs text-slate-400">sin contar las canceladas</dd>
            </div>
            <div class="card-erp-metric">
                <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Cobertura</dt>
                <dd class="mt-2 text-2xl font-black text-white">@Model.CategoriasAsociadas.Count</dd>
                <dd class="mt-1 text-xs text-slate-400">categoría@(Model.CategoriasAsociadas.Count == 1 ? "" : "s") · @Model.MarcasAsociadas.Count marca@(Model.MarcasAsociadas.Count == 1 ? "" : "s")</dd>
            </div>
        </dl>
    </section>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <section class="card-erp-panel lg:col-span-2" aria-labelledby="prov-info-title">
            <div class="px-6 py-4 border-b border-slate-800 bg-slate-800/30">
                <h2 id="prov-info-title" class="text-lg font-bold">Información general</h2>
            </div>
            <div class="p-6 space-y-6">
                <dl class="prov-dl">
                    <div>
                        <dt>Razón social</dt>
                        <dd>@Model.RazonSocial</dd>
                    </div>
                    <div>
                        <dt>Nombre de fantasía</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.NombreFantasia) ? "—" : Model.NombreFantasia)</dd>
                    </div>
                    <div>
                        <dt>Persona de contacto</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Contacto) ? "—" : Model.Contacto)</dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-primary-on-dark hover:underline no-underline break-all">@Model.Email</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Teléfono</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                            {
                                <a href="tel:@Model.Telefono" class="text-primary-on-dark hover:underline no-underline">@Model.Telefono</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Dirección</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</dd>
                    </div>
                    <div>
                        <dt>Ciudad / provincia</dt>
                        <dd>@(string.IsNullOrEmpty(ciudadProvincia) ? "—" : ciudadProvincia)</dd>
                    </div>
                    <div>
                        <dt>Código postal</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CodigoPostal) ? "—" : Model.CodigoPostal)</dd>
                    </div>
                </dl>

                <div class="border-t border-slate-800 pt-6">
                    <h3 class="prov-dl-heading">Aclaraciones</h3>
                    @if (!string.IsNullOrWhiteSpace(Model.Aclaraciones))
                    {
                        <p class="mt-2 rounded-lg bg-slate-800 p-4 text-sm text-slate-300 whitespace-pre-line">@Model.Aclaraciones</p>
                    }
                    else
                    {
                        <p class="mt-2 text-sm text-slate-400 italic">Sin aclaraciones.</p>
                    }
                </div>
            </div>
        </section>

        <div class="space-y-6">
            <section class="card-erp-panel-padded" aria-labelledby="prov-cat-title">
                <h2 id="prov-cat-title" class="prov-dl-heading mb-4">Categorías asociadas</h2>
                @if (Model.CategoriasAsociadas.Any())
                {
                    <ul class="flex flex-wrap gap-2">
                        @foreach (var cat in Model.CategoriasAsociadas)
                        {
                            <li class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-semibold border border-primary/20">@cat</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-slate-400 italic">Sin categorías asignadas.</p>
                }
            </section>

            <section class="card-erp-panel-padded" aria-labelledby="prov-marca-title">
                <h2 id="prov-marca-title" class="prov-dl-heading mb-4">Marcas asociadas</h2>
                @if (Model.MarcasAsociadas.Any())
                {
                    <ul class="flex flex-wrap gap-2">
                        @foreach (var marca in Model.MarcasAsociadas)
                        {
                            <li class="px-3 py-1 bg-slate-800 text-slate-300 rounded-full text-xs font-semibold border border-slate-700">@marca</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-slate-400 italic">Sin marcas asignadas.</p>
                }
            </section>
        </div>

        <section data-oc-scroll style="--oc-scroll-min-width: 40rem;" class="card-erp-panel lg:col-span-3" aria-labelledby="prov-prod-title">
            <div class="border-b border-slate-800 bg-slate-800/30 px-6 py-4">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <h2 id="prov-prod-title" class="text-lg font-bold text-white">Productos asociados</h2>
                        <p class="text-sm text-slate-400">Código, stock y precio de compra de los productos vinculados a este proveedor.</p>
                    </div>
                    <span id="productos-badge" class="chip-erp self-start" role="status">
                        <span class="material-symbols-outlined text-sm" aria-hidden="true">inventory_2</span>
                        <span data-productos-badge-text>Cargando</span>
                    </span>
                </div>
                <p data-oc-scroll-hint hidden class="mt-3 text-xs font-medium text-slate-400">
                    Deslizá la tabla para ver stock y precio completos.
                </p>
            </div>
            <div data-oc-scroll-shell>
                <div data-oc-scroll-fade="left" hidden></div>
                <div data-oc-scroll-fade="right" hidden></div>
                <div data-oc-scroll-region tabindex="0" role="region" aria-label="Productos asociados del proveedor">
                    <table data-erp-cards data-oc-scroll-table class="w-full text-left text-sm">
                        <thead class="text-slate-400 uppercase text-[10px] font-bold tracking-widest bg-slate-800/30">
                            <tr>
                                <th scope="col" data-card="title" class="px-6 py-3">Producto</th>
                                <th scope="col" data-card="half" class="px-6 py-3 text-center">Código</th>
                                <th scope="col" data-card="half" class="px-6 py-3 text-center">Stock</th>
                                <th scope="col" data-card="half" class="px-6 py-3 text-right">Precio de compra</th>
                            </tr>
                        </thead>
                        <tbody id="productos-tbody" class="divide-y divide-slate-800">
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-sm text-slate-400">
                                    <div class="flex items-center justify-center gap-2">
                                        <div class="w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                                        Cargando productos…
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div id="productos-footer" class="hidden border-t border-slate-800 p-4 text-center">
                <span id="productos-count" class="text-slate-300 text-sm font-semibold"></span>
            </div>
        </section>
    </div>
</div>

@if (puedeEditar)
{
    <partial name="_ProveedorModales" model="modales" />
}

@section Scripts {
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-product-picker.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-modal-base.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-module.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-detalles.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-editar-modal.js" asp-append-version="true"></script>
}
