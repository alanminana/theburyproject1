@model ProveedorFilterViewModel
@using TheBuryProject.Helpers
@{
    ViewData["Title"] = "Gestión de Proveedores";
    ViewData["MetaDescription"] = "Administración de proveedores, contactos y órdenes de compra en el ERP TheBuryProject.";
    var proveedores = Model.Proveedores.ToList();
    var activos = proveedores.Count(p => p.Activo);

    // Cada acción exige su permiso propio en ProveedorController (create/update/delete): la vista solo
    // ofrece lo que el servidor va a aceptar. Con solo lectura la fila queda con "Ver".
    var puedeCrear = User.TienePermiso("proveedores", "create");
    var puedeEditar = User.TienePermiso("proveedores", "update");
    var puedeEliminar = User.TienePermiso("proveedores", "delete");
    var puedeVerOrdenes = User.TienePermiso("ordenescompra", "view");

    var filtroProvActivo = !string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SoloActivos;
    var modales = new ProveedorModalesViewModel
    {
        PuedeCrear = puedeCrear,
        PuedeEditar = puedeEditar,
        Categorias = Model.CategoriasDisponibles,
        Marcas = Model.MarcasDisponibles,
        ProductosPickerJson = Model.ProductosPickerJson
    };
}

@section Styles {
    <partial name="_ProveedorModuleStyles" />
}

@if (TempData["Success"] != null)
{
    <div class="alert-erp alert-erp-success toast-msg mb-4" role="status">
        <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
        @TempData["Success"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert-erp alert-erp-warning toast-msg mb-4" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">warning</span>
        @TempData["Warning"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-erp alert-erp-error toast-msg mb-4" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">error</span>
        @TempData["Error"]
    </div>
}

<div data-oc-scroll style="--oc-scroll-min-width: 40rem;" class="table-erp-wrapper">
    <div class="border-b border-slate-800 px-5 py-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
                <h2 class="text-base font-bold text-white">Listado de proveedores</h2>
                <p class="text-sm text-slate-400" aria-live="polite">
                    @proveedores.Count @(proveedores.Count == 1 ? "proveedor" : "proveedores")
                    @if (proveedores.Count > 0)
                    {
                        <span>· @activos @(activos == 1 ? "activo" : "activos")</span>
                    }
                    @if (filtroProvActivo)
                    {
                        <span>· con filtros aplicados</span>
                    }
                </p>
            </div>
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center lg:justify-end">
                @if (puedeVerOrdenes)
                {
                    <a asp-controller="OrdenCompra" asp-action="Index"
                       class="btn-erp-ghost btn-sm no-underline sm:w-auto">
                        <span class="material-symbols-outlined text-[16px]" aria-hidden="true">local_shipping</span>
                        Órdenes de compra
                    </a>
                }
                @* Sin proveedores cargados el estado vacío ya ofrece la acción: un solo CTA primario por pantalla. *@
                @if (puedeCrear && (proveedores.Any() || filtroProvActivo))
                {
                    <button type="button" data-proveedor-modal-action="open" data-proveedor-modal="create"
                            class="btn-erp-primary btn-sm sm:w-auto">
                        <span class="material-symbols-outlined text-[16px]" aria-hidden="true">add</span>
                        Nuevo proveedor
                    </button>
                }
            </div>
        </div>
    </div>

    @* Los filtros se aplican solos (proveedor-index.js): al elegir una opción, o al dejar de escribir en la búsqueda. *@
    <form asp-action="Index" method="get" id="form-filtros" role="search" data-proveedor-auto-filter
          class="prov-filters border-b border-slate-800 bg-slate-900/30">
        <div class="prov-filters__search">
            <label for="filtro-buscar" class="prov-filters__label">Buscar</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-lg text-slate-400" aria-hidden="true">search</span>
                <input type="search" id="filtro-buscar" name="searchTerm" value="@Model.SearchTerm"
                       autocomplete="off"
                       class="filter-input-erp filter-input-erp-icon"
                       placeholder="Nombre o CUIT" />
            </div>
        </div>
        <div class="prov-filters__sort">
            <label for="filtro-orden" class="prov-filters__label">Ordenar por</label>
            <select id="filtro-orden" name="orderBy" class="filter-select-erp">
                <option value="razonsocial" selected="@(Model.OrderBy == "razonsocial" || string.IsNullOrEmpty(Model.OrderBy))">Razón social</option>
                <option value="cuit" selected="@(Model.OrderBy == "cuit")">CUIT</option>
                <option value="email" selected="@(Model.OrderBy == "email")">Email</option>
                <option value="telefono" selected="@(Model.OrderBy == "telefono")">Teléfono</option>
            </select>
        </div>
        <div class="prov-filters__sort">
            <label for="filtro-sentido" class="prov-filters__label">Sentido</label>
            <select id="filtro-sentido" name="orderDirection" class="filter-select-erp">
                <option value="asc" selected="@(Model.OrderDirection == "asc" || string.IsNullOrEmpty(Model.OrderDirection))">Ascendente</option>
                <option value="desc" selected="@(Model.OrderDirection == "desc")">Descendente</option>
            </select>
        </div>
        <label class="prov-filters__check">
            <input type="checkbox" name="soloActivos" value="true" @(Model.SoloActivos ? "checked" : "") />
            <span>Solo activos</span>
        </label>
        @if (filtroProvActivo)
        {
            <a asp-action="Index" class="btn-erp-ghost btn-sm no-underline prov-filters__clear">
                <span class="material-symbols-outlined text-[16px]" aria-hidden="true">filter_alt_off</span>
                Limpiar filtros
            </a>
        }
        <noscript>
            <button type="submit" class="btn-erp-primary btn-sm">Aplicar</button>
        </noscript>
    </form>

    @if (proveedores.Any())
    {
        <p data-oc-scroll-hint hidden class="px-5 pt-4 text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 lg:hidden">
            Deslizá la tabla para ver contacto y acciones completas.
        </p>

        <div data-oc-scroll-shell>
            <div data-oc-scroll-fade="left" hidden></div>
            <div data-oc-scroll-fade="right" hidden></div>
            <div data-oc-scroll-region tabindex="0" role="region" aria-label="Listado de proveedores">
                <table data-erp-cards data-oc-scroll-table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-800 bg-slate-800/30">
                            <th scope="col" data-card="title" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Proveedor</th>
                            <th scope="col" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Cobertura</th>
                            <th scope="col" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Contacto</th>
                            <th scope="col" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-400">Estado</th>
                            <th scope="col" data-card="actions" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="proveedores-tbody" class="divide-y divide-slate-800">
                        @foreach (var p in proveedores)
                        {
                            var cuitFormatted = p.Cuit.Length == 11
                                ? $"{p.Cuit[..2]}-{p.Cuit[2..10]}-{p.Cuit[10]}"
                                : p.Cuit;
                            var categorias = p.CategoriasAsociadas.Take(2).ToList();
                            var categoriasRestantes = p.CategoriasAsociadas.Count - categorias.Count;
                            var cantidadProductos = p.ProductosAsociados.Count;

                            <tr data-proveedor-row-id="@p.Id" class="transition-colors hover:bg-white/5">
                                <td class="px-5 py-3">
                                    <div class="min-w-0">
                                        <a asp-action="Details" asp-route-id="@p.Id"
                                           class="block truncate text-sm font-bold text-white no-underline hover:underline">@p.RazonSocial</a>
                                        <p class="mt-0.5 flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400">
                                            <span class="font-mono">@cuitFormatted</span>
                                            @if (!string.IsNullOrEmpty(p.NombreFantasia))
                                            {
                                                <span class="h-1 w-1 rounded-full bg-slate-700" aria-hidden="true"></span>
                                                <span class="truncate max-w-56">@p.NombreFantasia</span>
                                            }
                                        </p>
                                    </div>
                                </td>
                                <td class="prov-cobertura px-5 py-3">
                                    @if (categorias.Any())
                                    {
                                        <div class="flex max-w-[18rem] flex-wrap gap-1">
                                            @foreach (var cat in categorias)
                                            {
                                                <span class="chip-erp max-w-36 truncate" title="@cat">@cat</span>
                                            }
                                            @if (categoriasRestantes > 0)
                                            {
                                                <span class="chip-erp chip-erp-primary">+@categoriasRestantes</span>
                                            }
                                        </div>
                                    }
                                    else if (cantidadProductos > 0)
                                    {
                                        <span class="text-xs text-slate-300">@cantidadProductos @(cantidadProductos == 1 ? "producto" : "productos")</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400">Sin cobertura cargada</span>
                                    }
                                </td>
                                <td class="px-5 py-3">
                                    <div class="prov-contact flex max-w-68 flex-col gap-0.5 text-sm">
                                        @if (!string.IsNullOrEmpty(p.Contacto))
                                        {
                                            <span class="truncate font-semibold text-slate-200">@p.Contacto</span>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <a href="mailto:@p.Email" class="flex items-center gap-1 truncate text-xs text-primary-on-dark hover:underline no-underline">
                                                <span class="material-symbols-outlined text-[14px]" aria-hidden="true">mail</span>
                                                <span class="truncate">@p.Email</span>
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Telefono))
                                        {
                                            <span class="flex items-center gap-1 text-xs text-slate-400">
                                                <span class="material-symbols-outlined text-[14px]" aria-hidden="true">phone</span>
                                                @p.Telefono
                                            </span>
                                        }
                                        @if (string.IsNullOrEmpty(p.Contacto) && string.IsNullOrEmpty(p.Email) && string.IsNullOrEmpty(p.Telefono))
                                        {
                                            <span class="text-xs text-slate-400">Sin contacto</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-5 py-3">
                                    @if (p.Activo)
                                    {
                                        <span class="chip-erp chip-erp-success">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="chip-erp">
                                            <span class="h-1.5 w-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="px-5 py-3 text-right">
                                    <div class="flex items-center justify-end gap-0.5">
                                        <a asp-action="Details" asp-route-id="@p.Id"
                                           class="row-action row-action--primary no-underline"
                                           title="Ver detalle"
                                           aria-label="Ver detalle de @p.RazonSocial">
                                            <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                                            <span class="row-action__label">Ver</span>
                                        </a>
                                        @if (puedeEditar)
                                        {
                                            <button type="button" data-proveedor-modal-action="open" data-proveedor-modal="edit" data-proveedor-id="@p.Id"
                                                    class="row-action"
                                                    title="Editar"
                                                    aria-label="Editar @p.RazonSocial">
                                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                                <span class="row-action__label">Editar</span>
                                            </button>
                                        }
                                        @if (puedeEliminar)
                                        {
                                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="inline" data-proveedor-delete-form data-proveedor-name="@p.RazonSocial">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="row-action row-action--danger"
                                                        title="Eliminar"
                                                        aria-label="Eliminar @p.RazonSocial">
                                                    <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                                    <span class="row-action__label">Eliminar</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (filtroProvActivo)
    {
        <div class="flex flex-col items-center justify-center py-16 px-6 text-center">
            <div class="w-14 h-14 bg-slate-800 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-slate-400 text-3xl" aria-hidden="true">search_off</span>
            </div>
            <h3 class="text-lg font-bold text-white">Ningún proveedor coincide</h3>
            <p class="text-slate-400 max-w-sm mt-1">Probá con otra búsqueda o quitá los filtros para ver todos.</p>
            <a asp-action="Index" class="btn-erp-secondary btn-sm no-underline mt-5">
                <span class="material-symbols-outlined text-[16px]" aria-hidden="true">filter_alt_off</span>
                Limpiar filtros
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center py-16 px-6 text-center">
            <div class="w-14 h-14 bg-slate-800 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-slate-400 text-3xl" aria-hidden="true">local_shipping</span>
            </div>
            <h3 class="text-lg font-bold text-white">Todavía no cargaste proveedores</h3>
            <p class="text-slate-400 max-w-sm mt-1">Cargá el primero para asociarle productos y armar órdenes de compra.</p>
            @if (puedeCrear)
            {
                <button type="button" data-proveedor-modal-action="open" data-proveedor-modal="create"
                        class="btn-erp-primary btn-sm mt-5">
                    <span class="material-symbols-outlined text-[16px]" aria-hidden="true">add</span>
                    Nuevo proveedor
                </button>
            }
        </div>
    }
</div>

<partial name="_ProveedorModales" model="modales" />

@section Scripts {
    <script src="~/js/module-index.js" asp-append-version="true"></script>
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-product-picker.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-modal-base.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-module.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-index.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-crear-modal.js" asp-append-version="true"></script>
    <script src="~/js/proveedor-editar-modal.js" asp-append-version="true"></script>
}
