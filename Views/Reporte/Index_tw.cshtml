@{
    ViewData["Title"] = "Reportes";

    // Movimientos valorizados exige reportes.stock en el controller; sin ese permiso la tarjeta llevaría a un 403.
    var puedeVerStock = User.TienePermiso("reportes", "stock");

    var reportes = new List<(string Action, string Icon, string Titulo, string Descripcion)>
    {
        ("Ventas", "bar_chart", "Ventas", "Resumen de ventas por período, tipo de pago y vendedor."),
        ("Margenes", "trending_up", "Márgenes", "Análisis de márgenes por producto y categoría."),
        ("Morosidad", "account_balance_wallet", "Morosidad", "Estado de cuotas vencidas y créditos en mora."),
        ("ComisionesVendedores", "payments", "Comisiones", "Detalle de comisiones por vendedor, producto y período."),
        ("Iva", "receipt_long", "IVA de compras y ventas", "Neto, IVA y totales por rango de fechas. Diferencia de IVA."),
    };
    if (puedeVerStock)
    {
        reportes.Add(("MovimientosValorizados", "swap_vert", "Movimientos valorizados", "Costos históricos por movimiento. No representa valor de inventario actual."));
    }
}

<div class="max-w-7xl mx-auto space-y-6">
    @* El título visible ya lo muestra el header de la app; el h1 queda para lectores de pantalla. *@
    <h1 class="sr-only">Reportes</h1>

    @* Grid auto-fill: tailwind.css está precompilado y su regla sm:grid-cols-2 posterior pisa a lg:grid-cols-3. *@
    <ul class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));" role="list">
        @foreach (var r in reportes)
        {
            <li class="flex">
                <a asp-action="@r.Action"
                   class="card-erp group flex w-full items-start gap-4 hover:border-primary/50 transition-colors no-underline focus-visible:ring-2 focus-visible:ring-primary">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10" aria-hidden="true">
                        <span class="material-symbols-outlined text-primary text-2xl">@r.Icon</span>
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block font-semibold text-slate-100">@r.Titulo</span>
                        <span class="mt-1 block text-sm leading-snug text-slate-400">@r.Descripcion</span>
                    </span>
                    <span class="material-symbols-outlined shrink-0 text-xl text-slate-500 group-hover:text-primary transition-colors" aria-hidden="true">arrow_forward</span>
                </a>
            </li>
        }
    </ul>
</div>
