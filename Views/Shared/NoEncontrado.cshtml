@{
    ViewData["Title"] = "No encontrado";
}

<div class="max-w-3xl mx-auto py-8 px-4">
    <div class="bg-slate-900 rounded-xl shadow-sm border border-slate-800">
        <div class="p-6 flex items-start gap-4">
            <span class="material-symbols-outlined text-amber-500 text-3xl" aria-hidden="true">search_off</span>
            <div class="flex-1">
                <h1 class="text-xl font-bold mb-1">No encontramos lo que buscás</h1>
                <p class="text-slate-400">El registro o la página solicitada no existe o fue eliminada.</p>
                <div class="mt-6 flex gap-3 flex-wrap">
                    <a class="inline-flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-slate-600 hover:bg-slate-800 transition-colors"
                       asp-controller="Home" asp-action="Index">
                        <span class="material-symbols-outlined text-lg" aria-hidden="true">home</span>Ir al inicio
                    </a>
                    <button type="button"
                            class="inline-flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-primary text-primary hover:bg-primary/10 transition-colors"
                            onclick="history.back()">
                        <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_back</span>Volver
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
