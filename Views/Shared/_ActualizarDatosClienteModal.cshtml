@* Aviso periódico "actualizar datos del cliente". Lo abre wwwroot/js/cliente-actualizar-datos.js
   (window.ClienteActualizarDatos.mostrar) al buscar un cliente en Venta o abrirlo en Cliente/Details. *@
<style>
    .cad-dialog { position: fixed; inset: 0; margin: auto; height: fit-content; border: 1px solid var(--pal-neutral-700); border-radius: 14px; background: var(--pal-neutral-925); color: var(--pal-neutral-100); padding: 0; width: min(28rem, calc(100vw - 2rem)); box-shadow: 0 24px 60px rgba(0, 0, 0, .55); }
    .cad-dialog::backdrop { background: rgba(2, 6, 23, .65); }
    .cad-body { padding: 1.25rem 1.25rem 1rem; display: flex; gap: .85rem; }
    .cad-icon { flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: color-mix(in srgb, var(--pal-warning-500, #f59e0b) 16%, transparent); color: var(--pal-warning-400, #fbbf24); }
    .cad-title { margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff; line-height: 1.3; }
    .cad-text { margin: .35rem 0 0; font-size: .875rem; line-height: 1.5; color: var(--pal-neutral-300); }
    .cad-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; padding: .75rem 1.25rem 1.1rem; }
    .cad-actions > * { min-height: 2.75rem; }
    @@media (max-width: 480px) { .cad-actions > * { flex: 1 1 100%; justify-content: center; } }
</style>
@{
    // Cliente/Details completa estas claves cuando el cliente tiene los datos vencidos; en Venta no hay (lo dispara el JS).
    var autoId = ViewData["ActualizarDatosClienteId"] as int?;
}
<dialog id="cliente-actualizar-datos-modal" class="cad-dialog" aria-labelledby="cad-title" aria-describedby="cad-text"
        data-auto-id="@autoId"
        data-auto-nombre="@(autoId.HasValue ? ViewData["ActualizarDatosClienteNombre"] : null)"
        data-auto-dias="@(autoId.HasValue ? ViewData["ActualizarDatosClienteDias"] : null)">
    <div class="cad-body">
        <span class="cad-icon" aria-hidden="true"><span class="material-symbols-outlined">contact_phone</span></span>
        <div>
            <h2 id="cad-title" class="cad-title">Actualizar datos del cliente</h2>
            <p id="cad-text" class="cad-text"></p>
        </div>
    </div>
    <div class="cad-actions">
        <button type="button" class="btn-erp-ghost" data-cad-later>Más tarde</button>
        <a href="#" class="btn-erp-primary no-underline" data-cad-edit autofocus>
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">edit</span>
            Actualizar datos
        </a>
    </div>
</dialog>
<script src="~/js/cliente-actualizar-datos.js" asp-append-version="true"></script>
