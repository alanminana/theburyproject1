@* Modal "Completar datos del cliente" para el flujo de venta a crédito. Lo abre
   wwwroot/js/cliente-datos-contractuales.js (window.ClienteDatosContractuales.abrir) o cualquier
   elemento con [data-completar-datos-cliente="<clienteId>"]. Edita sólo los campos que exige el
   contrato (ClienteDatosContractualesController). *@
<style>
    .cdc-dialog { position: fixed; inset: 0; margin: auto; height: fit-content; max-height: calc(100dvh - 2rem); overflow: auto; border: 1px solid var(--pal-neutral-700); border-radius: 14px; background: var(--pal-neutral-925); color: var(--pal-neutral-100); padding: 0; width: min(36rem, calc(100vw - 2rem)); box-shadow: 0 24px 60px rgba(0, 0, 0, .55); }
    .cdc-dialog::backdrop { background: rgba(2, 6, 23, .65); }
    .cdc-head { display: flex; gap: .85rem; padding: 1.25rem 1.25rem .5rem; }
    .cdc-icon { flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: color-mix(in srgb, var(--pal-warning-500, #f59e0b) 16%, transparent); color: var(--pal-warning-400, #fbbf24); }
    .cdc-title { margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff; line-height: 1.3; }
    .cdc-sub { margin: .35rem 0 0; font-size: .875rem; line-height: 1.5; color: var(--pal-neutral-300); }
    .cdc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; padding: .75rem 1.25rem; }
    .cdc-field { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
    .cdc-field--wide { grid-column: 1 / -1; }
    .cdc-label { font-size: .8rem; font-weight: 600; color: var(--pal-neutral-300); }
    .cdc-label .cdc-miss { margin-left: .35rem; font-weight: 500; color: var(--pal-warning-400, #fbbf24); }
    .cdc-input { min-height: 2.75rem; width: 100%; padding: .5rem .75rem; border-radius: 10px; border: 1px solid var(--pal-neutral-700); background: var(--pal-neutral-900, #0f172a); color: var(--pal-neutral-100); font-size: 1rem; }
    .cdc-input:focus-visible { outline: 2px solid var(--pal-warning-400, #fbbf24); outline-offset: 1px; }
    .cdc-input[aria-invalid="true"] { border-color: var(--pal-danger-400, #f87171); }
    .cdc-errors { margin: 0 1.25rem; padding: .6rem .8rem; border-radius: 10px; font-size: .85rem; color: var(--pal-danger-300, #fca5a5); background: color-mix(in srgb, var(--pal-danger-500, #ef4444) 14%, transparent); }
    .cdc-errors ul { margin: 0; padding-left: 1.1rem; }
    .cdc-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; padding: .75rem 1.25rem 1.1rem; }
    .cdc-actions > * { min-height: 2.75rem; }
    @@media (max-width: 480px) {
        .cdc-grid { grid-template-columns: minmax(0, 1fr); }
        .cdc-actions > * { flex: 1 1 100%; justify-content: center; }
    }
</style>
<dialog id="cliente-datos-contractuales-modal" class="cdc-dialog" aria-labelledby="cdc-title" aria-describedby="cdc-sub">
    <form id="cdc-form" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ClienteId" />
        <div class="cdc-head">
            <span class="cdc-icon" aria-hidden="true"><span class="material-symbols-outlined">person_edit</span></span>
            <div>
                <h2 id="cdc-title" class="cdc-title">Completar datos del cliente</h2>
                <p id="cdc-sub" class="cdc-sub">El contrato de crédito necesita estos datos. Completá los que faltan y guardá para continuar con la venta.</p>
            </div>
        </div>
        <div class="cdc-grid">
            <div class="cdc-field"><label class="cdc-label" for="cdc-Nombre">Nombre<span class="cdc-miss" hidden>falta</span></label><input class="cdc-input" id="cdc-Nombre" name="Nombre" data-rule="nombre" maxlength="100" autocomplete="off" /></div>
            <div class="cdc-field"><label class="cdc-label" for="cdc-Apellido">Apellido<span class="cdc-miss" hidden>falta</span></label><input class="cdc-input" id="cdc-Apellido" name="Apellido" data-rule="nombre" maxlength="100" autocomplete="off" /></div>
            <div class="cdc-field">
                <label class="cdc-label" for="cdc-TipoDocumento">Tipo de documento<span class="cdc-miss" hidden>falta</span></label>
                <select class="cdc-input" id="cdc-TipoDocumento" name="TipoDocumento">
                    <option value="">Elegí…</option>
                    <option value="DNI">DNI</option>
                    <option value="CUIL">CUIL</option>
                    <option value="CUIT">CUIT</option>
                </select>
            </div>
            <div class="cdc-field"><label class="cdc-label" for="cdc-NumeroDocumento">Número de documento<span class="cdc-miss" hidden>falta</span></label><input class="cdc-input" id="cdc-NumeroDocumento" name="NumeroDocumento" data-rule="documento" data-tipo="#cdc-TipoDocumento" maxlength="20" autocomplete="off" /></div>
            <div class="cdc-field cdc-field--wide"><label class="cdc-label" for="cdc-Domicilio">Domicilio<span class="cdc-miss" hidden>falta</span></label><input class="cdc-input" id="cdc-Domicilio" name="Domicilio" maxlength="200" placeholder="Calle, número, piso, depto" autocomplete="off" /></div>
            <div class="cdc-field"><label class="cdc-label" for="cdc-Localidad">Localidad<span class="cdc-miss" hidden>falta</span></label><input class="cdc-input" id="cdc-Localidad" name="Localidad" maxlength="100" autocomplete="off" /></div>
            <div class="cdc-field"><label class="cdc-label" for="cdc-Telefono">Teléfono<span class="cdc-miss" hidden>falta</span></label><input class="cdc-input" id="cdc-Telefono" name="Telefono" data-rule="telefono" type="tel" maxlength="20" placeholder="11 0000-0000" autocomplete="off" /></div>
        </div>
        <div id="cdc-errors" class="cdc-errors" role="alert" hidden></div>
        <div class="cdc-actions">
            <button type="button" class="btn-erp-ghost" data-cdc-cancel>Cancelar</button>
            <button type="submit" class="btn-erp-primary" data-cdc-save>
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">save</span>
                Guardar datos
            </button>
        </div>
    </form>
</dialog>
<script src="~/js/cliente-datos-contractuales.js" asp-append-version="true"></script>
