@model BarraModulo
@* Pestañas de módulo (ERP-UI-STANDARD §5, navegación real: una URL por pestaña, aria-current, siempre en la
   misma posición). Mismo aspecto que las pestañas de Inventario. modulo-tabs.js conserva los filtros de cada
   pestaña y deja visible la activa cuando hay scroll horizontal. *@
<div class="modulo-barra card-erp-panel" data-modulo-barra="@Model.ModuloClave">
    @if (Model.Pestanas.Count > 0)
    {
        <nav class="modulo-tabs" aria-label="Secciones de @Model.ModuloTitulo" data-modulo-tabs>
            @foreach (var p in Model.Pestanas)
            {
                <a class="modulo-tab" data-modulo-tab="@p.Clave" aria-current="@(p.Activa ? "page" : null)"
                   asp-controller="@p.Destino.Controlador" asp-action="@p.Destino.Accion" asp-route-tab="@p.Destino.Tab">
                    <span class="material-symbols-outlined" aria-hidden="true">@p.Icono</span>
                    @p.Titulo
                </a>
            }
        </nav>
    }
    @if (Model.SubPestanas.Count > 0)
    {
        <nav class="modulo-subtabs" aria-label="Vistas de la sección" data-modulo-tabs>
            @foreach (var p in Model.SubPestanas)
            {
                <a class="modulo-subtab" data-modulo-tab="@p.Clave" aria-current="@(p.Activa ? "page" : null)"
                   asp-controller="@p.Destino.Controlador" asp-action="@p.Destino.Accion" asp-route-tab="@p.Destino.Tab">
                    @p.Titulo
                </a>
            }
        </nav>
    }
</div>
