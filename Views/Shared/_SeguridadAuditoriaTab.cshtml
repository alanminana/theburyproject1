@model SeguridadAuditoriaViewModel
@{
    // Color = significado: verde alta/recuperación, rojo baja/bloqueo, violeta/azul informativos, neutro el resto.
    // "Editar" es una operación rutinaria, no una advertencia: va neutro (el ámbar queda reservado a advertencias).
    Func<string, string> badgeClasses = accion => accion.ToLowerInvariant() switch
    {
        "crear" => "bg-emerald-900/30 text-emerald-400",
        "eliminar" => "bg-rose-900/30 text-rose-400",
        "bloquear" => "bg-rose-900/30 text-rose-400",
        "desbloquear" => "bg-emerald-900/30 text-emerald-400",
        "reset password" => "bg-orange-900/30 text-orange-400",
        "permisos" => "bg-violet-900/30 text-violet-400",
        "login" => "bg-blue-900/30 text-blue-400",
        _ => "bg-slate-800 text-slate-300"
    };

    Func<string, string> getInitials = usuario =>
    {
        var parts = usuario.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0
            ? "?"
            : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    };

    // Querystring de los filtros vigentes (sin vacíos): la paginación los conserva y la URL es compartible.
    Func<int, IDictionary<string, string>> rutaPagina = pagina =>
    {
        var ruta = new Dictionary<string, string> { ["tab"] = "auditoria", ["pagina"] = pagina.ToString() };
        if (!string.IsNullOrWhiteSpace(Model.UsuarioSeleccionado)) ruta["usuario"] = Model.UsuarioSeleccionado;
        if (!string.IsNullOrWhiteSpace(Model.ModuloSeleccionado)) ruta["modulo"] = Model.ModuloSeleccionado;
        if (!string.IsNullOrWhiteSpace(Model.AccionSeleccionada)) ruta["accion"] = Model.AccionSeleccionada;
        if (Model.Desde.HasValue) ruta["desde"] = Model.Desde.Value.ToString("yyyy-MM-dd");
        if (Model.Hasta.HasValue) ruta["hasta"] = Model.Hasta.Value.ToString("yyyy-MM-dd");
        return ruta;
    };

    var hayFiltros = !string.IsNullOrWhiteSpace(Model.UsuarioSeleccionado)
        || !string.IsNullOrWhiteSpace(Model.ModuloSeleccionado)
        || !string.IsNullOrWhiteSpace(Model.AccionSeleccionada)
        || Model.Desde.HasValue
        || Model.Hasta.HasValue;
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="bg-slate-900/50 rounded-xl border border-slate-800 overflow-hidden shadow-sm">
        <partial name="_SeguridadTabNav" />

        <form asp-controller="Seguridad" asp-action="Index" method="get" class="seg-toolbar seg-toolbar--audit"
              role="search" aria-label="Filtrar eventos de auditoría">
            <input type="hidden" name="tab" value="auditoria" />

            <div class="seg-field">
                <label for="usuario" class="seg-field__label">Usuario</label>
                <select id="usuario" name="usuario"
                        class="bg-slate-800 border-none rounded-lg text-sm px-4 py-2 focus:ring-primary text-white">
                    <option value="">Todos los usuarios</option>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <option value="@usuario" selected="@string.Equals(Model.UsuarioSeleccionado, usuario, StringComparison.OrdinalIgnoreCase)">@usuario</option>
                    }
                </select>
            </div>

            <div class="seg-field">
                <label for="modulo" class="seg-field__label">Módulo</label>
                <select id="modulo" name="modulo"
                        class="bg-slate-800 border-none rounded-lg text-sm px-4 py-2 focus:ring-primary text-white">
                    <option value="">Todos los módulos</option>
                    @foreach (var modulo in Model.Modulos)
                    {
                        <option value="@modulo" selected="@string.Equals(Model.ModuloSeleccionado, modulo, StringComparison.OrdinalIgnoreCase)">@modulo</option>
                    }
                </select>
            </div>

            <div class="seg-field">
                <label for="accion" class="seg-field__label">Acción</label>
                <select id="accion" name="accion"
                        class="bg-slate-800 border-none rounded-lg text-sm px-4 py-2 focus:ring-primary text-white">
                    <option value="">Todas las acciones</option>
                    @foreach (var accion in Model.Acciones)
                    {
                        <option value="@accion" selected="@string.Equals(Model.AccionSeleccionada, accion, StringComparison.OrdinalIgnoreCase)">@accion</option>
                    }
                </select>
            </div>

            <div class="seg-field seg-field--date">
                <label for="desde" class="seg-field__label">Desde</label>
                <input id="desde" name="desde" type="date" value="@(Model.Desde?.ToString("yyyy-MM-dd"))"
                       class="bg-slate-800 border-none rounded-lg text-sm px-3 py-2 focus:ring-primary text-white" />
            </div>

            <div class="seg-field seg-field--date">
                <label for="hasta" class="seg-field__label">Hasta</label>
                <input id="hasta" name="hasta" type="date" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))"
                       class="bg-slate-800 border-none rounded-lg text-sm px-3 py-2 focus:ring-primary text-white" />
            </div>

            <div class="seg-toolbar__cta seg-toolbar__buttons">
                <button type="submit" class="btn-erp-primary">
                    <span class="material-symbols-outlined text-sm">filter_alt</span>
                    Buscar
                </button>
                @if (hayFiltros)
                {
                    <a asp-controller="Seguridad" asp-action="Index" asp-route-tab="auditoria"
                       class="btn-erp-ghost no-underline">
                        Limpiar
                    </a>
                }
            </div>
        </form>

        <div data-oc-scroll class="relative" style="--oc-scroll-min-width: 980px;">
            <div data-oc-scroll-hint hidden class="px-4 pt-4 text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 lg:hidden">
                Deslizá para ver toda la auditoría
            </div>
            <div data-oc-scroll-shell class="relative">
                <div data-oc-scroll-fade="left" hidden class="absolute inset-y-0 left-0 z-10 w-6 bg-gradient-to-r from-slate-900 via-slate-900/95 to-transparent"></div>
                <div data-oc-scroll-fade="right" hidden class="absolute inset-y-0 right-0 z-10 w-6 bg-gradient-to-l from-slate-900 via-slate-900/95 to-transparent"></div>
                <div data-oc-scroll-region class="overflow-x-auto scroll-smooth" tabindex="0" role="region" aria-label="Registro de auditoría">
            <table data-erp-cards data-oc-scroll-table class="seg-table w-full text-left border-collapse" style="min-width: var(--oc-scroll-min-width);">
                <thead>
                    <tr class="bg-slate-800/50 border-b border-slate-800">
                        <th data-card="title" scope="col" class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">Fecha / Hora</th>
                        <th data-card="half" scope="col" class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">Usuario</th>
                        <th data-card="half" scope="col" class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">Acción</th>
                        <th data-card="half" scope="col" class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">Módulo</th>
                        <th data-card="half" scope="col" class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">Entidad</th>
                        <th scope="col" class="seg-col-detail px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-400">Detalle</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @if (Model.Registros.Any())
                    {
                        @foreach (var registro in Model.Registros)
                        {
                            <tr class="hover:bg-slate-800/30 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <div class="font-medium text-white">@registro.FechaHora.ToString("dd MMM yyyy")</div>
                                    <div class="text-xs text-slate-400">@registro.FechaHora.ToString("HH:mm:ss")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="size-8 rounded-full flex items-center justify-center text-xs font-bold uppercase bg-slate-800 text-slate-300">
                                            @getInitials(registro.Usuario)
                                        </div>
                                        <span class="text-sm font-medium text-white">@registro.Usuario</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium uppercase @badgeClasses(registro.Accion)">
                                        @registro.Accion
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-400">@registro.Modulo</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-white">@registro.Entidad</td>
                                <td class="seg-col-detail px-6 py-4 text-sm text-slate-400">
                                    <span class="seg-detail" title="@registro.Detalle">@registro.Detalle</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-14 text-center">
                                <div class="inline-flex items-center justify-center size-14 rounded-full bg-slate-800 mb-4">
                                    <span class="material-symbols-outlined text-3xl text-slate-400">history</span>
                                </div>
                                <p class="text-sm font-semibold text-slate-300">@(hayFiltros ? "No hay registros para los filtros aplicados" : "Todavía no hay eventos auditados")</p>
                                @if (hayFiltros)
                                {
                                    <p class="text-xs text-slate-500 mt-1">Probá cambiando usuario, módulo, acción o rango de fechas.</p>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
                </div>
            </div>
        </div>

        <div class="px-6 py-4 flex flex-col gap-3 border-t border-slate-800 bg-slate-800/30 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
            <span class="text-xs text-slate-500 font-medium" role="status">
                @if (Model.TotalRegistros == 0)
                {
                    <text>0 eventos</text>
                }
                else
                {
                    <text>Mostrando @Model.PrimerRegistro–@Model.UltimoRegistro de @Model.TotalRegistros @(Model.TotalRegistros == 1 ? "evento" : "eventos")</text>
                }
            </span>
            @if (Model.TotalPaginas > 1)
            {
                <nav class="seg-pager justify-center" aria-label="Paginación de auditoría">
                    @if (Model.Pagina > 1)
                    {
                        <a asp-controller="Seguridad" asp-action="Index" asp-all-route-data="@rutaPagina(Model.Pagina - 1)"
                           class="btn-erp-ghost btn-sm no-underline" rel="prev">
                            <span class="material-symbols-outlined text-sm">chevron_left</span>
                            Anterior
                        </a>
                    }
                    <span class="seg-pager__page" aria-current="page">Página @Model.Pagina de @Model.TotalPaginas</span>
                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a asp-controller="Seguridad" asp-action="Index" asp-all-route-data="@rutaPagina(Model.Pagina + 1)"
                           class="btn-erp-ghost btn-sm no-underline" rel="next">
                            Siguiente
                            <span class="material-symbols-outlined text-sm">chevron_right</span>
                        </a>
                    }
                </nav>
            }
        </div>
    </div>
</div>
