@model TheBuryProject.ViewModels.ValoracionStockIndexViewModel
@using System.Globalization
@using TheBuryProject.Helpers
@using TheBuryProject.Services
@using TheBuryProject.Services.Models
@{
    ViewData["Title"] = "Valoración de stock (gerencial)";
    ViewData["MetaDescription"] = "Valoración gerencial del stock por costo promedio ponderado. Solo lectura.";
    var f = Model.Filtro;
    var r = Model.Resumen;
    var ar = CultureInfo.GetCultureInfo("es-AR");

    // Presentación: los costos unitarios se muestran con 4 decimales para no ocultar diferencias; los totales con 2.
    string Costo(decimal? v) => v.HasValue ? v.Value.ToString("C4", ar) : "—";
    string Total(decimal? v) => v.HasValue ? v.Value.ToString("C2", ar) : "—";
    string Cantidad(decimal v) => v.ToString("0.####", ar);

    Dictionary<string, string> Ruta(int pagina) => new Dictionary<string, string?>
    {
        ["Busqueda"] = f.Busqueda,
        ["CategoriaId"] = f.CategoriaId?.ToString(),
        ["MarcaId"] = f.MarcaId?.ToString(),
        ["Estado"] = f.Estado?.ToString(),
        ["IncluirSinStock"] = f.IncluirSinStock ? "true" : null,
        ["pagina"] = pagina.ToString()
    }.Where(kv => !string.IsNullOrEmpty(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value!);

    var RutaExport = Ruta(1);
    RutaExport.Remove("pagina");

    string BadgeClase(EstadoValoracionStock e) => e switch
    {
        EstadoValoracionStock.PromedioMovilExacto => "badge-erp badge-erp-success",
        EstadoValoracionStock.ComposicionPorCompras => "badge-erp badge-erp-warning",
        _ => "badge-erp badge-erp-neutral"
    };
}

<style>
    @@media (min-width: 768px) {
        .vsg-col-producto { min-width: 14rem; max-width: 20rem; }
    }
</style>

<h1 class="sr-only">Valoración de stock (gerencial)</h1>

<section class="card-erp-panel mb-4 p-4" aria-labelledby="vsg-titulo">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 id="vsg-titulo" class="text-lg font-bold text-white">Valoración de stock (gerencial)</h2>
            <p class="text-sm text-slate-400">Costo promedio ponderado de las compras recibidas, junto al último costo de compra como indicador de reposición.</p>
        </div>
        <a asp-action="Exportar" asp-all-route-data="RutaExport"
           class="btn-erp-secondary btn-sm no-underline">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">download</span>
            Exportar a Excel
        </a>
    </div>

    <p id="vsg-leyenda" role="note" class="mt-3 rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm text-amber-200">
        <strong>Uso gerencial.</strong> No es valuación fiscal ni contable; no modifica costos ni márgenes.
        Los precios sugeridos y los márgenes siguen usando el costo de ficha del producto.
    </p>

    <dl class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="card-erp-metric">
            <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Valor gerencial</dt>
            <dd class="mt-2 whitespace-nowrap text-xl font-black text-white sm:text-2xl">@Total(r.ValorGerencialTotal)</dd>
            <dd class="mt-1 text-xs text-slate-400">@r.ProductosConValorCompleto producto@(r.ProductosConValorCompleto == 1 ? "" : "s") con cobertura completa</dd>
        </div>
        <div class="card-erp-metric">
            <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">A último costo (reposición)</dt>
            <dd class="mt-2 whitespace-nowrap text-xl font-black text-white sm:text-2xl">@Total(r.ValorAUltimoCostoTotal)</dd>
            <dd class="mt-1 text-xs text-slate-400">mismos productos</dd>
        </div>
        <div class="card-erp-metric">
            <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Diferencia</dt>
            <dd class="mt-2 whitespace-nowrap text-xl font-black text-white sm:text-2xl">@Total(r.DiferenciaVsUltimoCostoTotal)</dd>
            <dd class="mt-1 text-xs text-slate-400">último costo menos promedio</dd>
        </div>
        <div class="card-erp-metric">
            <dt class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Sin valor completo</dt>
            <dd class="mt-2 text-xl font-black text-white sm:text-2xl">@(r.ProductosConValorParcial + r.ProductosSinCompras)</dd>
            <dd class="mt-1 text-xs text-slate-400">@r.ProductosConValorParcial parcial@(r.ProductosConValorParcial == 1 ? "" : "es") · @r.ProductosSinCompras sin compras@(r.ProductosConValorParcial > 0 ? " · parcial " + Total(r.ValorParcialTotal) : "")</dd>
        </div>
    </dl>
</section>

<form asp-action="Index" method="get" class="filter-panel-erp mb-4" aria-label="Filtros de valoración de stock">
    <div class="grid grid-cols-1 gap-4 p-4 md:grid-cols-12">
        <div class="md:col-span-3">
            <label class="@CuentaPorPagarUiHelper.LabelClass" for="f-busqueda">Código o nombre</label>
            <input id="f-busqueda" type="text" name="Busqueda" value="@f.Busqueda" maxlength="100"
                   class="@CuentaPorPagarUiHelper.InputClass" placeholder="Buscar producto" />
        </div>
        <div class="md:col-span-2">
            <label class="@CuentaPorPagarUiHelper.LabelClass" for="f-categoria">Categoría</label>
            <select id="f-categoria" name="CategoriaId" class="@CuentaPorPagarUiHelper.InputClass">
                <option value="">Todas</option>
                @foreach (var c in Model.Categorias)
                {
                    <option value="@c.Id" selected="@(f.CategoriaId == c.Id)">@c.Nombre</option>
                }
            </select>
        </div>
        <div class="md:col-span-2">
            <label class="@CuentaPorPagarUiHelper.LabelClass" for="f-marca">Marca</label>
            <select id="f-marca" name="MarcaId" class="@CuentaPorPagarUiHelper.InputClass">
                <option value="">Todas</option>
                @foreach (var m in Model.Marcas)
                {
                    <option value="@m.Id" selected="@(f.MarcaId == m.Id)">@m.Nombre</option>
                }
            </select>
        </div>
        <div class="md:col-span-3">
            <label class="@CuentaPorPagarUiHelper.LabelClass" for="f-estado">Cálculo</label>
            <select id="f-estado" name="Estado" class="@CuentaPorPagarUiHelper.InputClass">
                <option value="">Todos</option>
                @foreach (var e in Enum.GetValues<EstadoValoracionStock>())
                {
                    <option value="@e" selected="@(f.Estado == e)">@ValoracionStockGerencialService.EtiquetaEstado(e)</option>
                }
            </select>
        </div>
        <div class="flex items-end md:col-span-2">
            <label class="flex items-center gap-2 text-sm text-slate-300">
                <input type="checkbox" name="IncluirSinStock" value="true" checked="@f.IncluirSinStock" class="h-4 w-4 rounded border-slate-600 bg-slate-900" />
                Incluir sin stock
            </label>
        </div>
        <div class="flex items-end gap-2 md:col-span-12">
            <button type="submit" class="btn-erp-primary btn-sm">Buscar</button>
            <a asp-action="Index" class="btn-erp-ghost btn-sm no-underline" title="Limpiar filtros" aria-label="Limpiar filtros">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">filter_alt_off</span>
            </a>
        </div>
    </div>
</form>

<section class="card-erp-panel mb-4" aria-label="Listado de valoración de stock">
    @if (Model.Items.Count == 0)
    {
        <p class="p-6 text-center text-sm text-slate-400">No hay productos que coincidan con los filtros@(f.IncluirSinStock ? "" : " (se omiten los productos sin stock)").</p>
    }
    else
    {
        <div class="table-erp-wrapper" role="region" aria-label="Tabla de valoración de stock" tabindex="0">
            <table data-erp-cards class="w-full border-collapse text-left">
                <thead>
                    <tr class="border-b border-slate-800">
                        <th scope="col" data-card="title" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 whitespace-nowrap">Producto</th>
                        <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Stock</th>
                        <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Costo promedio</th>
                        <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Último costo</th>
                        <th scope="col" data-card="half" class="px-3 py-3 text-xs font-bold uppercase tracking-wider text-slate-400 text-right whitespace-nowrap">Valor gerencial / dif. vs último</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @foreach (var i in Model.Items)
                    {
                        <tr class="transition-colors hover:bg-slate-800/50">
                            <td class="px-3 py-2.5 vsg-col-producto">
                                <span class="block whitespace-nowrap font-bold text-primary">@i.Codigo</span>
                                <span class="block text-sm">@i.Nombre</span>
                                <span class="block text-xs text-slate-400">@i.Categoria · @i.Marca</span>
                                <span class="@BadgeClase(i.Estado) mt-1.5">@ValoracionStockGerencialService.EtiquetaEstado(i.Estado)</span>
                                <span class="mt-1 block text-xs text-slate-400">@i.Observacion</span>
                            </td>
                            <td class="px-3 py-2.5 text-right whitespace-nowrap">@Cantidad(i.StockActual)</td>
                            <td class="px-3 py-2.5 text-right whitespace-nowrap">@Costo(i.CostoPromedioPonderado)</td>
                            <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                @Costo(i.UltimoCostoCompra)
                                @if (i.FechaUltimaCompra.HasValue)
                                {
                                    <span class="block text-xs text-slate-400">@i.FechaUltimaCompra.Value.ToString("dd/MM/yyyy", ar)</span>
                                }
                            </td>
                            <td class="px-3 py-2.5 text-right font-bold whitespace-nowrap">
                                @if (i.ValorGerencial.HasValue)
                                {
                                    @Total(i.ValorGerencial)
                                }
                                else if (i.ValorParcial.HasValue)
                                {
                                    <span title="Valor parcial: solo las unidades cubiertas por compras registradas">@Total(i.ValorParcial) <span class="text-xs font-semibold text-amber-300">parcial</span></span>
                                }
                                else
                                {
                                    <span class="text-slate-500">—</span>
                                }
                                @if (i.DiferenciaVsUltimoCosto.HasValue)
                                {
                                    <span class="block text-xs font-normal text-slate-400" title="Valor a último costo menos valor gerencial">dif. @Total(i.DiferenciaVsUltimoCosto)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación" class="flex items-center justify-between gap-3 border-t border-slate-800 px-4 py-3 text-sm text-slate-400">
                <span>Página @Model.Pagina de @Model.TotalPaginas · @Model.TotalItems productos</span>
                <span class="flex gap-2">
                    @if (Model.Pagina > 1)
                    {
                        <a asp-action="Index" asp-all-route-data="Ruta(Model.Pagina - 1)" class="btn-erp-secondary btn-sm no-underline">Anterior</a>
                    }
                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a asp-action="Index" asp-all-route-data="Ruta(Model.Pagina + 1)" class="btn-erp-secondary btn-sm no-underline">Siguiente</a>
                    }
                </span>
            </nav>
        }
    }
</section>

<p class="mb-6 text-xs text-slate-500">
    Calculado al @Model.FechaCalculo.ToString("dd/MM/yyyy HH:mm", ar) UTC. Promedio móvil exacto cuando el Kardex concilia con el stock;
    si no, promedio de las últimas compras recibidas que componen el stock. Sin compras registradas no hay costo calculable.
</p>
