@model TheBuryProject.ViewModels.VentaViewModel
@using TheBuryProject.Models.Enums
@using TheBuryProject.Helpers
@{
    ViewData["Title"] = Model.Estado == EstadoVenta.Cotizacion ? "Nueva Cotización" : "Nueva Venta";
}

@* Vista fina: el cuerpo del wizard vive en el parcial compartido _VentaWizardForm,
   reutilizado por Create_tw y Edit_tw para garantizar paridad (Micro-lote 7). El
   modo (crear/editar) lo infiere el parcial de Model.Id. *@
@* El cotizador es el paso 1 del wizard (pestaña Cotizar): se embebe como parcial
   reutilizable (_CotizadorForm), no como vista completa de Cotización. El enlace de
   salida al listado de cotizaciones guardadas vive dentro del propio panel Cotizar. *@
<div id="venta-create-page" class="mx-auto flex min-h-[calc(100dvh-5rem)] w-full flex-col px-4 py-4 sm:px-6 lg:px-8"
     data-paso-activo="cotizar">
    <partial name="_VentaWizardForm" model="Model" />
</div>

@section Styles {
    <partial name="_VentaModuleStyles" />
    @* Ruta calificada, NO "_CreditoModuleStyles" a secas: esta vista vive en Views/Venta,
       así que Razor resolvería el nombre contra Views/Shared/_CreditoModuleStyles.cshtml
       (el de CreditoPersonal_tw, homónimo y sin relación) en vez de éste, que trae
       credito-module.css — el que realmente peina .card/.kv/.result-card/etc. del
       configurador embebido (mismo patrón que usa la vista de ConfiguracionContratoCredito). *@
    <partial name="~/Views/Credito/_CreditoModuleStyles.cshtml" />
    @* Estilos del cotizador embebido en el paso Cotizar. *@
    <link rel="stylesheet" href="~/css/cotizacion-simulador.css" asp-append-version="true" />
}

@section Scripts {
    @* Orden canónico: el wizard debe cargar ANTES que venta-create.js para que
       parsee el seed #venta-inicial-json a window.ventaInicial antes de que
       venta-create.js hidrate la edición. Idéntico en Create y Edit (Micro-lote 7).
       En Create el seed sólo aparece al re-renderizar por error (para no perder
       cliente y detalle ya cargados); en Edit está siempre. *@
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/venta-module.js" asp-append-version="true"></script>
    <script src="~/js/credito-module.js" asp-append-version="true"></script>
    <script src="~/js/venta-page-wizard.js" asp-append-version="true"></script>
    <script src="~/js/venta-create.js" asp-append-version="true"></script>
    @* Paso Envío: lee window.ventaInicial (ya sembrado por venta-page-wizard.js arriba)
       y escucha la selección de cliente que dispara venta-create.js. *@
    <script src="~/js/venta-envio.js" asp-append-version="true"></script>
    @* Configurador embebido del paso Crédito: configurar-venta-credito.js expone
       initConfigurarVentaCredito, que venta-credito-embebido.js llama tras inyectar el
       fragmento de /Credito/ConfigurarVenta?embedded=true. Debe cargar después de
       venta-create.js (usa window.ventaInicial) y antes de que el operador pueda
       llegar al paso Crédito. *@
    <script src="~/js/configurar-venta-credito.js" asp-append-version="true"></script>
    <script src="~/js/venta-credito-embebido.js" asp-append-version="true"></script>
    @* Cotizador del paso 1. -ui.js publica window.setQuoteState, que usa el simulador,
       así que debe cargar antes. Ambos abortan si no hay [data-cotizacion-simulador]. *@
    <script src="~/js/cotizacion-simulador-ui.js" asp-append-version="true"></script>
    <script src="~/js/cotizacion-simulador.js" asp-append-version="true"></script>
}
