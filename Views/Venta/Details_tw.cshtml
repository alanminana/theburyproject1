@model VentaViewModel
@using TheBuryProject.Models.Enums
@{
    ViewData["Title"] = $"Venta {Model.Numero}";
    var detalles = Model.Detalles ?? new List<VentaDetalleViewModel>();
    var facturas = Model.Facturas ?? new List<FacturaViewModel>();
    var tieneFactura = facturas.Any(f => !f.Anulada);
    var facturaActiva = facturas.FirstOrDefault(f => !f.Anulada);
    var contratoVentaCredito = ViewBag.ContratoVentaCredito as ContratoVentaCreditoResumenViewModel;
    // VENTA-DETAILS-DUPLICACION-01 (H11): columnas "Descuento"/"Desc. gral." sólo aportan
    // cuando alguna línea realmente tiene descuento — si no, son dos columnas vacías ("—"/"-")
    // repetidas en cada fila. Se ocultan juntas (mismo criterio) sin tocar Model.Descuento ni
    // el resumen de totales, que sigue mostrando el descuento global de la venta si existe.
    var hayDescuentosEnDetalle = detalles.Any(d => d.Descuento > 0 || d.DescuentoGeneralProrrateado > 0);

    // Status badge mapping (Tailwind)
    string estadoBg = Model.Estado switch
    {
        EstadoVenta.Cotizacion          => "bg-slate-500/10 text-slate-400 border-slate-500/20",
        EstadoVenta.Presupuesto         => "bg-blue-500/10 text-blue-400 border-blue-500/20",
        EstadoVenta.Confirmada          => "bg-primary/10 text-primary border-primary/20",
        EstadoVenta.Facturada           => "bg-green-500/10 text-green-400 border-green-500/20",
        EstadoVenta.Entregada           => "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
        EstadoVenta.Cancelada           => "bg-red-500/10 text-red-400 border-red-500/20",
        EstadoVenta.PendienteRequisitos => "bg-amber-500/10 text-amber-400 border-amber-500/20",
        EstadoVenta.PendienteFinanciacion => "bg-orange-500/10 text-orange-400 border-orange-500/20",
        _                               => "bg-slate-500/10 text-slate-400 border-slate-500/20"
    };

    string tipoPagoDisplay = Model.TipoPago switch
    {
        TipoPago.Efectivo        => "Efectivo",
        TipoPago.Transferencia   => "Transferencia",
        TipoPago.TarjetaDebito   => "Tarjeta Débito",
        TipoPago.TarjetaCredito  => "Tarjeta Crédito",
        TipoPago.Cheque          => "Cheque",
        TipoPago.CreditoPersonal => "Crédito Personal",
        TipoPago.MercadoPago     => "Mercado Pago",
        TipoPago.CuentaCorriente => "Cuenta Corriente",
        _                        => Model.TipoPago.ToString()
    };

    string tipoPagoIcon = Model.TipoPago switch
    {
        TipoPago.Efectivo        => "payments",
        TipoPago.Transferencia   => "swap_horiz",
        TipoPago.TarjetaDebito   => "credit_card",
        TipoPago.TarjetaCredito  => "credit_card",
        TipoPago.Cheque          => "description",
        TipoPago.CreditoPersonal => "account_balance",
        TipoPago.MercadoPago     => "phone_iphone",
        TipoPago.CuentaCorriente => "account_balance_wallet",
        _                        => "payment"
    };

    var puedeCrearDevoluciones = User.TienePermiso("devoluciones", "create");
    var puedeVerCreditos = User.TienePermiso("creditos", "view");
    var puedeActualizarVentas = User.TienePermiso("ventas", "update");
    var puedeAutorizarVentas = User.TienePermiso("ventas", "authorize");
    var puedeRechazarVentas = User.TienePermiso("ventas", "reject");
    var puedeFacturarVentas = User.TienePermiso("ventas", "invoice");
    var puedeCancelarVentas = User.TienePermiso("ventas", "cancel");
    var puedeOperarVentas = (bool?)ViewBag.PuedeOperarVentas ?? false;
    var recargoDebitoAplicado = Model.RecargoDebitoAplicado;
    var datosTarjeta = Model.DatosTarjeta;
    var ajustePlanMonto = datosTarjeta?.MontoAjustePagoAplicado ?? datosTarjeta?.MontoAjustePlanAplicado;
    var ajustePlanPct = datosTarjeta?.PorcentajeAjustePagoAplicado ?? datosTarjeta?.PorcentajeAjustePlanAplicado;
    var nombrePlanPago = datosTarjeta?.NombrePlanPagoSnapshot;
    var cuotasPlanPago = datosTarjeta?.CantidadCuotas;
    var heroDescripcion = Model.Estado switch
    {
        EstadoVenta.Presupuesto => "Revisá el detalle, completá la configuración pendiente y prepará la aprobación o confirmación final.",
        EstadoVenta.Confirmada => "Supervisá el estado de la operación, la facturación y los movimientos asociados desde una sola vista.",
        EstadoVenta.Facturada => "Controlá productos, factura emitida y devoluciones disponibles sin salir del detalle.",
        EstadoVenta.Entregada => "Consultá el historial completo de la venta y los documentos vinculados a la entrega.",
        EstadoVenta.PendienteFinanciacion => "Verificá el detalle, configurá la financiación y resolvé pendientes operativos antes de cerrar la venta.",
        EstadoVenta.PendienteRequisitos => "Comprobá documentos y acciones necesarias para dejar la operación lista para confirmar.",
        EstadoVenta.Cancelada => "Auditá el detalle, el motivo y el historial de la operación cancelada.",
        _ => "Consultá el detalle, la cobranza y las acciones disponibles sobre la operación actual."
    };
    // VENTA-ENVIO-TOTAL-01: el envío se cobra pero no integra el comprobante (Venta.TotalFacturable
    // = Venta.Total). Sólo se separa visualmente cuando hay un importe de envío real (> 0).
    var tieneEnvioACobrar = Model.ImporteEnvio > 0m;
    var facturacionResumen = tieneFactura
        ? facturaActiva?.Numero ?? "Factura emitida"
        : "Sin factura emitida";
    var facturacionDetalle = tieneFactura
        ? (Model.FechaFacturacion.HasValue
            ? $"Emitida el {Model.FechaFacturacion.Value:dd/MM/yyyy HH:mm}"
            : "Documento activo asociado")
        : Model.Estado switch
        {
            EstadoVenta.Cotizacion => "Prepará la venta y confirmala para habilitar facturación.",
            EstadoVenta.Presupuesto => "Confirmá la venta para habilitar facturación.",
            EstadoVenta.Confirmada => "Venta confirmada; ya podés emitir la factura desde Acciones.",
            EstadoVenta.PendienteRequisitos => "Resolvé los requisitos y confirmá la venta para facturar.",
            EstadoVenta.PendienteFinanciacion => "Configurá la financiación y confirmá la venta para facturar.",
            _ => "Se habilita cuando la venta está lista para facturar."
        };
}

<div id="venta-details-page" class="w-full py-4">
    @* VENTA-DETAILS-GEOMETRIA-01: converge al mismo criterio de ancho fluido que
       #venta-index-rework (ventas-index.css) y .shell.cliente-details
       (cliente-module.css) — el gutter lateral real ya lo aporta el padding
       responsive de _Layout.cshtml (px-4/sm:px-6/lg:px-8); un max-width propio
       + padding propio encima duplicaba el gutter y angostaba el contenido a
       1280px centrado (medido: ~160px de margen muerto por lado a 1920px,
       mientras Venta/Index y Cliente/Details usan el ancho fluido completo). *@
    <div class="space-y-4">

        <!-- TempData Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="toast-msg flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400" role="status">
                <span class="material-symbols-outlined">check_circle</span>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast-msg flex items-center gap-3 rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400" role="alert">
                <span class="material-symbols-outlined">error</span>
                @TempData["Error"]
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="toast-msg flex items-center gap-3 rounded-xl border border-amber-500/20 bg-amber-500/10 p-4 text-sm font-semibold text-amber-400" role="status">
                <span class="material-symbols-outlined">warning</span>
                @TempData["Warning"]
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="toast-msg flex items-center gap-3 rounded-xl border border-sky-500/20 bg-sky-500/10 p-4 text-sm font-semibold text-sky-400" role="status">
                <span class="material-symbols-outlined">info</span>
                @TempData["Info"]
            </div>
        }
        @if (ViewBag.PrimeraCuotaHoyCuotaId != null && User.TienePermiso("cobranzas", "payinstallment"))
        {
            <div class="flex flex-col gap-3 rounded-xl border border-sky-500/20 bg-sky-500/10 p-4 text-sm font-semibold text-sky-300 sm:flex-row sm:items-center sm:justify-between" role="status" data-venta-primera-cuota-hoy>
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined">payments</span>
                    <span>La 1ª cuota del crédito sigue pendiente y vence hoy. Podés cobrarla ahora.</span>
                </div>
                <a asp-controller="Credito"
                   asp-action="PagarCuota"
                   asp-route-id="@ViewBag.PrimeraCuotaHoyCuotaId"
                   asp-route-returnUrl="@Url.Action("Details", "Venta", new { id = Model.Id })"
                   class="inline-flex items-center gap-2 rounded-lg bg-sky-500/20 border border-sky-500/40 px-4 py-2 text-sky-200 hover:bg-sky-500/30 shrink-0">
                    <span class="material-symbols-outlined text-[18px]">point_of_sale</span>
                    Cobrar primera cuota
                </a>
            </div>
        }
        @if (!puedeOperarVentas)
        {
            <div class="p-4 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 text-sm font-bold flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-sm mt-0.5">warning</span>
                    <div>
                        <p>Sin caja abierta a su nombre.</p>
                        <p class="mt-1 font-medium text-amber-200/80">Abra una caja para habilitar confirmación, facturación, edición, cancelación y devoluciones.</p>
                    </div>
                </div>
                <a asp-controller="Caja" asp-action="Abrir"
                   class="btn-erp-warning btn-sm shrink-0 no-underline">
                    <span class="material-symbols-outlined text-[16px]">lock_open</span>
                    Abrir caja
                </a>
            </div>
        }

        <section class="hero-erp sm:p-8">
            <div class="venta-hero-row flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
                <div class="space-y-3">
                    <div class="venta-hero-crumbs flex flex-wrap items-center gap-2 text-xs font-semibold">
                        <span class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1 text-slate-300">Ventas</span>
                        <span class="text-slate-600">/</span>
                        <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-primary">@Model.Numero</span>
                    </div>
                    <div class="venta-hero-title space-y-2">
                        <div class="flex flex-wrap items-center gap-3">
                            <h1 class="text-2xl font-black tracking-tight text-white sm:text-3xl">@Model.Numero</h1>
                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-[10px] font-black uppercase tracking-widest @estadoBg">@Model.EstadoDisplay</span>
                        </div>
                        <p class="max-w-3xl text-sm text-slate-400 sm:text-base">@heroDescripcion</p>
                    </div>
                    <div class="venta-hero-meta flex flex-wrap gap-2 text-xs font-medium">
                        <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-primary">
                            <span class="material-symbols-outlined text-sm">payments</span>
                            @tipoPagoDisplay
                        </span>
                        <span class="inline-flex items-center gap-2 venta-info-pill">
                            <span class="material-symbols-outlined text-sm">schedule</span>
                            @Model.FechaVenta.ToString("dd/MM/yyyy HH:mm")
                        </span>
                        @* VENTA-DETAILS-DUPLICACION-03 (H13): el chip de factura repetía el
                           mismo número que la tarjeta "Facturación" de la grilla, un instante
                           después y sin scroll de por medio — esa tarjeta ya tiene más contexto
                           (fecha de emisión). El estado "Facturada" del badge de arriba ya cubre
                           la señal de "hay factura" a nivel chip. *@
                    </div>
                </div>

                <div class="venta-hero-actions flex w-full flex-col gap-3 sm:flex-row xl:w-auto xl:min-w-60 xl:flex-col">
                    <a asp-action="Index" class="btn-erp-ghost xl:w-full no-underline">
                        Volver a Ventas
                    </a>
                    <button type="button"
                            data-venta-action="print"
                            class="btn-erp-secondary xl:w-full">
                        <span class="material-symbols-outlined text-sm">print</span>
                        Imprimir
                    </button>
                </div>
            </div>

            <div class="venta-hero-kpis mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
                <article class="card-erp-metric">
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Cliente</p>
                    <p class="mt-3 text-sm font-bold text-white">@Model.ClienteNombre</p>
                    <p class="mt-1 text-xs text-slate-400">@(string.IsNullOrWhiteSpace(Model.ClienteDocumento) ? "Sin documento registrado." : Model.ClienteDocumento)</p>
                </article>
                @* VENTA-ENVIO-TOTAL-01: con envío, el resumen superior separa Productos / Envío y
                   deja TOTAL A COBRAR como cifra dominante (Venta.TotalACobrar, calculado en backend);
                   sin envío se conserva el "Total" de siempre. *@
                @if (tieneEnvioACobrar)
                {
                    <article id="venta-resumen-total-a-cobrar" class="card-erp-metric-info">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-sky-400">Total a cobrar</p>
                        <p id="venta-total-a-cobrar" class="mt-2 text-xl font-black text-sky-200">@Model.TotalACobrar.ToString("C2")</p>
                        <dl class="mt-2 space-y-0.5 text-xs text-sky-400/90">
                            <div class="flex justify-between gap-3"><dt>Productos</dt><dd id="venta-total-productos" class="font-semibold text-sky-300">@Model.Total.ToString("C2")</dd></div>
                            <div class="flex justify-between gap-3"><dt>Envío</dt><dd id="venta-importe-envio" class="font-semibold text-sky-300">@Model.ImporteEnvio.ToString("C2")</dd></div>
                        </dl>
                        @if (Model.TipoPago == TipoPago.CreditoPersonal || Model.TipoPago == TipoPago.CuentaCorriente)
                        {
                            <p id="venta-envio-no-financiado" class="mt-2 text-[11px] text-sky-400/80">El envío no se financia: se cobra aparte del crédito.</p>
                        }
                    </article>
                }
                else
                {
                    <article class="card-erp-metric-info">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-sky-400">Total</p>
                        <p class="mt-3 text-sm font-bold text-sky-300">@Model.Total.ToString("C2")</p>
                        <p class="mt-1 text-xs text-sky-400/80">Incluye IVA y descuentos aplicados a la venta.</p>
                    </article>
                }
                <article class="@(tieneFactura ? "card-erp-metric-success" : "card-erp-metric")">
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] @(tieneFactura ? "text-emerald-400" : "text-slate-400")">Facturación</p>
                    <p class="mt-3 text-sm font-bold @(tieneFactura ? "text-emerald-300" : "text-white")">@facturacionResumen</p>
                    <p class="mt-1 text-xs @(tieneFactura ? "text-emerald-400/80" : "text-slate-400")">@facturacionDetalle</p>
                    @if (tieneEnvioACobrar)
                    {
                        <p id="venta-comprobante-nota" class="mt-2 text-[11px] @(tieneFactura ? "text-emerald-300/80" : "text-slate-400")">
                            Comprobante: @Model.TotalFacturable.ToString("C2") · el envío (@Model.ImporteEnvio.ToString("C2")) se cobra aparte y no integra el comprobante.
                        </p>
                    }
                </article>
            </div>
        </section>

        <!-- Main Grid -->
        @* VENTA-DETAILS-GEOMETRIA-01: mismo patrón main+aside ya usado en
           Venta/Autorizar_tw.cshtml y Venta/Cancelar_tw.cshtml
           (minmax(0,1.65fr)_minmax(18rem,1fr)) en vez de grid-cols-3/col-span-2
           fijo — converge al lenguaje visual del propio módulo Venta y evita
           que la tabla fuerce un blowout del grid (minmax(0,…) + min-w-0). *@
        <div class="venta-details-grid grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.65fr)_minmax(18rem,1fr)] lg:items-start">

            <!-- Left Column: Details -->
            <div class="min-w-0 space-y-4">

                <!-- Sale Info Card -->
                <section class="card-erp-panel-padded">
                    <div class="mb-6 flex flex-col gap-3 border-b border-slate-800 pb-4 sm:flex-row sm:items-start sm:justify-between">
                        <div class="flex items-start gap-2">
                            <span class="material-symbols-outlined mt-0.5 text-primary">receipt_long</span>
                            <div>
                                <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Resumen</p>
                                <h2 class="mt-1 text-xl font-bold text-white">Información de la venta</h2>
                                <p class="mt-1 text-sm text-slate-400">Datos principales de la operación, del cliente y de la forma de cobro elegida.</p>
                            </div>
                        </div>
                        @* VENTA-DETAILS-DUPLICACION-03 (H13): el badge de forma de pago acá
                           repetía el mismo ícono+texto que el campo "Forma de Pago" dos
                           renglones abajo, dentro de la misma tarjeta — sin aportar nada que el
                           campo no dijera ya. *@
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Cliente</p>
                            <p class="text-sm font-bold text-white">@Model.ClienteNombre</p>
                            @if (!string.IsNullOrEmpty(Model.ClienteDocumento))
                            {
                                <p class="text-[11px] text-slate-400">@Model.ClienteDocumento</p>
                            }
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Forma de Pago</p>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-primary text-sm">@tipoPagoIcon</span>
                                <p class="text-sm font-bold text-white">@tipoPagoDisplay</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(nombrePlanPago) || cuotasPlanPago.HasValue)
                            {
                                var planPagoLabel = !string.IsNullOrWhiteSpace(nombrePlanPago)
                                    ? nombrePlanPago
                                    : cuotasPlanPago == 1 ? "1 pago" : $"{cuotasPlanPago} cuotas";
                                <p class="mt-1 text-[11px] text-slate-400">@planPagoLabel</p>
                            }
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Vendedor</p>
                            <p class="text-sm font-bold text-white">@(Model.VendedorNombre ?? "—")</p>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Fecha</p>
                            <p class="text-sm font-bold text-white">@Model.FechaVenta.ToString("dd/MM/yyyy")</p>
                            <p class="text-[11px] text-slate-400">@Model.FechaVenta.ToString("HH:mm") hs</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        <div class="mt-4 p-3 bg-slate-800/50 rounded-lg">
                            <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Observaciones</p>
                            <p class="text-xs text-slate-400">@Model.Observaciones</p>
                        </div>
                    }
                </section>

                <!-- Line Items Table -->
                <section class="card-erp-panel">
                    <div class="flex flex-col gap-3 border-b border-slate-800 p-6 sm:flex-row sm:items-start sm:justify-between">
                        <div class="flex items-start gap-2">
                            <span class="material-symbols-outlined mt-0.5 text-primary">inventory_2</span>
                            <div>
                                <h2 class="text-xl font-bold text-white">Detalle de productos</h2>
                                <p class="mt-1 text-sm text-slate-400">Revisá cantidades, descuentos y subtotales completos antes de imprimir o facturar.</p>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-2 self-start rounded-full badge-erp badge-erp-neutral">
                            <span class="material-symbols-outlined text-sm">shopping_bag</span>
                            @detalles.Count @(detalles.Count == 1 ? "ítem" : "ítems")
                        </span>
                    </div>
                    <div id="venta-details-scroll" data-oc-scroll style="--oc-scroll-min-width: 36rem;">
                        <p data-oc-scroll-hint hidden class="px-6 pt-4 text-xs font-medium text-slate-400">
                            Deslizá la tabla para revisar importes, descuentos y subtotales completos.
                        </p>
                        <div data-oc-scroll-shell class="px-0 pb-0">
                            <div data-oc-scroll-fade="left" hidden></div>
                            <div data-oc-scroll-fade="right" hidden></div>
                            <div data-oc-scroll-region tabindex="0" role="region" aria-label="Detalle de productos de la venta">
                                <table data-erp-cards data-oc-scroll-table class="w-full text-sm">
                                    <thead>
                                        <tr class="bg-slate-800/50 text-[10px] font-black uppercase tracking-wider text-slate-500">
                                            <th data-card="title" class="px-6 py-3 text-left">Producto</th>
                                            <th data-card="half" class="px-4 py-3 text-center">Cant.</th>
                                            <th data-card="half" class="px-4 py-3 text-right">Precio Unit.</th>
                                            @if (hayDescuentosEnDetalle)
                                            {
                                                <th data-card="half" class="px-4 py-3 text-right">Descuento</th>
                                                <th data-card="half" class="px-4 py-3 text-right">Desc. gral.</th>
                                            }
                                            <th data-card="half" class="px-4 py-3 text-right">IVA</th>
                                            <th data-card="half" class="px-4 py-3 text-right">Neto</th>
                                            <th data-card="half" class="px-4 py-3 text-right">IVA línea</th>
                                            <th data-card="half" class="px-6 py-3 text-right">Subtotal final</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-800">
                                        @foreach (var item in detalles)
                                        {
                                            var usaSnapshotsFinales = item.SubtotalFinal != 0m
                                                || item.SubtotalFinalNeto != 0m
                                                || item.SubtotalFinalIVA != 0m
                                                || item.DescuentoGeneralProrrateado != 0m;
                                            var subtotalNetoLinea = usaSnapshotsFinales ? item.SubtotalFinalNeto : item.SubtotalNeto;
                                            var subtotalIVALinea = usaSnapshotsFinales ? item.SubtotalFinalIVA : item.SubtotalIVA;
                                            var subtotalLinea = usaSnapshotsFinales ? item.SubtotalFinal : item.Subtotal;
                                            var efectivoPagoItem = item.TipoPago ?? Model.TipoPago;
                                            var tieneAjustePlanItem = item.ProductoCondicionPagoPlanId.HasValue
                                                && item.MontoAjustePlanAplicado.HasValue
                                                && efectivoPagoItem != TipoPago.CreditoPersonal;
                                            var itemTipoPagoLabel = item.TipoPago switch
                                            {
                                                TipoPago.Efectivo        => "Efectivo",
                                                TipoPago.Transferencia   => "Transferencia",
                                                TipoPago.TarjetaDebito   => "Tarjeta Débito",
                                                TipoPago.TarjetaCredito  => "Tarjeta Crédito",
                                                TipoPago.Cheque          => "Cheque",
                                                TipoPago.CreditoPersonal => "Crédito Personal",
                                                TipoPago.MercadoPago     => "Mercado Pago",
                                                TipoPago.CuentaCorriente => "Cuenta Corriente",
                                                null                     => null,
                                                _                        => item.TipoPago?.ToString()
                                            };
                                            <tr class="transition-colors hover:bg-slate-800/30">
                                                <td class="px-6 py-4">
                                                    <p class="font-bold text-white">@item.ProductoNombre</p>
                                                    <p class="text-[11px] text-slate-400">@item.ProductoCodigo</p>
                                                    <div class="mt-1.5 flex flex-wrap gap-1">
                                                        @if (item.TipoPago.HasValue)
                                                        {
                                                            <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-semibold bg-slate-700/60 text-slate-300 forma-pago-item">
                                                                Excepción: @itemTipoPagoLabel
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-semibold bg-slate-800/60 text-slate-500 forma-pago-item hereda-pago-principal">
                                                                Usa pago principal
                                                            </span>
                                                        }
                                                        @if (tieneAjustePlanItem)
                                                        {
                                                            var esRecargoPlanItem   = item.MontoAjustePlanAplicado!.Value > 0;
                                                            var esDescuentoPlanItem = item.MontoAjustePlanAplicado!.Value < 0;
                                                            var labelAjustePlanItem = esRecargoPlanItem   ? "Recargo por plan"
                                                                                    : esDescuentoPlanItem ? "Descuento por plan"
                                                                                    : "Plan sin ajuste";
                                                            var colorAjustePlanItem = esRecargoPlanItem   ? "bg-amber-500/10 text-amber-300"
                                                                                    : esDescuentoPlanItem ? "bg-red-500/10 text-red-400"
                                                                                    : "bg-slate-700/60 text-slate-400";
                                                            var pctSufijoItem = item.PorcentajeAjustePlanAplicado.HasValue
                                                                ? $" ({(item.PorcentajeAjustePlanAplicado.Value > 0 ? "+" : "")}{item.PorcentajeAjustePlanAplicado.Value:0.##}%)"
                                                                : "";
                                                            <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-semibold @colorAjustePlanItem ajuste-plan-item">
                                                                @labelAjustePlanItem@pctSufijoItem
                                                            </span>
                                                            <span class="text-[10px] font-bold @(esRecargoPlanItem ? "text-amber-300" : esDescuentoPlanItem ? "text-red-400" : "text-slate-400") monto-ajuste-plan-item">
                                                                @item.MontoAjustePlanAplicado!.Value.ToString("C2")
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="px-4 py-4 text-center font-medium">@item.Cantidad</td>
                                                <td class="px-4 py-4 text-right text-slate-300">@item.PrecioUnitario.ToString("C2")</td>
                                                @if (hayDescuentosEnDetalle)
                                                {
                                                    <td class="px-4 py-4 text-right">
                                                        @if (item.Descuento > 0)
                                                        {
                                                            <span class="text-red-500">-@item.Descuento.ToString("C2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-400">—</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-4 text-right">
                                                        @if (item.DescuentoGeneralProrrateado > 0)
                                                        {
                                                            <span class="text-red-500">-@item.DescuentoGeneralProrrateado.ToString("C2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-400">-</span>
                                                        }
                                                    </td>
                                                }
                                                <td class="px-4 py-4 text-right text-slate-300">@item.PorcentajeIVA.ToString("0.##")%</td>
                                                <td class="px-4 py-4 text-right text-slate-300">@subtotalNetoLinea.ToString("C2")</td>
                                                <td class="px-4 py-4 text-right text-slate-300">@subtotalIVALinea.ToString("C2")</td>
                                                <td class="px-6 py-4 text-right font-bold text-white">@subtotalLinea.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen agrupado por forma de pago con plan -->
                    @{
                        var gruposAjustePlan = detalles
                            .Where(d => d.ProductoCondicionPagoPlanId.HasValue
                                && d.MontoAjustePlanAplicado.HasValue
                                && (d.TipoPago ?? Model.TipoPago) != TipoPago.CreditoPersonal)
                            .GroupBy(d => new
                            {
                                TipoPago = d.TipoPago ?? Model.TipoPago,
                                d.ProductoCondicionPagoPlanId,
                                d.PorcentajeAjustePlanAplicado
                            })
                            .ToList();
                    }
                    @if (gruposAjustePlan.Any())
                    {
                        <div id="resumen-ajuste-por-grupo" class="border-t border-slate-800 px-6 py-4">
                            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-3">Desglose por forma de pago</p>
                            <div class="space-y-2">
                                @foreach (var grp in gruposAjustePlan)
                                {
                                    var grpTipoPagoLabel = grp.Key.TipoPago switch
                                    {
                                        TipoPago.Efectivo        => "Efectivo",
                                        TipoPago.Transferencia   => "Transferencia",
                                        TipoPago.TarjetaDebito   => "Tarjeta Débito",
                                        TipoPago.TarjetaCredito  => "Tarjeta Crédito",
                                        TipoPago.Cheque          => "Cheque",
                                        TipoPago.MercadoPago     => "Mercado Pago",
                                        TipoPago.CuentaCorriente => "Cuenta Corriente",
                                        _                        => grp.Key.TipoPago.ToString()
                                    };
                                    var grpSubtotal = grp.Sum(d => d.SubtotalFinal);
                                    var grpAjuste   = grp.Sum(d => d.MontoAjustePlanAplicado ?? 0m);
                                    var grpTotal    = grpSubtotal + grpAjuste;
                                    var grpPct      = grp.Key.PorcentajeAjustePlanAplicado;
                                    var grpEsRecargo  = grpAjuste > 0;
                                    var grpEsDescuento = grpAjuste < 0;
                                    var grpColorAjuste = grpEsRecargo ? "text-amber-300" : grpEsDescuento ? "text-red-400" : "text-slate-400";
                                    var grpPctLabel = grpPct.HasValue
                                        ? $" ({(grpPct.Value > 0 ? "+" : "")}{grpPct.Value:0.##}%)"
                                        : "";
                                    <div class="flex flex-col gap-1 rounded-lg bg-slate-800/40 px-4 py-2.5 text-xs">
                                        <div class="flex items-center justify-between">
                                            <span class="font-semibold text-slate-300">@grpTipoPagoLabel@grpPctLabel</span>
                                            <span class="font-bold text-white">@grpTotal.ToString("C2")</span>
                                        </div>
                                        <div class="flex items-center justify-between text-slate-500">
                                            <span>Subtotal grupo</span>
                                            <span>@grpSubtotal.ToString("C2")</span>
                                        </div>
                                        @if (grpAjuste != 0m)
                                        {
                                            <div class="flex items-center justify-between">
                                                <span class="text-slate-500">Ajuste plan</span>
                                                <span class="@grpColorAjuste">@(grpEsRecargo ? "+" : "")@grpAjuste.ToString("C2")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Totals row -->
                    <div class="p-6 bg-slate-800/30 border-t border-slate-800">
                        <div class="flex flex-col items-end gap-2">
                            <div class="flex justify-between w-64 text-sm">
                                <span class="text-slate-500">Subtotal</span>
                                <span class="font-medium text-slate-300">@Model.Subtotal.ToString("C2")</span>
                            </div>
                            @if (Model.Descuento > 0)
                            {
                                <div class="flex justify-between w-64 text-sm">
                                    <span class="text-slate-500">Descuento</span>
                                    <span class="font-medium text-red-500">-@Model.Descuento.ToString("C2")</span>
                                </div>
                            }
                            <div class="flex justify-between w-64 text-sm">
                                <span class="text-slate-500">IVA</span>
                                <span class="font-medium text-slate-300">@Model.IVA.ToString("C2")</span>
                            </div>
                            @if (recargoDebitoAplicado > 0)
                            {
                                <div class="flex justify-between w-64 text-sm">
                                    <span class="text-slate-500">Recargo d&eacute;bito</span>
                                    <span class="font-medium text-amber-300">@recargoDebitoAplicado.ToString("C2")</span>
                                </div>
                            }
                            @if (ajustePlanMonto.HasValue)
                            {
                                var esRecargoPlan = ajustePlanMonto.Value > 0;
                                var esDescuentoPlan = ajustePlanMonto.Value < 0;
                                var labelPlan = esRecargoPlan ? "Recargo por plan" : esDescuentoPlan ? "Descuento por plan" : "Ajuste por plan";
                                var colorPlan = esRecargoPlan ? "text-amber-300" : esDescuentoPlan ? "text-red-500" : "text-slate-400";
                                var sufijoPct = ajustePlanPct.HasValue ? $" ({(ajustePlanPct.Value > 0 ? "+" : "")}{ajustePlanPct.Value:0.##}%)" : "";
                                <div class="flex justify-between w-64 text-sm">
                                    <span class="text-slate-500">@labelPlan@sufijoPct</span>
                                    <span class="font-medium @colorPlan">@ajustePlanMonto.Value.ToString("C2")</span>
                                </div>
                            }
                            @if (tieneEnvioACobrar)
                            {
                                @* Productos y envío quedan como líneas separadas; TOTAL A COBRAR es la
                                   cifra dominante y no se mezcla con IVA ni con el total del comprobante. *@
                                <div class="flex justify-between w-64 text-sm pt-2 border-t border-slate-700">
                                    <span class="text-slate-400">Total productos</span>
                                    <span id="venta-totales-productos" class="font-semibold text-slate-200">@Model.Total.ToString("C2")</span>
                                </div>
                                <div class="flex justify-between w-64 text-sm">
                                    <span class="text-slate-400">Envío</span>
                                    <span id="venta-totales-envio" class="font-semibold text-slate-200">@Model.ImporteEnvio.ToString("C2")</span>
                                </div>
                                <div class="flex justify-between w-64 text-lg pt-2 border-t border-slate-700">
                                    <span class="font-bold text-white">Total a cobrar</span>
                                    <span id="venta-totales-a-cobrar" class="font-black text-primary">@Model.TotalACobrar.ToString("C2")</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex justify-between w-64 text-lg pt-2 border-t border-slate-700">
                                    <span class="font-bold text-white">Total</span>
                                    <span class="font-black text-primary">@Model.Total.ToString("C2")</span>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <!-- Credit Info (if CreditoPersonal) -->
                @if (Model.TipoPago == TipoPago.CreditoPersonal && Model.CreditoId.HasValue)
                {
                    <section class="card-erp-panel-padded">
                        <div class="flex items-center gap-2 mb-6 border-b border-slate-800 pb-3">
                            <span class="material-symbols-outlined text-primary">account_balance</span>
                            <h2 class="text-white text-xl font-bold">Crédito Personal</h2>
                            @if (Model.CreditoConfigurado)
                            {
                                <span class="ml-auto px-2 py-0.5 rounded text-[10px] font-black bg-green-500/10 text-green-400 uppercase">Configurado</span>
                            }
                            else if (Model.CreditoPendienteConfiguracion)
                            {
                                <span class="ml-auto px-2 py-0.5 rounded text-[10px] font-black bg-orange-500/10 text-orange-400 uppercase">Pendiente</span>
                            }
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div class="px-3 py-2 bg-primary/5 rounded-lg">
                                <p class="text-[10px] text-primary font-bold uppercase">Crédito Nº</p>
                                <p class="text-sm font-bold text-white">@(Model.CreditoNumero ?? "—")</p>
                            </div>
                            @if (Model.DatosCreditoPersonall != null)
                            {
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Monto Financiado</p>
                                    <p class="text-sm font-bold text-white">@Model.DatosCreditoPersonall.MontoAFinanciar.ToString("C2")</p>
                                </div>
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Cuotas</p>
                                    @if (Model.DatosCreditoPersonall.MontoCuotaDisponible)
                                    {
                                        <p class="text-sm font-bold text-white">@Model.DatosCreditoPersonall.CantidadCuotas x @Model.DatosCreditoPersonall.MontoCuota.ToString("C2")</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm font-bold text-white">@Model.DatosCreditoPersonall.CantidadCuotas cuota(s) <span class="font-normal text-slate-500">(monto a confirmar)</span></p>
                                    }
                                </div>
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Tasa Mensual</p>
                                    <p class="text-sm font-bold text-white">@Model.DatosCreditoPersonall.TasaInteresMensual.ToString("F2")%</p>
                                </div>
                            }
                            else
                            {
                                <div class="venta-stat col-span-3">
                                    <p class="text-xs text-slate-500 italic">Datos del crédito pendientes de configuración.</p>
                                </div>
                            }
                        </div>
                    </section>

                    @if (contratoVentaCredito != null)
                    {
                        <section class="card-erp-panel-padded">
                            <div class="mb-6 flex flex-col gap-3 border-b border-slate-800 pb-4 sm:flex-row sm:items-start sm:justify-between">
                                <div class="flex items-start gap-2">
                                    <span class="material-symbols-outlined mt-0.5 text-emerald-400">contract</span>
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-400">Contrato generado</p>
                                        <h2 class="mt-1 text-xl font-bold text-white">Documentación contractual</h2>
                                        <p class="mt-1 text-sm text-slate-400">Contrato y pagaré asociados a esta venta.</p>
                                    </div>
                                </div>
                                <span class="inline-flex items-center gap-2 self-start rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-300">
                                    <span class="material-symbols-outlined text-sm">check_circle</span>
                                    @contratoVentaCredito.EstadoDocumento
                                </span>
                            </div>
                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Contrato Nº</p>
                                    <p class="text-sm font-bold text-white">@contratoVentaCredito.NumeroContrato</p>
                                </div>
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Pagaré Nº</p>
                                    <p class="text-sm font-bold text-white">@contratoVentaCredito.NumeroPagare</p>
                                </div>
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Generación</p>
                                    <p class="text-sm font-bold text-white">@contratoVentaCredito.FechaGeneracionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Usuario</p>
                                    <p class="text-sm font-bold text-white">@contratoVentaCredito.UsuarioGeneracion</p>
                                </div>
                            </div>
                            @* VENTA-DETAILS-DUPLICACION-02 (H12): el CTA "Ver contrato" vive
                               solo en Acciones (única autoridad de qué mostrar, ver arriba) —
                               esta card queda informativa, mismo patrón que Facturación, que
                               tampoco repite "Imprimir Factura" dentro de su propia sección. *@
                            <p class="mt-5 text-xs text-slate-500">
                                @(string.IsNullOrWhiteSpace(contratoVentaCredito.NombreArchivo) ? "PDF contractual generado." : contratoVentaCredito.NombreArchivo)
                            </p>
                        </section>
                    }
                }

                <!-- Invoice Section (if facturada) -->
                @if (facturas.Any())
                {
                    <section class="card-erp-panel-padded">
                        <div class="flex items-center gap-2 mb-6 border-b border-slate-800 pb-3">
                            <span class="material-symbols-outlined text-primary">description</span>
                            <h2 class="text-white text-xl font-bold">Facturación</h2>
                        </div>
                        <div class="space-y-3">
                            @foreach (var factura in facturas)
                            {
                                <div class="flex items-center justify-between p-4 rounded-lg border @(factura.Anulada ? "bg-red-500/5 border-red-500/20" : "bg-green-500/5 border-green-500/20")">
                                    <div class="flex items-center gap-4">
                                        <div class="size-10 rounded-lg @(factura.Anulada ? "bg-red-500/10" : "bg-green-500/10") flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm @(factura.Anulada ? "text-red-500" : "text-green-500")">
                                                @(factura.Anulada ? "cancel" : "check_circle")
                                            </span>
                                        </div>
                                        <div>
                                            <p class="text-sm font-bold text-white">@(string.IsNullOrEmpty(factura.Numero) ? "Factura" : factura.Numero)</p>
                                            <p class="text-[11px] text-slate-400">
                                                Tipo @factura.Tipo · @factura.FechaEmision.ToString("dd/MM/yyyy")
                                                @if (factura.Anulada)
                                                {
                                                    <span class="text-red-500 font-bold"> · ANULADA @(factura.FechaAnulacion?.ToString("dd/MM/yyyy"))</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-black @(factura.Anulada ? "text-red-500 line-through" : "text-white")">@factura.Total.ToString("C2")</p>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (tieneFactura && Model.ResumenAlicuotasFactura.Any())
                        {
                            <div class="mt-5 overflow-x-auto rounded-lg border border-slate-800">
                                <p class="border-b border-slate-800 px-4 py-3 text-xs font-semibold text-slate-400">
                                    El resumen por al&iacute;cuotas corresponde s&oacute;lo a productos.
                                </p>
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="bg-slate-800/50 text-[10px] font-black uppercase tracking-wider text-slate-500">
                                            <th class="px-4 py-3 text-left">Al&iacute;cuota</th>
                                            <th class="px-4 py-3 text-right">Base imponible</th>
                                            <th class="px-4 py-3 text-right">IVA</th>
                                            <th class="px-4 py-3 text-right">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-800">
                                        @foreach (var item in Model.ResumenAlicuotasFactura)
                                        {
                                            <tr>
                                                <td class="px-4 py-3">
                                                    <p class="font-bold text-white">@item.AlicuotaIVANombre</p>
                                                    <p class="text-[11px] text-slate-500">@item.PorcentajeIVA.ToString("0.##")%</p>
                                                </td>
                                                <td class="px-4 py-3 text-right font-semibold text-slate-200">@item.BaseImponible.ToString("C2")</td>
                                                <td class="px-4 py-3 text-right font-semibold text-slate-200">@item.IVA.ToString("C2")</td>
                                                <td class="px-4 py-3 text-right font-black text-white">@item.Total.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }

                <!-- Envío (if applicable) -->
                @if (Model.Envio != null)
                {
                    var envio = Model.Envio;
                    <section class="card-erp-panel-padded">
                        <div class="mb-6 flex flex-col gap-3 border-b border-slate-800 pb-4 sm:flex-row sm:items-start sm:justify-between">
                            <div class="flex items-start gap-2">
                                <span class="material-symbols-outlined mt-0.5 text-primary">local_shipping</span>
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Entrega a domicilio</p>
                                    <h2 class="mt-1 text-xl font-bold text-white">Envío</h2>
                                    <p class="mt-1 text-sm text-slate-400">El importe de envío se cobra al cliente junto con los productos (Total a cobrar) y no integra el comprobante.</p>
                                </div>
                            </div>
                            <span class="pill @envio.EstadoPillClass shrink-0">@envio.EstadoDisplay</span>
                        </div>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
                            <div class="venta-stat sm:col-span-2 xl:col-span-3">
                                <p class="text-[10px] text-slate-500 font-bold uppercase">Destinatario</p>
                                <p class="text-sm font-bold text-white">@envio.Destinatario</p>
                            </div>
                            <div class="venta-stat sm:col-span-2 xl:col-span-3">
                                <p class="text-[10px] text-slate-500 font-bold uppercase">Domicilio de entrega</p>
                                <p class="text-sm font-bold text-white">
                                    @envio.Domicilio
                                    @if (!string.IsNullOrWhiteSpace(envio.Localidad) || !string.IsNullOrWhiteSpace(envio.Provincia))
                                    {
                                        <text>, @string.Join(", ", new[] { envio.Localidad, envio.Provincia }.Where(s => !string.IsNullOrWhiteSpace(s)))</text>
                                    }
                                </p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(envio.Telefono))
                            {
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Teléfono</p>
                                    <p class="text-sm font-bold text-white">@envio.Telefono</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(envio.Transportista))
                            {
                                <div class="venta-stat">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Transportista</p>
                                    <p class="text-sm font-bold text-white">@envio.Transportista</p>
                                </div>
                            }
                            <div class="venta-stat">
                                <p class="text-[10px] text-slate-500 font-bold uppercase">Costo de envío</p>
                                <p id="venta-envio-costo" class="text-sm font-bold text-white">@Model.ImporteEnvio.ToString("C2")</p>
                            </div>
                            @if (envio.Estado == EstadoEnvio.Fallido && !string.IsNullOrWhiteSpace(envio.MotivoNoEntrega))
                            {
                                <div class="venta-stat sm:col-span-2 xl:col-span-3">
                                    <p class="text-[10px] text-slate-500 font-bold uppercase">Motivo de la entrega fallida</p>
                                    <p class="text-sm font-bold text-amber-300">@envio.MotivoNoEntrega</p>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Authorization Info (if applicable) -->
                @if (Model.RequiereAutorizacion)
                {
                    <partial name="_VentaAutorizacionPanel" model="Model" />
                }
            </div>

            <!-- Right Column: Actions & Timeline -->
            <div class="space-y-4">

                <!-- Actions Card -->
                @{
                    // VENTA-DETAILS-01C (H6): autoridad única de "hay acciones disponibles",
                    // derivada exactamente de las mismas condiciones que ya gobiernan cada
                    // botón (Puede*, permisos, estado). No se duplica lógica de negocio: cada
                    // condición se nombra una sola vez y se reutiliza tanto para decidir el
                    // empty state como para renderizar el botón correspondiente.
                    // VENTA-DETAILS-FINAL (H8): si la venta está PendienteAutorizacion, el backend
                    // rechaza ConfigurarVenta (Get/Post) con "La venta requiere autorización antes
                    // de configurar el crédito." (CreditoController). Mostrar el CTA igual —y antes
                    // que Autorizar/Rechazar— es una contradicción de acciones (§14): no se renderiza
                    // mientras la autorización esté pendiente, sin duplicar la regla del backend.
                    var hayAccionConfigurarCredito = puedeOperarVentas && Model.PuedeConfigurarCredito && puedeVerCreditos && !Model.PuedeAutorizar;
                    var hayAccionGenerarContrato = puedeOperarVentas && Model.CreditoConfigurado && contratoVentaCredito == null;
                    // VENTA-DETAILS-DUPLICACION-02 (H12): "Ver contrato" es de solo lectura
                    // (ContratoVentaCreditoController.Ver sirve el PDF ya generado, sin
                    // ninguna verificación de caja) — igual que hayAccionImprimirFactura, que
                    // tampoco depende de puedeOperarVentas. El gate previo ocultaba el único
                    // acceso al contrato cuando no había caja abierta, lo que había forzado a
                    // duplicar el mismo botón sin condición dentro de la card "Contrato
                    // generado" para no perder esa vía.
                    var hayAccionVerContrato = contratoVentaCredito != null;
                    var hayAccionPrepararVenta = puedeOperarVentas && Model.PuedePrepararVenta && puedeActualizarVentas;
                    // Reapertura (reporte directo del usuario): "Confirmar Venta" (+ checkbox
                    // "Facturar al confirmar") se retira de Details — quedaba duplicado contra
                    // el mismo botón/modal del paso Revisión de Venta/Edit para la misma venta,
                    // dos autoridades ofreciendo la misma acción en dos pantallas. Confirmar
                    // queda como una acción exclusiva del wizard de edición; Details conserva
                    // "Editar Venta" como única vía hacia esa acción. hayAccionFacturar (venta
                    // YA confirmada, sólo falta facturarla) no se toca: es un estado distinto,
                    // sin equivalente en el wizard.
                    var hayAccionFacturar = puedeOperarVentas && Model.PuedeFacturar && puedeFacturarVentas;
                    var hayAccionImprimirFactura = tieneFactura && facturaActiva != null;
                    var hayAccionAutorizar = Model.PuedeAutorizar && (puedeAutorizarVentas || puedeRechazarVentas);
                    var hayAccionDevolucion = puedeOperarVentas && Model.PuedeCrearDevolucion && puedeCrearDevoluciones;
                    var hayAccionEditar = puedeOperarVentas && Model.PuedeEditar && puedeActualizarVentas;
                    var hayAccionCancelar = puedeCancelarVentas && puedeOperarVentas && Model.PuedeCancelar
                        && Model.Estado != EstadoVenta.Facturada && Model.Estado != EstadoVenta.Entregada;
                    var hayAccionAnularFactura = puedeOperarVentas && tieneFactura && facturaActiva != null && puedeFacturarVentas;
                    var hayAccionActualizarEnvio = puedeOperarVentas && puedeActualizarVentas && Model.PuedeCambiarEstadoEnvio;

                    var hayAccionesDestructivas = hayAccionCancelar || hayAccionAnularFactura;
                    var hayAccionesDisponibles = hayAccionConfigurarCredito || hayAccionGenerarContrato || hayAccionVerContrato
                        || hayAccionPrepararVenta || hayAccionFacturar
                        || hayAccionImprimirFactura || hayAccionAutorizar || hayAccionDevolucion || hayAccionEditar
                        || hayAccionActualizarEnvio
                        || hayAccionesDestructivas;
                }
                <section class="card-erp-panel-padded">
                    <div class="flex items-center gap-2 mb-6 border-b border-slate-800 pb-3">
                        <span class="material-symbols-outlined text-primary">bolt</span>
                        <h2 class="text-white text-xl font-bold">Acciones</h2>
                    </div>
                    <div class="flex flex-col gap-3">
                        @if (!hayAccionesDisponibles)
                        {
                            <p class="text-sm text-slate-400">Sin acciones disponibles para esta venta en su estado actual.</p>
                        }
                        else
                        {

                        @* Configurar Crédito *@
                        @if (hayAccionConfigurarCredito)
                        {
                            <a asp-action="ConfigurarVenta" asp-controller="Credito"
                               asp-route-id="@Model.CreditoId" asp-route-ventaId="@Model.Id"
                               class="btn-erp-warning btn-erp-block no-underline">
                                <span class="material-symbols-outlined text-sm">settings</span> Configurar Crédito
                            </a>
                        }

                        @* Contrato — requerido antes de confirmar en Crédito Personal *@
                        @if (hayAccionGenerarContrato)
                        {
                            <a asp-controller="ContratoVentaCredito" asp-action="Preparar"
                               asp-route-ventaId="@Model.Id"
                               class="btn-erp-warning btn-erp-block no-underline">
                                <span class="material-symbols-outlined text-sm">contract</span> Generar contrato
                            </a>
                        }
                        else if (hayAccionVerContrato)
                        {
                            <a asp-controller="ContratoVentaCredito" asp-action="Ver"
                               asp-route-ventaId="@Model.Id"
                               target="_blank" rel="noopener"
                               class="btn-erp-secondary btn-erp-block no-underline">
                                <span class="material-symbols-outlined text-sm">print</span> Ver contrato
                            </a>
                        }

                        @* Preparar venta *@
                        @if (hayAccionPrepararVenta)
                        {
                            <form asp-action="PrepararVenta" method="post" id="form-preparar-venta">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn-erp-primary btn-erp-block">
                                    <span class="material-symbols-outlined text-sm">assignment_turned_in</span> Preparar venta
                                </button>
                            </form>
                        }

                        @* Facturar *@
                        @if (hayAccionFacturar)
                        {
                            <button type="button"
                                    data-venta-modal-action="open"
                                    data-venta-modal-target="facturar-modal"
                                    class="btn-erp-success btn-erp-block">
                                <span class="material-symbols-outlined text-sm">receipt</span> Facturar
                            </button>
                        }

                        @* Imprimir Factura *@
                        @if (hayAccionImprimirFactura)
                        {
                            <a asp-action="ComprobanteFactura"
                               asp-route-facturaId="@facturaActiva!.Id"
                               target="_blank"
                               rel="noopener"
                               class="btn-erp-secondary btn-erp-block no-underline">
                                <span class="material-symbols-outlined text-sm">print</span> Imprimir Factura
                            </a>
                        }

                        @* Autorizar *@
                        @if (hayAccionAutorizar)
                        {
                            <div class="flex flex-col gap-2 sm:flex-row">
                                @if (puedeAutorizarVentas)
                                {
                                    <form asp-action="Autorizar" method="post" class="flex-1">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <button type="submit" class="btn-erp-success btn-erp-block">
                                            <span class="material-symbols-outlined text-sm">thumb_up</span> Autorizar
                                        </button>
                                    </form>
                                }
                                @if (puedeRechazarVentas)
                                {
                                    <form asp-action="Rechazar" method="post" class="flex-1">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <button type="submit" class="btn-erp-danger btn-erp-block">
                                            <span class="material-symbols-outlined text-sm">thumb_down</span> Rechazar
                                        </button>
                                    </form>
                                }
                            </div>
                        }

                        @* Devolucion *@
                        @if (hayAccionDevolucion)
                        {
                            <button type="button"
                               data-open-devolucion-modal
                               data-venta-id="@Model.Id"
                               class="btn-erp-ghost btn-erp-block">
                                <span class="material-symbols-outlined text-sm">undo</span> Crear Devolución
                            </button>
                        }

                        @* Actualizar estado de envío *@
                        @if (hayAccionActualizarEnvio)
                        {
                            <button type="button"
                                    id="btn-actualizar-envio"
                                    data-venta-modal-action="open"
                                    data-venta-modal-target="actualizar-envio"
                                    class="btn-erp-ghost btn-erp-block">
                                <span class="material-symbols-outlined text-sm">local_shipping</span> Actualizar Estado de Envío
                            </button>
                        }

                        @* Editar *@
                        @if (hayAccionEditar)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn-erp-ghost btn-erp-block no-underline">
                                <span class="material-symbols-outlined text-sm">edit</span> Editar Venta
                            </a>
                        }

                        @if (hayAccionesDestructivas)
                        {
                            <div class="border-t border-slate-800 pt-3 mt-1">
                                @* Cancelar *@
                                @if (hayAccionCancelar)
                                {
                                    <a asp-action="Cancelar" asp-route-id="@Model.Id"
                                       class="btn-erp-danger btn-erp-block no-underline">
                                        <span class="material-symbols-outlined text-sm">cancel</span> Cancelar Venta
                                    </a>
                                }

                                @* Anular Factura *@
                                @if (hayAccionAnularFactura)
                                {
                                    <button type="button"
                                            id="btn-anular-factura"
                                            data-factura-id="@facturaActiva!.Id"
                                            data-factura-numero="@facturaActiva.Numero"
                                            data-venta-modal-action="open"
                                            data-venta-modal-target="anular-factura"
                                            class="btn-erp-danger btn-erp-block">
                                        <span class="material-symbols-outlined text-sm">block</span> Anular Factura
                                    </button>
                                }
                            </div>
                        }
                        }
                    </div>
                </section>

                <!-- Status Timeline -->
                <section class="card-erp-panel-padded">
                    <div class="flex items-center gap-2 mb-6 border-b border-slate-800 pb-3">
                        <span class="material-symbols-outlined text-primary">timeline</span>
                        <h2 class="text-white text-xl font-bold">Historial</h2>
                    </div>
                    <div class="relative pl-6 space-y-4 before:absolute before:left-2.25 before:top-1 before:bottom-1 before:w-px before:bg-slate-700">
                        @* Created *@
                        <div class="relative flex items-start gap-3">
                            <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-primary border-2 border-slate-900 z-10"></div>
                            <div>
                                <p class="text-xs font-bold text-white">Venta creada</p>
                                <p class="text-[11px] text-slate-400">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>

                        @* Confirmed *@
                        @if (Model.FechaConfirmacion.HasValue)
                        {
                            <div class="relative flex items-start gap-3">
                                <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-primary border-2 border-slate-900 z-10"></div>
                                <div>
                                    <p class="text-xs font-bold text-white">Venta confirmada</p>
                                    <p class="text-[11px] text-slate-400">@Model.FechaConfirmacion.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        }

                        @* Credit configured *@
                        @if (Model.FechaConfiguracionCredito.HasValue)
                        {
                            <div class="relative flex items-start gap-3">
                                <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-blue-500 border-2 border-slate-900 z-10"></div>
                                <div>
                                    <p class="text-xs font-bold text-white">Crédito configurado</p>
                                    <p class="text-[11px] text-slate-400">@Model.FechaConfiguracionCredito.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        }

                        @* Invoiced *@
                        @if (Model.FechaFacturacion.HasValue)
                        {
                            <div class="relative flex items-start gap-3">
                                <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-green-500 border-2 border-slate-900 z-10"></div>
                                <div>
                                    <p class="text-xs font-bold text-white">Facturada</p>
                                    <p class="text-[11px] text-slate-400">@Model.FechaFacturacion.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                    @if (facturaActiva != null)
                                    {
                                        <p class="text-[11px] text-primary font-bold">@facturaActiva.Numero</p>
                                    }
                                </div>
                            </div>
                        }

                        @* Delivered *@
                        @if (Model.FechaEntrega.HasValue)
                        {
                            <div class="relative flex items-start gap-3">
                                <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-emerald-500 border-2 border-slate-900 z-10"></div>
                                <div>
                                    <p class="text-xs font-bold text-white">Entregada</p>
                                    <p class="text-[11px] text-slate-400">@Model.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        }

                        @* Cancelled *@
                        @if (Model.FechaCancelacion.HasValue)
                        {
                            <div class="relative flex items-start gap-3">
                                <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-red-500 border-2 border-slate-900 z-10"></div>
                                <div>
                                    <p class="text-xs font-bold text-red-500">Cancelada</p>
                                    <p class="text-[11px] text-slate-400">@Model.FechaCancelacion.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                    @if (!string.IsNullOrEmpty(Model.MotivoCancelacion))
                                    {
                                        <p class="text-[11px] text-slate-500 mt-0.5">@Model.MotivoCancelacion</p>
                                    }
                                </div>
                            </div>
                        }

                        @* Pending dot if not final state *@
                        @if (Model.Estado != EstadoVenta.Cancelada && Model.Estado != EstadoVenta.Entregada)
                        {
                            <div class="relative flex items-start gap-3">
                                <div class="absolute -left-6 top-0.5 size-4.5 rounded-full bg-slate-700 border-2 border-slate-900 z-10 animate-pulse"></div>
                                <div>
                                    <p class="text-xs text-slate-400 italic">
                                        @(Model.Estado switch
                                        {
                                            EstadoVenta.Presupuesto => "Esperando confirmación",
                                            EstadoVenta.Confirmada => "Pendiente de facturación",
                                            EstadoVenta.Facturada => "Pendiente de entrega",
                                            EstadoVenta.PendienteRequisitos => "Requisitos pendientes",
                                            EstadoVenta.PendienteFinanciacion => "Pendiente de financiación",
                                            _ => "Próximo paso..."
                                        })
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>

    </div>
</div>

@* Modal de Facturación *@
@if (puedeOperarVentas && Model.PuedeFacturar && puedeFacturarVentas)
{
    var facturaViewModel = ViewBag.FacturaViewModel as FacturaViewModel ?? new FacturaViewModel();
    var tiposFactura = ViewBag.TiposFactura as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    ViewData["TiposFactura"] = tiposFactura;

    <div id="facturar-modal"
         data-venta-modal="facturar-modal"
         data-venta-modal-backdrop
         aria-hidden="true"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4 backdrop-blur-sm overflow-y-auto">
        <div class="w-full max-w-2xl rounded-2xl bg-slate-900 my-8 shadow-2xl">
            <form asp-action="Facturar" method="post" id="form-facturar" class="space-y-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VentaId" value="@facturaViewModel.VentaId" />
                <input type="hidden" name="Subtotal" value="@facturaViewModel.Subtotal" />
                <input type="hidden" name="IVA" value="@facturaViewModel.IVA" />
                <input type="hidden" name="Total" value="@facturaViewModel.Total" />

                <!-- Header -->
                <header class="border-b border-slate-800 bg-slate-950/95 px-6 py-5 flex items-start justify-between gap-4 rounded-t-2xl">
                    <div class="min-w-0">
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-emerald-400">Emisión de comprobante</p>
                        <h3 class="mt-1 text-xl font-black tracking-tight text-white">Emitir factura</h3>
                    </div>
                    <button type="button"
                            data-venta-modal-action="close"
                            class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-800 hover:text-slate-200">
                        <span class="material-symbols-outlined text-base">close</span>
                    </button>
                </header>

                <!-- Body -->
                <div class="min-h-0 max-h-[calc(100vh-200px)] overflow-y-auto px-6 py-6 space-y-5">
                    @* COTIZACION-MIVENTA-02: extraído a un partial reutilizado también por el
                       Cotizador ("Facturar al confirmar") — misma fuente de verdad, ver
                       Views/Venta/_FacturaCamposEmision.cshtml. idPrefix por defecto ("modal-")
                       conserva los ids originales, así ningún JS/test existente de esta pantalla
                       se rompe. *@
                    <partial name="_FacturaCamposEmision" model="facturaViewModel" view-data="ViewData" />
                </div>

                <!-- Footer -->
                <footer class="border-t border-slate-800 bg-slate-950/95 px-6 py-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end rounded-b-2xl">
                    <button type="button"
                            data-venta-modal-action="close"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-5 py-2 text-sm font-bold text-slate-300 transition-colors hover:border-slate-600 hover:text-white sm:w-auto">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-500 px-5 py-2 text-sm font-black text-slate-950 shadow-lg shadow-emerald-500/20 transition-colors hover:bg-emerald-400 sm:w-auto">
                        <span class="material-symbols-outlined text-[18px]">receipt</span>
                        Emitir factura
                    </button>
                </footer>
            </form>
        </div>
    </div>
}

@if (puedeOperarVentas && tieneFactura && facturaActiva != null && puedeFacturarVentas)
{
    <div id="modal-anular-factura"
         data-venta-modal="anular-factura"
         data-venta-modal-backdrop
         aria-hidden="true"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4 backdrop-blur-sm">
        <div class="w-full max-w-lg rounded-2xl bg-slate-900 p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Anular factura</h3>
                    <p class="mt-1 text-sm text-slate-400">
                        Indicá el motivo de la anulación para la factura <span id="modal-anular-factura-numero" class="font-bold text-white">@facturaActiva.Numero</span>.
                    </p>
                </div>
                <button type="button"
                        data-venta-modal-action="close"
                        class="inline-flex size-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-800 hover:text-slate-200">
                    <span class="material-symbols-outlined text-base">close</span>
                </button>
            </div>

            <form asp-action="AnularFactura" method="post" id="form-anular-factura" class="mt-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="facturaId" id="anular-factura-id" value="@facturaActiva.Id" />

                <div class="rounded-2xl border border-red-500/20 bg-red-500/10 p-4 text-sm text-slate-300">
                    Esta acción revierte la factura activa de la venta y queda registrada en el historial operativo.
                </div>

                <div>
                    <label for="anular-factura-motivo" class="venta-label">Motivo de anulación</label>
                    <textarea id="anular-factura-motivo"
                              name="motivo"
                              rows="4"
                              required
                              placeholder="Describa el motivo de la anulación..."
                              data-modal-initial-focus
                              class="venta-input"></textarea>
                </div>

                <div class="venta-details-modal-footer flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                    <button type="button"
                            data-venta-modal-action="close"
                            class="venta-details-modal-action btn-erp-ghost">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="venta-details-modal-action btn-erp-danger">
                        Confirmar anulación
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Envio != null && hayAccionActualizarEnvio)
{
    <div id="modal-actualizar-envio"
         data-venta-modal="actualizar-envio"
         data-venta-modal-backdrop
         aria-hidden="true"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4 backdrop-blur-sm">
        <div class="w-full max-w-lg rounded-2xl bg-slate-900 p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Actualizar estado de envío</h3>
                    <p class="mt-1 text-sm text-slate-400">
                        Estado actual: <span class="pill @Model.Envio.EstadoPillClass">@Model.Envio.EstadoDisplay</span>
                    </p>
                </div>
                <button type="button"
                        data-venta-modal-action="close"
                        class="inline-flex size-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-800 hover:text-slate-200">
                    <span class="material-symbols-outlined text-base">close</span>
                </button>
            </div>

            <form asp-action="CambiarEstadoEnvio" method="post" id="form-actualizar-envio" class="mt-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div>
                    <label for="envio-nuevo-estado" class="venta-label">Nuevo estado</label>
                    <select id="envio-nuevo-estado" name="estado" required class="venta-input" data-modal-initial-focus>
                        @foreach (var siguiente in Model.Envio.EstadosSiguientesPosibles)
                        {
                            <option value="@((int)siguiente)">@TheBuryProject.ViewModels.VentaEnvioViewModel.EstadoDisplayFor(siguiente)</option>
                        }
                    </select>
                </div>

                <div id="envio-motivo-bloque" class="hidden">
                    <label for="envio-motivo" class="venta-label">Motivo de la entrega fallida</label>
                    <textarea id="envio-motivo" name="motivo" rows="3" maxlength="500"
                              placeholder="Por qué no se pudo entregar..." class="venta-input"></textarea>
                </div>

                <div class="venta-details-modal-footer flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                    <button type="button"
                            data-venta-modal-action="close"
                            class="venta-details-modal-action btn-erp-ghost">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="venta-details-modal-action btn-erp-primary">
                        Actualizar
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (puedeOperarVentas && Model.PuedeCrearDevolucion && puedeCrearDevoluciones)
{
    <partial name="_VentaDevolucionModal" />
}

@section Styles {
    <partial name="_VentaModuleStyles" />
}

@section Scripts {
    <script src="~/js/horizontal-scroll-affordance.js" asp-append-version="true"></script>
    <script src="~/js/venta-module.js" asp-append-version="true"></script>
    <script src="~/js/venta-devolucion-modal.js" asp-append-version="true"></script>
    <script src="~/js/details-venta.js" asp-append-version="true"></script>
}
