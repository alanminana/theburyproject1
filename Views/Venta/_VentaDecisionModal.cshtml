@model VentaDecisionModalViewModel
@* Modal de decisión sobre una venta (autorizar / rechazar / cancelar).
   Mismo patrón que modal-anular-factura (Details): [data-venta-modal] + bindModal.
   Postea a la acción MVC canónica con el motivo obligatorio, así el operador no pasa por
   una página aparte sólo para escribir una línea. Las páginas independientes siguen
   existiendo (links directos, Index). *@
<div id="modal-@Model.Name"
     data-venta-modal="@Model.Name"
     data-venta-modal-backdrop
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     aria-labelledby="modal-@Model.Name-titulo"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4 backdrop-blur-sm">
    <div class="w-full max-w-lg rounded-2xl bg-slate-900 p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h3 id="modal-@Model.Name-titulo" class="text-lg font-bold text-white">@Model.Title</h3>
                <p class="mt-1 text-sm text-slate-400">@Model.Description</p>
            </div>
            <button type="button"
                    data-venta-modal-action="close"
                    aria-label="Cerrar"
                    class="inline-flex size-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-800 hover:text-slate-200">
                <span class="material-symbols-outlined text-base">close</span>
            </button>
        </div>

        <form asp-action="@Model.Action" asp-route-id="@Model.VentaId" method="post" class="mt-6 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label for="motivo-@Model.Name" class="venta-label">@Model.MotivoLabel <span class="text-rose-500">*</span></label>
                <textarea id="motivo-@Model.Name"
                          name="motivo"
                          rows="4"
                          required
                          maxlength="500"
                          placeholder="@Model.MotivoPlaceholder"
                          data-modal-initial-focus
                          class="venta-input"></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.RequiredCheckText))
            {
                <label class="flex items-start gap-2 rounded-lg border border-amber-900/40 bg-amber-950/20 p-3 text-sm text-amber-200">
                    <input id="confirmo-@Model.Name" type="checkbox" required class="mt-0.5" />
                    <span>@Model.RequiredCheckText</span>
                </label>
            }

            <div class="venta-details-modal-footer flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button type="button"
                        data-venta-modal-action="close"
                        class="venta-details-modal-action btn-erp-ghost">
                    Volver
                </button>
                <button type="submit" class="venta-details-modal-action @Model.ConfirmButtonClass">
                    <span class="material-symbols-outlined text-sm">@Model.ConfirmIcon</span>
                    @Model.ConfirmText
                </button>
            </div>
        </form>
    </div>
</div>
