@model TheBuryProject.ViewModels.VentaViewModel
@using TheBuryProject.Models.Enums
@using TheBuryProject.Helpers
@{
    // Parcial compartido por Create_tw y Edit_tw. El modo se infiere del modelo:
    // una venta nueva no tiene Id (0); una edición sí. Ver Micro-lote 7 (paridad).
    var esEdicion = Model.Id > 0;
    var clientes = ViewBag.Clientes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var productos = ViewBag.Productos as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var tiposPago = ViewBag.TiposPago as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var tarjetas = ViewBag.Tarjetas as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var creditos = ViewBag.Creditos as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var categorias = ViewBag.CategoriasFiltro as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var marcas = ViewBag.MarcasFiltro as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var esCotizacion = Model.Estado == EstadoVenta.Cotizacion;
    var estadoLabel = esCotizacion ? "Cotización" : "Venta";
    var formAction = esEdicion ? "Edit" : "Create";
    // Cotizar es el paso 1 sólo en creación: en edición la operación ya existe y el
    // simulador no aplica. Desplaza la numeración estática del resto de los pasos
    // (venta-page-wizard.js la recalcula al cargar cuando Crédito está oculto).
    var pasoCotizar = !esEdicion;
    var offsetPaso = pasoCotizar ? 1 : 0;
    // Paso inicial: Cotizar en Create, Cliente en Edit.
    var clienteEsPasoInicial = !pasoCotizar;
    // Semilla de hidratación del wizard. Se emite también en alta cuando el modelo ya trae
    // datos (re-render por error de validación en Create POST): sin esto el operador pierde
    // el cliente y el detalle que ya había cargado.
    var sembrarEstado = esEdicion || Model.ClienteId > 0 || Model.Detalles.Count > 0;
    var ventaInicialJson = sembrarEstado
        ? System.Text.Json.JsonSerializer.Serialize(new
        {
            id = esEdicion ? Model.Id : (int?)null,
            creditoId = esEdicion ? Model.CreditoId : null,
            // Semilla para el configurador embebido (venta-credito-embebido.js): en
            // edición ya puede haber un crédito persistido (incluso ya configurado, p.ej.
            // venta convertida desde Cotización). En creación arrancan null/false: recién
            // se completan cuando el operador entra al paso Crédito por primera vez.
            creditoConfigurado = esEdicion && Model.CreditoConfigurado,
            cliente = Model.ClienteId > 0
                ? new
                {
                    id = Model.ClienteId,
                    nombre = Model.ClienteNombre,
                    documento = Model.ClienteDocumento
                }
                : null,
            detalles = Model.Detalles.Select(d => new
            {
                productoId = d.ProductoId,
                codigo = d.ProductoCodigo ?? string.Empty,
                nombre = d.ProductoNombre ?? string.Empty,
                cantidad = d.Cantidad,
                precioUnitario = d.PrecioUnitario,
                descuento = d.Descuento,
                subtotal = d.Subtotal,
                stock = d.StockDisponible,
                requiereNumeroSerie = d.RequiereNumeroSerie,
                productoUnidadId = (object?)d.ProductoUnidadId,
                productoUnidadLabel = d.ProductoUnidadCodigoInterno ?? string.Empty
            })
        }, new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        })
        : string.Empty;
    // Errores "" (nivel modelo: reglas de negocio, concurrencia) vs. errores de campo
    // (nivel formulario: algo que el operador puede corregir acá mismo). El título y la
    // acción del banner cambian según cuál predomina — antes ambos casos mostraban el
    // mismo "Corrige los errores antes de continuar", que no aplica a un conflicto de
    // concurrencia (no hay ningún campo que "corregir": hay que recargar y reintentar).
    var erroresModelo = ViewData.ModelState
        .Where(kvp => string.IsNullOrEmpty(kvp.Key))
        .SelectMany(kvp => kvp.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        .Select(e => e.ErrorMessage)
        .ToList();
    var erroresCampo = ViewData.ModelState
        .Where(kvp => !string.IsNullOrEmpty(kvp.Key))
        .SelectMany(kvp => kvp.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        .Select(e => e.ErrorMessage)
        .ToList();
    var esConflictoConcurrencia = erroresModelo.Any(m => m.Contains("modificada por otro usuario", StringComparison.OrdinalIgnoreCase));
    var bannerTitulo = esConflictoConcurrencia
        ? "No se pudo guardar: alguien más modificó esta operación"
        : (erroresCampo.Any() ? "Corrige los errores antes de continuar" : "No se pudo guardar la operación");
    // El camino "no viable" de Crédito Personal (VentaService/ValidacionVentaService) rechaza el
    // guardado con un InvalidOperationException cuyo mensaje es el resumen de negocio crudo
    // ("OPERACIÓN NO VIABLE: ... Requisitos pendientes: Documentación, Cupo"). Ese detalle ya está
    // visible paso a paso en Crédito (documentación/cupo/mora); repetirlo tal cual acá sólo agrega
    // texto de backend sin explicar qué hacer. Se reemplaza por un resumen corto que dirige al
    // operador a ese paso, sin volver a listar cada requisito.
    var esCreditoNoViable = erroresModelo.Any(m =>
        m.Contains("OPERACIÓN NO VIABLE", StringComparison.OrdinalIgnoreCase)
        || m.Contains("Requisitos pendientes:", StringComparison.OrdinalIgnoreCase));
    var erroresModeloParaMostrar = esCreditoNoViable
        ? new List<string> { "El cliente no cumple los requisitos mínimos para Crédito Personal. Revisá el detalle en el paso Crédito antes de continuar." }
        : erroresModelo;
    // VENTA-CREDITO-ARQUITECTURA-VISUAL-02: Observaciones pasa a <details> colapsado por
    // defecto (sidebar §13) — pero nunca debe arrancar oculto si ya trae un error de
    // validación real (ModelState), para no esconder algo que el operador necesita ver.
    var hayErrorObservaciones = ViewData.ModelState["Observaciones"]?.Errors?.Count > 0;
}

    <div id="banner-errores"
         class="@(ViewData.ModelState.IsValid ? "hidden" : "flex") flex-1 flex-col items-start justify-between gap-4 rounded-xl border border-red-500/30 bg-red-500/10 p-5 sm:flex-row sm:items-center mb-5">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-red-500">error</span>
            <div class="flex flex-col gap-1">
                <p class="text-white text-base font-bold leading-tight">@bannerTitulo</p>
                <div id="banner-errores-list" class="text-slate-400 text-sm">
                    @foreach (var error in erroresModeloParaMostrar.Concat(erroresCampo))
                    {
                        <p>@error</p>
                    }
                </div>
                @if (esConflictoConcurrencia && esEdicion)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="mt-1 inline-flex w-fit items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-bold text-white no-underline hover:bg-white/20">
                        <span class="material-symbols-outlined text-sm">refresh</span>
                        Recargar página
                    </a>
                }
            </div>
        </div>
        <button type="button" id="btn-cerrar-banner-errores"
                class="text-sm font-bold text-white opacity-70 hover:opacity-100">Cerrar</button>
    </div>

    @* ── TempData toasts ───────────────────────────────────────────────── *@
    @if (TempData["Success"] != null)
    {
        <div class="toast-msg flex items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400"
             role="status">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="toast-msg flex items-center gap-3 rounded-xl border border-amber-500/20 bg-amber-500/10 p-4 text-sm font-semibold text-amber-400"
             role="status">
            <span class="material-symbols-outlined">warning</span>
            @TempData["Warning"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-msg flex items-center gap-3 rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400"
             role="alert">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    <p id="wizard-feedback" class="hidden mb-4 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm font-semibold text-amber-200" role="alert" aria-live="assertive"></p>

    <form id="venta-form" asp-action="@formAction" method="post"
          data-credito-configurado="@Model.CreditoConfigurado.ToString().ToLowerInvariant()"
          data-excepcion-documental-registrada="@Model.TieneExcepcionDocumentalRegistrada.ToString().ToLowerInvariant()"
          data-excepcion-documental-motivo="@Model.MotivoExcepcionDocumental">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Estado" />
        <input type="hidden" asp-for="RowVersion" />
        @if (esEdicion)
        {
            <input type="hidden" asp-for="Id" />
        }
        @if (sembrarEstado)
        {
            <input type="hidden" id="venta-inicial-json" data-seed-target="window.ventaInicial" value="@ventaInicialJson" />
        }

        @* ══════════════════════════════════════════════════════════════════
           HERO — cabecera con métricas en vivo
           ══════════════════════════════════════════════════════════════════ *@
        <section class="hero-erp mb-5">
            <div class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
                <div class="space-y-3">
                    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                        @if (esEdicion)
                        {
                            <a asp-action="Index" class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1 text-slate-400 no-underline hover:bg-slate-700 transition-colors">Ventas</a>
                            <span class="text-slate-600">/</span>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1 text-slate-400 no-underline hover:bg-slate-700 transition-colors">@Model.Numero</a>
                            <span class="text-slate-600">/</span>
                            <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-primary">Editar</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1 text-slate-400">Ventas</span>
                            <span class="text-slate-600">/</span>
                            <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-primary">@estadoLabel en curso</span>
                        }
                        </div>
                        <div>
                            <h1 class="text-2xl font-black tracking-tight text-white sm:text-3xl">
                                @if (esEdicion)
                                {
                                    @(esCotizacion ? "Editar Cotización" : "Editar Venta")
                                }
                                else
                                {
                                    @(esCotizacion ? "Nueva Cotización" : "Nueva Venta")
                                }
                            </h1>
                            <p class="mt-2 text-sm text-slate-400 sm:text-base max-w-2xl">
                                @if (esEdicion)
                                {
                                    <text>Modificá los datos de la operación. Solo se pueden editar ventas en estado Cotización, Presupuesto, Pendiente Requisitos o Pendiente Financiación.</text>
                                }
                                else
                                {
                                    @(esCotizacion
                                        ? "Prepará el presupuesto, validá crédito si hace falta y dejá la operación lista para seguimiento."
                                        : "Armá la venta, verificá elegibilidad crediticia y cerrá la operación sin salir de la pantalla.")
                                }
                            </p>
                        </div>
                    </div>

                    <div class="flex w-full flex-col gap-3 sm:flex-row xl:w-auto xl:min-w-60 xl:flex-col">
                        @if (esEdicion)
                        {
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-erp-ghost h-11 w-full no-underline">Cancelar</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn-erp-ghost h-11 w-full no-underline">Cancelar</a>
                        }
                        <button type="button" data-wizard-primary
                                class="inline-flex h-11 w-full items-center justify-center rounded-xl bg-primary px-5 text-sm font-bold text-white shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90">
                            @if (esEdicion)
                            {
                                <text>Guardar cambios</text>
                            }
                            else
                            {
                                <text>Guardar Operación</text>
                            }
                        </button>
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between gap-3">
                    <div role="tablist" class="venta-wizard-tablist flex gap-1 overflow-x-auto" aria-label="Pasos de la venta">
                        @if (pasoCotizar)
                        {
                            <button type="button" id="step-btn-cotizar" role="tab" aria-selected="true" tabindex="0"
                                    aria-controls="step-panel-cotizar" data-step="cotizar" class="vm-step-tab vm-step-tab--active">
                                <span class="vm-step-tab__num">1</span>
                                Cotizar
                            </button>
                        }
                        <button type="button" id="step-btn-cliente" role="tab"
                                aria-selected="@(clienteEsPasoInicial ? "true" : "false")"
                                tabindex="@(clienteEsPasoInicial ? "0" : "-1")"
                                aria-controls="step-panel-cliente" data-step="cliente"
                                class="vm-step-tab @(clienteEsPasoInicial ? "vm-step-tab--active" : "")">
                            <span class="vm-step-tab__num">@(1 + offsetPaso)</span>
                            Cliente
                        </button>
                        <button type="button" id="step-btn-productos" role="tab" aria-selected="false" tabindex="-1"
                                aria-controls="step-panel-productos" data-step="productos" class="vm-step-tab">
                            <span class="vm-step-tab__num">@(2 + offsetPaso)</span>
                            Productos
                            <span id="detalle-items-badge" class="vm-step-tab__badge">0</span>
                        </button>
                        <button type="button" id="step-btn-pago" role="tab" aria-selected="false" tabindex="-1"
                                aria-controls="step-panel-pago" data-step="pago" class="vm-step-tab">
                            <span class="vm-step-tab__num">@(3 + offsetPaso)</span>
                            Pago
                        </button>
                        <button type="button" id="step-btn-credito" role="tab" aria-selected="false" tabindex="-1"
                                aria-controls="step-panel-credito" data-step="credito" class="vm-step-tab hidden" hidden>
                            <span class="vm-step-tab__num">@(4 + offsetPaso)</span>
                            Crédito
                        </button>
                        <button type="button" id="step-btn-revision" role="tab" aria-selected="false" tabindex="-1"
                                aria-controls="step-panel-revision" data-step="revision" class="vm-step-tab">
                            <span class="vm-step-tab__num">@(5 + offsetPaso)</span>
                            Revisión
                        </button>
                    </div>
                    <span id="vm-estado-global"
                          class="hidden shrink-0 items-center gap-1.5 rounded-full border border-slate-700 bg-slate-800/60 px-3 py-1 text-[10px] font-bold text-slate-400 sm:inline-flex">
                        Incompleta
                    </span>
                </div>

            </section>

            @* ══════════════════════════════════════════════════════════════════
           CUERPO — grilla 2/3 + 1/3
           ══════════════════════════════════════════════════════════════════ *@
            @* ── Paso 1 (sólo Create): cotizador embebido ─────────────────────
               Es el flujo canónico de Cotización reutilizado como parcial. No abre
               <form> propio ni emite antiforgery: postea por fetch a /api/cotizacion/*
               y toma el token de #venta-form. Ver Views/Cotizacion/_CotizadorForm.cshtml. *@
            @if (pasoCotizar)
            {
                <section id="step-panel-cotizar" role="tabpanel" aria-labelledby="step-btn-cotizar"
                         class="venta-cotizar-panel">
                    <partial name="~/Views/Cotizacion/_CotizadorForm.cshtml" />
                </section>
            }

            <div class="vm-mobile-summary-bar" data-venta-workspace role="region" aria-label="Resumen de compra">
                <div class="vm-mobile-summary-bar__info">
                    <span class="material-symbols-outlined vm-mobile-summary-bar__icon">receipt_long</span>
                    <span>Total: <strong id="vm-modal-sticky-total" data-mobile-total>$0,00</strong></span>
                </div>
                <button type="button" class="vm-btn-confirm-sm" data-wizard-primary>
                    <span class="material-symbols-outlined vm-btn-confirm-sm__icon">point_of_sale</span>
                    <span data-wizard-primary-label>@(esEdicion || esCotizacion ? "Guardar" : "Confirmar")</span>
                </button>
            </div>

            @* data-venta-workspace: se oculta mientras el paso activo es Cotizar, para que
               el simulador ocupe el ancho completo y no queden visibles los totales ni el
               CTA de la venta. Ver venta-page-wizard.css / .js (data-paso-activo). *@
            <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:items-start" data-venta-workspace>

                @* ── Columna izquierda (2/3) ──────────────────────────────── *@
                <div class="flex flex-col gap-5 lg:col-span-8">

                    @* ── Sección 1: Datos generales ─────────────────────── *@
                    <section id="step-panel-cliente" role="tabpanel" aria-labelledby="step-btn-cliente"
                             class="@(clienteEsPasoInicial ? "" : "hidden")">
                        <div class="venta-section">
                            <div class="mb-6 flex items-start justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <span
                                    class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full bg-primary/15 text-primary text-xs font-bold">1</span>
                                    <div>
                                        <h2 class="text-lg font-bold text-white">Datos generales</h2>
                                        <p class="text-sm text-slate-400">Seleccioná el cliente, la fecha y el tipo de pago
                                            principal antes de armar el detalle.</p>
                                        </div>
                                    </div>
                                    <span class="badge-erp badge-erp-neutral shrink-0">
                                        <span class="material-symbols-outlined text-sm">person</span>
                                        Cliente + contexto
                                    </span>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                                    @* Cliente *@
                                    <div class="md:col-span-2">
                                        <label class="venta-label" for="input-buscar-cliente">Buscar Cliente</label>
                                        <div class="relative">
                                            <span
                                            class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400">search</span>
                                            <input id="input-buscar-cliente" type="text" autocomplete="off" class="venta-input"
                                                   style="padding-left: 2.5rem" placeholder="Nombre, CUIT o DNI del cliente..." />
                                            <div id="dropdown-clientes"
                                                 class="absolute top-full left-0 w-full bg-slate-800 mt-1 rounded-lg border border-slate-700 shadow-xl z-20 hidden max-h-60 overflow-y-auto">
                                            </div>
                                        </div>
                                        <input type="hidden" asp-for="ClienteId" id="hdn-cliente-id" />
                                    </div>

                                    @* Cliente seleccionado *@
                                    <div id="info-cliente"
                                         class="md:col-span-2 hidden rounded-2xl border border-primary/20 bg-primary/10 p-4">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div
                                                    class="size-10 bg-primary/20 rounded-full flex items-center justify-center">
                                                    <span class="material-symbols-outlined text-primary text-sm">person</span>
                                                </div>
                                                <div>
                                                    <p id="info-cliente-nombre" class="text-sm font-bold text-white"></p>
                                                    <p id="info-cliente-doc" class="text-xs text-slate-500"></p>
                                                </div>
                                            </div>
                                            <button type="button" id="btn-limpiar-cliente"
                                                    class="text-xs font-bold text-red-500 hover:underline">Cambiar</button>
                                        </div>
                                    </div>

                                    @* Fecha *@
                                    <div>
                                        <label class="venta-label" for="FechaVenta">Fecha de Operación</label>
                                        <input asp-for="FechaVenta" type="date" class="venta-input" />
                                    </div>

                                </div>

                                @* Aviso de crédito personal (oculto por defecto) *@
                                <div id="panel-aviso-credito"
                                     class="mt-6 p-4 rounded-lg bg-orange-500/10 border border-orange-500/20 hidden">
                                    <div class="flex items-center gap-2 mb-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">info</span>
                                        <span class="text-orange-500 font-bold text-sm">Aviso de Crédito Personal</span>
                                    </div>
                                    <div class="grid grid-cols-3 gap-4 text-xs">
                                        <div>
                                            <p class="text-slate-400">Disponible</p>
                                            <p id="credito-disponible" class="text-white font-bold mt-0.5">$0,00</p>
                                        </div>
                                        <div>
                                            <p class="text-slate-400">Solicitado</p>
                                            <p id="credito-solicitado" class="text-white font-bold mt-0.5">$0,00</p>
                                        </div>
                                        <div>
                                            <p class="text-slate-400">Margen</p>
                                            <p id="credito-margen" class="text-white font-bold mt-0.5">$0,00</p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </section>

                        @* ── Sección 2: Selección de productos ──────────────── *@
                        <section id="step-panel-productos" role="tabpanel" aria-labelledby="step-btn-productos" class="hidden">
                            <div class="venta-section">
                                <div class="mb-6 flex items-start justify-between gap-4">
                                    <div class="flex items-center gap-3">
                                        <span
                                        class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full bg-primary/15 text-primary text-xs font-bold">2</span>
                                        <div>
                                            <h2 class="text-lg font-bold text-white">Selección de productos</h2>
                                            <p class="text-sm text-slate-400">Buscá artículos, afiná por filtros y revisá el
                                                detalle antes de pasar al cobro.</p>
                                            </div>
                                        </div>
                                        <span class="badge-erp badge-erp-neutral shrink-0">
                                            <span class="material-symbols-outlined text-sm">shopping_bag</span>
                                            0 productos
                                        </span>
                                    </div>

                                    @* Filtros avanzados *@
                                    <div
                                        class="grid grid-cols-1 gap-3 rounded-xl border border-slate-800 bg-slate-800/50 p-4 mb-5 md:grid-cols-4">
                                        <select id="filtro-categoria" class="venta-select text-xs">
                                            <option value="">Categoría: Todas</option>
                                            @if (categorias != null)
                                            {
                                                foreach (var cat in categorias)
                                                {
                                                    <option value="@cat.Value">@cat.Text</option>
                                                }
                                            }
                                        </select>
                                        <select id="filtro-marca" class="venta-select text-xs">
                                            <option value="">Marca: Todas</option>
                                            @if (marcas != null)
                                            {
                                                foreach (var marca in marcas)
                                                {
                                                    <option value="@marca.Value">@marca.Text</option>
                                                }
                                            }
                                        </select>
                                        <div class="flex gap-2">
                                            <input id="filtro-precio-min" type="number" min="0" step="0.01"
                                                   class="w-full venta-select text-xs" placeholder="Min $" />
