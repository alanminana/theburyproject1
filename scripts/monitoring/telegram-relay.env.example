# Instalar como /etc/bury-monitor/telegram-relay.env, modo 0600, propietario root. NUNCA versionar valores reales.
# Token del bot de Telegram (lo crea el propietario con @BotFather) y chat/grupo destino (id numerico).
BURY_RELAY_TELEGRAM_TOKEN=
BURY_RELAY_TELEGRAM_CHAT_ID=
# Mismo valor que BURY_MONITOR_TOKEN de monitor.env (el monitor lo envia como Bearer). Obligatorio.
BURY_RELAY_AUTH_TOKEN=
# En monitor.env: BURY_MONITOR_WEBHOOK=http://127.0.0.1:9098/alert  y  BURY_MONITOR_TOKEN=<mismo valor>
